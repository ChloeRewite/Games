						if isOpen then updateAccordionSize(true) end
					end

					function dropdownfunc:AddOption(option)
						local label, desc, img, value = parseOption(option)
						optionCount = optionCount + 1

						local hasDesc = (desc ~= nil and tostring(desc) ~= "")
						local hasImg = (img ~= nil and tostring(img) ~= "")

						local height = 28
						if hasDesc and hasImg then
							height = 46
						elseif hasDesc then
							height = 42
						elseif hasImg then
							height = 34
						else
							height = 28
						end

						local optbtn = instance.textbutton(scrollselect)
						optbtn.Name = "Option"
						optbtn.Size = UDim2.new(1, 0, 0, height)
						optbtn.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
						optbtn.BackgroundTransparency = 0
						optbtn.BorderSizePixel = 0
						optbtn.AutoButtonColor = false
						optbtn.Text = ""
						instance.uicorner(optbtn).CornerRadius = UDim.new(0, 4)

						local ostroke = instance.uistroke(optbtn)
						ostroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
						ostroke.Color = Color3.fromRGB(255, 255, 255)
						ostroke.Thickness = 1
						ostroke.Transparency = 0.92

