	local activeDropdown = nil
	local dropdownClosing = false
	local closeAnyPopover

	local function closeDropdown()
		if closeAnyPopover then
			closeAnyPopover()
		end
		activeDropdown = nil
		if dropdownClosing then
			return
		end
		dropdownClosing = true
		sv.ts:Create(dropdownselect, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(1, 220, 0.5, 0),
		}):Play()
		task.delay(0.25, function()
			dropdownClosing = false
			if not activeDropdown then
				moreblur.Visible = false
			end
		end)
	end

