								else
									sv.ts:Create(drop.Bar, TweenInfo.new(0.15), { Size = targetBar }):Play()
									sv.ts:Create(drop.OptionText, TweenInfo.new(0.15), { TextColor3 = targetTextCol }):Play()
								end

								if selected then
									table.insert(texts, drop.OptionText.Text)
								end
							end
						end

						local hasSelection = (#texts > 0)
						optionselecting.Text = hasSelection and table.concat(texts, ", ") or (dropdownconfig.Multi and "Select Options" or "Select Option")
						optionselecting.TextColor3 = Color3.fromRGB(160, 160, 160)
						optionselecting.TextTransparency = 0.55

						updateClearBtnVisibility()

						if dropdownconfig.Callback then
							if dropdownconfig.Multi then
								dropdownconfig.Callback(dropdownfunc.Value)
							else
								dropdownconfig.Callback(dropdownfunc.Value)
							end
						end
					end

					function dropdownfunc:ClearSelection()
						dropdownfunc:Set(dropdownconfig.Multi and {} or nil)
					end

