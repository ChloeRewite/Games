for t=1,64 do s[r:sub(t,t)]=t-1 end local function pureBase64Encode(t)local u={}
local v=#t local w=(3-(v%3))%3 local x=t..string.rep('\0',w)for y=1,#x,3 do
local z,A,B=string.byte(x,y,y+2)local C=bit32.bor(bit32.lshift(z,16),bit32.
lshift(A,8),B)local D=bit32.band(bit32.rshift(C,18),63)+1 local E=bit32.band(
bit32.rshift(C,12),63)+1 local F=bit32.band(bit32.rshift(C,6),63)+1 local G=
bit32.band(C,63)+1 table.insert(u,r:sub(D,D)..r:sub(E,E)..r:sub(F,F)..r:sub(G,G)
)end local y=table.concat(u)if w>0 then y=y:sub(1,-w-1)..string.rep('=',w)end
return y end local function pureBase64Decode(t)t=string.gsub(t,'[^A-Za-z0-9+/=]'
,'')local u={}local v=#t if v%4~=0 then return nil end local w=0 if t:sub(-2)==
'=='then w=2 elseif t:sub(-1)=='='then w=1 end for x=1,v,4 do local y=s[t:sub(x,
x)]local z=s[t:sub(x+1,x+1)]local A=s[t:sub(x+2,x+2)]or 0 local B=s[t:sub(x+3,x+
3)]or 0 if not y or not z then return nil end local C=bit32.bor(bit32.lshift(y,
18),bit32.lshift(z,12),bit32.lshift(A,6),B)local D=bit32.band(bit32.rshift(C,16)
,255)local E=bit32.band(bit32.rshift(C,8),255)local F=bit32.band(C,255)table.
insert(u,string.char(D))if x+2<=v-w then table.insert(u,string.char(E))end if x+
3<=v-w then table.insert(u,string.char(F))end end return table.concat(u)end
local function encodeBase64(t)if crypt and crypt.base64encode then local u,v=
pcall(crypt.base64encode,t)if u and v then return v end elseif syn and syn.crypt
and syn.crypt.base64 and syn.crypt.base64.encode then local u,v=pcall(syn.crypt.
base64.encode,t)if u and v then return v end elseif base64_encode then local u,v
=pcall(base64_encode,t)if u and v then return v end end return pureBase64Encode(
t)end local function decodeBase64(t)if crypt and crypt.base64decode then local u
,v=pcall(crypt.base64decode,t)if u and v then return v end elseif syn and syn.
crypt and syn.crypt.base64 and syn.crypt.base64.decode then local u,v=pcall(syn.
crypt.base64.decode,t)if u and v then return v end elseif base64_decode then
local u,v=pcall(base64_decode,t)if u and v then return v end end return
