						instance.uicorner(bar).CornerRadius = UDim.new(0, 2)

						local textX = 13
						if hasImg then
							local icon = instance.imagelabel(optbtn)
							icon.Name = "OptionIcon"
							icon.Image = img
							icon.BackgroundTransparency = 1
							local iconSize = hasDesc and 26 or 22
							icon.Position = UDim2.new(0, 11, 0.5, -math.floor(iconSize / 2))
							icon.Size = UDim2.new(0, iconSize, 0, iconSize)
							icon.ScaleType = Enum.ScaleType.Fit
							instance.uicorner(icon).CornerRadius = UDim.new(0, 4)
							textX = 11 + iconSize + 7
						end

						local opttext = instance.textlabel(optbtn)
						opttext.Name = "OptionText"
						opttext.Font = guiconfig.Font
						opttext.Text = label
						opttext.TextSize = 11
						opttext.TextColor3 = Color3.fromRGB(200, 200, 200)
						opttext.TextXAlignment = Enum.TextXAlignment.Left
						opttext.TextTruncate = Enum.TextTruncate.AtEnd
						opttext.BackgroundTransparency = 1

						if hasDesc then
							opttext.Position = UDim2.new(0, textX, 0, 4)
							opttext.Size = UDim2.new(1, -(textX + 8), 0, 15)

							local optdesc = instance.textlabel(optbtn)
							optdesc.Name = "OptionDesc"
							optdesc.Font = guiconfig.Font
							optdesc.Text = tostring(desc)
							optdesc.TextSize = 10
							optdesc.TextColor3 = Color3.fromRGB(135, 135, 135)
							optdesc.TextTransparency = 0.2
							optdesc.TextXAlignment = Enum.TextXAlignment.Left
							optdesc.TextTruncate = Enum.TextTruncate.AtEnd
							optdesc.BackgroundTransparency = 1
							optdesc.Position = UDim2.new(0, textX, 0, 21)
							optdesc.Size = UDim2.new(1, -(textX + 8), 0, 14)
