	chloeex.ResetOnSpawn = false
	chloeex.DisplayOrder = 100
	pcall(function()
		if not gethui and syn and syn.protect_gui then
			syn.protect_gui(chloeex)
		end
		chloeex.Parent = guiParent
	end)
	if not chloeex.Parent then
		pcall(function()
			chloeex.Parent = sv.plrs.LocalPlayer:WaitForChild("PlayerGui")
		end)
	end

