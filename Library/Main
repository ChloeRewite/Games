local function compareVersions(ct,cu)local cv,cw={},{}for cx in string.gmatch(ct
,'%d+')do table.insert(cv,tonumber(cx))end for cx in string.gmatch(cu,'%d+')do
table.insert(cw,tonumber(cx))end local cx=math.max(#cv,#cw)for cy=1,cx do local
cz=cv[cy]or 0 local cA=cw[cy]or 0 if cz~=cA then return cz>cA end end return ct>
cu end local function parseVersionFile(ct,cu)local cv=cu local cw=string.match(
cu,'%.([a-zA-Z]+)$')if cw then cv=string.gsub(cu,'%.'..cw..'$','')end if not
string.find(cv,'^[vV]')then cv='v'..cv end local cx,cy=pcall(function()return b.
http:JSONDecode(ct)end)if cx and type(cy)=='table'then if cy[1]and type(cy[1])==
'string'then return{Version=cy.Version or cv,Date=cy.Date or os.date('%d %b %Y')
,Logs=cy}else return{Version=cy.Version or cv,Date=cy.Date or os.date('%d %b %Y'
),Logs=cy.Logs or{}}end end local cz,cA=pcall(loadstring,ct)if cz and type(cA)==
'function'then local cB,cC=pcall(cA)if cB and type(cC)=='table'then return{
