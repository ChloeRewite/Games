						pcall(pressEffect, mainbutton)
					end)
					mainbutton.Activated:Connect(function()
						pcall(buttonconfig.Callback)
					end)

					buttonObj = mainbutton
				end

				registerSearchItem(buttonconfig.Title, buttonObj, "Button")
				countitem = countitem + 1
				yieldbuild()
			end

			function items:AddToggle(toggleconfig)
				toggleconfig = toggleconfig or {}
				toggleconfig.Title = toggleconfig.Title or "Title"
				toggleconfig.Default = toggleconfig.Default or false
				toggleconfig.Callback = toggleconfig.Callback or function() end

				-- // Dual Toggle Support (Single Card: Type = "Right" or "Down")
				if toggleconfig.SubTitle and (toggleconfig.SubCallback ~= nil or toggleconfig.SubDefault ~= nil or toggleconfig.Dual == true) then
					local layoutMode = (toggleconfig.Type and string.lower(tostring(toggleconfig.Type)))
						or (toggleconfig.Layout and string.lower(tostring(toggleconfig.Layout)))
						or "right"
					local isDown = (layoutMode == "down" or layoutMode == "bottom")

					local card = instance.frame(sectionadd)
					card.Name = "DualToggleCard"
					card.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
					card.BackgroundTransparency = 0
					card.BorderSizePixel = 0
					card.ClipsDescendants = true
					card.LayoutOrder = countitem
					card.Size = isDown and UDim2.new(1, 0, 0, 78) or UDim2.new(1, 0, 0, 46)

					instance.uicorner(card).CornerRadius = UDim.new(0, 6)

					local stroke = instance.uistroke(card)
					stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					stroke.Color = Color3.fromRGB(255, 255, 255)
					stroke.Thickness = 1
					stroke.Transparency = 0.88

					local sep = instance.frame(card)
					sep.Name = "Separator"
					sep.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
					sep.BackgroundTransparency = 0.92
					sep.BorderSizePixel = 0
					if isDown then
						sep.Position = UDim2.new(0, 10, 0, 39)
						sep.Size = UDim2.new(1, -20, 0, 1)
					else
						sep.Position = UDim2.new(0.5, 0, 0, 6)
						sep.Size = UDim2.new(0, 1, 1, -12)
					end

					local function createToggleBox(isSub)
						local tTitleText = isSub and toggleconfig.SubTitle or toggleconfig.Title
						local tDef = false
						if isSub then
							tDef = (toggleconfig.SubDefault == true)
						else
							tDef = (toggleconfig.Default == true)
						end
						local tCb = isSub and (toggleconfig.SubCallback or function() end) or (toggleconfig.Callback or function() end)

						local cfgKey = makeConfigKey("Toggle", tTitleText)
						local nKey = normalizeConfigKey(cfgKey)
						if config.data[cfgKey] ~= nil then
							tDef = config.data[cfgKey]
						elseif config.data[nKey] ~= nil then
							tDef = config.data[nKey]
						end

						local box = instance.frame(card)
						box.Name = isSub and "TogglePart2" or "TogglePart1"
						box.BackgroundTransparency = 1
						box.BorderSizePixel = 0
						box.ClipsDescendants = true

						local titleLbl = instance.textlabel(box)
						titleLbl.Name = "ToggleTitle"
						titleLbl.Font = guiconfig.Font or Enum.Font.GothamBold
						titleLbl.Text = tostring(tTitleText)
						titleLbl.TextColor3 = Color3.fromRGB(230, 230, 230)
						titleLbl.TextXAlignment = Enum.TextXAlignment.Left
						titleLbl.TextYAlignment = Enum.TextYAlignment.Center
						titleLbl.BackgroundTransparency = 1
						titleLbl.TextTruncate = Enum.TextTruncate.AtEnd

						local featFrame = instance.frame(box)
						featFrame.Name = "FeatureFrame"
						featFrame.AnchorPoint = Vector2.new(1, 0.5)
						featFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
						featFrame.BackgroundTransparency = 0.92
						featFrame.BorderSizePixel = 0
						instance.uicorner(featFrame).CornerRadius = UDim.new(1, 0)

						local featStroke = instance.uistroke(featFrame)
						featStroke.Color = Color3.fromRGB(255, 255, 255)
						featStroke.Thickness = 2
						featStroke.Transparency = 0.9

						local circle = instance.frame(featFrame)
						circle.Name = "ToggleCircle"
						circle.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
						circle.BorderSizePixel = 0
						circle.AnchorPoint = Vector2.new(0, 0.5)
						circle.Position = UDim2.new(0, 1, 0.5, 0)
						circle.Size = UDim2.new(0, 12, 0, 12)
						instance.uicorner(circle).CornerRadius = UDim.new(1, 0)

						if isDown then
							box.Size = UDim2.new(1, 0, 0, 39)
							box.Position = isSub and UDim2.new(0, 0, 0, 39) or UDim2.new(0, 0, 0, 0)
							titleLbl.Position = UDim2.new(0, 12, 0, 0)
							titleLbl.Size = UDim2.new(1, -54, 1, 0)
							titleLbl.TextSize = 12
							featFrame.Position = UDim2.new(1, -12, 0.5, 0)
							featFrame.Size = UDim2.new(0, 26, 0, 14)
						else
							box.Size = isSub and UDim2.new(0.5, -1, 1, 0) or UDim2.new(0.5, 0, 1, 0)
							box.Position = isSub and UDim2.new(0.5, 1, 0, 0) or UDim2.new(0, 0, 0, 0)
							titleLbl.Position = UDim2.new(0, 10, 0, 0)
							titleLbl.Size = UDim2.new(1, -44, 1, 0)
							titleLbl.TextSize = 11
							featFrame.Position = isSub and UDim2.new(1, -10, 0.5, 0) or UDim2.new(1, -8, 0.5, 0)
							featFrame.Size = UDim2.new(0, 26, 0, 14)
						end

						local clickBtn = instance.textbutton(box)
						clickBtn.Name = "ToggleButton"
						clickBtn.Text = ""
						clickBtn.BackgroundTransparency = 1
						clickBtn.Size = UDim2.new(1, 0, 1, 0)

						local singleFunc = {
							Value = tDef,
							Default = tDef,
							_configType = "Toggle",
						}

						function singleFunc:Set(val, instant)
							val = val and true or false
							singleFunc.Value = val
							config.data[cfgKey] = val

							if val then
								activeToggles[tTitleText] = singleFunc
							else
								activeToggles[tTitleText] = nil
							end
							if updateElementHud then
								updateElementHud()
							end

							if typeof(tCb) == "function" then
								local ok, err = pcall(function()
									tCb(val)
								end)
								if not ok then
									warn("Toggle Callback error:", err)
								end
							end

							local titleColor = val and guiconfig.Color or Color3.fromRGB(230, 230, 230)
							local circlePos = val and UDim2.new(1, -13, 0.5, 0) or UDim2.new(0, 1, 0.5, 0)
							local sColor = val and guiconfig.Color or Color3.fromRGB(255, 255, 255)
							local sTrans = val and 0 or 0.9
							local bColor = val and guiconfig.Color or Color3.fromRGB(255, 255, 255)
							local bTrans = val and 0 or 0.92

							if instant then
								titleLbl.TextColor3 = titleColor
								circle.Position = circlePos
								featStroke.Color = sColor
								featStroke.Transparency = sTrans
								featFrame.BackgroundColor3 = bColor
								featFrame.BackgroundTransparency = bTrans
							else
								sv.ts:Create(titleLbl, TweenInfo.new(0.2), { TextColor3 = titleColor }):Play()
								sv.ts:Create(circle, TweenInfo.new(0.2), { Position = circlePos }):Play()
								sv.ts:Create(featStroke, TweenInfo.new(0.2), { Color = sColor, Transparency = sTrans }):Play()
								sv.ts:Create(featFrame, TweenInfo.new(0.2), { BackgroundColor3 = bColor, BackgroundTransparency = bTrans }):Play()
							end
						end

						clickBtn.Activated:Connect(function()
							singleFunc:Set(not singleFunc.Value)
						end)

						singleFunc:Set(singleFunc.Value, true)
						config.elements[cfgKey] = singleFunc
						registerSearchItem(tTitleText, box, "Toggle")

						return singleFunc, box
					end

					local mainTog, box1 = createToggleBox(false)
					local subTog, box2 = createToggleBox(true)

					countitem = countitem + 1
					yieldbuild()

					local dualfunc = {
						Value = mainTog.Value,
						SubValue = subTog.Value,
						Main = mainTog,
						Sub = subTog,
						Card = card,
						_configType = "DualToggle",
					}
					function dualfunc:Set(val, instant)
						mainTog:Set(val, instant)
						dualfunc.Value = mainTog.Value
					end
					function dualfunc:SetSub(val, instant)
						subTog:Set(val, instant)
						dualfunc.SubValue = subTog.Value
					end

					return dualfunc
				end

				local configkey = makeConfigKey("Toggle", toggleconfig.Title)
				local normKey = normalizeConfigKey(configkey)
				if config.data[configkey] ~= nil then
					toggleconfig.Default = config.data[configkey]
				elseif config.data[normKey] ~= nil then
					toggleconfig.Default = config.data[normKey]
				end

				local togglefunc = {
					Value = toggleconfig.Default,
					Default = (toggleconfig.Default == true),
					_configType = "Toggle",
				}

				local toggle = templates.Toggle:Clone()
				toggle.LayoutOrder = countitem
				toggle.Parent = sectionadd

				local toggletitle = toggle.ToggleTitle
				toggletitle.Text = toggleconfig.Title

				local toggleSubText = toggleconfig.Title2 or toggleconfig.Content or toggleconfig.SubTitle or toggleconfig.Description
				if toggleSubText and tostring(toggleSubText) ~= "" then
					toggle.Size = UDim2.new(1, 0, 0, 56)
					toggletitle.Position = UDim2.new(0, 10, 0, 10)

					local togglesub = instance.textlabel(toggle)
					togglesub.Name = "ToggleSubTitle"
					togglesub.Font = toggletitle.Font
					togglesub.Text = tostring(toggleSubText)
					togglesub.TextSize = toggletitle.TextSize - 1
					togglesub.TextColor3 = Color3.fromRGB(255, 255, 255)
					togglesub.TextTransparency = 0.5
					togglesub.TextXAlignment = Enum.TextXAlignment.Left
					togglesub.TextYAlignment = Enum.TextYAlignment.Top
					togglesub.BackgroundTransparency = 1
					togglesub.Position = UDim2.new(0, 10, 0, 28)
					togglesub.Size = UDim2.new(1, -100, 0, 16)
					togglesub.TextTruncate = Enum.TextTruncate.AtEnd
				end

				local togglebutton = toggle.ToggleButton
				local featureframe2 = toggle.FeatureFrame
				local uistroke8 = featureframe2.UIStroke
				local togglecircle = featureframe2.ToggleCircle

				togglebutton.Activated:Connect(function()
					togglefunc.Value = not togglefunc.Value
					togglefunc:Set(togglefunc.Value)
				end)

				function togglefunc:Set(value, instant)
					value = value and true or false
					togglefunc.Value = value
					config.data[configkey] = value

					if value then
						activeToggles[toggleconfig.Title] = togglefunc
					else
						activeToggles[toggleconfig.Title] = nil
					end

					if updateElementHud then
						updateElementHud()
					end

					if typeof(toggleconfig.Callback) == "function" then
						local ok, err = pcall(function()
							toggleconfig.Callback(value)
						end)
						if not ok then
							warn("Toggle Callback error:", err)
						end
					end

					local titleColor = value and guiconfig.Color or Color3.fromRGB(230, 230, 230)
					local circlePosition = value and UDim2.new(0, 15, 0, 0) or UDim2.new(0, 0, 0, 0)
					local strokeColor = value and guiconfig.Color or Color3.fromRGB(255, 255, 255)
					local strokeTransparency = value and 0 or 0.9
					local backgroundColor = value and guiconfig.Color or Color3.fromRGB(255, 255, 255)
					local backgroundTransparency = value and 0 or 0.92

					if instant then
						toggletitle.TextColor3 = titleColor
						togglecircle.Position = circlePosition
						uistroke8.Color = strokeColor
						uistroke8.Transparency = strokeTransparency
						featureframe2.BackgroundColor3 = backgroundColor
						featureframe2.BackgroundTransparency = backgroundTransparency
					else
						sv.ts:Create(toggletitle, TweenInfo.new(0.2), { TextColor3 = titleColor }):Play()
						sv.ts:Create(togglecircle, TweenInfo.new(0.2), { Position = circlePosition }):Play()
						sv.ts
							:Create(uistroke8, TweenInfo.new(0.2), {
								Color = strokeColor,
								Transparency = strokeTransparency,
							})
							:Play()
						sv.ts
							:Create(featureframe2, TweenInfo.new(0.2), {
								BackgroundColor3 = backgroundColor,
								BackgroundTransparency = backgroundTransparency,
							})
							:Play()
					end
				end
				togglefunc:Set(togglefunc.Value, true)

				-- // Mini UI Sync for Toggle (Main UI only)
				if not isInfo and miniScroll then
					miniLayoutOrder = miniLayoutOrder + 1
					local mRow = instance.frame(miniScroll)
					mRow.Name = "MiniToggle_" .. toggleconfig.Title
					mRow.LayoutOrder = miniLayoutOrder
					mRow.Size = UDim2.new(1, 0, 0, 32)
					mRow.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
					mRow.BackgroundTransparency = 0.3
					mRow.BorderSizePixel = 0
					instance.uicorner(mRow).CornerRadius = UDim.new(0, 5)

					local mStroke = instance.uistroke(mRow)
					mStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					mStroke.Color = Color3.fromRGB(255, 255, 255)
					mStroke.Thickness = 1
					mStroke.Transparency = 0.92

					local mTitle = instance.textlabel(mRow)
					mTitle.Font = guiconfig.Font or Enum.Font.GothamBold
					mTitle.Text = toggleconfig.Title
					mTitle.TextSize = 11
					mTitle.TextColor3 = Color3.fromRGB(210, 210, 210)
					mTitle.TextXAlignment = Enum.TextXAlignment.Left
					mTitle.TextTruncate = Enum.TextTruncate.AtEnd
					mTitle.BackgroundTransparency = 1
					mTitle.Position = UDim2.new(0, 8, 0, 0)
					mTitle.Size = UDim2.new(1, -44, 1, 0)

					local mSwitch = instance.frame(mRow)
					mSwitch.Name = "Switch"
					mSwitch.AnchorPoint = Vector2.new(1, 0.5)
					mSwitch.Position = UDim2.new(1, -8, 0.5, 0)
					mSwitch.Size = UDim2.new(0, 26, 0, 14)
					mSwitch.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
					instance.uicorner(mSwitch).CornerRadius = UDim.new(1, 0)

					local mSwitchStroke = instance.uistroke(mSwitch)
					mSwitchStroke.Color = Color3.fromRGB(255, 255, 255)
					mSwitchStroke.Thickness = 1
					mSwitchStroke.Transparency = 0.85

					local mDot = instance.frame(mSwitch)
					mDot.Name = "Dot"
					mDot.AnchorPoint = Vector2.new(0, 0.5)
					mDot.Position = UDim2.new(0, 1, 0.5, 0)
					mDot.Size = UDim2.new(0, 12, 0, 12)
					mDot.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
					instance.uicorner(mDot).CornerRadius = UDim.new(1, 0)

					local mBtn = instance.textbutton(mRow)
					mBtn.Text = ""
					mBtn.BackgroundTransparency = 1
					mBtn.Size = UDim2.new(1, 0, 1, 0)

					local function updateMiniToggleVisual(val, instant)
						local sColor = val and guiconfig.Color or Color3.fromRGB(35, 35, 35)
						local dPos = val and UDim2.new(1, -13, 0.5, 0) or UDim2.new(0, 1, 0.5, 0)
						local tColor = val and guiconfig.Color or Color3.fromRGB(210, 210, 210)
						if instant then
							mSwitch.BackgroundColor3 = sColor
							mDot.Position = dPos
							mTitle.TextColor3 = tColor
						else
							sv.ts:Create(mSwitch, TweenInfo.new(0.2), { BackgroundColor3 = sColor }):Play()
							sv.ts:Create(mDot, TweenInfo.new(0.2), { Position = dPos }):Play()
							sv.ts:Create(mTitle, TweenInfo.new(0.2), { TextColor3 = tColor }):Play()
						end
					end

					mBtn.Activated:Connect(function()
						togglefunc:Set(not togglefunc.Value)
					end)

					local oldSet = togglefunc.Set
					function togglefunc:Set(val, instant)
						oldSet(self, val, instant)
						updateMiniToggleVisual(self.Value, instant)
						if refreshMiniItems then
							refreshMiniItems()
						end
					end

					updateMiniToggleVisual(togglefunc.Value, true)

					local mItemEntry = {
						Type = "Toggle",
						Title = toggleconfig.Title,
						SectionTitle = sectiontitletext,
						Row = mRow,
						IsActive = function()
							return togglefunc.Value == true
						end,
					}
					table.insert(miniElements, mItemEntry)
					if currentMiniSection then
						table.insert(currentMiniSection.Items, mItemEntry)
					end
					if queueMiniRefresh then
						queueMiniRefresh()
					end
				end

				countitem = countitem + 1
				yieldbuild()
				config.elements[configkey] = togglefunc
				registerSearchItem(toggleconfig.Title, toggle, "Toggle")
				return togglefunc
			end

			function items:AddSlider(sliderconfig)
				sliderconfig = sliderconfig or {}
				sliderconfig.Title = sliderconfig.Title or sliderconfig.Name or "Slider"
				sliderconfig.Increment = tonumber(sliderconfig.Increment) or 1
				sliderconfig.Min = tonumber(sliderconfig.Min) or 0
				sliderconfig.Max = tonumber(sliderconfig.Max) or 100
				sliderconfig.Default = tonumber(sliderconfig.Default) or sliderconfig.Min
				sliderconfig.Callback = sliderconfig.Callback or function() end

				-- // Dual Slider Support (Single Card: Type = "Right" or "Down")
				if sliderconfig.SubTitle and (sliderconfig.SubCallback ~= nil or sliderconfig.SubDefault ~= nil or sliderconfig.SubMin ~= nil or sliderconfig.SubMax ~= nil or sliderconfig.Dual == true) then
					local layoutMode = (sliderconfig.Type and string.lower(tostring(sliderconfig.Type)))
						or (sliderconfig.Layout and string.lower(tostring(sliderconfig.Layout)))
						or "right"
					local isDown = (layoutMode == "down" or layoutMode == "bottom")

					local card = instance.frame(sectionadd)
					card.Name = "DualSliderCard"
					card.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
					card.BackgroundTransparency = 0
					card.BorderSizePixel = 0
					card.ClipsDescendants = true
					card.LayoutOrder = countitem
					card.Size = isDown and UDim2.new(1, 0, 0, 110) or UDim2.new(1, 0, 0, 58)

					instance.uicorner(card).CornerRadius = UDim.new(0, 6)

					local stroke = instance.uistroke(card)
					stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					stroke.Color = Color3.fromRGB(255, 255, 255)
					stroke.Thickness = 1
					stroke.Transparency = 0.88

					local sep = instance.frame(card)
					sep.Name = "Separator"
					sep.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
					sep.BackgroundTransparency = 0.92
					sep.BorderSizePixel = 0
					if isDown then
						sep.Position = UDim2.new(0, 10, 0, 55)
						sep.Size = UDim2.new(1, -20, 0, 1)
					else
						sep.Position = UDim2.new(0.5, 0, 0, 8)
						sep.Size = UDim2.new(0, 1, 1, -16)
					end

					local function createSliderBox(isSub)
						local sTitle = isSub and sliderconfig.SubTitle or sliderconfig.Title
						local sMin = isSub and (tonumber(sliderconfig.SubMin or sliderconfig.Min) or 0) or (tonumber(sliderconfig.Min) or 0)
						local sMax = isSub and (tonumber(sliderconfig.SubMax or sliderconfig.Max) or 100) or (tonumber(sliderconfig.Max) or 100)
						local sInc = isSub and (tonumber(sliderconfig.SubIncrement or sliderconfig.Increment) or 1) or (tonumber(sliderconfig.Increment) or 1)
						local sDef = isSub and (tonumber(sliderconfig.SubDefault) or sMin) or (tonumber(sliderconfig.Default) or sMin)
						local sCb = isSub and (sliderconfig.SubCallback or function() end) or (sliderconfig.Callback or function() end)
						local sSuffix = isSub and (sliderconfig.SubSuffix or sliderconfig.Suffix or "") or (sliderconfig.Suffix or "")

						local cfgKey = makeConfigKey("Slider", sTitle)
						local nKey = normalizeConfigKey(cfgKey)
						if config.data[cfgKey] ~= nil then
							sDef = tonumber(config.data[cfgKey]) or sDef
						elseif config.data[nKey] ~= nil then
							sDef = tonumber(config.data[nKey]) or sDef
						end

						local function getprecision(step)
							local s = tostring(step)
							if s:find("e") or s:find("E") then
								s = string.format("%.12f", step):gsub("0+$", ""):gsub("%.$", "")
							end
							local dot = s:find("%.")
							return dot and (#s - dot) or 0
						end

						local sPrec = tonumber(isSub and sliderconfig.SubPrecision or sliderconfig.Precision) or getprecision(sInc)

						local function clampVal(val)
							val = tonumber(val) or sMin
							val = math.clamp(val, sMin, sMax)
							val = math.floor((val / sInc) + 0.5) * sInc
							val = math.clamp(val, sMin, sMax)
							return tonumber(string.format("%." .. sPrec .. "f", val)) or sMin
						end

						local curVal = clampVal(sDef)

						local box = instance.frame(card)
						box.Name = isSub and "SliderPart2" or "SliderPart1"
						box.BackgroundTransparency = 1
						box.BorderSizePixel = 0
						box.ClipsDescendants = true

						local titleLbl = instance.textlabel(box)
						titleLbl.Name = "SliderTitle"
						titleLbl.Font = guiconfig.Font or Enum.Font.GothamBold
						titleLbl.Text = tostring(sTitle)
						titleLbl.TextColor3 = Color3.fromRGB(230, 230, 230)
						titleLbl.TextXAlignment = Enum.TextXAlignment.Left
						titleLbl.BackgroundTransparency = 1
						titleLbl.TextTruncate = Enum.TextTruncate.AtEnd

						local valLbl = instance.textlabel(box)
						valLbl.Name = "ValueLabel"
						valLbl.Font = guiconfig.Font or Enum.Font.GothamBold
						valLbl.Text = tostring(curVal) .. sSuffix
						valLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
						valLbl.TextXAlignment = Enum.TextXAlignment.Right
						valLbl.AnchorPoint = Vector2.new(1, 0)
						valLbl.BackgroundTransparency = 1

						local track = instance.frame(box)
						track.Name = "SliderTrack"
						track.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
						track.BorderSizePixel = 0
						instance.uicorner(track).CornerRadius = UDim.new(1, 0)

						local fill = instance.frame(track)
						fill.Name = "SliderFill"
						fill.BackgroundColor3 = sliderconfig.Color or guiconfig.Color or Color3.fromRGB(0, 208, 255)
						fill.BorderSizePixel = 0
						fill.Size = UDim2.new(0, 0, 1, 0)
						instance.uicorner(fill).CornerRadius = UDim.new(1, 0)

						local circle = instance.frame(track)
						circle.Name = "SliderCircle"
						circle.AnchorPoint = Vector2.new(0.5, 0.5)
						circle.Position = UDim2.new(0, 0, 0.5, 0)
						circle.Size = UDim2.new(0, 12, 0, 12)
						circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
						circle.BorderSizePixel = 0
						instance.uicorner(circle).CornerRadius = UDim.new(1, 0)

						if isDown then
							box.Size = UDim2.new(1, 0, 0, 55)
							box.Position = isSub and UDim2.new(0, 0, 0, 55) or UDim2.new(0, 0, 0, 0)
							titleLbl.Position = UDim2.new(0, 12, 0, 8)
							titleLbl.Size = UDim2.new(1, -64, 0, 15)
							titleLbl.TextSize = 12
							valLbl.Position = UDim2.new(1, -12, 0, 8)
							valLbl.Size = UDim2.new(0, 50, 0, 15)
							valLbl.TextSize = 12
							track.Position = UDim2.new(0, 12, 0, 32)
							track.Size = UDim2.new(1, -24, 0, 6)
						else
							box.Size = isSub and UDim2.new(0.5, -1, 1, 0) or UDim2.new(0.5, 0, 1, 0)
							box.Position = isSub and UDim2.new(0.5, 1, 0, 0) or UDim2.new(0, 0, 0, 0)
							titleLbl.Position = isSub and UDim2.new(0, 8, 0, 8) or UDim2.new(0, 10, 0, 8)
							titleLbl.Size = UDim2.new(1, -50, 0, 14)
							titleLbl.TextSize = 11
							valLbl.Position = isSub and UDim2.new(1, -10, 0, 8) or UDim2.new(1, -8, 0, 8)
							valLbl.Size = UDim2.new(0, 42, 0, 14)
							valLbl.TextSize = 11
							track.Position = isSub and UDim2.new(0, 8, 0, 34) or UDim2.new(0, 10, 0, 34)
							track.Size = UDim2.new(1, -18, 0, 6)
						end

						local singleFunc = {
							Value = curVal,
							Default = curVal,
							Min = sMin,
							Max = sMax,
							_configType = "Slider",
						}

						local function updateVisual(val, instant)
							local pct = (sMax == sMin) and 0 or math.clamp((val - sMin) / (sMax - sMin), 0, 1)
							valLbl.Text = tostring(val) .. sSuffix
							if instant then
								fill.Size = UDim2.new(pct, 0, 1, 0)
								circle.Position = UDim2.new(pct, 0, 0.5, 0)
							else
								sv.ts:Create(fill, TweenInfo.new(0.08), { Size = UDim2.new(pct, 0, 1, 0) }):Play()
								sv.ts:Create(circle, TweenInfo.new(0.08), { Position = UDim2.new(pct, 0, 0.5, 0) }):Play()
							end
						end

						function singleFunc:Set(val, instant)
							local clamped = clampVal(val)
							singleFunc.Value = clamped
							config.data[cfgKey] = clamped
							updateVisual(clamped, instant)
							if typeof(sCb) == "function" then
								pcall(sCb, clamped)
							end
						end

						-- Drag interaction
						local dragging = false
						local function updateFromInput(inputObj)
							local trackPos = track.AbsolutePosition.X
							local trackSize = track.AbsoluteSize.X
							if trackSize <= 0 then return end
							local mouseX = inputObj.Position.X
							local pct = math.clamp((mouseX - trackPos) / trackSize, 0, 1)
							local rawVal = sMin + pct * (sMax - sMin)
							singleFunc:Set(rawVal, false)
						end

						local clickBtn = instance.textbutton(box)
						clickBtn.Name = "SliderButton"
						clickBtn.Text = ""
						clickBtn.BackgroundTransparency = 1
						clickBtn.Position = isDown and UDim2.new(0, 0, 0, 20) or UDim2.new(0, 0, 0, 20)
						clickBtn.Size = isDown and UDim2.new(1, 0, 0, 32) or UDim2.new(1, 0, 1, -20)
						clickBtn.ZIndex = 5

						clickBtn.InputBegan:Connect(function(inputObj)
							if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
								dragging = true
								updateFromInput(inputObj)
							end
						end)

						clickBtn.InputEnded:Connect(function(inputObj)
							if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
								dragging = false
							end
						end)

						sv.uis.InputChanged:Connect(function(inputObj)
							if dragging and (inputObj.UserInputType == Enum.UserInputType.MouseMovement or inputObj.UserInputType == Enum.UserInputType.Touch) then
								updateFromInput(inputObj)
							end
						end)

						sv.uis.InputEnded:Connect(function(inputObj)
							if dragging and (inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch) then
								dragging = false
							end
						end)

						singleFunc:Set(singleFunc.Value, true)
						config.elements[cfgKey] = singleFunc
						registerSearchItem(sTitle, box, "Slider")

						return singleFunc, box
					end

					local mainSld, box1 = createSliderBox(false)
					local subSld, box2 = createSliderBox(true)

					countitem = countitem + 1
					yieldbuild()

					local dualfunc = {
						Value = mainSld.Value,
						SubValue = subSld.Value,
						Main = mainSld,
						Sub = subSld,
						Card = card,
						_configType = "DualSlider",
					}
					function dualfunc:Set(val, instant)
						mainSld:Set(val, instant)
						dualfunc.Value = mainSld.Value
					end
					function dualfunc:SetSub(val, instant)
						subSld:Set(val, instant)
						dualfunc.SubValue = subSld.Value
					end
					function dualfunc:Get()
						return mainSld.Value
					end
					function dualfunc:GetSub()
						return subSld.Value
					end

					return dualfunc
				end

				local configkey = makeConfigKey("Slider", sliderconfig.Title)
				local normKey = normalizeConfigKey(configkey)
				if config.data[configkey] ~= nil then
					sliderconfig.Default = tonumber(config.data[configkey]) or sliderconfig.Default
				elseif config.data[normKey] ~= nil then
					sliderconfig.Default = tonumber(config.data[normKey]) or sliderconfig.Default
				end

				local function getprecision(step)
					local s = tostring(step)
					if s:find("e") or s:find("E") then
						s = string.format("%.12f", step):gsub("0+$", ""):gsub("%.$", "")
					end

					local dot = s:find("%.")
					return dot and (#s - dot) or 0
				end

				local precision = tonumber(sliderconfig.Precision) or getprecision(sliderconfig.Increment)

				local function roundtoincrement(value)
					local step = sliderconfig.Increment
					return math.floor((value / step) + 0.5) * step
				end

				local function formatnumber(value)
					value = tonumber(string.format("%." .. precision .. "f", value)) or 0

					if precision > 0 then
						return string.format("%." .. precision .. "f", value):gsub("0+$", ""):gsub("%.$", "")
					end

					return tostring(math.floor(value + 0.5))
				end

				local function clampvalue(value)
					value = tonumber(value) or sliderconfig.Min
					value = math.clamp(value, sliderconfig.Min, sliderconfig.Max)
					value = roundtoincrement(value)
					value = math.clamp(value, sliderconfig.Min, sliderconfig.Max)
					value = tonumber(string.format("%." .. precision .. "f", value)) or sliderconfig.Min
					return value
				end

				local sliderfunc = {
					Value = clampvalue(sliderconfig.Default),
					Default = clampvalue(sliderconfig.Default),
					Min = sliderconfig.Min,
					Max = sliderconfig.Max,
					_configType = "Slider",
				}

				local slider = templates.Slider:Clone()
				slider.LayoutOrder = countitem
				slider.Parent = sectionadd

				local slidertitle = slider.SliderTitle
				slidertitle.Text = sliderconfig.Title

				local inputholder = slider.SliderInputHolder
				local textbox = inputholder.SliderInput

				local sliderframe = slider.SliderBar
				local sliderfill = sliderframe.SliderFill
				local slidercircle = sliderframe.SliderCircle
				local circlestroke = slidercircle:FindFirstChildWhichIsA("UIStroke") or slidercircle.UIStroke
				local bubble = sliderframe.ValueBubble
				local bubbletext = bubble.BubbleText

				local sliderSubText = sliderconfig.Title2 or sliderconfig.Content or sliderconfig.SubTitle or sliderconfig.Description
				if sliderSubText and tostring(sliderSubText) ~= "" then
					slider.Size = UDim2.new(1, 0, 0, 72)
					slidertitle.Position = UDim2.new(0, 10, 0, 5)
					slidertitle.Size = UDim2.new(1, -58, 0, 14)

					local slidersub = instance.textlabel(slider)
					slidersub.Name = "SliderSubTitle"
					slidersub.Font = slidertitle.Font
					slidersub.Text = tostring(sliderSubText)
					slidersub.TextSize = slidertitle.TextSize - 1
					slidersub.TextColor3 = Color3.fromRGB(255, 255, 255)
					slidersub.TextTransparency = 0.5
					slidersub.TextXAlignment = Enum.TextXAlignment.Left
					slidersub.TextYAlignment = Enum.TextYAlignment.Top
					slidersub.BackgroundTransparency = 1
					slidersub.Position = UDim2.new(0, 10, 0, 21)
					slidersub.Size = UDim2.new(1, -58, 0, 14)
					slidersub.TextTruncate = Enum.TextTruncate.AtEnd

					sliderframe.Position = UDim2.new(0, 10, 0, 48)
				end

				if sliderconfig.Color then
					sliderfill.BackgroundColor3 = sliderconfig.Color
					slidercircle.BackgroundColor3 = sliderconfig.Color
				end
				bubble.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
				bubble.BackgroundTransparency = 0.05

				local dragging = false
				local setting = false
				local dragInputConn = nil
				local dragEndedConn = nil

				local function getpercent(value)
					if sliderconfig.Max == sliderconfig.Min then
						return 0
					end

					return math.clamp((value - sliderconfig.Min) / (sliderconfig.Max - sliderconfig.Min), 0, 1)
				end

				local function updatebubble(percent, value)
					local valStr = tostring(value)
					local w = math.clamp(#valStr * 8 + 14, 28, 48)
					bubble.AnchorPoint = Vector2.new(percent, 1)
					bubble.Position = UDim2.new(percent, 0, 0, -8)
					bubble.Size = UDim2.new(0, w, 0, 18)
					bubbletext.Text = valStr
				end

				local function showbubble()
					bubble.Visible = true

					sv.ts
						:Create(slidercircle, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							Size = UDim2.new(0, 16, 0, 16),
							BackgroundTransparency = 0.55,
						})
						:Play()

					if circlestroke then
						sv.ts
							:Create(circlestroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								Transparency = 0.1,
								Thickness = 1.6,
							})
							:Play()
					end

					local valStr = tostring(sliderfunc.Value or "")
					local w = math.clamp(#valStr * 8 + 14, 28, 48)

					sv.ts
						:Create(bubble, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							BackgroundTransparency = 0.05,
							Size = UDim2.new(0, w, 0, 18),
						})
						:Play()
					sv.ts
						:Create(bubbletext, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							TextTransparency = 0,
						})
						:Play()
				end

				local function hidebubble()
					sv.ts
						:Create(slidercircle, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							Size = UDim2.new(0, 12, 0, 12),
							BackgroundTransparency = 0,
						})
						:Play()

					if circlestroke then
						sv.ts
							:Create(circlestroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								Transparency = 0.45,
								Thickness = 1,
							})
							:Play()
					end

					sv.ts
						:Create(bubble, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
							BackgroundTransparency = 1,
							Size = UDim2.new(0, 16, 0, 10),
						})
						:Play()
					sv.ts
						:Create(bubbletext, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
							TextTransparency = 1,
						})
						:Play()

					task.delay(0.12, function()
						if not dragging then
							bubble.Visible = false
						end
					end)
				end

				local function stopdrag()
					if not dragging then
						return
					end
					dragging = false
					if dragInputConn then
						dragInputConn:Disconnect()
						dragInputConn = nil
					end
					if dragEndedConn then
						dragEndedConn:Disconnect()
						dragEndedConn = nil
					end
					hidebubble()
				end

				local function setfromx(x, isDragging)
					local barWidth = math.max(1, sliderframe.AbsoluteSize.X)
					local percent = math.clamp((x - sliderframe.AbsolutePosition.X) / barWidth, 0, 1)
					local value = sliderconfig.Min + ((sliderconfig.Max - sliderconfig.Min) * percent)

					sliderfunc:Set(value, isDragging)
				end

				function sliderfunc:Set(value, instant, nocallback)
					local prevValue = sliderfunc.Value
					value = clampvalue(value)

					sliderfunc.Value = value
					config.data[configkey] = value

					local percent = getpercent(value)
					local formatted = formatnumber(value)

					setting = true
					textbox.Text = formatted
					setting = false

					updatebubble(percent, formatted)

					if instant then
						sliderfill.Size = UDim2.new(percent, 0, 1, 0)
						slidercircle.Position = UDim2.new(percent, 0, 0.5, 0)
					else
						sv.ts
							:Create(sliderfill, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								Size = UDim2.new(percent, 0, 1, 0),
							})
							:Play()

						sv.ts
							:Create(slidercircle, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								Position = UDim2.new(percent, 0, 0.5, 0),
							})
							:Play()
					end

					if not nocallback and (instant ~= true or value ~= prevValue) then
						task.spawn(sliderconfig.Callback, value)
					end
				end

				local function startdrag(input)
					if
						input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.Touch
					then
						dragging = true
						showbubble()
						setfromx(input.Position.X, true)

						if dragInputConn then
							dragInputConn:Disconnect()
						end
						if dragEndedConn then
							dragEndedConn:Disconnect()
						end

						dragInputConn = sv.uis.InputChanged:Connect(function(moveInput)
							if
								dragging
								and (
									moveInput.UserInputType == Enum.UserInputType.MouseMovement
									or moveInput.UserInputType == Enum.UserInputType.Touch
								)
							then
								setfromx(moveInput.Position.X, true)
							end
						end)
						trackConnection(dragInputConn, "slider.dragInput")

						dragEndedConn = sv.uis.InputEnded:Connect(function(endInput)
							if
								endInput.UserInputType == Enum.UserInputType.MouseButton1
								or endInput.UserInputType == Enum.UserInputType.Touch
							then
								stopdrag()
							end
						end)
						trackConnection(dragEndedConn, "slider.dragEnded")
					end
				end

				sliderframe.InputBegan:Connect(startdrag)
				slidercircle.InputBegan:Connect(startdrag)

				textbox.Focused:Connect(function()
					showbubble()
				end)

				textbox.FocusLost:Connect(function()
					if setting then
						return
					end

					local text = textbox.Text:gsub(",", ".")
					local value = tonumber(text)

					if value then
						sliderfunc:Set(value)
					else
						textbox.Text = formatnumber(sliderfunc.Value)
					end

					hidebubble()
				end)

				sliderfunc:Set(sliderfunc.Value, true)

				-- // Mini UI Sync for Slider (Main UI only)
				if not isInfo and miniScroll then
					miniLayoutOrder = miniLayoutOrder + 1
					local mRow = instance.frame(miniScroll)
					mRow.Name = "MiniSlider_" .. sliderconfig.Title
					mRow.LayoutOrder = miniLayoutOrder
					mRow.Size = UDim2.new(1, 0, 0, 42)
					mRow.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
					mRow.BackgroundTransparency = 0.3
					mRow.BorderSizePixel = 0
					instance.uicorner(mRow).CornerRadius = UDim.new(0, 5)

					local mStroke = instance.uistroke(mRow)
					mStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					mStroke.Color = Color3.fromRGB(255, 255, 255)
					mStroke.Thickness = 1
					mStroke.Transparency = 0.92

					local mTitle = instance.textlabel(mRow)
					mTitle.Font = guiconfig.Font or Enum.Font.GothamBold
					mTitle.Text = sliderconfig.Title
					mTitle.TextSize = 11
					mTitle.TextColor3 = Color3.fromRGB(210, 210, 210)
					mTitle.TextXAlignment = Enum.TextXAlignment.Left
					mTitle.TextTruncate = Enum.TextTruncate.AtEnd
					mTitle.BackgroundTransparency = 1
					mTitle.Position = UDim2.new(0, 8, 0, 4)
					mTitle.Size = UDim2.new(1, -56, 0, 14)

					local mValLabel = instance.textlabel(mRow)
					mValLabel.Font = guiconfig.Font or Enum.Font.GothamBold
					mValLabel.Text = formatnumber(sliderfunc.Value)
					mValLabel.TextSize = 10
					mValLabel.TextColor3 = guiconfig.Color or Color3.fromRGB(0, 208, 255)
					mValLabel.TextXAlignment = Enum.TextXAlignment.Right
					mValLabel.BackgroundTransparency = 1
					mValLabel.Position = UDim2.new(1, -48, 0, 4)
					mValLabel.Size = UDim2.new(0, 40, 0, 14)

					local mBar = instance.frame(mRow)
					mBar.Name = "Bar"
					mBar.Position = UDim2.new(0, 8, 0, 24)
					mBar.Size = UDim2.new(1, -16, 0, 5)
					mBar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
					mBar.Active = true
					instance.uicorner(mBar).CornerRadius = UDim.new(1, 0)

					local mFill = instance.frame(mBar)
					mFill.Name = "Fill"
					mFill.Size = UDim2.new(0, 0, 1, 0)
					mFill.BackgroundColor3 = sliderconfig.Color or guiconfig.Color or Color3.fromRGB(0, 208, 255)
					mFill.BorderSizePixel = 0
					instance.uicorner(mFill).CornerRadius = UDim.new(1, 0)

					local mCircle = instance.frame(mBar)
					mCircle.Name = "Circle"
					mCircle.AnchorPoint = Vector2.new(0.5, 0.5)
					mCircle.Position = UDim2.new(0, 0, 0.5, 0)
					mCircle.Size = UDim2.new(0, 11, 0, 11)
					mCircle.BackgroundColor3 = sliderconfig.Color or guiconfig.Color or Color3.fromRGB(0, 208, 255)
					mCircle.Active = true
					instance.uicorner(mCircle).CornerRadius = UDim.new(1, 0)

					local function updateMiniSliderVisual(val)
						local pct = getpercent(val)
						mFill.Size = UDim2.new(pct, 0, 1, 0)
						mCircle.Position = UDim2.new(pct, 0, 0.5, 0)
						mValLabel.Text = formatnumber(val)
					end

					local mDragging = false
					local mDragInputConn = nil
					local mDragEndedConn = nil

					local function stopMiniDrag()
						if not mDragging then
							return
						end
						mDragging = false
						if mDragInputConn then
							mDragInputConn:Disconnect()
							mDragInputConn = nil
						end
						if mDragEndedConn then
							mDragEndedConn:Disconnect()
							mDragEndedConn = nil
						end
					end

					local function setFromInput(input)
						local barX = mBar.AbsolutePosition.X
						local barW = math.max(1, mBar.AbsoluteSize.X)
						local mouseX = input.Position.X
						local percent = math.clamp((mouseX - barX) / barW, 0, 1)
						local val = sliderconfig.Min + ((sliderconfig.Max - sliderconfig.Min) * percent)
						sliderfunc:Set(val, true)
					end

					mBar.InputBegan:Connect(function(input)
						if
							input.UserInputType == Enum.UserInputType.MouseButton1
							or input.UserInputType == Enum.UserInputType.Touch
						then
							mDragging = true
							setFromInput(input)

							if mDragInputConn then
								mDragInputConn:Disconnect()
							end
							if mDragEndedConn then
								mDragEndedConn:Disconnect()
							end

							mDragInputConn = sv.uis.InputChanged:Connect(function(moveInput)
								if
									mDragging
									and (
										moveInput.UserInputType == Enum.UserInputType.MouseMovement
										or moveInput.UserInputType == Enum.UserInputType.Touch
									)
								then
									setFromInput(moveInput)
								end
							end)
							trackConnection(mDragInputConn, "miniSlider.dragInput")

							mDragEndedConn = sv.uis.InputEnded:Connect(function(endInput)
								if
									endInput.UserInputType == Enum.UserInputType.MouseButton1
									or endInput.UserInputType == Enum.UserInputType.Touch
								then
									stopMiniDrag()
								end
							end)
							trackConnection(mDragEndedConn, "miniSlider.dragEnded")
						end
					end)

					local oldSliderSet = sliderfunc.Set
					function sliderfunc:Set(val, instant, nocallback)
						oldSliderSet(self, val, instant, nocallback)
						updateMiniSliderVisual(self.Value)
						if refreshMiniItems then
							refreshMiniItems()
						end
					end

					updateMiniSliderVisual(sliderfunc.Value)

					local mItemEntry = {
						Type = "Slider",
						Title = sliderconfig.Title,
						SectionTitle = sectiontitletext,
						Row = mRow,
						IsActive = function()
							return sliderfunc.Value > sliderfunc.Min
						end,
					}
					table.insert(miniElements, mItemEntry)
					if currentMiniSection then
						table.insert(currentMiniSection.Items, mItemEntry)
					end
					if queueMiniRefresh then
						queueMiniRefresh()
					end
				end

				countitem = countitem + 1
				yieldbuild()
				config.elements[configkey] = sliderfunc
				registerSearchItem(sliderconfig.Title, slider, "Slider")
				return sliderfunc
			end

			-- // AddColorPicker Element (Visual Color Bar, Sliders & RGB/HEX Inputs)
			function items:AddColorPicker(pickerconfig)
				pickerconfig = pickerconfig or {}
				pickerconfig.Title = pickerconfig.Title or "Color Picker"
				pickerconfig.Description = pickerconfig.Description or nil
				pickerconfig.Default = pickerconfig.Default or Color3.fromRGB(0, 220, 255)
				pickerconfig.Callback = pickerconfig.Callback or function(color) end

				local configkey = makeConfigKey("ColorPicker", pickerconfig.Title)
				local normKey = normalizeConfigKey(configkey)
				if config.data[configkey] ~= nil then
					local saved = config.data[configkey]
					if typeof(saved) == "string" and saved:sub(1, 1) == "#" then
						pcall(function() pickerconfig.Default = Color3.fromHex(saved) end)
					end
				elseif config.data[normKey] ~= nil then
					local saved = config.data[normKey]
					if typeof(saved) == "string" and saved:sub(1, 1) == "#" then
						pcall(function() pickerconfig.Default = Color3.fromHex(saved) end)
					end
				end

				local currentColor = pickerconfig.Default
				local currentH, currentS, currentV = currentColor:ToHSV()

				local colorfunc = {
					Value = currentColor,
					Default = pickerconfig.Default,
					_configType = "ColorPicker",
				}

				local pickerSubText = pickerconfig.Title2 or pickerconfig.Content or pickerconfig.Description
				local hasPickerSub = pickerSubText and tostring(pickerSubText) ~= ""
				local startY = hasPickerSub and 48 or 30
				local cardHeight = startY + 120

				local row = instance.frame(sectionadd)
				row.Name = "ColorPicker_" .. pickerconfig.Title
				row.Size = UDim2.new(1, 0, 0, cardHeight)
				row.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
				row.BackgroundTransparency = 0
				row.BorderSizePixel = 0
				row.ClipsDescendants = true
				row.LayoutOrder = countitem
				instance.uicorner(row).CornerRadius = UDim.new(0, 6)

				local rStroke = instance.uistroke(row)
				rStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				rStroke.Color = Color3.fromRGB(255, 255, 255)
				rStroke.Thickness = 1
				rStroke.Transparency = 0.88

				-- // 1. Title
				local title = instance.textlabel(row)
				title.Font = guiconfig.Font or Enum.Font.GothamBold
				title.Text = pickerconfig.Title
				title.TextSize = 13
				title.TextColor3 = Color3.fromRGB(230, 230, 230)
				title.TextXAlignment = Enum.TextXAlignment.Left
				title.BackgroundTransparency = 1
				title.Position = UDim2.new(0, 10, 0, 8)
				title.Size = UDim2.new(1, -20, 0, 18)

				-- // 2. Content (Title2 / Description)
				if hasPickerSub then
					local desc = instance.textlabel(row)
					desc.Name = "ColorPickerSubTitle"
					desc.Font = title.Font
					desc.Text = tostring(pickerSubText)
					desc.TextSize = title.TextSize - 1
					desc.TextColor3 = Color3.fromRGB(255, 255, 255)
					desc.TextTransparency = 0.5
					desc.TextXAlignment = Enum.TextXAlignment.Left
					desc.TextTruncate = Enum.TextTruncate.AtEnd
					desc.BackgroundTransparency = 1
					desc.Position = UDim2.new(0, 10, 0, 26)
					desc.Size = UDim2.new(1, -20, 0, 16)
				end

				-- // 3. Hasil dari warna slider / input (Color Preview Bar)
				local previewBar = instance.frame(row)
				previewBar.Name = "ColorResultBar"
				previewBar.Position = UDim2.new(0, 10, 0, startY)
				previewBar.Size = UDim2.new(1, -20, 0, 14)
				previewBar.BackgroundColor3 = currentColor
				previewBar.BorderSizePixel = 0
				instance.uicorner(previewBar).CornerRadius = UDim.new(0, 4)

				-- // 4. Slider: Rainbow Hue Bar
				local hueBar = instance.frame(row)
				hueBar.Name = "HueBar"
				hueBar.Position = UDim2.new(0, 10, 0, startY + 20)
				hueBar.Size = UDim2.new(1, -20, 0, 14)
				hueBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				hueBar.BorderSizePixel = 0
				instance.uicorner(hueBar).CornerRadius = UDim.new(0, 4)

				local hueGradient = instance.uigradient(hueBar)
				hueGradient.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
					ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
					ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
					ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
					ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
					ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
					ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
				})

				local hueThumb = instance.frame(hueBar)
				hueThumb.Name = "HueThumb"
				hueThumb.AnchorPoint = Vector2.new(0.5, 0.5)
				hueThumb.Size = UDim2.new(0, 10, 0, 18)
				hueThumb.Position = UDim2.new(currentH, 0, 0.5, 0)
				hueThumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				hueThumb.BorderSizePixel = 0
				instance.uicorner(hueThumb).CornerRadius = UDim.new(0, 3)
				local htStroke = instance.uistroke(hueThumb)
				htStroke.Color = Color3.fromRGB(0, 0, 0)
				htStroke.Thickness = 1.2
				htStroke.Transparency = 0.35

				-- // 5. Slider Slider: Saturation & Brightness/Value Bars
				local satBar = instance.frame(row)
				satBar.Name = "SatBar"
				satBar.Position = UDim2.new(0, 10, 0, startY + 40)
				satBar.Size = UDim2.new(0.5, -14, 0, 14)
				satBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				satBar.BorderSizePixel = 0
				instance.uicorner(satBar).CornerRadius = UDim.new(0, 4)

				local satGradient = instance.uigradient(satBar)
				local satThumb = instance.frame(satBar)
				satThumb.Name = "SatThumb"
				satThumb.AnchorPoint = Vector2.new(0.5, 0.5)
				satThumb.Size = UDim2.new(0, 10, 0, 18)
				satThumb.Position = UDim2.new(currentS, 0, 0.5, 0)
				satThumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				satThumb.BorderSizePixel = 0
				instance.uicorner(satThumb).CornerRadius = UDim.new(0, 3)
				local stStroke = instance.uistroke(satThumb)
				stStroke.Color = Color3.fromRGB(0, 0, 0)
				stStroke.Thickness = 1.2
				stStroke.Transparency = 0.35

				local valBar = instance.frame(row)
				valBar.Name = "ValBar"
				valBar.Position = UDim2.new(0.5, 4, 0, startY + 40)
				valBar.Size = UDim2.new(0.5, -14, 0, 14)
				valBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				valBar.BorderSizePixel = 0
				instance.uicorner(valBar).CornerRadius = UDim.new(0, 4)

				local valGradient = instance.uigradient(valBar)
				local valThumb = instance.frame(valBar)
				valThumb.Name = "ValThumb"
				valThumb.AnchorPoint = Vector2.new(0.5, 0.5)
				valThumb.Size = UDim2.new(0, 10, 0, 18)
				valThumb.Position = UDim2.new(currentV, 0, 0.5, 0)
				valThumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				valThumb.BorderSizePixel = 0
				instance.uicorner(valThumb).CornerRadius = UDim.new(0, 3)
				local vtStroke = instance.uistroke(valThumb)
				vtStroke.Color = Color3.fromRGB(0, 0, 0)
				vtStroke.Thickness = 1.2
				vtStroke.Transparency = 0.35

				-- // 6. Input RGB Box
				local rgbBox = instance.frame(row)
				rgbBox.Name = "RGBInputBox"
				rgbBox.Position = UDim2.new(0, 10, 0, startY + 60)
				rgbBox.Size = UDim2.new(1, -20, 0, 22)
				rgbBox.BackgroundColor3 = Color3.fromRGB(22, 22, 24)
				rgbBox.BorderSizePixel = 0
				instance.uicorner(rgbBox).CornerRadius = UDim.new(0, 4)

				local rgbTag = instance.textlabel(rgbBox)
				rgbTag.Font = guiconfig.Font or Enum.Font.GothamBold
				rgbTag.Text = "RGB"
				rgbTag.TextSize = 10
				rgbTag.TextColor3 = Color3.fromRGB(130, 130, 130)
				rgbTag.TextXAlignment = Enum.TextXAlignment.Left
				rgbTag.BackgroundTransparency = 1
				rgbTag.Position = UDim2.new(0, 8, 0, 0)
				rgbTag.Size = UDim2.new(0, 30, 1, 0)

				local rgbInput = instance.textbox(rgbBox)
				rgbInput.Name = "RGBText"
				rgbInput.Font = guiconfig.Font or Enum.Font.GothamBold
				rgbInput.TextSize = 10
				rgbInput.TextColor3 = Color3.fromRGB(230, 230, 230)
				rgbInput.TextXAlignment = Enum.TextXAlignment.Left
				rgbInput.BackgroundTransparency = 1
				rgbInput.ClearTextOnFocus = false
				rgbInput.Position = UDim2.new(0, 40, 0, 0)
				rgbInput.Size = UDim2.new(1, -48, 1, 0)

				-- // 7. Input HEX Box
				local hexBox = instance.frame(row)
				hexBox.Name = "HEXInputBox"
				hexBox.Position = UDim2.new(0, 10, 0, startY + 88)
				hexBox.Size = UDim2.new(1, -20, 0, 22)
				hexBox.BackgroundColor3 = Color3.fromRGB(22, 22, 24)
				hexBox.BorderSizePixel = 0
				instance.uicorner(hexBox).CornerRadius = UDim.new(0, 4)

				local hexTag = instance.textlabel(hexBox)
				hexTag.Font = guiconfig.Font or Enum.Font.GothamBold
				hexTag.Text = "HEX"
				hexTag.TextSize = 10
				hexTag.TextColor3 = Color3.fromRGB(130, 130, 130)
				hexTag.TextXAlignment = Enum.TextXAlignment.Left
				hexTag.BackgroundTransparency = 1
				hexTag.Position = UDim2.new(0, 8, 0, 0)
				hexTag.Size = UDim2.new(0, 30, 1, 0)

				local hexInput = instance.textbox(hexBox)
				hexInput.Name = "HEXText"
				hexInput.Font = guiconfig.Font or Enum.Font.GothamBold
				hexInput.TextSize = 10
				hexInput.TextColor3 = Color3.fromRGB(230, 230, 230)
				hexInput.TextXAlignment = Enum.TextXAlignment.Left
				hexInput.BackgroundTransparency = 1
				hexInput.ClearTextOnFocus = false
				hexInput.Position = UDim2.new(0, 40, 0, 0)
				hexInput.Size = UDim2.new(1, -48, 1, 0)

				local function updateVisuals(fireCb)
					currentColor = Color3.fromHSV(currentH, currentS, currentV)
					colorfunc.Value = currentColor
					config.data[configkey] = "#" .. currentColor:ToHex()

					previewBar.BackgroundColor3 = currentColor

					local pureHue = Color3.fromHSV(currentH, 1, 1)
					satGradient.Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 255, 255)),
						ColorSequenceKeypoint.new(1.00, pureHue),
					})
					valGradient.Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0.00, Color3.fromRGB(0, 0, 0)),
						ColorSequenceKeypoint.new(1.00, Color3.fromHSV(currentH, currentS, 1)),
					})

					hueThumb.Position = UDim2.new(currentH, 0, 0.5, 0)
					satThumb.Position = UDim2.new(currentS, 0, 0.5, 0)
					valThumb.Position = UDim2.new(currentV, 0, 0.5, 0)

					local r = math.floor(currentColor.R * 255 + 0.5)
					local g = math.floor(currentColor.G * 255 + 0.5)
					local b = math.floor(currentColor.B * 255 + 0.5)
					local hexStr = "#" .. currentColor:ToHex():upper()

					if not rgbInput:IsFocused() then
						rgbInput.Text = string.format("%d, %d, %d", r, g, b)
					end
					if not hexInput:IsFocused() then
						hexInput.Text = hexStr
					end

					if fireCb and typeof(pickerconfig.Callback) == "function" then
						task.spawn(pickerconfig.Callback, currentColor)
					end
				end

				-- // Slider interaction logic
				local function bindSlider(bar, onUpdate)
					local dragging = false
					local function updatePos(input)
						local relX = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
						onUpdate(relX)
					end
					bar.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							dragging = true
							updatePos(input)
						end
					end)
					trackConnection(sv.uis.InputChanged:Connect(function(input)
						if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
							updatePos(input)
						end
					end), "colorpicker.barDrag")
					trackConnection(sv.uis.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							dragging = false
						end
					end), "colorpicker.barDragEnd")
				end

				bindSlider(hueBar, function(rel)
					currentH = rel
					updateVisuals(true)
				end)
				bindSlider(satBar, function(rel)
					currentS = rel
					updateVisuals(true)
				end)
				bindSlider(valBar, function(rel)
					currentV = rel
					updateVisuals(true)
				end)

				-- // Two-Way Input: RGB FocusLost
				rgbInput.FocusLost:Connect(function(enterPressed)
					local text = rgbInput.Text
					local r, g, b = text:match("(%d+)%s*[,%s]%s*(%d+)%s*[,%s]%s*(%d+)")
					if r and g and b then
						r = math.clamp(tonumber(r) or 0, 0, 255)
						g = math.clamp(tonumber(g) or 0, 0, 255)
						b = math.clamp(tonumber(b) or 0, 0, 255)
						local newCol = Color3.fromRGB(r, g, b)
						currentH, currentS, currentV = newCol:ToHSV()
						updateVisuals(true)
					else
						local rVal = math.floor(currentColor.R * 255 + 0.5)
						local gVal = math.floor(currentColor.G * 255 + 0.5)
						local bVal = math.floor(currentColor.B * 255 + 0.5)
						rgbInput.Text = string.format("%d, %d, %d", rVal, gVal, bVal)
					end
				end)

				-- // Two-Way Input: HEX FocusLost
				hexInput.FocusLost:Connect(function(enterPressed)
					local text = hexInput.Text:gsub("%s+", "")
					if text:sub(1, 1) == "#" then text = text:sub(2) end
					if #text == 6 and text:match("^%x+$") then
						local ok, newCol = pcall(function() return Color3.fromHex(text) end)
						if ok and newCol then
							currentH, currentS, currentV = newCol:ToHSV()
							updateVisuals(true)
							return
						end
					end
					hexInput.Text = "#" .. currentColor:ToHex():upper()
				end)

				updateVisuals(false)

				function colorfunc:Set(newCol, instant)
					if typeof(newCol) == "string" and newCol:sub(1, 1) == "#" then
						pcall(function() newCol = Color3.fromHex(newCol) end)
					end
					if typeof(newCol) == "Color3" then
						currentH, currentS, currentV = newCol:ToHSV()
						updateVisuals(not instant)
					end
				end

				function colorfunc:Get()
					return colorfunc.Value
				end

				function colorfunc:GetHex()
					return "#" .. colorfunc.Value:ToHex():upper()
				end

				countitem = countitem + 1
				yieldbuild()
				config.elements[configkey] = colorfunc
				registerSearchItem(pickerconfig.Title, row, "ColorPicker")
				return colorfunc
			end

			function items:AddInput(inputconfig)
				inputconfig = inputconfig or {}
				inputconfig.Title = inputconfig.Title or "Title"
				inputconfig.Placeholder = inputconfig.Placeholder or "Write your input here"
				inputconfig.Callback = inputconfig.Callback or function() end
				inputconfig.Default = inputconfig.Default or ""

				-- // Dual Input Support (Single Card: Type = "Right" or "Down")
				if inputconfig.SubTitle and (inputconfig.SubCallback ~= nil or inputconfig.SubDefault ~= nil or inputconfig.SubPlaceholder ~= nil or inputconfig.Dual == true) then
					local layoutMode = (inputconfig.Type and string.lower(tostring(inputconfig.Type)))
						or (inputconfig.Layout and string.lower(tostring(inputconfig.Layout)))
						or "right"
					local isDown = (layoutMode == "down" or layoutMode == "bottom")

					local card = instance.frame(sectionadd)
					card.Name = "DualInputCard"
					card.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
					card.BackgroundTransparency = 0
					card.BorderSizePixel = 0
					card.ClipsDescendants = true
					card.LayoutOrder = countitem
					card.Size = isDown and UDim2.new(1, 0, 0, 114) or UDim2.new(1, 0, 0, 58)

					instance.uicorner(card).CornerRadius = UDim.new(0, 6)

