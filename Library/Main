						if not popOpen then return end
						popOpen = false
						sv.ts:Create(popover, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							Size = UDim2.new(0, popover.AbsoluteSize.X, 0, 0)
						}):Play()
						sv.ts:Create(optionimg, TweenInfo.new(0.15), { Rotation = -90 }):Play()
						task.delay(0.15, function()
							if not popOpen then
								popover.Visible = false
								popoverOverlay.Visible = false
							end
						end)
					end

					local function openThisPopover()
						closeAnyPopover()
						popOpen = true
						activePopoverClose = closeThisPopover
						popoverOverlay.Visible = true

						local bx = selector.AbsolutePosition.X - main.AbsolutePosition.X
						local by = selector.AbsolutePosition.Y - main.AbsolutePosition.Y
						local bw = selector.AbsoluteSize.X
						local bh = selector.AbsoluteSize.Y

						local popW = 200
						local rows = math.ceil(math.max(1, optionCount) / 2)
						local popH = math.min(160, rows * 40 + 16)
						local popX = bx + bw - popW
						local popY = by + bh + 4

						if popY + popH > main.AbsoluteSize.Y - 10 then
							popY = by - popH - 4
						end

						popover.Position = UDim2.new(0, popX, 0, popY)
						popover.Size = UDim2.new(0, popW, 0, 0)
						popover.Visible = true

						sv.ts:Create(popover, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							Size = UDim2.new(0, popW, 0, popH)
						}):Play()
						sv.ts:Create(optionimg, TweenInfo.new(0.2), { Rotation = 0 }):Play()
					end

