						dSub.TextColor3 = Color3.fromRGB(255, 255, 255)
						dSub.TextTransparency = 0.5
						dSub.TextXAlignment = Enum.TextXAlignment.Left
						dSub.TextYAlignment = Enum.TextYAlignment.Top
						dSub.BackgroundTransparency = 1
						dSub.Position = UDim2.new(0, 10, 0, 28)
						dSub.Size = UDim2.new(1, -170, 0, 16)
						dSub.TextTruncate = Enum.TextTruncate.AtEnd
					end

					local optionimg = instance.imagelabel(head)
					optionimg.Name = "OptionImg"
					optionimg.Image = "rbxassetid://16851841101"
					optionimg.ImageColor3 = Color3.fromRGB(200, 200, 200)
					optionimg.AnchorPoint = Vector2.new(1, 0.5)
					optionimg.BackgroundTransparency = 1
					optionimg.Position = UDim2.new(1, -6, 0.5, 0)
					optionimg.Size = UDim2.new(0, 20, 0, 20)
					optionimg.Rotation = -90

					local headbtn = instance.textbutton(head)
					headbtn.Name = "HeadBtn"
					headbtn.BackgroundTransparency = 1
					headbtn.Text = ""
					headbtn.Size = UDim2.new(1, 0, 1, 0)

					local searchFrame = instance.frame(dropdown)
					searchFrame.Name = "SearchFrame"
					searchFrame.Position = UDim2.new(0, 8, 0, headHeight)
					searchFrame.Size = UDim2.new(1, -16, 0, 26)
					searchFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
					searchFrame.BackgroundTransparency = 0
					searchFrame.BorderSizePixel = 0
					instance.uicorner(searchFrame).CornerRadius = UDim.new(0, 4)

					local searchStroke = instance.uistroke(searchFrame)
					searchStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					searchStroke.Color = Color3.fromRGB(255, 255, 255)
					searchStroke.Thickness = 1
					searchStroke.Transparency = 0.9

					local searchIcon = instance.imagelabel(searchFrame)
					searchIcon.Image = "rbxassetid://8447654914"
					searchIcon.ImageColor3 = Color3.fromRGB(160, 160, 160)
					searchIcon.BackgroundTransparency = 1
					searchIcon.Position = UDim2.new(0, 8, 0.5, -6)
					searchIcon.Size = UDim2.new(0, 12, 0, 12)

					local clearBtn = instance.textbutton(searchFrame)
					clearBtn.Name = "ClearBtn"
					clearBtn.BackgroundTransparency = 1
					clearBtn.Text = ""
					clearBtn.AnchorPoint = Vector2.new(1, 0.5)
					clearBtn.Position = UDim2.new(1, -6, 0.5, 0)
					clearBtn.Size = UDim2.new(0, 18, 0, 18)
					clearBtn.Visible = false

					local clearIcon = instance.imagelabel(clearBtn)
					clearIcon.Name = "ClearIcon"
					clearIcon.Image = "rbxassetid://9886659671"
					clearIcon.ImageColor3 = Color3.fromRGB(140, 140, 140)
					clearIcon.BackgroundTransparency = 1
					clearIcon.AnchorPoint = Vector2.new(0.5, 0.5)
					clearIcon.Position = UDim2.new(0.5, 0, 0.5, 0)
					clearIcon.Size = UDim2.new(0, 11, 0, 11)

					clearBtn.MouseEnter:Connect(function()
						sv.ts:Create(clearIcon, TweenInfo.new(0.12), { ImageColor3 = Color3.fromRGB(255, 255, 255) }):Play()
					end)
					clearBtn.MouseLeave:Connect(function()
						sv.ts:Create(clearIcon, TweenInfo.new(0.12), { ImageColor3 = Color3.fromRGB(140, 140, 140) }):Play()
					end)

					local searchbox = instance.textbox(searchFrame)
					searchbox.Name = "SearchBox"
					searchbox.PlaceholderText = "Search options..."
					searchbox.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
					searchbox.Text = ""
					searchbox.Font = guiconfig.Font
					searchbox.TextSize = 11
					searchbox.TextColor3 = Color3.fromRGB(240, 240, 240)
					searchbox.TextXAlignment = Enum.TextXAlignment.Left
					searchbox.BackgroundTransparency = 1
					searchbox.Position = UDim2.new(0, 26, 0, 0)
					searchbox.Size = UDim2.new(1, -52, 1, 0)
					searchbox.ClearTextOnFocus = false

