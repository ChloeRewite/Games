				searchpad.PaddingRight = UDim.new(0, 8)

				local scrollselect = instance.scrollingframe(dropdowncontainer)
				scrollselect.Name = "ScrollSelect"
				scrollselect.Size = UDim2.new(1, 0, 1, -34)
				scrollselect.Position = UDim2.new(0, 0, 0, 34)
				scrollselect.ScrollBarImageTransparency = 0.7
				scrollselect.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
				scrollselect.BorderSizePixel = 0
				scrollselect.BackgroundTransparency = 1
				scrollselect.ScrollBarThickness = 2
				scrollselect.CanvasSize = UDim2.new(0, 0, 0, 0)
				scrollselect.ZIndex = 54

				local uilistlayout = instance.uilistlayout(scrollselect)
				uilistlayout.Padding = UDim.new(0, 3)
				uilistlayout.SortOrder = Enum.SortOrder.LayoutOrder

				uilistlayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
					scrollselect.CanvasSize = UDim2.new(0, 0, 0, uilistlayout.AbsoluteContentSize.Y)
				end)

				searchbox:GetPropertyChangedSignal("Text"):Connect(function()
					local query = string.lower(searchbox.Text)
					for _, option in ipairs(scrollselect:GetChildren()) do
						if option.Name == "Option" and option:FindFirstChild("OptionText") then
							local text = string.lower(option.OptionText.Text)
							local desc = option:FindFirstChild("OptionDesc")
							local descText = desc and string.lower(desc.Text) or ""

							option.Visible = query == ""
								or string.find(text, query, 1, true)
								or string.find(descText, query, 1, true)
						end
					end
					scrollselect.CanvasSize = UDim2.new(0, 0, 0, uilistlayout.AbsoluteContentSize.Y)
				end)

				function dropdownfunc:Clear()
					for _, dropframe in ipairs(scrollselect:GetChildren()) do
						if dropframe.Name == "Option" then
							dropframe:Destroy()
						end
					end
					dropdownfunc.Value = dropdownconfig.Multi and {} or nil
					dropdownfunc.Options = {}
					optionselecting.Text = dropdownconfig.Multi and "Select Options" or "Select Option"
				end

				function dropdownfunc:AddOption(option)
					local label, desc, img, value = parseOption(option)
					local useAdvanced = dropdownconfig.Advanced and (desc or img)
					local height = 28
					local leftPadding = img and 36 or 12
					local textX = useAdvanced and math.max(12, leftPadding - 10) or leftPadding

					local optionframe = templates.DropdownOption:Clone()
					optionframe.Size = UDim2.new(1, 0, 0, height)
					optionframe.Parent = scrollselect

					local optionbutton = optionframe.OptionButton
					local optiontext = optionframe.OptionText
					optiontext.Text = label
					optiontext.Position = UDim2.new(0, textX, 0, useAdvanced and 1 or 0)
					optiontext.Size = UDim2.new(1, -(textX + 8), 1, 0)

					if img then
						local icon = instance.imagelabel(optionframe)
						icon.Name = "OptionIcon"
						icon.Image = img
						icon.BackgroundTransparency = 1
						icon.Position = UDim2.new(0, 8, 0.5, -12)
						icon.Size = UDim2.new(0, 24, 0, 24)
						icon.ScaleType = Enum.ScaleType.Fit
						instance.uicorner(icon).CornerRadius = UDim.new(0, 4)
					end

					if useAdvanced and desc then
						local optiondesc = instance.textlabel(optionframe)
						optiondesc.Name = "OptionDesc"
						optiondesc.Font = guiconfig.Font
						optiondesc.Text = tostring(desc)
						optiondesc.TextSize = 10
						optiondesc.TextTransparency = 0.4
						optiondesc.TextColor3 = Color3.fromRGB(200, 200, 200)
						optiondesc.Position = UDim2.new(0, textX, 0, 12)
						optiondesc.Size = UDim2.new(1, -(textX + 8), 0, 12)
						optiondesc.BackgroundTransparency = 1
						optiondesc.TextXAlignment = Enum.TextXAlignment.Left
						optiondesc.TextTruncate = Enum.TextTruncate.AtEnd
					end

					optionframe:SetAttribute("RealValue", value)

					optionbutton.MouseEnter:Connect(function()
						local curSelected = dropdownconfig.Multi and table.find(dropdownfunc.Value, value)
							or dropdownfunc.Value == value
						if not curSelected then
							sv.ts:Create(optionframe, TweenInfo.new(0.15), { BackgroundTransparency = 0.94 }):Play()
						end
					end)

					optionbutton.MouseLeave:Connect(function()
						local curSelected = dropdownconfig.Multi and table.find(dropdownfunc.Value, value)
							or dropdownfunc.Value == value
						if not curSelected then
							sv.ts:Create(optionframe, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
						end
					end)

					optionbutton.Activated:Connect(function()
						if dropdownconfig.Multi then
							dropdownfunc.Value = type(dropdownfunc.Value) == "table" and dropdownfunc.Value or {}

							if not table.find(dropdownfunc.Value, value) then
								table.insert(dropdownfunc.Value, value)
							else
								for i, v in pairs(dropdownfunc.Value) do
									if v == value then
										table.remove(dropdownfunc.Value, i)
										break
									end
								end
							end
						else
							dropdownfunc.Value = value
						end

						dropdownfunc:Set(dropdownfunc.Value)
					end)
				end

				function dropdownfunc:Set(value, instant)
					if dropdownconfig.Multi then
						dropdownfunc.Value = type(value) == "table" and value or {}
					else
						dropdownfunc.Value = (type(value) == "table" and value[1]) or value
					end

					config.data[configkey] = dropdownfunc.Value

					local texts = {}

					for _, drop in ipairs(scrollselect:GetChildren()) do
						if drop.Name == "Option" and drop:FindFirstChild("OptionText") then
							local v = drop:GetAttribute("RealValue")
							local selected = dropdownconfig.Multi and table.find(dropdownfunc.Value, v)
								or dropdownfunc.Value == v
							local targetSize = selected and UDim2.new(0, 3, 0, 14) or UDim2.new(0, 0, 0, 0)
							local targetBackground = selected and 0.92 or 1
							local targetTextColor = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(210, 210, 210)

							if instant then
								drop.ChooseFrame.Size = targetSize
								drop.BackgroundTransparency = targetBackground
								drop.OptionText.TextColor3 = targetTextColor
							else
								sv.ts
									:Create(drop.ChooseFrame, TweenInfo.new(selected and 0.2 or 0.1), {
										Size = targetSize,
									})
									:Play()

								sv.ts
									:Create(drop, TweenInfo.new(selected and 0.2 or 0.1), {
										BackgroundTransparency = targetBackground,
									})
									:Play()

								sv.ts
									:Create(drop.OptionText, TweenInfo.new(selected and 0.2 or 0.1), {
										TextColor3 = targetTextColor,
									})
									:Play()
							end

							if selected then
								table.insert(texts, drop.OptionText.Text)
							end
						end
					end

					optionselecting.Text = (#texts == 0)
							and (dropdownconfig.Multi and "Select Options" or "Select Option")
						or table.concat(texts, ", ")

					if dropdownconfig.Callback then
						if dropdownconfig.Multi then
							dropdownconfig.Callback(dropdownfunc.Value)
						else
							local str = dropdownfunc.Value ~= nil and tostring(dropdownfunc.Value) or ""
							dropdownconfig.Callback(str)
						end
					end
				end

				function dropdownfunc:SetValue(val)
					self:Set(val)
				end

				function dropdownfunc:GetValue()
					return self.Value
				end

				function dropdownfunc:SetValues(newlist, selecting, instant)
					newlist = newlist or {}
					selecting = selecting or (dropdownconfig.Multi and {} or nil)
					dropdownfunc:Clear()

					for _, v in ipairs(newlist) do
						dropdownfunc:AddOption(v)
					end

					dropdownfunc.Options = newlist
					dropdownfunc:Set(selecting, instant)
				end

				function dropdownfunc:Refresh(newlist)
					newlist = newlist or {}
					dropdownfunc:Clear()

					for _, v in ipairs(newlist) do
						dropdownfunc:AddOption(v)
					end

					dropdownfunc.Options = newlist
					dropdownfunc:Set(dropdownconfig.Multi and {} or nil, true)
				end

				dropdownfunc:SetValues(dropdownfunc.Options, dropdownfunc.Value, true)

				countitem = countitem + 1
				countdropdown = countdropdown + 1
				yieldbuild()
				config.elements[configkey] = dropdownfunc
				registerSearchItem(dropdownconfig.Title, dropdown, "Dropdown", dropdownconfig.Options)
				setupMiniDropdown()
				return dropdownfunc
			end

			-- // AddBody / AddBodyTarget Element (Interactive Humanoid Dummy with Selected Part Dropdown)
			function items:AddBody(bodyconfig)
				bodyconfig = bodyconfig or {}
				bodyconfig.Title = bodyconfig.Title or "Hitbox Target"
				bodyconfig.Description = bodyconfig.Description or nil
				bodyconfig.Multi = (bodyconfig.Multi == true)
				bodyconfig.Default = bodyconfig.Default or (bodyconfig.Multi and { "Head" } or "Head")
				bodyconfig.Color = bodyconfig.Color or guiconfig.Color or Color3.fromRGB(0, 220, 255)
				bodyconfig.Callback = bodyconfig.Callback or function(selected) end

				local configkey = makeConfigKey("Body", bodyconfig.Title)
				local normKey = normalizeConfigKey(configkey)
				if config.data[configkey] ~= nil then
					bodyconfig.Default = config.data[configkey]
				elseif config.data[normKey] ~= nil then
					bodyconfig.Default = config.data[normKey]
				end

				local function normalizePartName(name)
					if not name then return nil end
					local lower = string.lower(tostring(name))
					if lower == "head" then return "Head" end
					if lower == "torso" or lower == "uppertorso" or lower == "lowertorso" then return "Torso" end
					if lower == "left arm" or lower == "lefthand" or lower == "left hand" or lower == "leftupperarm" or lower == "leftlowerarm" then
						return "Left Hand"
					end
					if lower == "right arm" or lower == "righthand" or lower == "right hand" or lower == "rightupperarm" or lower == "rightlowerarm" then
						return "Right Hand"
					end
					if lower == "left leg" or lower == "leftleg" or lower == "leftfoot" or lower == "leftupperleg" or lower == "leftlowerleg" then
						return "Left Leg"
					end
					if lower == "right leg" or lower == "rightleg" or lower == "rightfoot" or lower == "rightupperleg" or lower == "rightlowerleg" then
						return "Right Leg"
					end
					return tostring(name)
				end

				local selectedMap = {}
				if bodyconfig.Multi then
					if typeof(bodyconfig.Default) == "table" then
						for _, p in ipairs(bodyconfig.Default) do
							local n = normalizePartName(p)
							if n then selectedMap[n] = true end
						end
					elseif typeof(bodyconfig.Default) == "string" then
						local n = normalizePartName(bodyconfig.Default)
						if n then selectedMap[n] = true end
					end
				else
					local initialPart = normalizePartName(bodyconfig.Default) or "Head"
					selectedMap[initialPart] = true
				end

				local bodyfunc = {
					Value = bodyconfig.Default,
					Default = bodyconfig.Default,
					_configType = "Body",
				}

				local row = instance.frame(sectionadd)
				row.Name = "Body_" .. bodyconfig.Title
				row.Size = UDim2.new(1, 0, 0, 182)
				row.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
				row.BackgroundTransparency = 0
				row.BorderSizePixel = 0
				row.ClipsDescendants = true
				row.LayoutOrder = countitem
				instance.uicorner(row).CornerRadius = UDim.new(0, 6)

				local bStroke = instance.uistroke(row)
				bStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				bStroke.Color = Color3.fromRGB(255, 255, 255)
				bStroke.Thickness = 1
				bStroke.Transparency = 0.88

				-- // Header Area
				local title = instance.textlabel(row)
				title.Font = guiconfig.Font or Enum.Font.GothamBold
				title.Text = bodyconfig.Title
				title.TextSize = 13
				title.TextColor3 = Color3.fromRGB(230, 230, 230)
				title.TextXAlignment = Enum.TextXAlignment.Left
				title.BackgroundTransparency = 1
				title.Position = UDim2.new(0, 10, 0, 8)
				title.Size = UDim2.new(1, -20, 0, 18)

				-- // Left Side: Mannequin Canvas Container
				local canvas = instance.frame(row)
				canvas.Name = "MannequinCanvas"
				canvas.Position = UDim2.new(0, 8, 0, 32)
				canvas.Size = UDim2.new(0, 84, 0, 138)
				canvas.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
				canvas.BackgroundTransparency = 0.5
				instance.uicorner(canvas).CornerRadius = UDim.new(0, 6)
				local cStroke = instance.uistroke(canvas)
				cStroke.Color = Color3.fromRGB(255, 255, 255)
				cStroke.Thickness = 1
				cStroke.Transparency = 0.92

				-- // Limb Definitions
				local limbButtons = {}
				local limbDefs = {
					{ Name = "Head", Display = "Head", Label = "H", Size = UDim2.new(0, 24, 0, 24), Pos = UDim2.new(0.5, 0, 0, 8), Corner = 6 },
					{ Name = "Torso", Display = "Torso", Label = "Torso", Size = UDim2.new(0, 34, 0, 44), Pos = UDim2.new(0.5, 0, 0, 35), Corner = 4 },
					{ Name = "Left Hand", Display = "Left Hand", AltName = "Left Arm", Label = "L", Size = UDim2.new(0, 13, 0, 42), Pos = UDim2.new(0.5, -25, 0, 35), Corner = 4 },
					{ Name = "Right Hand", Display = "Right Hand", AltName = "Right Arm", Label = "R", Size = UDim2.new(0, 13, 0, 42), Pos = UDim2.new(0.5, 25, 0, 35), Corner = 4 },
					{ Name = "Left Leg", Display = "Left Leg", Label = "L", Size = UDim2.new(0, 14, 0, 46), Pos = UDim2.new(0.5, -9, 0, 82), Corner = 4 },
					{ Name = "Right Leg", Display = "Right Leg", Label = "R", Size = UDim2.new(0, 14, 0, 46), Pos = UDim2.new(0.5, 9, 0, 82), Corner = 4 },
				}

				-- // Right Side: Selected Part Dropdown Panel
				local dropPanel = instance.frame(row)
				dropPanel.Name = "SelectedPartsPanel"
				dropPanel.Position = UDim2.new(0, 100, 0, 32)
				dropPanel.Size = UDim2.new(1, -108, 0, 138)
				dropPanel.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
				dropPanel.BackgroundTransparency = 0.5
				dropPanel.ClipsDescendants = true
				instance.uicorner(dropPanel).CornerRadius = UDim.new(0, 6)

				local dStroke = instance.uistroke(dropPanel)
				dStroke.Color = Color3.fromRGB(255, 255, 255)
				dStroke.Thickness = 1
				dStroke.Transparency = 0.92

				-- // Dropdown Header Bar
				local dHeader = instance.frame(dropPanel)
				dHeader.Name = "Header"
				dHeader.Size = UDim2.new(1, 0, 0, 24)
				dHeader.BackgroundColor3 = Color3.fromRGB(22, 22, 24)
				dHeader.BorderSizePixel = 0
				instance.uicorner(dHeader).CornerRadius = UDim.new(0, 5)

				local dHeaderTitle = instance.textlabel(dHeader)
				dHeaderTitle.Font = guiconfig.Font or Enum.Font.GothamBold
				dHeaderTitle.Text = bodyconfig.Multi and "Selected Parts" or "Selected Part"
				dHeaderTitle.TextSize = 10
				dHeaderTitle.TextColor3 = Color3.fromRGB(205, 205, 205)
				dHeaderTitle.TextXAlignment = Enum.TextXAlignment.Left
				dHeaderTitle.BackgroundTransparency = 1
				dHeaderTitle.Position = UDim2.new(0, 7, 0, 0)
				dHeaderTitle.Size = UDim2.new(1, -30, 1, 0)

				local dBadge = instance.frame(dHeader)
				dBadge.Name = "CountBadge"
				dBadge.Size = UDim2.new(0, 16, 0, 13)
				dBadge.Position = UDim2.new(1, -21, 0.5, -6)
				dBadge.BackgroundColor3 = Color3.fromRGB(32, 32, 35)
				dBadge.BorderSizePixel = 0
				instance.uicorner(dBadge).CornerRadius = UDim.new(0, 3)

				local dBadgeLabel = instance.textlabel(dBadge)
				dBadgeLabel.Font = guiconfig.Font or Enum.Font.GothamBold
				dBadgeLabel.Text = "0"
				dBadgeLabel.TextSize = 9
				dBadgeLabel.TextColor3 = bodyconfig.Color or guiconfig.Color or Color3.fromRGB(0, 208, 255)
				dBadgeLabel.BackgroundTransparency = 1
				dBadgeLabel.Size = UDim2.new(1, 0, 1, 0)

				-- // Scrollable List of Selected Items ("kotak")
				local partScroll = instance.scrollingframe(dropPanel)
				partScroll.Name = "SelectedScroll"
				partScroll.Position = UDim2.new(0, 4, 0, 28)
				partScroll.Size = UDim2.new(1, -8, 1, -32)
				partScroll.BackgroundTransparency = 1
				partScroll.BorderSizePixel = 0
				partScroll.ScrollBarThickness = 2
				partScroll.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 80)
				partScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
				partScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y

				local partLayout = instance.uilistlayout(partScroll)
				partLayout.Padding = UDim.new(0, 3)
				partLayout.SortOrder = Enum.SortOrder.LayoutOrder

				-- // Empty State Placeholder
				local emptyLabel = instance.textlabel(partScroll)
				emptyLabel.Name = "EmptyLabel"
				emptyLabel.Size = UDim2.new(1, 0, 0, 50)
				emptyLabel.BackgroundTransparency = 1
				emptyLabel.Font = guiconfig.Font or Enum.Font.GothamBold
				emptyLabel.TextSize = 9
				emptyLabel.TextColor3 = Color3.fromRGB(115, 115, 115)
				emptyLabel.Text = "None Selected\n(Click dummy)"
				emptyLabel.TextWrapped = true
				emptyLabel.LayoutOrder = 999

				local function getSelectedList()
					local list = {}
					for _, def in ipairs(limbDefs) do
						if selectedMap[def.Name] then
							table.insert(list, def.Name)
						end
					end
					return list
				end

				local activeCards = {}

				local function updateVisuals(fireCb)
					local activeCount = 0
					local firstActive = nil

					for _, def in ipairs(limbDefs) do
						local isSel = selectedMap[def.Name] == true
						if isSel then
							activeCount = activeCount + 1
							if not firstActive then firstActive = def.Name end
						end

						-- // Update mannequin limb button visual
						local btn = limbButtons[def.Name]
						if btn then
							local stroke = btn:FindFirstChildWhichIsA("UIStroke")
							local lbl = btn:FindFirstChildWhichIsA("TextLabel")
							sv.ts:Create(btn, TweenInfo.new(0.18), {
								BackgroundColor3 = isSel and bodyconfig.Color or Color3.fromRGB(25, 25, 25),
								BackgroundTransparency = isSel and 0.15 or 0.45,
							}):Play()
							if stroke then
								sv.ts:Create(stroke, TweenInfo.new(0.18), {
									Color = isSel and bodyconfig.Color or Color3.fromRGB(255, 255, 255),
									Transparency = isSel and 0.1 or 0.88,
									Thickness = isSel and 1.5 or 1,
								}):Play()
							end
							if lbl then
								lbl.TextColor3 = isSel and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 150)
							end
						end
					end

					-- // Update Count Badge & Empty State
					dBadgeLabel.Text = tostring(activeCount)
					dBadgeLabel.TextColor3 = activeCount > 0 and (bodyconfig.Color or guiconfig.Color) or Color3.fromRGB(140, 140, 140)
					emptyLabel.Visible = (activeCount == 0)

					-- // Update Selected Part Kotak Cards
					for idx, def in ipairs(limbDefs) do
						local isSel = selectedMap[def.Name] == true
						local existingCard = activeCards[def.Name]

						if isSel and not existingCard then
							-- // Create new kotak card
							local card = instance.textbutton(partScroll)
							card.Name = "Kotak_" .. def.Name
							card.Size = UDim2.new(1, 0, 0, 22)
							card.BackgroundColor3 = Color3.fromRGB(26, 26, 28)
							card.BackgroundTransparency = 0.1
							card.BorderSizePixel = 0
							card.Text = ""
							card.AutoButtonColor = false
							card.LayoutOrder = idx
							instance.uicorner(card).CornerRadius = UDim.new(0, 4)

							-- // Part display name
							local lbl = instance.textlabel(card)
							lbl.Font = guiconfig.Font or Enum.Font.GothamBold
							lbl.Text = def.Display
							lbl.TextSize = 10
							lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
							lbl.TextXAlignment = Enum.TextXAlignment.Left
							lbl.BackgroundTransparency = 1
							lbl.Position = UDim2.new(0, 8, 0, 0)
							lbl.Size = UDim2.new(1, -16, 1, 0)

							-- // Hover feedback (smooth background tint only, no stroke/outline)
							card.MouseEnter:Connect(function()
								sv.ts:Create(card, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(34, 34, 38) }):Play()
								sv.ts:Create(lbl, TweenInfo.new(0.12), { TextColor3 = Color3.fromRGB(255, 255, 255) }):Play()
							end)
							card.MouseLeave:Connect(function()
								sv.ts:Create(card, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(24, 24, 26) }):Play()
								sv.ts:Create(lbl, TweenInfo.new(0.12), { TextColor3 = Color3.fromRGB(210, 210, 210) }):Play()
							end)

							-- // 1-click delete / unselect!
							card.Activated:Connect(function()
								selectedMap[def.Name] = nil
								updateVisuals(true)
							end)

							activeCards[def.Name] = card
						elseif not isSel and existingCard then
							activeCards[def.Name] = nil
							existingCard:Destroy()
						end
					end

					local retVal = bodyconfig.Multi and getSelectedList() or (firstActive or "")
					bodyfunc.Value = retVal
					config.data[configkey] = retVal

					if fireCb and typeof(bodyconfig.Callback) == "function" then
						task.spawn(bodyconfig.Callback, retVal)
					end
				end

				-- // Create Mannequin Limb Buttons
				for _, def in ipairs(limbDefs) do
					local partBtn = instance.textbutton(canvas)
					partBtn.Name = def.Name
					partBtn.AnchorPoint = Vector2.new(0.5, 0)
					partBtn.Position = def.Pos
					partBtn.Size = def.Size
					partBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
					partBtn.BackgroundTransparency = 0.45
					partBtn.BorderSizePixel = 0
					partBtn.Text = ""
					partBtn.AutoButtonColor = false
					instance.uicorner(partBtn).CornerRadius = UDim.new(0, def.Corner)

					local partStroke = instance.uistroke(partBtn)
					partStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					partStroke.Color = Color3.fromRGB(255, 255, 255)
					partStroke.Thickness = 1
					partStroke.Transparency = 0.88

					local partLabel = instance.textlabel(partBtn)
					partLabel.Font = Enum.Font.GothamBold
					partLabel.Text = def.Label
					partLabel.TextSize = def.Name == "Torso" and 9 or 8
					partLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
					partLabel.BackgroundTransparency = 1
					partLabel.Size = UDim2.new(1, 0, 1, 0)

					partBtn.Activated:Connect(function()
						if bodyconfig.Multi then
							if selectedMap[def.Name] then
								selectedMap[def.Name] = nil
							else
								selectedMap[def.Name] = true
							end
						else
							if selectedMap[def.Name] then
								table.clear(selectedMap)
							else
								table.clear(selectedMap)
								selectedMap[def.Name] = true
							end
						end
						updateVisuals(true)
					end)

					limbButtons[def.Name] = partBtn
				end

				updateVisuals(false)

				function bodyfunc:Set(val, instant)
					table.clear(selectedMap)
					if bodyconfig.Multi then
						if typeof(val) == "table" then
							for _, p in ipairs(val) do
								local n = normalizePartName(p)
								if n then selectedMap[n] = true end
							end
						elseif typeof(val) == "string" then
							local n = normalizePartName(val)
							if n then selectedMap[n] = true end
						end
					else
						local p = normalizePartName(val) or "Head"
						selectedMap[p] = true
					end
					updateVisuals(not instant)
				end

				function bodyfunc:Get()
					return bodyfunc.Value
				end

				function bodyfunc:SelectAll()
					for _, def in ipairs(limbDefs) do
						selectedMap[def.Name] = true
					end
					updateVisuals(true)
				end

				function bodyfunc:Clear()
					table.clear(selectedMap)
					updateVisuals(true)
				end

				countitem = countitem + 1
				yieldbuild()
				config.elements[configkey] = bodyfunc
				registerSearchItem(bodyconfig.Title, row, "Body")
				return bodyfunc
			end

			-- // Alias AddBodyTarget
			function items:AddBodyTarget(bodyconfig)
				return items:AddBody(bodyconfig)
			end

			-- // AddProgressBar Element (Multi-Step / Milestone Progress Indicator)
			function items:AddProgressBar(progressconfig)
				progressconfig = progressconfig or {}
				progressconfig.Title = progressconfig.Title or "Progress"
				local stepsData = progressconfig.Steps or {
					{ Title = "Step 1" },
					{ Title = "Step 2" },
					{ Title = "Step 3" },
				}
				local stepCount = math.clamp(#stepsData, 2, 10)
				local hasLabels = false
				for i = 1, stepCount do
					if stepsData[i] and (stepsData[i].Title or stepsData[i].Name) then
						hasLabels = true
						break
					end
				end

				local hasSubtitle = (progressconfig.Description or progressconfig.Title2) ~= nil
				local cardHeight = hasLabels and (hasSubtitle and 94 or 78) or (hasSubtitle and 70 or 54)
				local yTrackOffset = hasSubtitle and 46 or 28

				local row = instance.frame(sectionadd)
				row.Name = "ProgressBar_" .. tostring(progressconfig.Title)
				row.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
				row.BackgroundTransparency = 0
				row.BorderSizePixel = 0
				row.LayoutOrder = countitem
				row.Size = UDim2.new(1, 0, 0, cardHeight)
				countitem = countitem + 1

				local rowCorner = instance.uicorner(row)
				rowCorner.CornerRadius = UDim.new(0, 6)

				local rowStroke = instance.uistroke(row)
				rowStroke.Color = Color3.fromRGB(255, 255, 255)
				rowStroke.Thickness = 1
				rowStroke.Transparency = 0.88

				-- // Title
				local titleLabel = instance.textlabel(row)
				titleLabel.Name = "Title"
				titleLabel.Font = guiconfig.Font or Enum.Font.GothamBold
				titleLabel.Text = tostring(progressconfig.Title)
				titleLabel.TextColor3 = Color3.fromRGB(231, 231, 231)
				titleLabel.TextSize = 13
				titleLabel.TextXAlignment = Enum.TextXAlignment.Left
				titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
				titleLabel.BackgroundTransparency = 1
				titleLabel.Position = UDim2.new(0, 10, 0, 8)
				titleLabel.Size = UDim2.new(1, -20, 0, 16)

				-- // Subtitle / Description (optional, multiline wrap support)
				local subLabel = nil
				if hasSubtitle then
					subLabel = instance.textlabel(row)
					subLabel.Name = "Description"
					subLabel.Font = guiconfig.Font or Enum.Font.GothamBold
					subLabel.Text = tostring(progressconfig.Description or progressconfig.Title2)
					subLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
					subLabel.TextTransparency = 0.5
					subLabel.TextSize = 11
					subLabel.TextXAlignment = Enum.TextXAlignment.Left
					subLabel.TextYAlignment = Enum.TextYAlignment.Top
					subLabel.TextWrapped = true
					subLabel.BackgroundTransparency = 1
					subLabel.Position = UDim2.new(0, 10, 0, 26)
					subLabel.Size = UDim2.new(1, -20, 0, 14)
				end

				-- // Status / Percentage Label (Opsional, dinonaktifkan secara default)
				local statusLabel = nil
				if progressconfig.ShowStatus or progressconfig.ShowPercentage then
					statusLabel = instance.textlabel(row)
					statusLabel.Name = "Status"
					statusLabel.Font = guiconfig.Font or Enum.Font.GothamBold
					statusLabel.Text = ""
					statusLabel.TextColor3 = guiconfig.Color
					statusLabel.TextSize = 11
					statusLabel.TextXAlignment = Enum.TextXAlignment.Right
					statusLabel.BackgroundTransparency = 1
					statusLabel.Position = UDim2.new(0.65, 0, 0, 8)
					statusLabel.Size = UDim2.new(0.35, -10, 0, 16)
					titleLabel.Size = UDim2.new(0.65, -10, 0, 16)
				end

				-- // Track Container Frame
				local trackArea = instance.frame(row)
				trackArea.Name = "TrackArea"
				trackArea.BackgroundTransparency = 1
				trackArea.BorderSizePixel = 0
				trackArea.Position = UDim2.new(0, 30, 0, yTrackOffset)
				trackArea.Size = UDim2.new(1, -60, 0, 26)

				local function updateProgressBarLayout()
					local subHeight = 0
					if subLabel and subLabel.Text ~= "" then
						local availWidth = math.max(60, row.AbsoluteSize.X - 20)
						local measured = game:GetService("TextService"):GetTextSize(
							subLabel.Text,
							subLabel.TextSize,
							subLabel.Font,
							Vector2.new(availWidth, 1000)
						)
						subHeight = math.max(14, measured.Y)
						subLabel.Size = UDim2.new(1, -20, 0, subHeight)
					end
					local currentTrackY = hasSubtitle and (26 + subHeight + 6) or 30
					trackArea.Position = UDim2.new(0, 30, 0, currentTrackY)
					local currentCardH = currentTrackY + 26 + (hasLabels and 20 or 8)
					row.Size = UDim2.new(1, 0, 0, currentCardH)
				end

				if subLabel then
					subLabel:GetPropertyChangedSignal("TextBounds"):Connect(updateProgressBarLayout)
				end
				row:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateProgressBarLayout)
				task.defer(updateProgressBarLayout)

				-- // Connecting Line Background
				local lineBg = instance.frame(trackArea)
				lineBg.Name = "LineBg"
				lineBg.AnchorPoint = Vector2.new(0, 0.5)
				lineBg.Position = UDim2.new(0, 0, 0.5, 0)
				lineBg.Size = UDim2.new(1, 0, 0, 4)
				lineBg.BackgroundColor3 = Color3.fromRGB(38, 38, 42)
				lineBg.BorderSizePixel = 0
				lineBg.ZIndex = 2
				local lineBgCorner = instance.uicorner(lineBg)
				lineBgCorner.CornerRadius = UDim.new(0, 2)

				-- // Connecting Line Active Fill
				local lineFill = instance.frame(lineBg)
				lineFill.Name = "LineFill"
				lineFill.Position = UDim2.new(0, 0, 0, 0)
				lineFill.Size = UDim2.new(0, 0, 1, 0)
				lineFill.BackgroundColor3 = guiconfig.Color
				lineFill.BorderSizePixel = 0
				lineFill.ZIndex = 3
				local lineFillCorner = instance.uicorner(lineFill)
				lineFillCorner.CornerRadius = UDim.new(0, 2)

				local progressfunc = {}
				local currentStep = math.clamp(tonumber(progressconfig.Current or progressconfig.Default) or 1, 1, stepCount)
				local nodes = {}
				local setToggleState = nil
				local isAutoRunning = false

				for i = 1, stepCount do
					local stepInfo = stepsData[i] or {}
					local xRatio = (stepCount > 1) and ((i - 1) / (stepCount - 1)) or 0

					local nodeBtn = instance.textbutton(trackArea)
					nodeBtn.Name = "Node_" .. tostring(i)
					nodeBtn.AnchorPoint = Vector2.new(0.5, 0.5)
					nodeBtn.Position = UDim2.new(xRatio, 0, 0.5, 0)
					nodeBtn.Size = UDim2.new(0, 22, 0, 22)
					nodeBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
					nodeBtn.BorderSizePixel = 0
					nodeBtn.Text = ""
					nodeBtn.AutoButtonColor = false
					nodeBtn.ZIndex = 5

					local nCorner = instance.uicorner(nodeBtn)
					nCorner.CornerRadius = UDim.new(1, 0)

					local nStroke = instance.uistroke(nodeBtn)
					nStroke.Color = Color3.fromRGB(55, 55, 60)
					nStroke.Thickness = 1.5
					nStroke.Transparency = 0.3

					local nIcon = nil
					local nNum = nil

					local iconAsset = stepInfo.Icon or stepInfo.Image
					if iconAsset then
						nIcon = instance.imagelabel(nodeBtn)
						nIcon.Name = "Icon"
						nIcon.AnchorPoint = Vector2.new(0.5, 0.5)
						nIcon.Position = UDim2.new(0.5, 0, 0.5, 0)
						nIcon.Size = UDim2.new(0, 13, 0, 13)
						nIcon.BackgroundTransparency = 1
						nIcon.Image = formatAsset(iconAsset)
						nIcon.ImageColor3 = Color3.fromRGB(150, 150, 150)
						nIcon.ZIndex = 6
					else
						nNum = instance.textlabel(nodeBtn)
						nNum.Name = "Num"
						nNum.AnchorPoint = Vector2.new(0.5, 0.5)
						nNum.Position = UDim2.new(0.5, 0, 0.5, 0)
						nNum.Size = UDim2.new(1, 0, 1, 0)
						nNum.BackgroundTransparency = 1
						nNum.Font = Enum.Font.GothamBold
						nNum.Text = tostring(i)
						nNum.TextColor3 = Color3.fromRGB(150, 150, 150)
						nNum.TextSize = 10
						nNum.ZIndex = 6
					end

					local nLabel = nil
					local stepTitle = stepInfo.Title or stepInfo.Name
					if stepTitle then
						local maxLabelWidth = (stepCount <= 3) and 56 or ((stepCount == 4) and 48 or ((stepCount == 5) and 40 or math.max(26, math.floor(180 / (stepCount - 1)))))
						local labelTextSize = (stepCount <= 5) and 8.5 or 8

						nLabel = instance.textlabel(trackArea)
						nLabel.Name = "Label_" .. tostring(i)
						nLabel.AnchorPoint = Vector2.new(0.5, 0)
						nLabel.Position = UDim2.new(xRatio, 0, 1, 3)
						nLabel.Size = UDim2.new(0, maxLabelWidth, 0, 14)
						nLabel.BackgroundTransparency = 1
						nLabel.Font = guiconfig.Font or Enum.Font.GothamBold
						nLabel.Text = tostring(stepTitle)
						nLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
						nLabel.TextSize = labelTextSize
						nLabel.TextXAlignment = Enum.TextXAlignment.Center
						nLabel.TextTruncate = Enum.TextTruncate.AtEnd
						nLabel.ZIndex = 5
					end

					if progressconfig.Interactive ~= false then
						nodeBtn.Activated:Connect(function()
							if isAutoRunning and setToggleState then
								setToggleState(false)
							end
							progressfunc:SetStep(i)
						end)
					end

					nodes[i] = {
						Btn = nodeBtn,
						Stroke = nStroke,
						Icon = nIcon,
						Num = nNum,
						Label = nLabel,
						Ratio = xRatio,
						Data = stepInfo,
					}
				end

				local function updateNodeStyles(stepIdx, animated)
					local tweenDuration = animated and 0.25 or 0.01
					local tInfo = TweenInfo.new(tweenDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

					for i = 1, stepCount do
						local node = nodes[i]
						local isPassed = (i <= stepIdx)
						local isCurrent = (i == stepIdx)

						local targetBg = isPassed and guiconfig.Color or Color3.fromRGB(28, 28, 32)
						local targetStroke = isPassed and guiconfig.Color or Color3.fromRGB(55, 55, 60)
						local targetContentColor = isPassed and Color3.fromRGB(20, 20, 20) or Color3.fromRGB(150, 150, 150)
						local targetLabelColor = isCurrent and guiconfig.Color or (isPassed and Color3.fromRGB(230, 230, 230) or Color3.fromRGB(120, 120, 120))

						sv.ts:Create(node.Btn, tInfo, { BackgroundColor3 = targetBg }):Play()
						sv.ts:Create(node.Stroke, tInfo, { Color = targetStroke }):Play()

						if node.Icon then
							sv.ts:Create(node.Icon, tInfo, { ImageColor3 = targetContentColor }):Play()
						end
						if node.Num then
							sv.ts:Create(node.Num, tInfo, { TextColor3 = targetContentColor }):Play()
						end
						if node.Label then
							sv.ts:Create(node.Label, tInfo, { TextColor3 = targetLabelColor }):Play()
						end
					end
				end

				local function applyStep(stepIdx, animated)
					stepIdx = math.clamp(stepIdx, 1, stepCount)
					currentStep = stepIdx
					progressfunc.Value = currentStep

					local targetRatio = (stepCount > 1) and ((stepIdx - 1) / (stepCount - 1)) or 0
					local percentInt = math.floor(targetRatio * 100)

					if statusLabel then
						if progressconfig.ShowPercentage then
							statusLabel.Text = string.format("Tahap %d/%d (%d%%)", stepIdx, stepCount, percentInt)
						else
							statusLabel.Text = string.format("Tahap %d/%d", stepIdx, stepCount)
						end
					end

					local tweenDuration = animated and 0.35 or 0.01
					local tInfo = TweenInfo.new(tweenDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

					sv.ts:Create(lineFill, tInfo, {
						Size = UDim2.new(targetRatio, 0, 1, 0)
					}):Play()

					updateNodeStyles(stepIdx, animated)

					if progressconfig.Callback then
						pcall(progressconfig.Callback, stepIdx, targetRatio, stepsData[stepIdx])
					end
				end

				local autoThread = nil

				local function stopAuto()
					isAutoRunning = false
					if autoThread then
						pcall(task.cancel, autoThread)
						autoThread = nil
					end
				end

				local function startAuto()
					stopAuto()
					isAutoRunning = true
					autoThread = task.spawn(function()
						while isAutoRunning do
							if not row or not row.Parent then break end

							-- // Mulai dari langkah pertama
							applyStep(1, false)
							task.wait(0.3)
							if not isAutoRunning or not row or not row.Parent then break end

							local stepDuration = tonumber(progressconfig.StepDuration) or 0.85
							for s = 2, stepCount do
								if not isAutoRunning or not row or not row.Parent then break end
								local targetRatio = (s - 1) / (stepCount - 1)

								-- // Garis secara mulus bergerak mengisi ke kanan menuju node berikutnya
								local fillTween = sv.ts:Create(lineFill, TweenInfo.new(stepDuration, Enum.EasingStyle.Linear), {
									Size = UDim2.new(targetRatio, 0, 1, 0)
								})
								fillTween:Play()

								task.wait(stepDuration)
								if not isAutoRunning or not row or not row.Parent then break end

								-- // Node menyala dan membesar sesaat saat garis menyentuhnya
								currentStep = s
								progressfunc.Value = currentStep
								updateNodeStyles(s, true)

								local activeNode = nodes[s]
								if activeNode then
									local pulse = sv.ts:Create(activeNode.Btn, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), {
										Size = UDim2.new(0, 26, 0, 26)
									})
									pulse:Play()
								end

								if statusLabel then
									local percentInt = math.floor(targetRatio * 100)
									if progressconfig.ShowPercentage then
										statusLabel.Text = string.format("Tahap %d/%d (%d%%)", s, stepCount, percentInt)
									else
										statusLabel.Text = string.format("Tahap %d/%d", s, stepCount)
									end
								end

								if progressconfig.Callback then
									pcall(progressconfig.Callback, s, targetRatio, stepsData[s])
								end

								task.wait(0.2)
							end

							if not isAutoRunning or not row or not row.Parent then break end
							task.wait(1.0) -- // Berhenti di milestone reward akhir

							if isAutoRunning and (progressconfig.Loop ~= false) then
								-- // Reset mulus kembali ke kiri untuk siklus berulang
								local resetTween = sv.ts:Create(lineFill, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
									Size = UDim2.new(0, 0, 1, 0)
								})
								resetTween:Play()
								task.wait(0.4)
								updateNodeStyles(1, true)
								task.wait(0.3)
							else
								break
							end
						end
					end)
				end

				local toggleActive = (progressconfig.Default == true)

				setToggleState = function(state, skipCallback)
					toggleActive = (state == true)
					progressfunc.ToggleValue = toggleActive

					if not skipCallback and progressconfig.ToggleCallback then
						pcall(progressconfig.ToggleCallback, toggleActive)
					end

					if toggleActive then
						startAuto()
					else
						stopAuto()
						applyStep(1, true)
					end
				end

				function progressfunc:SetStep(newStep, skipAnim)
					if isAutoRunning then
						setToggleState(false)
					end
					applyStep(newStep, not skipAnim)
				end

				function progressfunc:SetProgress(ratio, skipAnim)
					if isAutoRunning then
						setToggleState(false)
					end
					ratio = math.clamp(tonumber(ratio) or 0, 0, 1)
					local calculatedStep = math.floor(ratio * (stepCount - 1) + 0.5) + 1
					applyStep(calculatedStep, not skipAnim)
				end

				function progressfunc:Next()
					if isAutoRunning then
						setToggleState(false)
					end
					if currentStep < stepCount then
						applyStep(currentStep + 1, true)
					end
				end

				function progressfunc:Prev()
					if isAutoRunning then
						setToggleState(false)
					end
					if currentStep > 1 then
						applyStep(currentStep - 1, true)
					end
				end

				function progressfunc:Reset()
					if isAutoRunning then
						setToggleState(false)
					end
					applyStep(1, true)
				end

				function progressfunc:SetToggle(state)
					setToggleState(state)
				end

				function progressfunc:GetToggle()
					return toggleActive
				end

				function progressfunc:StartAuto()
					setToggleState(true)
				end

				function progressfunc:StopAuto()
					setToggleState(false)
				end

				function progressfunc:GetStep()
					return currentStep
				end

				function progressfunc:GetProgress()
					return (stepCount > 1) and ((currentStep - 1) / (stepCount - 1)) or 0
				end

				function progressfunc:SetVisible(state)
					row.Visible = (state == true)
				end

				function progressfunc:SetTitle(newTitle)
					titleLabel.Text = tostring(newTitle)
				end

				function progressfunc:SetDescription(newDesc)
					if subLabel then
						subLabel.Text = tostring(newDesc)
						updateProgressBarLayout()
					end
				end

				applyStep(currentStep, false)

				if toggleActive or progressconfig.AutoFill then
					startAuto()
				end

				local configkey = (type(sectiontitletext) == "string" and sectiontitletext or "General") .. "_" .. progressconfig.Title
				config.elements[configkey] = progressfunc
				registerSearchItem(progressconfig.Title, row, "ProgressBar")

				return progressfunc
			end

			-- // AddDropTracker Element (Item Drops & Material Farm Tracker)
			function items:AddDropTracker(trackerconfig)
				trackerconfig = trackerconfig or {}
				trackerconfig.Title = trackerconfig.Title or "Drop Tracker"
				local itemsData = trackerconfig.Items or {
					{ Name = "Item 1", Value = 0 },
				}

				local rowHeight = 28
				local headerHeight = 28
				local totalHeight = headerHeight + (#itemsData * rowHeight) + 6

				local card = instance.frame(sectionadd)
				card.Name = "DropTracker_" .. tostring(trackerconfig.Title)
				card.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
				card.BackgroundTransparency = 0
				card.BorderSizePixel = 0
				card.ClipsDescendants = true
				card.LayoutOrder = countitem
				card.Size = UDim2.new(1, 0, 0, totalHeight)
				countitem = countitem + 1

				local cardCorner = instance.uicorner(card)
				cardCorner.CornerRadius = UDim.new(0, 6)

				local cardStroke = instance.uistroke(card)
				cardStroke.Color = Color3.fromRGB(255, 255, 255)
				cardStroke.Thickness = 1
				cardStroke.Transparency = 0.88

				-- // Title
				local titleLabel = instance.textlabel(card)
				titleLabel.Name = "Title"
				titleLabel.Font = guiconfig.Font or Enum.Font.GothamBold
				titleLabel.Text = tostring(trackerconfig.Title)
				titleLabel.TextColor3 = Color3.fromRGB(231, 231, 231)
				titleLabel.TextSize = 13
				titleLabel.TextXAlignment = Enum.TextXAlignment.Left
				titleLabel.BackgroundTransparency = 1
				titleLabel.Position = UDim2.new(0, 12, 0, 8)
				titleLabel.Size = UDim2.new(1, -24, 0, 16)

				-- // Helper: Number comma formatting
				local function formatValue(val, prefix, suffix)
					prefix = prefix or ""
					suffix = suffix or ""
					if type(val) == "number" then
						local s = tostring(math.floor(val))
						local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
						return prefix .. formatted .. suffix
					end
					return prefix .. tostring(val) .. suffix
				end

				local trackerfunc = {}
				local itemEntries = {}

				-- // Items List Container
				local listFrame = instance.frame(card)
				listFrame.Name = "ItemsList"
				listFrame.BackgroundTransparency = 1
				listFrame.Position = UDim2.new(0, 12, 0, headerHeight)
				listFrame.Size = UDim2.new(1, -24, 1, -headerHeight)

				local function createRow(idx, itemInfo)
					local yPos = (idx - 1) * rowHeight
					local rowItem = instance.frame(listFrame)
					rowItem.Name = "Row_" .. tostring(itemInfo.Name or idx)
					rowItem.BackgroundTransparency = 1
					rowItem.Position = UDim2.new(0, 0, 0, yPos)
					rowItem.Size = UDim2.new(1, 0, 0, rowHeight)

					local nameLabel = instance.textlabel(rowItem)
					nameLabel.Name = "ItemName"
					nameLabel.Font = guiconfig.Font or Enum.Font.GothamBold
					nameLabel.Text = tostring(itemInfo.Name or "Item")
					nameLabel.TextColor3 = Color3.fromRGB(215, 215, 215)
					nameLabel.TextSize = 11.5
					nameLabel.TextXAlignment = Enum.TextXAlignment.Left
					nameLabel.AnchorPoint = Vector2.new(0, 0.5)
					nameLabel.Position = UDim2.new(0, 2, 0.5, 0)
					nameLabel.Size = UDim2.new(0.55, -2, 1, 0)
					nameLabel.BackgroundTransparency = 1
					nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
					nameLabel.ZIndex = 2

					local valBtn = instance.textbutton(rowItem)
					valBtn.Name = "ItemValue"
					valBtn.Font = guiconfig.Font or Enum.Font.GothamBold
					valBtn.Text = formatValue(itemInfo.Value or 0, itemInfo.Prefix, itemInfo.Suffix)
					valBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
					valBtn.TextSize = 11.5
					valBtn.TextXAlignment = Enum.TextXAlignment.Right
					valBtn.AnchorPoint = Vector2.new(1, 0.5)
					valBtn.Position = UDim2.new(1, -2, 0.5, 0)
					valBtn.Size = UDim2.new(0.45, 0, 1, 0)
					valBtn.BackgroundTransparency = 1
					valBtn.AutoButtonColor = false
					valBtn.ZIndex = 3

					local entry = {
						Data = itemInfo,
						Row = rowItem,
						NameLabel = nameLabel,
						ValBtn = valBtn,
						Value = itemInfo.Value or 0,
						InitialValue = itemInfo.Value or 0,
					}

					valBtn.Activated:Connect(function()
						if itemInfo.Callback then
							pcall(itemInfo.Callback, entry.Value, entry)
						elseif trackerconfig.Callback then
							pcall(trackerconfig.Callback, itemInfo.Name, entry.Value)
						end
					end)

					-- // Separator Line (kecuali baris terakhir)
					if idx < #itemsData then
						local separator = instance.frame(rowItem)
						separator.Name = "Separator"
						separator.AnchorPoint = Vector2.new(0, 1)
						separator.Position = UDim2.new(0, 0, 1, 0)
						separator.Size = UDim2.new(1, 0, 0, 1)
						separator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
						separator.BackgroundTransparency = 0.93
						separator.BorderSizePixel = 0
						entry.Separator = separator
					end

					itemEntries[idx] = entry
					if itemInfo.Name then
						itemEntries[tostring(itemInfo.Name):lower()] = entry
					end
					return entry
				end

				for idx, itemInfo in ipairs(itemsData) do
					createRow(idx, itemInfo)
				end

				local function findEntry(key)
					if type(key) == "number" then
						return itemEntries[key]
					elseif type(key) == "string" then
						return itemEntries[key:lower()]
					end
					return nil
				end

				function trackerfunc:Set(key, newVal)
					local entry = findEntry(key)
					if entry then
						entry.Value = newVal
						entry.ValBtn.Text = formatValue(newVal, entry.Data.Prefix, entry.Data.Suffix)
					end
				end

				function trackerfunc:Add(key, amount)
					local entry = findEntry(key)
					if entry then
						local curr = tonumber(entry.Value) or 0
						local delta = tonumber(amount) or 1
						trackerfunc:Set(key, curr + delta)
					end
				end

				function trackerfunc:Get(key)
					local entry = findEntry(key)
					return entry and entry.Value or nil
				end

				function trackerfunc:Reset()
					for idx, entry in ipairs(itemEntries) do
						entry.Value = 0
						entry.ValBtn.Text = formatValue(0, entry.Data.Prefix, entry.Data.Suffix)
					end
					if trackerconfig.OnReset then
						pcall(trackerconfig.OnReset)
					end
				end

				function trackerfunc:SetVisible(state)
					card.Visible = (state == true)
				end

				local configkey = (type(sectiontitletext) == "string" and sectiontitletext or "General") .. "_" .. trackerconfig.Title
				config.elements[configkey] = trackerfunc
				registerSearchItem(trackerconfig.Title, card, "DropTracker")

				return trackerfunc
			end

			-- // Aliases for DropTracker
			function items:AddMaterialTracker(cfg)
				return items:AddDropTracker(cfg)
			end
			function items:AddStatTracker(cfg)
				return items:AddDropTracker(cfg)
			end

			function items:AddDivider()
				local divider = instance.frame(sectionadd)
				divider.Name = "Divider"
				divider.AnchorPoint = Vector2.new(0.5, 0)
				divider.Position = UDim2.new(0.5, 0, 0, 0)
				divider.Size = UDim2.new(1, 0, 0, 2)
				divider.BackgroundColor3 = guiconfig.Color
				divider.BackgroundTransparency = 0
				divider.BorderSizePixel = 0
				divider.LayoutOrder = countitem

				local gradient = instance.uigradient(divider)
				gradient.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.8),
					NumberSequenceKeypoint.new(0.5, 0),
					NumberSequenceKeypoint.new(1, 0.8),
				})

				instance.uicorner(divider).CornerRadius = UDim.new(0, 2)

				countitem = countitem + 1
				return divider
			end

			function items:AddSubSection(sectiontext)
				sectiontext = sectiontext or "Sub Section"

				local subsection = instance.frame(sectionadd)
				subsection.Name = "SubSection"
				subsection.BackgroundTransparency = 1
				subsection.Size = UDim2.new(1, 0, 0, 22)
				subsection.LayoutOrder = countitem

				local background = instance.frame(subsection)
				background.Size = UDim2.new(1, 0, 1, 0)
				background.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				background.BackgroundTransparency = 1
				background.BorderSizePixel = 0
				instance.uicorner(background).CornerRadius = UDim.new(0, 6)

				local label = instance.textlabel(subsection)
				label.AnchorPoint = Vector2.new(0, 0.5)
				label.Position = UDim2.new(0, 1, 0.5, 0)
				label.Size = UDim2.new(1, -1, 1, 0)
				label.BackgroundTransparency = 1
				label.Font = Enum.Font.GothamBold
				label.Text = tostring(sectiontext)
				label.TextColor3 = Color3.fromRGB(0, 208, 255)
				label.TextSize = 13
				label.TextXAlignment = Enum.TextXAlignment.Left

				countitem = countitem + 1
				currentSubSection = tostring(sectiontext)
				return subsection
			end

			function items:AddConfigPanel()
				local selectedconfigname = config.current or ""
				local configdropdown
				local autostatus
				local saveparagraph
				local externalconfiginput

				local function setdropdownlist(dropdown, list, targetName)
					targetName = targetName or (selectedconfigname ~= "" and selectedconfigname or nil)
					if dropdown and dropdown.SetValues then
						dropdown:SetValues(list, targetName, true)
					elseif dropdown and dropdown.Refresh then
						dropdown:Refresh(list)
					end
				end

				local function refreshconfiglist(targetName)
					setdropdownlist(configdropdown, config:getlist(), targetName)
				end

				saveparagraph = items:AddParagraph({
					Title = "Config Manager",
					Content = "Current: " .. (config.current or "None"),
				})

				local function updatestatus()
					if saveparagraph then
						saveparagraph:SetContent("Current: " .. (config.current or "None"))
					end
					if autostatus then
						autostatus:SetContent("Auto Load: " .. (config:getautoload() or "None"))
					end
				end

				local confignameinput = items:AddInput({
					Title = "Config Name",
					Placeholder = "Write config name here",
					Default = selectedconfigname,
				})

				configdropdown = items:AddDropdown({
					Title = "Select Config",
					Multi = false,
					Default = (config.current and config.current ~= "") and config.current or nil,
					Options = config:getlist(),
					Callback = function(value)
						selectedconfigname = value or ""
						if selectedconfigname ~= "" and confignameinput then
							confignameinput:Set(selectedconfigname)
						end
					end,
				})

				items:AddButton({
					Title = "Save Config",
					SubTitle = "Load Config",
					Callback = function()
						local rawName = (confignameinput and confignameinput.Value) or ""
						if (not rawName or rawName == "") and confignameinput and confignameinput.Get then
							rawName = confignameinput:Get()
						end
						local name = tostring(rawName or ""):match("^%s*(.-)%s*$")

						if name == "" then
							chloex("Config name cannot be empty", 3, Color3.fromRGB(255, 100, 100))
							return
						end

						if name:find('[/\\:*%?"<>|]') then
							chloex("Invalid filename characters", 3, Color3.fromRGB(255, 100, 100))
							return
						end

						if config:save(name) then
							selectedconfigname = name
							refreshconfiglist(name)
							updatestatus()
							chloex("Config saved: " .. name, 3, Color3.fromRGB(100, 255, 100))
						end
					end,
					SubCallback = function()
						if selectedconfigname == "" then
							chloex("Select config first", 3, Color3.fromRGB(255, 100, 100))
							return
						end

						if config:load(selectedconfigname) then
							refreshconfiglist(selectedconfigname)
							updatestatus()
							chloex("Config loaded: " .. selectedconfigname, 3, Color3.fromRGB(100, 255, 100))
						end
					end,
				})

				items:AddButton({
					Title = "Delete Config",
					SubTitle = "Override Config",
					Callback = function()
						if selectedconfigname == "" then
							chloex("Select config first", 3, Color3.fromRGB(255, 100, 100))
							return
						end

						local nameToDelete = selectedconfigname
						if config:delete(nameToDelete) then
							selectedconfigname = ""
							if confignameinput then
								confignameinput:Set("")
							end
							refreshconfiglist(nil)
							updatestatus()
							chloex("Config deleted: " .. nameToDelete, 3, Color3.fromRGB(100, 255, 100))
						end
					end,
					SubCallback = function()
						if selectedconfigname == "" then
							chloex("Select config first", 3, Color3.fromRGB(255, 100, 100))
							return
						end

						if config:save(selectedconfigname) then
							refreshconfiglist(selectedconfigname)
							updatestatus()
							chloex("Config overridden: " .. selectedconfigname, 3, Color3.fromRGB(100, 255, 100))
						end
					end,
				})

				items:AddSubSection("Auto-Load Configuration")

				autostatus = items:AddParagraph({
					Title = "Auto Load Status",
					Content = "Auto Load: " .. (config:getautoload() or "None"),
				})

				items:AddButton({
					Title = "Set Auto Load",
					SubTitle = "Clear Auto Load",
					Callback = function()
						if selectedconfigname == "" then
							chloex("Select config first", 3, Color3.fromRGB(255, 100, 100))
							return
						end

						if config:setautoload(selectedconfigname) then
							updatestatus()
							chloex("Auto load set: " .. selectedconfigname, 3, Color3.fromRGB(100, 255, 100))
						end
					end,
					SubCallback = function()
						if config:clearautoload() then
							updatestatus()
							chloex("Auto load cleared", 3, Color3.fromRGB(100, 255, 100))
						end
					end,
				})

				items:AddSubSection("Config Management")

				externalconfiginput = items:AddInput({
					Title = "Share & Import Config",
					Placeholder = "Paste Code Here...",
				})

				items:AddButton({
					Title = "Export & Share Code",
					SubTitle = "Import & Apply Code",
					Callback = function()
						local targetName = selectedconfigname ~= "" and selectedconfigname or nil
						local code = config:export(targetName)
						if code then
							if externalconfiginput and externalconfiginput.Set then
								externalconfiginput:Set(code)
							end
							chloex("Config code copied to clipboard!", 4, Color3.fromRGB(0, 208, 255), "Chloe X", "Share Code")
						else
							chloex("Failed to export config", 3, Color3.fromRGB(255, 100, 100))
						end
					end,
					SubCallback = function()
						local rawCode = (externalconfiginput and externalconfiginput.Value) or ""
						if (not rawCode or rawCode == "") and externalconfiginput and externalconfiginput.Get then
							rawCode = externalconfiginput:Get()
						end

						if not rawCode or rawCode == "" then
							chloex("Share code cannot be empty", 3, Color3.fromRGB(255, 100, 100))
							return
						end

						local targetSave = (confignameinput and confignameinput.Value) or ""
						if targetSave == "" and confignameinput and confignameinput.Get then
							targetSave = confignameinput:Get()
						end
						if targetSave == "" then
							targetSave = "Shared_" .. os.date("%d%b_%H%M")
						end

						local ok, err = config:import(rawCode, targetSave)
						if ok then
							selectedconfigname = targetSave
							refreshconfiglist(targetSave)
							updatestatus()
							chloex("Config imported & applied: " .. targetSave, 4, Color3.fromRGB(100, 255, 100), "Chloe X", "Import Success")
						else
							chloex("Failed to import: " .. tostring(err or "Invalid format"), 3, Color3.fromRGB(255, 100, 100))
						end
					end,
				})

				items:AddSubSection("Reset Configuration")

				items:AddButton({
					Title = "Reset All To Default",
					Callback = function()
						config:reset()
						updatestatus()
						chloex("All elements reset to default", 3, Color3.fromRGB(100, 255, 100))
					end,
				})

				return {
					UpdateStatus = updatestatus,
					RefreshList = refreshconfiglist,
				}
			end

			return items
		end

		local defaultSection = nil
