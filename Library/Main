				classicStartPos.Y.Scale,
				classicStartPos.Y.Offset + delta.Y
			)
		end

		local function onDragInputBegan(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				classicDragging = true
				classicHasDragged = false
				classicDragStart = input.Position
				classicPressPos = Vector2.new(input.Position.X, input.Position.Y)
				classicStartPos = classicBtn.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						classicDragging = false
					end
				end)
			end
		end

		logoClick.InputBegan:Connect(onDragInputBegan)
		classicBtn.InputBegan:Connect(onDragInputBegan)

		trackConnection(sv.uis.InputChanged:Connect(function(input)
			if
				classicDragging
				and (
					input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch
				)
			then
				if (Vector2.new(input.Position.X, input.Position.Y) - classicPressPos).Magnitude > 4 then
					classicHasDragged = true
				end
				if classicHasDragged then
					updateClassicDrag(input)
				end
			end
		end), "classicToggle.drag")

		trackConnection(sv.uis.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				classicDragging = false
			end
		end), "classicToggle.dragEnd")

		local function updateBtnVisuals()
			local isMainOpen = dropshadowholder and dropshadowholder.Visible
			local isMiniOpen = miniHolder and miniHolder.Visible

			if btnFlyMain and btnFlyMain.Parent then
				btnFlyMain.Text = "Main UI"
				btnFlyMain.TextColor3 = isMainOpen and (guiconfig.Color or Color3.fromRGB(0, 208, 255)) or Color3.fromRGB(160, 160, 160)
				btnFlyMain.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
				flyMainStroke.Color = Color3.fromRGB(255, 255, 255)
				flyMainStroke.Transparency = 0.88
			end

			if btnFlyMini and btnFlyMini.Parent then
				btnFlyMini.Text = "Mini UI"
				btnFlyMini.TextColor3 = isMiniOpen and (guiconfig.Color or Color3.fromRGB(0, 208, 255)) or Color3.fromRGB(160, 160, 160)
				btnFlyMini.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
				flyMiniStroke.Color = Color3.fromRGB(255, 255, 255)
				flyMiniStroke.Transparency = 0.88
			end
		end

		updateAllBtnVisuals = function()
			local isMainOpen = dropshadowholder and dropshadowholder.Visible
			local isMiniOpen = miniHolder and miniHolder.Visible

			if btnMain and btnMain.Parent then
				btnMain.Text = isMainOpen and "Close UI" or "Open UI"
				btnMain.TextTransparency = isMainOpen and 0 or 0.15
				sv.ts:Create(btnMain, TweenInfo.new(0.18), {
					BackgroundColor3 = isMainOpen and Color3.fromRGB(25, 25, 25) or Color3.fromRGB(20, 20, 20),
				}):Play()
			end

			if btnMini and btnMini.Parent then
				btnMini.Text = isMiniOpen and "Close MiniUI" or "Open MiniUI"
				btnMini.TextTransparency = isMiniOpen and 0 or 0.15
				sv.ts:Create(btnMini, TweenInfo.new(0.18), {
					BackgroundColor3 = isMiniOpen and Color3.fromRGB(25, 25, 25) or Color3.fromRGB(20, 20, 20),
				}):Play()
			end

			updateBtnVisuals()
		end

		setBarExpansion = function(expanded)
			isBarExpanded = expanded
			local targetW = isBarExpanded and expandedW or collapsedW
			local tInfo = TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

			if isBarExpanded then
				divider.Visible = true
				btnContainer.Visible = true
				local screenW = (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.X) or 800
				if classicBtn.AbsolutePosition.X + expandedW + 10 > screenW then
					local overflow = (classicBtn.AbsolutePosition.X + expandedW + 10) - screenW
					sv.ts:Create(classicBtn, tInfo, {
						Position = UDim2.new(classicBtn.Position.X.Scale, math.max(10, classicBtn.Position.X.Offset - overflow), classicBtn.Position.Y.Scale, classicBtn.Position.Y.Offset)
					}):Play()
				end
				updateBtnVisuals()
				sv.ts:Create(classicBtn, tInfo, {
					Size = UDim2.new(0, targetW, 0, barH),
					BackgroundTransparency = 0.08
				}):Play()
				sv.ts:Create(classicStroke, tInfo, {
					Transparency = 0.88
				}):Play()
				sv.ts:Create(divider, tInfo, {
					BackgroundTransparency = 0.88
				}):Play()
				sv.ts:Create(logoImg, tInfo, {
					Size = UDim2.new(0, logoSize, 0, logoSize),
					Position = UDim2.new(0, logoPad, 0.5, 0)
				}):Play()
				sv.ts:Create(logoCorner, tInfo, {
					CornerRadius = UDim.new(0, 6)
				}):Play()
			else
				local closeTween = sv.ts:Create(classicBtn, tInfo, {
					Size = UDim2.new(0, targetW, 0, barH),
					BackgroundTransparency = 1
				})
				sv.ts:Create(classicStroke, tInfo, {
					Transparency = 1
				}):Play()
				sv.ts:Create(divider, tInfo, {
					BackgroundTransparency = 1
				}):Play()
				sv.ts:Create(logoImg, tInfo, {
					Size = UDim2.new(0, barH, 0, barH),
					Position = UDim2.new(0, 0, 0.5, 0)
				}):Play()
				sv.ts:Create(logoCorner, tInfo, {
					CornerRadius = UDim.new(0, 8)
				}):Play()
				closeTween:Play()
				task.delay(0.24, function()
					if not isBarExpanded then
						divider.Visible = false
						btnContainer.Visible = false
					end
				end)
			end
		end

		btnFlyMain.MouseButton1Click:Connect(function()
			if dropshadowholder then
				dropshadowholder.Visible = not dropshadowholder.Visible
				updateAllBtnVisuals()
			end
		end)

		btnFlyMini.MouseButton1Click:Connect(function()
			if miniHolder then
				miniHolder.Visible = not miniHolder.Visible
				updateAllBtnVisuals()
			end
		end)

		logoClick.MouseButton1Click:Connect(function()
			if not classicHasDragged then
				if isMiniUIEnabled then
					setBarExpansion(not isBarExpanded)
				else
					if dropshadowholder then
						dropshadowholder.Visible = not dropshadowholder.Visible
					end
				end
			end
		end)

		-- // Switch mode: Card Overlay vs Classic Pill Bar
		setToggleUIStyle = function(style)
			style = (style == "Square") and "Square" or "Overlay"
			toggleUIStyle = style
			guiconfig.ToggleUIStyle = style

			if not card or not card.Parent or not classicBtn or not classicBtn.Parent then return end

			if not isMiniUIEnabled then
				card.Visible = false
				classicBtn.Visible = true
				setBarExpansion(false)
				mainIconButton = classicBtn
			elseif style == "Overlay" then
				card.Visible = true
				classicBtn.Visible = false
				setBarExpansion(false)
				mainIconButton = card
				if updateCardPosition then
					updateCardPosition(false)
				end
			else
				card.Visible = false
				classicBtn.Visible = true
				setBarExpansion(false)
				mainIconButton = classicBtn
			end
		end

		setToggleUIMode = function(enabled)
			isMiniUIEnabled = (enabled == true)
			guiconfig.MiniUI = isMiniUIEnabled
			if not isMiniUIEnabled then
				if miniHolder then
					miniHolder.Visible = false
				end
			end
			setToggleUIStyle(toggleUIStyle)
		end
		local initialMiniState = isMiniUIEnabled
		setToggleUIMode(initialMiniState)
		updateAllBtnVisuals()
	end

