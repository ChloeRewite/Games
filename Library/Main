	local function formatTime(sec)
		local h = math.floor(sec / 3600)
		local m = math.floor((sec % 3600) / 60)
		local s = math.floor(sec % 60)
		return string.format("%dh %dm %ds", h, m, s)
	end

	local function updateIdent()
		username.Text = "Welcome, " .. userNameText
		if headshot and headshot.Parent then
			headshot.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(userId) .. "&w=150&h=150"
		end
	end

	updateIdent()

	local function updateElementHud()
		if not useroptions.ShowElement then
			if elementHudDragConn then
				elementHudDragConn:Disconnect()
				elementHudDragConn = nil
			end
			if elementHud then
				elementHud:Destroy()
				elementHud = nil
			end
			return
		end

		if not elementHud then
			elementHud = instance.screengui(sv.coregui)
			elementHud.Name = "ChloeX_ActiveElements"
			elementHud.ResetOnSpawn = false
			elementHud.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

			local mainhud = instance.frame(elementHud)
			mainhud.Name = "Main"
			mainhud.Position = UDim2.new(1, -250, 0, 90)
			mainhud.Size = UDim2.new(0, 230, 0, 180)
			mainhud.BackgroundColor3 = Color3.fromRGB(1, 60, 75)
			mainhud.BackgroundTransparency = 0.1
			mainhud.BorderSizePixel = 0
			mainhud.Active = true
			instance.uicorner(mainhud).CornerRadius = UDim.new(0, 6)

			local dragging = false
			local dragstart
			local startpos

			mainhud.InputBegan:Connect(function(input)
				if
					input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch
				then
					dragging = true
					dragstart = input.Position
					startpos = mainhud.Position

					input.Changed:Connect(function()
						if input.UserInputState == Enum.UserInputState.End then
							dragging = false
						end
					end)
				end
			end)

			if elementHudDragConn then
				elementHudDragConn:Disconnect()
				elementHudDragConn = nil
			end
			elementHudDragConn = sv.uis.InputChanged:Connect(function(input)
				if
					dragging
					and (
						input.UserInputType == Enum.UserInputType.MouseMovement
						or input.UserInputType == Enum.UserInputType.Touch
					)
				then
					local delta = input.Position - dragstart
					mainhud.Position = clampPositionToScreen(
						mainhud,
						startpos.X.Scale,
						startpos.X.Offset + delta.X,
						startpos.Y.Scale,
						startpos.Y.Offset + delta.Y
					)
				end
			end)

			local scroll = instance.scrollingframe(mainhud)
			scroll.Name = "Scroll"
			scroll.BackgroundTransparency = 1
			scroll.BorderSizePixel = 0
			scroll.Size = UDim2.new(1, -10, 1, -10)
			scroll.Position = UDim2.new(0, 5, 0, 5)
			scroll.ScrollBarThickness = 3
			scroll.ScrollBarImageTransparency = 0.5

			local layout = instance.uilistlayout(scroll)
			layout.Padding = UDim.new(0, 4)
			layout.SortOrder = Enum.SortOrder.LayoutOrder
		end

		local scroll = elementHud.Main.Scroll

		for _, v in ipairs(scroll:GetChildren()) do
			if not v:IsA("UIListLayout") then
				v:Destroy()
			end
		end

		for title, togglefunc in pairs(activeToggles) do
			local row = instance.frame(scroll)
			row.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			row.BackgroundTransparency = 0.92
			row.BorderSizePixel = 0
			row.Size = UDim2.new(1, -6, 0, 32)
			instance.uicorner(row).CornerRadius = UDim.new(0, 5)

			local label = instance.textlabel(row)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.GothamBold
			label.Text = title
			label.TextColor3 = Color3.fromRGB(255, 255, 255)
			label.TextSize = 12
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Position = UDim2.new(0, 8, 0, 0)
			label.Size = UDim2.new(1, -45, 1, 0)

			local closebtn = instance.textbutton(row)
			closebtn.BackgroundTransparency = 1
			closebtn.Font = Enum.Font.GothamBold
			closebtn.Text = "X"
			closebtn.TextColor3 = guiconfig.Color
			closebtn.TextSize = 13
			closebtn.Position = UDim2.new(1, -34, 0, 0)
			closebtn.Size = UDim2.new(0, 30, 1, 0)

			closebtn.Activated:Connect(function()
				if togglefunc and togglefunc.Set then
					togglefunc:Set(false)
				end
			end)
		end

		task.defer(function()
			if scroll and scroll:FindFirstChild("UIListLayout") then
				scroll.CanvasSize = UDim2.new(0, 0, 0, scroll.UIListLayout.AbsoluteContentSize.Y + 8)
			end
		end)
	end

	local function setStatistic(state)
		footerstat.Visible = state

		if statConn then
			statConn:Disconnect()
			statConn = nil
		end

		if state then
			local acc = 0
			statConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
				acc = acc + dt
				if acc < 0.5 then
					return
				end
				acc = 0

				local fps = math.floor(1 / math.max(dt, 0.001))
				local cpu = math.floor(dt * 1000)
				local uptime = formatTime(os.clock() - serverStart)

				footerstat.Text = "FPS: " .. fps .. " | CPU: " .. cpu .. "ms | " .. uptime
			end)
		else
			footerstat.Text = ""
		end
	end

	local footerOverlay

	local function makeFooterToggle(parent, text, key, callback)
		local btn = instance.textbutton(parent)
		btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		btn.BackgroundTransparency = 0.93
		btn.BorderSizePixel = 0
		btn.Size = UDim2.new(1, 0, 0, 30)
		btn.Text = ""
		instance.uicorner(btn).CornerRadius = UDim.new(0, 5)

		local label = instance.textlabel(btn)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.TextSize = 12
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Position = UDim2.new(0, 8, 0, 0)
		label.Size = UDim2.new(1, -50, 1, 0)

		local mark = instance.textlabel(btn)
		mark.BackgroundTransparency = 1
		mark.Font = Enum.Font.GothamBold
		mark.TextColor3 = guiconfig.Color
		mark.TextSize = 13
		mark.TextXAlignment = Enum.TextXAlignment.Right
		mark.Position = UDim2.new(1, -38, 0, 0)
		mark.Size = UDim2.new(0, 30, 1, 0)

		local function refresh()
			label.Text = text
			mark.Text = useroptions[key] and "ON" or "OFF"
		end

		btn.Activated:Connect(function()
			useroptions[key] = not useroptions[key]
			refresh()
			if callback then
				callback(useroptions[key])
			end
		end)

		refresh()
	end

	footerclick.Activated:Connect(function()
		if footerOverlay then
			footerOverlay:Destroy()
