		counttab = counttab + 1
		local safename = tabconfig.Name:gsub("%s+", "_")
		_G[safename] = sections
		return sections
	end

	if guiconfig.AutoConfigTab then
		local ConfigTab = tabs:AddTab({
			Name = "Config",
			Icon = (guiconfig.HubIcons and (guiconfig.HubIcons.Config or guiconfig.HubIcons.config or guiconfig.HubIcons.Settings or guiconfig.HubIcons.settings)) or DEFAULT_CONFIG.HubIcons.Config,
			InfoTab = true,
			LayoutOrder = 1000000,
			StartActive = false,
		})

		local function buildConfigTab()
			local ConfigSection = ConfigTab:AddSection("Config Configuration", true)
			ConfigSection:AddConfigPanel()
		end

		if guiconfig.LazyConfigTab then
			ConfigTab:OnOpen(buildConfigTab)
		else
			buildConfigTab()
		end
	end

	function tabs:Watermark(watermarkconfig)
		watermarkconfig = watermarkconfig or {}
		watermarkconfig.Parent = chloeex
		watermarkconfig.Font = guiconfig.Font
		watermarkconfig.Color = guiconfig.Color
		if watermarkconfig.Title == nil then
			watermarkconfig.Title = guiconfig.Title or "Chloe X"
		end
		local wm = Chloex:Watermark(watermarkconfig)
		tabs._watermark = wm
		return wm
	end

	function tabs:ToggleSearch(state)
		if searchlayer then
			if state == nil then
				state = not searchlayer.Visible
			end
			if state then
				if guiconfig.Type == 3 and search then
					search.Visible = true
				end
				searchlayer.Visible = true
				if searchinput then
					searchinput:CaptureFocus()
				end
				if sidebarSearchBtn and sbIcon then
					sv.ts:Create(sidebarSearchBtn, TweenInfo.new(0.15), { BackgroundTransparency = 0 }):Play()
					sv.ts:Create(sbIcon, TweenInfo.new(0.15), { ImageColor3 = guiconfig.Color, ImageTransparency = 0 }):Play()
				end
				if refreshSearch then
					refreshSearch()
				end
			else
				if closeSearch then
					closeSearch(true)
				end
			end
		end
	end

	function tabs:AddInfoTab(tabconfig)
		tabconfig = tabconfig or {}
		tabconfig.InfoTab = true
		return tabs:AddTab(tabconfig)
	end

	function tabs:SetViewMode(mode)
		setViewMode(mode)
	end

	function tabs:ToggleViewMode()
		toggleViewMode()
	end

	function tabs:GetViewMode()
		return currentViewMode
	end

	local _defHub = {
		I = nil,
		GS = nil,
		D = nil,
		Adv = nil,
		E = nil,
		Logs = nil,
	}

	local function buildDefaultInfoTabs()
		local lang = string.lower(guiconfig.Language or "en")
		local isRu = (lang == "ru")
		local isEn = (lang == "en")
		local isId = (lang == "id")

		-- // Tab 1: Information
		local infoTab = tabs:AddInfoTab({
			Name = isRu and "Информация" or (isEn and "Information" or "Informasi"),
			Icon = (guiconfig.HubIcons and (guiconfig.HubIcons.Information or guiconfig.HubIcons.Info or guiconfig.HubIcons.information or guiconfig.HubIcons.info)) or DEFAULT_CONFIG.HubIcons.Information,
			LayoutOrder = 1,
			StartActive = true,
		})
		_defHub.I = infoTab

		local infoSec = infoTab:AddSection(isRu and "Сведения о системе" or (isEn and "System Overview" or "Ringkasan Sistem"), true)
		infoSec:AddUserCard({
			Title = isRu and ("Добро пожаловать, " .. ((sv.plrs.LocalPlayer and sv.plrs.LocalPlayer.DisplayName) or "User"))
				or ("Welcome, " .. ((sv.plrs.LocalPlayer and sv.plrs.LocalPlayer.DisplayName) or "User")),
		})
		infoSec:AddServerCondition({
			Title = isRu and "Состояние сервера" or (isId and "Kondisi Server" or "Condition Server"),
		})
		infoSec:AddGameCard({
			Title = isRu and "Текущая игра :" or (isEn and "Current Game :" or "Current Game :"),
			UsersTitle = isRu and "Активные игроки" or (isEn and "Active Users" or "Active Users"),
		})

		-- // Resolve Update Logs (supports GameId, Folder, PlaceId, URL)
		local logsSource = guiconfig.Logs or guiconfig.UpdateLogs
		local resolved = nil
		if _gInfo.Matched and _gInfo.Matched.Changelogs then
			resolved = {
				Title = (_gInfo.MatchedName or "Game") .. " Update Logs",
				Entries = {
					{
						Version = _gInfo.Matched.Version or "v1.0.0",
						Date = _gInfo.Matched.Date or os.date("%d %b %Y"),
						Logs = _gInfo.Matched.Changelogs,
					},
				},
			}
		end

		local logEntries = resolved and resolved.Entries or {
			{
				Version = "-",
				Date = "-",
				Logs = { "- - -" },
			},
		}

		local defaultTitle = isRu and "Список изменений" or (isEn and "Update Logs" or "Update Logs")
		local logTitle = (resolved and resolved.Title) or defaultTitle

		_defHub.Logs = infoSec:AddUpdateLogs({
			Title = logTitle,
			Entries = logEntries,
		})

		-- // Asynchronously fetch remote update logs if configured (non-blocking)
		if logsSource then
			task.spawn(function()
				local r = nil
				if _gInfo.Matched and _gInfo.Matched.Folder and type(logsSource) == "string" and string.find(logsSource, "/$") then
					r = resolveUpdateLogs(logsSource .. _gInfo.Matched.Folder .. "/", nil, _gInfo.CurrentId)
				end
				if not r then
					r = resolveUpdateLogs(logsSource, nil, _gInfo.CurrentId)
				end
				if r and r.Entries and _defHub.Logs and _defHub.Logs.SetEntries then
					_defHub.Logs:SetEntries(r.Entries, r.Title or defaultTitle)
				end
			end)
		end

		-- // Tab 2: Game Support (Data-driven via GameSupport.lua)
		local gamesTab = tabs:AddInfoTab({
			Name = isRu and "Поддержка игр" or (isEn and "Game Support" or "Game Support"),
			Icon = (guiconfig.HubIcons and (guiconfig.HubIcons.GameSupport or guiconfig.HubIcons.GameSup or guiconfig.HubIcons.Games or guiconfig.HubIcons.gamesup or guiconfig.HubIcons.gamesupport)) or DEFAULT_CONFIG.HubIcons.GameSupport,
			LayoutOrder = 2,
			StartActive = false,
		})
		_defHub.GS = gamesTab

		local supportedSec = gamesTab:AddSection(isRu and "Поддерживаемые игры" or "Game Supported", true)

		if not _gInfo.IsSupported then
			supportedSec:AddSupportedGameCard({
				Name = "Current Game (Unsupported)",
				PlaceId = game.PlaceId,
				Version = "v0.0.0",
				Date = "GameId: " .. tostring(_gInfo.CurrentId),
				Active = false,
				Changelogs = {
					"Dedicated script features are not yet available for this game.",
					"Universe GameId: " .. tostring(_gInfo.CurrentId),
					"You can still use Universal Tools (Anti-AFK, Fly, Server, etc.) in the Advanced tab.",
					"Join our Discord to request official support!",
				},
			})
		end

		if _gInfo.Data and next(_gInfo.Data) then
			for gName, gData in pairs(_gInfo.Data) do
				local isCurrent = (_gInfo.Matched == gData)
					or (gData.GameId == _gInfo.CurrentId)
					or (type(gData.GameId) == "table" and table.find(gData.GameId, _gInfo.CurrentId))

				local cardObj = supportedSec:AddSupportedGameCard({
					Name = gName,
					PlaceId = gData.PlaceId,
					GameId = gData.GameId,
					Folder = gData.Folder,
					Version = gData.Version or "-",
					Date = gData.Date or "-",
					Active = isCurrent,
					Changelogs = gData.Changelogs or { "- - -" },
				})

				if logsSource then
					task.spawn(function()
						local gLogs = resolveUpdateLogs(logsSource, gData.PlaceId, gData.GameId)
						if (not gLogs or not gLogs.Entries) and gData.Folder then
							gLogs = resolveUpdateLogs(logsSource .. gData.Folder .. "/", gData.PlaceId, gData.GameId)
						end
						if gLogs and gLogs.Entries and gLogs.Entries[1] then
							local latest = gLogs.Entries[1]
							cardObj:SetLogs(gLogs.Entries, latest.Version, latest.Date)
						else
							cardObj:SetLogs({ "- - -" }, "-", "-")
						end
					end)
				end
			end
		end

		-- // Tab 3: Discord
		local discordTab = tabs:AddInfoTab({
			Name = "Discord",
			Icon = (guiconfig.HubIcons and (guiconfig.HubIcons.Discord or guiconfig.HubIcons.discord)) or DEFAULT_CONFIG.HubIcons.Discord,
			LayoutOrder = 3,
			StartActive = false,
		})
		_defHub.D = discordTab

		-- // Tab 4: Advanced (Optional, toggleable via guiconfig.Advanced)
		local advTab = nil
		if guiconfig.Advanced ~= false then
			advTab = tabs:AddInfoTab({
				Name = isRu and "Продвинутый" or (isEn and "Advanced" or "Advanced"),
				Icon = (guiconfig.HubIcons and (guiconfig.HubIcons.Advanced or guiconfig.HubIcons.advanced or guiconfig.HubIcons.Adv or guiconfig.HubIcons.adv)) or DEFAULT_CONFIG.HubIcons.Advanced,
				LayoutOrder = 4,
				StartActive = false,
			})
			_defHub.Adv = advTab
		end

		-- // Tab 5: Engine
		local engineTab = tabs:AddInfoTab({
			Name = "Engine",
			Icon = (guiconfig.HubIcons and (guiconfig.HubIcons.Engine or guiconfig.HubIcons.engine)) or DEFAULT_CONFIG.HubIcons.Engine,
			LayoutOrder = 5,
			StartActive = false,
		})
		_defHub.E = engineTab

		local engineSec = engineTab:AddSection("Window & Engine Settings", true)

		engineSec:AddKeybind({
			Title = "Hide / Open Main UI",
			Default = Enum.KeyCode.F3,
			Callback = function(key)
				mainToggleKey = key
				chloex("Main UI Keybind set to: " .. key.Name)
			end,
		})

		engineSec:AddKeybind({
			Title = "Hide / Open Mini UI",
			Default = Enum.KeyCode.F4,
			Callback = function(key)
				miniToggleKey = key
				chloex("Mini UI Keybind set to: " .. key.Name)
			end,
		})

		local styleDropdown = nil
		styleDropdown = engineSec:AddDropdown({
			Title = "Select Open UI",
			Options = { "Overlay", "Square" },
			Default = toggleUIStyle or "Overlay",
			Callback = function(val)
				if setToggleUIStyle then
					setToggleUIStyle(val)
				end
			end,
		})

		engineSec:AddToggle({
			Title = "Enable Mini UI",
			Default = isMiniUIEnabled,
			Callback = function(state)
				isMiniUIEnabled = state
				guiconfig.MiniUI = state
				if setToggleUIMode then
					setToggleUIMode(state)
				end
				if miniHolder then
					miniHolder.Visible = state
					if state and autoDockMini and updateMiniPosition then
						updateMiniPosition(true)
					end
				end
			end,
		})

		-- // Priority Loader: Advanced Hub Module
		if guiconfig.Advanced ~= false and advTab then
			local hubTabs = {
				I = infoTab,
				GS = gamesTab,
				D = discordTab,
				Adv = advTab,
				E = engineTab,
			}

			-- // Direct Remote / Local Loader for Advanced Tab (Non-blocking)
			task.spawn(function()
				pcall(function()
					local advUrl = type(guiconfig.Advanced) == "string" and guiconfig.Advanced or DEFAULT_CONFIG.Advanced
					local content = nil
					pcall(function() content = game:HttpGet(advUrl) end)
					if (not content or content == "" or string.find(content, "404")) then
						if string.find(advUrl, "/Add%-On/Advanced") then
							pcall(function() content = game:HttpGet("https://raw.githubusercontent.com/ChloeRewite/Games/refs/heads/main/Advanced") end)
						elseif string.find(advUrl, "/Advanced$") then
							pcall(function() content = game:HttpGet("https://raw.githubusercontent.com/ChloeRewite/Games/refs/heads/main/Add-On/Advanced.lua") end)
						end
					end

					local fn = nil
					if content and content ~= "" and not string.find(content, "404") then
						local ok, res = pcall(loadstring, content)
						if ok and typeof(res) == "function" then
							fn = res
						end
					end

					-- // Fallback to local dev server if GitHub file is corrupted or failed to load
					if not fn then
						pcall(function()
							local devHost = (getgenv and getgenv().ChloeHost) or "127.0.0.1:8080"
							local localContent = game:HttpGet("http://" .. devHost .. "/Add-On/Advanced.lua")
							if localContent and localContent ~= "" then
								local ok, res = pcall(loadstring, localContent)
								if ok and typeof(res) == "function" then
									fn = res
								end
							end
						end)
					end

					if fn then
						local ok, mod = pcall(fn)
						if ok and typeof(mod) == "function" then
							mod(tabs, hubTabs)
						end
					end
				end)
			end)
		end

		-- // Auto Game Script Execution (if defined in GameSupport)
		if guiconfig.AutoExecute and _gInfo.Matched and _gInfo.Matched.Script and _gInfo.Matched.Script ~= "" then
			task.spawn(function()
				pcall(function()
					local sCode = game:HttpGet(_gInfo.Matched.Script)
					if sCode and sCode ~= "" and not string.find(sCode, "404") then
						loadstring(sCode)()
					end
				end)
			end)
		end
	end

	function tabs:GetHubTabs()
		return {
			I = _defHub.I,
			GS = _defHub.GS,
			D = _defHub.D,
			Adv = _defHub.Adv,
			E = _defHub.E,
		}
	end

	function tabs:LoadHubModule(mod)
		if typeof(mod) == "function" then
			pcall(function()
				mod(tabs, {
					I = _defHub.I,
					GS = _defHub.GS,
					D = _defHub.D,
					Adv = _defHub.Adv,
					E = _defHub.E,
				})
			end)
		end
	end

	function tabs:SetUpdateLogs(newEntries, newTitle)
		if _defHub.Logs and _defHub.Logs.SetEntries then
			return _defHub.Logs:SetEntries(newEntries, newTitle)
		end
	end

	function tabs:SetHubIcon(tabName, iconId)
		if not tabName or not iconId then return end
		local key = string.lower(tostring(tabName))
		guiconfig.HubIcons = guiconfig.HubIcons or {}
		guiconfig.HubIcons[tabName] = iconId
		if scrolltabInfo then
			for _, tabFrame in ipairs(scrolltabInfo:GetChildren()) do
				if tabFrame.Name == "Tab" then
					local tName = tabFrame:FindFirstChild("TabName")
					local match = false
					if tName and string.find(string.lower(tName.Text), key, 1, true) then
						match = true
					end
					if match or string.find(string.lower(tabFrame.Name), key, 1, true) then
						local tIcon = tabFrame:FindFirstChild("TabIcon")
						if tIcon then
							tIcon.Image = formatAsset(iconId)
						end
					end
				end
			end
		end
	end

	function tabs:BuildDefaultInfoTabs(lang)
		if lang then
			guiconfig.Language = lang
		end
		buildDefaultInfoTabs()
	end

	function tabs:SetUpdateLogs(newEntries, newTitle)
		if defaultUpdateLogsObj and defaultUpdateLogsObj.SetEntries then
			return defaultUpdateLogsObj:SetEntries(newEntries, newTitle)
		end
	end

	function tabs:GetUpdateLogs()
		return defaultUpdateLogsObj
	end

	-- // Build default Hub tabs immediately so they are instantly accessible
	if not hasActiveInfoTab and guiconfig.DefaultInfoTabs ~= false then
		buildDefaultInfoTabs()
	end

	if bannerButton then
		bannerButton.Active = true
	end
	if swapIcon then
		swapIcon.Visible = (guiconfig.Type ~= 3)
	end

	task.defer(function()
		if not _gInfo.IsSupported and (sidebarOrder == 0) then
			if setViewMode and currentViewMode ~= "Info" then
				setViewMode("Info")
			end
			task.delay(0.5, function()
				if Chloex.Notify then
					Chloex.Notify(
						"This game is not yet supported. Showing Info Hub & Universal Tools.",
						5,
						Color3.fromRGB(255, 170, 0),
						"Chloe X",
						"GameId: " .. tostring(_gInfo.CurrentId)
					)
				end
			end)
		end
	end)

		if guiconfig.Watermark then
		local wmCfg = (type(guiconfig.Watermark) == "table") and guiconfig.Watermark or {}
		tabs:Watermark(wmCfg)
	end

	tabs.Config = config
	tabs.DestroyGui = function()
		return guifunc:DestroyGui()
	end
	guifunc.Config = config
	guifunc.SetUpdateLogs = function(_, ...)
		return tabs:SetUpdateLogs(...)
	end
	guifunc.GetUpdateLogs = function(_)
		return tabs:GetUpdateLogs()
	end
	if getgenv then
		getgenv().ChloeX_Window = tabs
	end

	task.defer(function()
		if refreshMiniItems then
			refreshMiniItems()
		end
	end)

	task.delay(0.3, function()
		if refreshMiniItems then
			refreshMiniItems()
		end
	end)

	return tabs
end

if getgenv then
	getgenv().ChloeX = Chloex
end

return Chloex
