						optionselecting.TextXAlignment = Enum.TextXAlignment.Left
					else
						dropdowntitle.Position = hasDropSub and UDim2.new(0, 10, 0, 10) or UDim2.new(0, 10, 0, 0)
						dropdowntitle.Size = hasDropSub and UDim2.new(1, -170, 0, 13) or UDim2.new(1, -170, 1, 0)

						optionselecting.AnchorPoint = Vector2.new(1, 0.5)
						optionselecting.Position = UDim2.new(1, -30, 0.5, 0)
						optionselecting.Size = UDim2.new(0, 130, 1, 0)
						optionselecting.TextSize = 10
						optionselecting.TextColor3 = Color3.fromRGB(160, 160, 160)
						optionselecting.TextTransparency = 0.55
						optionselecting.TextXAlignment = Enum.TextXAlignment.Right
