						for _, c in ipairs(chipscroll:GetChildren()) do
							if c.Name == "Chip" then c:Destroy() end
						end
						dropdownfunc.Value = dropdownconfig.Multi and {} or nil
						dropdownfunc.Options = {}
						valLabel.Text = ""
					end

					function dropdownfunc:AddOption(option)
						local label, desc, img, value = parseOption(option)

						local chip = instance.textbutton(chipscroll)
						chip.Name = "Chip"
						chip.AutomaticSize = Enum.AutomaticSize.X
						chip.Size = UDim2.new(0, 0, 0, 26)
						chip.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
						chip.AutoButtonColor = false
						chip.Font = guiconfig.Font
						chip.Text = "  " .. label .. "  "
						chip.TextSize = 11
						chip.TextColor3 = Color3.fromRGB(180, 180, 180)
						instance.uicorner(chip).CornerRadius = UDim.new(0, 6)

						local cstroke = instance.uistroke(chip)
						cstroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
						cstroke.Color = Color3.fromRGB(255, 255, 255)
						cstroke.Thickness = 1
						cstroke.Transparency = 0.88

						chip:SetAttribute("RealValue", value)

						chip.Activated:Connect(function()
							if dropdownconfig.Multi then
								dropdownfunc.Value = type(dropdownfunc.Value) == "table" and dropdownfunc.Value or {}
								if not table.find(dropdownfunc.Value, value) then
									table.insert(dropdownfunc.Value, value)
								else
									for i, v in ipairs(dropdownfunc.Value) do
										if v == value then
											table.remove(dropdownfunc.Value, i)
											break
										end
									end
								end
							else
								dropdownfunc.Value = value
							end
							dropdownfunc:Set(dropdownfunc.Value)
						end)
					end

					function dropdownfunc:Set(value, instant)
						if dropdownconfig.Multi then
							dropdownfunc.Value = type(value) == "table" and value or {}
						else
							dropdownfunc.Value = (type(value) == "table" and value[1]) or value
						end
						config.data[configkey] = dropdownfunc.Value

						local texts = {}
						for _, chip in ipairs(chipscroll:GetChildren()) do
							if chip.Name == "Chip" then
								local v = chip:GetAttribute("RealValue")
								local selected = dropdownconfig.Multi and table.find(dropdownfunc.Value, v) or (dropdownfunc.Value == v)
								local targetBg = selected and guiconfig.Color or Color3.fromRGB(22, 22, 22)
								local targetTextCol = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
								local targetStrokeCol = selected and guiconfig.Color or Color3.fromRGB(255, 255, 255)
								local targetStrokeTrans = selected and 0.3 or 0.88

								local s = chip:FindFirstChildOfClass("UIStroke")
								if instant then
									chip.BackgroundColor3 = targetBg
									chip.TextColor3 = targetTextCol
									if s then
										s.Color = targetStrokeCol
										s.Transparency = targetStrokeTrans
									end
								else
									sv.ts:Create(chip, TweenInfo.new(0.15), {
										BackgroundColor3 = targetBg,
										TextColor3 = targetTextCol
									}):Play()
									if s then
										sv.ts:Create(s, TweenInfo.new(0.15), {
											Color = targetStrokeCol,
											Transparency = targetStrokeTrans
										}):Play()
									end
								end

								if selected then
									local cleanText = (chip.Text:gsub("^%s+", ""):gsub("%s+$", ""))
									table.insert(texts, cleanText)
								end
							end
						end

						valLabel.Text = table.concat(texts, ", ")

						if dropdownconfig.Callback then
							if dropdownconfig.Multi then
								dropdownconfig.Callback(dropdownfunc.Value)
							else
								dropdownconfig.Callback(dropdownfunc.Value ~= nil and tostring(dropdownfunc.Value) or "")
							end
						end
					end

