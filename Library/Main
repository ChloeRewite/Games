eBase64Encode(u)local v={}local w=#u local x=(3-(w%3))%3 local y=u..string.rep('\0',x)for z=1,#y,3 do local A,B,C=string.byte(y,z,z+2)local D=bit32.bor(bit32.lshift(A,16),bit32.lshift(B,8),C)local E=bit32.band(bit32.rshift(D,18),63)+1 local F=bit32.band(bit32.rshift(D,12),63)+1 local G=bit32.band(bit32.rshift(D,6),63)+1 local H=bit32.band(D,63)+1 table.insert(v,s:sub(E,E)..s:sub(F,F)..s:sub(G,G)..s:sub(H,H))end local z=table.concat(v)if x>0 then z=z:sub(1,-x-1)..string.rep('=',x)end return z end local function pureBase64Decode(u)u=string.gsub(u,'[^A-Za-z0-9+/=]','')local v={}local w=#u if w%4~=0 then return nil end local x=0 if u:sub(-2)=='=='then x=2 elseif u:sub(-1)=='='then x=1 end for y=1,w,4 do local z=t[u:sub(y,y)]local A=t[u:sub(y+1,y+1)]local B=t[u:sub(y+2,y+2)]or 0 local C=t[u:sub(y+3,y+3)]or 0 if not z or not A then return nil end local D=bit32.bor(bit32.lshift(z,18),bit32.lshift(A,12),bit32.lshift(B,6),C)local E=bit32.band(bit32.rshift(D,16),255)local F=bit32.band(bit32.rshift(D,8),255)local G=bit32.band(D,255)table.insert(v,string.char(E))if y+2<=w-x then table.insert(v,string.char(F))end if y+3<=w-x then table.insert(v,string.char(G))end end return table.concat(v)end local function encodeBase64(u)if crypt and crypt.base64encode then local v,w=pcall(crypt.base64encode,u)if v and w then return w end elseif syn and syn.crypt and syn.crypt.base64 and syn.crypt.base64.encode then local v,w=pcall(syn.crypt.base64.encode,u)if v and w then return w end elseif base64_encode then local v,w=pcall(base64_encode,u)if v and w then return w end end return pureBase64Encode(u)end local function decodeBase64(u)if crypt and crypt.base64decode then local v,w=pcall(crypt.base64decode,u)if v and w then return w end elseif syn and syn.crypt and syn.crypt.base64 and syn.crypt.base64.decode then local v,w=pcall(syn.crypt.base64.decode,u)if v and w then return w end elseif base64_decode then local v,w=pcall(base64_decode,u)if v and w then return w end end return pureBase64Decode