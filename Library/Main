					local btn2 = instance.textbutton(container)
					btn2.Name = "Button2"
					btn2.Font = Enum.Font.GothamBold
					btn2.Text = tostring(buttonconfig.SubTitle)
					btn2.TextSize = 11
					btn2.TextColor3 = Color3.fromRGB(255, 255, 255)
					btn2.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
					btn2.BackgroundTransparency = 0
					btn2.Size = UDim2.new(0.5, -gap, 1, 0)
					btn2.Position = UDim2.new(0.5, gap, 0, 0)
					btn2.BorderSizePixel = 0
					btn2.AutoButtonColor = false
					btn2.TextTruncate = Enum.TextTruncate.AtEnd
					btn2.ClipsDescendants = true
					instance.uicorner(btn2).CornerRadius = UDim.new(0, 6)
					local p2 = instance.uipadding(btn2)
					p2.PaddingLeft = UDim.new(0, 6)
					p2.PaddingRight = UDim.new(0, 6)

					local s2 = instance.uistroke(btn2)
					s2.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					s2.Color = Color3.fromRGB(255, 255, 255)
					s2.Thickness = 1
					s2.Transparency = 0.88

					btn2.MouseButton1Down:Connect(function()
						pcall(pressEffect, btn2)
					end)
					btn2.Activated:Connect(function()
						pcall(buttonconfig.SubCallback)
					end)

					registerSearchItem(buttonconfig.SubTitle, btn2, "Button")
					buttonObj = container
				else
					local btnSubText = buttonconfig.Title2 or buttonconfig.Content
					local hasBtnSub = btnSubText and tostring(btnSubText) ~= ""

					local mainbutton = instance.textbutton(sectionadd)
					mainbutton.Name = "Button"
					mainbutton.Font = Enum.Font.GothamBold
					mainbutton.Text = hasBtnSub and "" or tostring(buttonconfig.Title)
					mainbutton.TextSize = 12
					mainbutton.TextColor3 = Color3.fromRGB(255, 255, 255)
					mainbutton.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
					mainbutton.BackgroundTransparency = 0
					mainbutton.Size = UDim2.new(1, 0, 0, hasBtnSub and 48 or 36)
					mainbutton.Position = UDim2.new(0, 0, 0, 0)
					mainbutton.LayoutOrder = countitem
					mainbutton.BorderSizePixel = 0
					mainbutton.AutoButtonColor = false
					mainbutton.TextTruncate = Enum.TextTruncate.AtEnd
					mainbutton.ClipsDescendants = true
					instance.uicorner(mainbutton).CornerRadius = UDim.new(0, 6)
					local pMain = instance.uipadding(mainbutton)
					pMain.PaddingLeft = UDim.new(0, 8)
					pMain.PaddingRight = UDim.new(0, 8)

					if hasBtnSub then
						local bTitle = instance.textlabel(mainbutton)
						bTitle.Name = "ButtonTitle"
						bTitle.Font = Enum.Font.GothamBold
						bTitle.Text = tostring(buttonconfig.Title)
						bTitle.TextSize = 12
						bTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
						bTitle.TextXAlignment = Enum.TextXAlignment.Center
						bTitle.BackgroundTransparency = 1
						bTitle.Position = UDim2.new(0, 0, 0, 8)
						bTitle.Size = UDim2.new(1, 0, 0, 14)

						local bSub = instance.textlabel(mainbutton)
						bSub.Name = "ButtonSubTitle"
						bSub.Font = Enum.Font.GothamBold
						bSub.Text = tostring(btnSubText)
						bSub.TextSize = 11
						bSub.TextColor3 = Color3.fromRGB(255, 255, 255)
						bSub.TextTransparency = 0.5
						bSub.TextXAlignment = Enum.TextXAlignment.Center
						bSub.BackgroundTransparency = 1
						bSub.Position = UDim2.new(0, 0, 0, 24)
						bSub.Size = UDim2.new(1, 0, 0, 14)
					end

					local bstroke = instance.uistroke(mainbutton)
