					p1.PaddingLeft = UDim.new(0, 6)
					p1.PaddingRight = UDim.new(0, 6)

					local s1 = instance.uistroke(btn1)
					s1.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					s1.Color = Color3.fromRGB(255, 255, 255)
