					sep.Name = "Separator"
					sep.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
					sep.BackgroundTransparency = 0.92
					sep.BorderSizePixel = 0
					if isDown then
						sep.Position = UDim2.new(0, 10, 0, 57)
						sep.Size = UDim2.new(1, -20, 0, 1)
					else
						sep.Position = UDim2.new(0.5, 0, 0, 8)
						sep.Size = UDim2.new(0, 1, 1, -16)
					end

					local function createInputBox(isSub)
						local iTitle = isSub and inputconfig.SubTitle or inputconfig.Title
						local iPh = isSub and (inputconfig.SubPlaceholder or inputconfig.Placeholder or "Enter...") or (inputconfig.Placeholder or "Enter...")
						local iDef = isSub and (inputconfig.SubDefault or "") or (inputconfig.Default or "")
						local iCb = isSub and (inputconfig.SubCallback or function() end) or (inputconfig.Callback or function() end)

						local cfgKey = makeConfigKey("Input", iTitle)
						local nKey = normalizeConfigKey(cfgKey)
						if config.data[cfgKey] ~= nil then
							iDef = config.data[cfgKey]
						elseif config.data[nKey] ~= nil then
							iDef = config.data[nKey]
						end

						local box = instance.frame(card)
