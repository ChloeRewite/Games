	local searchpanelstroke = instance.uistroke(searchpanel)
	searchpanelstroke.Color = Color3.fromRGB(255, 255, 255)
	searchpanelstroke.Thickness = 1
	searchpanelstroke.Transparency = 0.9

	local resultscroll = instance.scrollingframe(searchpanel)
	resultscroll.Name = "ResultScroll"
	resultscroll.BackgroundTransparency = 1
	resultscroll.BorderSizePixel = 0
	resultscroll.Position = UDim2.new(0, 8, 0, 8)
	resultscroll.Size = UDim2.new(1, -16, 1, -16)
	resultscroll.ScrollBarThickness = 0
	resultscroll.ScrollBarImageTransparency = 1
	resultscroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	resultscroll.ZIndex = 61

	local resultlayout = instance.uilistlayout(resultscroll)
	resultlayout.Padding = UDim.new(0, 5)
	resultlayout.SortOrder = Enum.SortOrder.LayoutOrder

	local resultpad = instance.uipadding(resultscroll)
	resultpad.PaddingLeft = UDim.new(0, 4)
	resultpad.PaddingRight = UDim.new(0, 4)
	resultpad.PaddingTop = UDim.new(0, 3)
	resultpad.PaddingBottom = UDim.new(0, 4)

	local function isPointInside(guiObject, position)
		if not guiObject or not guiObject.Visible then
			return false
		end

		local absolutePosition = guiObject.AbsolutePosition
		local absoluteSize = guiObject.AbsoluteSize

		return
			position.X >= absolutePosition.X
			and position.X <= absolutePosition.X + absoluteSize.X
			and position.Y >= absolutePosition.Y
			and position.Y <= absolutePosition.Y + absoluteSize.Y
	end

	local function closeSearch(clearText)
		searchlayer.Visible = false
		if guiconfig.Type == 3 then
			search.Visible = false
		end
		if sidebarSearchBtn and sbIcon then
			sv.ts:Create(sidebarSearchBtn, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
			sv.ts:Create(sbIcon, TweenInfo.new(0.15), { ImageColor3 = Color3.fromRGB(160, 160, 160), ImageTransparency = 0.2 }):Play()
		end

		if clearText then
			searchinput.Text = ""
		end

		if searchClear then
			searchClear.Visible = (searchinput.Text ~= "")
		end

		if searchinput:IsFocused() then
			searchinput:ReleaseFocus()
		end

		search.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
		searchstroke.Color = Color3.fromRGB(255, 255, 255)
		searchstroke.Transparency = 0.88
		searchicon.ImageTransparency = 0.2
	end

	setViewMode = function(mode)
		if mode ~= "Main" and mode ~= "Info" then
			return
		end
		if closeSearch then
			closeSearch(true)
		end
		currentViewMode = mode

		if mode == "Info" then
			scrolltab.Visible = false
			scrolltabInfo.Visible = true

			sv.ts:Create(swapIcon, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Rotation = 0,
				ImageTransparency = 0,
				ImageColor3 = guiconfig.Color,
			}):Play()

			if activeInfoPage then
				local prevTime = layerspagelayout.TweenTime
				layerspagelayout.TweenTime = 0
				layerspagelayout:JumpTo(activeInfoPage)
				task.defer(function()
					layerspagelayout.TweenTime = prevTime
				end)
				if activeInfoRunOnOpen then
					pcall(activeInfoRunOnOpen)
				end
			end
		else
			scrolltabInfo.Visible = false
			scrolltab.Visible = true

			sv.ts:Create(swapIcon, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Rotation = 0,
				ImageTransparency = 0.55,
				ImageColor3 = Color3.fromRGB(160, 160, 160),
			}):Play()

			if activeMainPage then
				local prevTime = layerspagelayout.TweenTime
				layerspagelayout.TweenTime = 0
				layerspagelayout:JumpTo(activeMainPage)
				task.defer(function()
					layerspagelayout.TweenTime = prevTime
				end)
				if activeMainRunOnOpen then
					pcall(activeMainRunOnOpen)
				end
			end
		end
	end

	local viewModeDebounce = false
	toggleViewMode = function()
		if viewModeDebounce then return end
		viewModeDebounce = true
		task.delay(0.2, function()
			viewModeDebounce = false
		end)
		if currentViewMode == "Main" then
			setViewMode("Info")
		else
			setViewMode("Main")
		end
	end

	guifunc.SetViewMode = setViewMode
	guifunc.ToggleViewMode = toggleViewMode
	if getgenv then
		getgenv().ChloeX_SetViewMode = setViewMode
		getgenv().ChloeX_ToggleViewMode = toggleViewMode
	end

	local function refreshSearch()
		for _, v in ipairs(resultscroll:GetChildren()) do
			if not v:IsA("UIListLayout") and not v:IsA("UIPadding") then
				v:Destroy()
			end
		end

		local lang = string.lower(guiconfig.Language or "en")
		local isRu = (lang == "ru")
		local isId = (lang == "id")

		local keyword = string.lower(searchinput.Text or "")
		if keyword == "" then
			local hint = instance.textlabel(resultscroll)
			hint.Name = "SearchHint"
			hint.Text = isRu and "Введите текст для поиска..."
				or (isId and "Ketik sesuatu untuk mencari fitur..." or "Type to search features...")
			hint.Font = guiconfig.Font
			hint.TextSize = 12
			hint.TextColor3 = Color3.fromRGB(130, 130, 130)
			hint.BackgroundTransparency = 1
			hint.Size = UDim2.new(1, 0, 1, 0)
			hint.TextXAlignment = Enum.TextXAlignment.Center
			hint.TextYAlignment = Enum.TextYAlignment.Center
			hint.ZIndex = 62
			resultscroll.CanvasSize = UDim2.new(0, 0, 0, 0)
			return
		end

		local matchCount = 0
		local sectionsOrder = {}
		local sectionsMap = {}

		for _, data in ipairs(searchItems) do
			local nameMatch = string.find(string.lower(data.Name), keyword, 1, true)
			local pathMatch = string.find(string.lower(data.Path or ""), keyword, 1, true)
			local optMatch = nil
			if not nameMatch and data.Options and type(data.Options) == "table" then
				for _, opt in ipairs(data.Options) do
					local optStr = type(opt) == "table" and (opt.Label or opt.Title or opt.Value) or tostring(opt)
					if string.find(string.lower(optStr), keyword, 1, true) then
						optMatch = optStr
						break
					end
				end
			end

			if nameMatch or pathMatch or optMatch then
				matchCount = matchCount + 1
				local secGroup = data.TabSection or "General"
				if not sectionsMap[secGroup] then
					sectionsMap[secGroup] = {}
					table.insert(sectionsOrder, secGroup)
				end
				table.insert(sectionsMap[secGroup], {
					data = data,
					optMatch = optMatch,
				})
			end
		end

		local layoutOrder = 0

		for _, secGroup in ipairs(sectionsOrder) do
			local groupItems = sectionsMap[secGroup]

			-- Section Header Separator (Clean, no arrow, no "-- Section Tabs")
			layoutOrder = layoutOrder + 1
			local secHeader = instance.frame(resultscroll)
			secHeader.Name = "CategoryHeader - " .. secGroup
			secHeader.BackgroundTransparency = 1
			secHeader.BorderSizePixel = 0
			secHeader.Size = UDim2.new(1, 0, 0, 22)
			secHeader.LayoutOrder = layoutOrder
			secHeader.ZIndex = 62

			local secTitle = instance.textlabel(secHeader)
			secTitle.Name = "CategoryTitle"
			secTitle.Text = secGroup
			secTitle.Font = guiconfig.Font
			secTitle.TextSize = 11
			secTitle.TextColor3 = guiconfig.Color
			secTitle.TextXAlignment = Enum.TextXAlignment.Left
			secTitle.BackgroundTransparency = 1
			secTitle.Position = UDim2.new(0, 2, 0.5, 0)
			secTitle.AnchorPoint = Vector2.new(0, 0.5)
			secTitle.Size = UDim2.new(1, -4, 1, 0)
			secTitle.ZIndex = 63

			for _, itemInfo in ipairs(groupItems) do
				local data = itemInfo.data
				local optMatch = itemInfo.optMatch

				layoutOrder = layoutOrder + 1
				local item = instance.textbutton(resultscroll)
				item.Name = "SearchResult - " .. data.Name
				item.Text = ""
				item.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
				item.BackgroundTransparency = 0
				item.BorderSizePixel = 0
				item.Size = UDim2.new(1, 0, 0, 42)
				item.LayoutOrder = layoutOrder
				item.ZIndex = 62
				item.ClipsDescendants = false

				instance.uicorner(item).CornerRadius = UDim.new(0, 6)

				local itemstroke = instance.uistroke(item)
				itemstroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				itemstroke.Color = Color3.fromRGB(255, 255, 255)
				itemstroke.Thickness = 1
				itemstroke.Transparency = 0.85

				local indicator = instance.frame(item)
				indicator.Name = "Indicator"
				indicator.BackgroundColor3 = guiconfig.Color
				indicator.BorderSizePixel = 0
				indicator.Size = UDim2.new(0, 3, 0, 24)
				indicator.Position = UDim2.new(0, 0, 0.5, 0)
				indicator.AnchorPoint = Vector2.new(0, 0.5)
				indicator.BackgroundTransparency = 1
				indicator.ZIndex = 63

				local title = instance.textlabel(item)
				title.Name = "Title"
				title.Text = data.Name
				title.Font = guiconfig.Font
				title.TextSize = 12
				title.TextColor3 = Color3.fromRGB(240, 240, 240)
				title.TextXAlignment = Enum.TextXAlignment.Left
				title.TextTruncate = Enum.TextTruncate.AtEnd
				title.BackgroundTransparency = 1
				title.Position = UDim2.new(0, 12, 0, 5)
				title.Size = UDim2.new(1, -20, 0, 15)
				title.ZIndex = 63

				local baseClean = data.CleanPath or (data.TabName .. " / " .. (data.SectionName or ""))
				local pathText = baseClean .. " / " .. data.Name
				if optMatch then
					pathText = pathText .. " • Cocok: '" .. optMatch .. "'"
				end

				local path = instance.textlabel(item)
				path.Name = "Path"
				path.Text = pathText
				path.Font = guiconfig.Font
				path.TextSize = 10
				path.TextColor3 = Color3.fromRGB(130, 130, 130)
				path.TextXAlignment = Enum.TextXAlignment.Left
				path.TextTruncate = Enum.TextTruncate.AtEnd
				path.BackgroundTransparency = 1
				path.Position = UDim2.new(0, 12, 0, 22)
				path.Size = UDim2.new(1, -20, 0, 14)
				path.ZIndex = 63

				item.MouseEnter:Connect(function()
					item.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
					itemstroke.Color = Color3.fromRGB(255, 255, 255)
					itemstroke.Transparency = 0.72
					indicator.BackgroundTransparency = 0
				end)

				item.MouseLeave:Connect(function()
					item.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
					itemstroke.Color = Color3.fromRGB(255, 255, 255)
					itemstroke.Transparency = 0.85
					indicator.BackgroundTransparency = 1
				end)

				item.Activated:Connect(function()
					closeSearch(true)

					if data.IsInfoTab then
						setViewMode("Info")
					else
						setViewMode("Main")
					end

					local prevTime = layerspagelayout.TweenTime
					layerspagelayout.TweenTime = 0
					layerspagelayout:JumpTo(data.Page)
					task.defer(function()
						layerspagelayout.TweenTime = prevTime
					end)

					if data.Tab then
						local targetScroll = data.IsInfoTab and scrolltabInfo or scrolltab
						for _, tabframe in ipairs(targetScroll:GetChildren()) do
							if tabframe.Name == "Tab" then
								local cf = tabframe:FindFirstChild("ChooseFrame")
								if cf then
									cf.Parent = data.Tab
									if guiconfig.Type == 3 then
										cf.AnchorPoint = Vector2.new(0, 0.5)
										cf.Position = UDim2.new(0, 0, 0.5, 0)
										cf.Size = UDim2.new(0, 2.5, 0, 16)
									else
										cf.Position = UDim2.new(0, 2, 0, 9)
										cf.Size = UDim2.new(0, 1, 0, 12)
									end
								end
								if guiconfig.Type == 3 then
									tabframe.BackgroundTransparency = 1
									local icon = tabframe:FindFirstChild("TabIcon")
									if icon then
										icon.ImageColor3 = Color3.fromRGB(160, 160, 160)
										icon.ImageTransparency = 0.35
									end
								else
									tabframe.BackgroundTransparency = 0.999
								end
							end
						end
						if guiconfig.Type == 3 then
							data.Tab.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
							data.Tab.BackgroundTransparency = 0
							local icon = data.Tab:FindFirstChild("TabIcon")
							if icon then
								icon.ImageColor3 = guiconfig.Color
								icon.ImageTransparency = 0
							end
						else
							data.Tab.BackgroundTransparency = 0.92
						end
						if data.IsInfoTab then
							activeInfoTab = data.Tab
							activeInfoPage = data.Page
						else
							activeMainTab = data.Tab
							activeMainPage = data.Page
						end
					end

					if data.OpenSection then
						data.OpenSection()
					end

					task.wait(0.12)

					if data.Page and data.Object then
						local y = data.Object.AbsolutePosition.Y
							- data.Page.AbsolutePosition.Y
							+ data.Page.CanvasPosition.Y
							- 16
						sv.ts:Create(data.Page, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							CanvasPosition = Vector2.new(0, math.max(0, y))
						}):Play()

						local s = data.Object:FindFirstChildOfClass("UIStroke")
						if s then
							local oldColor = s.Color
							local oldTrans = s.Transparency
							sv.ts:Create(s, TweenInfo.new(0.2), { Color = guiconfig.Color, Transparency = 0.1 }):Play()
							task.delay(1.2, function()
								sv.ts:Create(s, TweenInfo.new(0.4), { Color = oldColor, Transparency = oldTrans }):Play()
							end)
						end
					end
				end)
			end
		end

		if matchCount == 0 then
			local empty = instance.textlabel(resultscroll)
			empty.Name = "SearchEmpty"
			empty.Text = isRu and ("Ничего не найдено для '" .. keyword .. "'")
				or (isId and ("Tidak ditemukan fitur untuk '" .. keyword .. "'") or ("No features found for '" .. keyword .. "'"))
			empty.Font = guiconfig.Font
			empty.TextSize = 12
			empty.TextColor3 = Color3.fromRGB(140, 140, 140)
			empty.BackgroundTransparency = 1
			empty.Size = UDim2.new(1, 0, 1, 0)
			empty.TextXAlignment = Enum.TextXAlignment.Center
			empty.TextYAlignment = Enum.TextYAlignment.Center
			empty.ZIndex = 62
		end

		task.wait()
		resultscroll.CanvasSize = UDim2.new(0, 0, 0, resultlayout.AbsoluteContentSize.Y + 10)
	end

	searchinput:GetPropertyChangedSignal("Text"):Connect(function()
		local hasText = (searchinput.Text ~= "")
		if searchClear then
			searchClear.Visible = hasText
		end
		if hasText then
			searchlayer.Visible = true
		end
		refreshSearch()
	end)

	searchinput.Focused:Connect(function()
		searchlayer.Visible = true
		if sidebarSearchBtn and sbIcon then
			sv.ts:Create(sidebarSearchBtn, TweenInfo.new(0.15), { BackgroundTransparency = 0 }):Play()
			sv.ts:Create(sbIcon, TweenInfo.new(0.15), { ImageColor3 = guiconfig.Color, ImageTransparency = 0 }):Play()
		end
		search.BackgroundColor3 = Color3.fromRGB(26, 26, 26)
		searchstroke.Color = guiconfig.Color
		searchstroke.Transparency = 0.4
		searchicon.ImageTransparency = 0.05
		refreshSearch()
	end)

	searchinput.FocusLost:Connect(function()
		search.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
		searchstroke.Color = Color3.fromRGB(255, 255, 255)
		searchstroke.Transparency = 0.88
		searchicon.ImageTransparency = 0.2
	end)

	if sidebarSearchBtn then
		sidebarSearchBtn.MouseEnter:Connect(function()
			if not searchlayer.Visible then
				sv.ts:Create(sidebarSearchBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0.5 }):Play()
				sv.ts:Create(sbIcon, TweenInfo.new(0.12), { ImageColor3 = Color3.fromRGB(240, 240, 240), ImageTransparency = 0 }):Play()
			end
			if sidebarTooltip then
				local tText = sidebarTooltip:FindFirstChild("TooltipText")
				if tText then tText.Text = "Search" end
				sidebarTooltip.Position = UDim2.new(0, tabWidth + 6, 0, sidebarSearchBtn.AbsolutePosition.Y - main.AbsolutePosition.Y + (sidebarSearchBtn.AbsoluteSize.Y - 22) / 2)
				sidebarTooltip.Visible = true
			end
		end)

		sidebarSearchBtn.MouseLeave:Connect(function()
			if not searchlayer.Visible then
				sv.ts:Create(sidebarSearchBtn, TweenInfo.new(0.12), { BackgroundTransparency = 1 }):Play()
				sv.ts:Create(sbIcon, TweenInfo.new(0.12), { ImageColor3 = Color3.fromRGB(160, 160, 160), ImageTransparency = 0.2 }):Play()
			end
			if sidebarTooltip then
				sidebarTooltip.Visible = false
			end
		end)

		sidebarSearchBtn.Activated:Connect(function()
			if sidebarTooltip then
				sidebarTooltip.Visible = false
			end
			if searchlayer.Visible then
				closeSearch(true)
			else
				if guiconfig.Type == 3 then
					search.Visible = true
				end
				searchlayer.Visible = true
				searchinput:CaptureFocus()
				sv.ts:Create(sidebarSearchBtn, TweenInfo.new(0.15), { BackgroundTransparency = 0 }):Play()
				sv.ts:Create(sbIcon, TweenInfo.new(0.15), { ImageColor3 = guiconfig.Color, ImageTransparency = 0 }):Play()
				refreshSearch()
			end
		end)
	end

	trackConnection(sv.uis.InputBegan:Connect(function(input, gpe)
		if not searchlayer.Visible then
			return
		end

		if
			input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		if isPointInside(search, input.Position) or isPointInside(searchpanel, input.Position) or (sidebarSearchBtn and isPointInside(sidebarSearchBtn, input.Position)) then
			return
		end

		closeSearch(true)
	end), "global.search.outsideClick")

	-- // Universal Update Logs Resolver (GitHub API directory, JSON/Lua files, or Local Table)
	local function resolveUpdateLogs(rawLogs, targetPlaceId, targetGameId)
		if not rawLogs then
			return nil
		end

		if type(rawLogs) == "function" then
			local ok, res = pcall(rawLogs)
			if ok then
				rawLogs = res
			end
		end

		local placeId = targetPlaceId and tostring(targetPlaceId)
		local gameId = targetGameId and tostring(targetGameId)

		if not placeId and gameId then
			if tonumber(gameId) == game.GameId then
				placeId = tostring(game.PlaceId)
			else
				pcall(function()
					local uRes = game:HttpGet("https://games.roblox.com/v1/games?universeIds=" .. gameId)
					if uRes and uRes ~= "" then
						local uData = sv.http:JSONDecode(uRes)
						if uData and uData.data and uData.data[1] and uData.data[1].rootPlaceId then
							placeId = tostring(uData.data[1].rootPlaceId)
						end
					end
				end)
			end
		end

		placeId = placeId or tostring(game.PlaceId)
		gameId = gameId or tostring(game.GameId)

		-- // Remote URL loader (directory per game, template {placeid}, or single file)
		if type(rawLogs) == "string" and (string.find(rawLogs, "^https?://") or string.find(rawLogs, "^[%w_%-]+/[%w_%-]+")) then
			local function tryFetchRaw(targetUrl)
				local s, res = pcall(function()
					return game:HttpGet(targetUrl)
				end)
				if s and type(res) == "string" and res ~= "" and not string.find(res, "404: Not Found") and not string.find(res, "^404") then
					return res
				end
				return nil
			end

			local function tryFetch(targetUrl)
				local res = tryFetchRaw(targetUrl)
				if res then
					local jOk, decoded = pcall(function()
						return sv.http:JSONDecode(res)
					end)
					if jOk and type(decoded) == "table" then
						return decoded
					end
					local lOk, lFunc = pcall(loadstring, res)
					if lOk and type(lFunc) == "function" then
						local rOk, rData = pcall(lFunc)
						if rOk and type(rData) == "table" then
							return rData
						end
					end
				end
				return nil
			end

			-- // Natural semantic version comparator (latest version first)
			local function compareVersions(a, b)
				local na, nb = {}, {}
				for n in string.gmatch(a, "%d+") do
					table.insert(na, tonumber(n))
				end
				for n in string.gmatch(b, "%d+") do
					table.insert(nb, tonumber(n))
				end
				local maxLen = math.max(#na, #nb)
				for i = 1, maxLen do
					local va = na[i] or 0
					local vb = nb[i] or 0
					if va ~= vb then
						return va > vb
					end
				end
				return a > b
			end

			-- // Parser for individual version files (supports JSON, Lua table, or raw text)
			local function parseVersionFile(rawText, filename)
				local baseVersion = filename
				local ext = string.match(filename, "%.([a-zA-Z]+)$")
				if ext then
					baseVersion = string.gsub(filename, "%." .. ext .. "$", "")
				end
				if not string.find(baseVersion, "^[vV]") then
					baseVersion = "v" .. baseVersion
				end

				local jOk, jData = pcall(function()
					return sv.http:JSONDecode(rawText)
				end)
				if jOk and type(jData) == "table" then
					if jData[1] and type(jData[1]) == "string" then
						return {
							Version = jData.Version or baseVersion,
							Date = jData.Date or os.date("%d %b %Y"),
							Logs = jData,
						}
					else
						return {
							Version = jData.Version or baseVersion,
							Date = jData.Date or os.date("%d %b %Y"),
							Logs = jData.Logs or {},
						}
					end
				end

				local lOk, lFunc = pcall(loadstring, rawText)
				if lOk and type(lFunc) == "function" then
					local rOk, rData = pcall(lFunc)
					if rOk and type(rData) == "table" then
						return {
							Version = rData.Version or baseVersion,
							Date = rData.Date or os.date("%d %b %Y"),
							Logs = rData.Logs or (rData[1] and rData) or {},
						}
					end
				end

				local lines = {}
				local dateFound = nil
				for line in string.gmatch(rawText, "[^\r\n]+") do
					local trimmed = string.match(line, "^%s*(.-)%s*$")
					if trimmed ~= "" then
						local d = string.match(trimmed, "^%[([^%]]+)%]")
						if d and not dateFound then
							dateFound = d
						else
							local cleanLine = string.gsub(trimmed, "^[%-%*•]%s*", "")
							table.insert(lines, cleanLine)
						end
					end
				end

				if #lines > 0 then
					return {
						Version = baseVersion,
						Date = dateFound or os.date("%d %b %Y"),
						Logs = lines,
					}
				end

				return nil
			end

			-- // Check if GitHub repo folder to fetch files via GitHub API (e.g. changelogs/<gameid>/v0.0.1)
			local function tryGitHubDirectory(urlStr)
				local o, r, b, p = string.match(urlStr, "raw%.githubusercontent%.com/([^/]+)/([^/]+)/refs/heads/([^/]+)/?(.*)")
				if not o then
					o, r, b, p = string.match(urlStr, "raw%.githubusercontent%.com/([^/]+)/([^/]+)/([^/]+)/?(.*)")
				end
				if not o then
					o, r, b, p = string.match(urlStr, "github%.com/([^/]+)/([^/]+)/tree/([^/]+)/?(.*)")
				end
				if not o then
					local o3, r3, p3 = string.match(urlStr, "^([^/]+)/([^/]+)/?(.*)")
					if o3 and r3 and not string.find(urlStr, "://") then
						o, r, b, p = o3, r3, "main", p3
					end
				end

				if not o or not r then
					return nil
				end

				b = b or "main"
				p = (p or "changelogs"):gsub("/+$", "")

				local folderPaths = {}
				if p ~= "" then
					table.insert(folderPaths, p)
					table.insert(folderPaths, p .. "/" .. placeId)
					table.insert(folderPaths, p .. "/" .. gameId)
					table.insert(folderPaths, p .. "/default")
					table.insert(folderPaths, p .. "/Default")
				else
					table.insert(folderPaths, "Changelogs/" .. placeId)
					table.insert(folderPaths, "changelogs/" .. placeId)
					table.insert(folderPaths, "Changelogs/" .. gameId)
					table.insert(folderPaths, "changelogs/" .. gameId)
					table.insert(folderPaths, placeId)
					table.insert(folderPaths, gameId)
					table.insert(folderPaths, "Changelogs/default")
					table.insert(folderPaths, "changelogs/default")
				end

				for _, targetPath in ipairs(folderPaths) do
					local fileList = {}
					local seenFiles = {}

					-- // Method 1: Web tree scraper (Zero rate limits, executor safe)
					local treeUrl = string.format("https://github.com/%s/%s/tree/%s/%s", o, r, b, targetPath)
					local treeHtml = tryFetchRaw(treeUrl)
					if treeHtml and type(treeHtml) == "string" and string.find(treeHtml, "blob/") then
						for fn in string.gmatch(treeHtml, '/blob/[^"]+/([%w%._%-]+%.[jJ][sS][oO][nN])') do
							if not seenFiles[fn] then
								seenFiles[fn] = true
								local rawDownUrl = string.format("https://raw.githubusercontent.com/%s/%s/refs/heads/%s/%s/%s", o, r, b, targetPath, fn)
								table.insert(fileList, { name = fn, download_url = rawDownUrl })
							end
						end
					end

					-- // Method 2: REST API fallback if web tree had no files
					if #fileList == 0 then
						local apiUrl = string.format("https://api.github.com/repos/%s/%s/contents/%s", o, r, targetPath)
						local res = tryFetch(apiUrl)
						if type(res) == "table" and res[1] and res[1].name then
							for _, item in ipairs(res) do
								if item.type == "file" and item.download_url then
									table.insert(fileList, item)
								end
							end
						end
					end

					if #fileList > 0 then
						table.sort(fileList, function(x, y)
							return compareVersions(x.name, y.name)
						end)

						local entries = {}
						for _, fileItem in ipairs(fileList) do
							local fileRaw = nil
							pcall(function()
								fileRaw = game:HttpGet(fileItem.download_url)
							end)
							if fileRaw and fileRaw ~= "" then
								local entry = parseVersionFile(fileRaw, fileItem.name)
								if entry then
									table.insert(entries, entry)
								end
							end
						end

						if #entries > 0 then
							return {
								Title = "Update Logs",
								Entries = entries,
							}
						end
					end
				end

				return nil
			end

			-- // 1. Try GitHub Directory (changelogs/<gameid>/v0.0.1)
			local dirLogs = tryGitHubDirectory(rawLogs)
			if dirLogs then
				rawLogs = dirLogs
			else
				local lowerUrl = string.lower(rawLogs)
				if string.find(lowerUrl, "{placeid}") or string.find(lowerUrl, "{gameid}") then
					local resolvedUrl = string.gsub(rawLogs, "{[Pp][Ll][Aa][Cc][Ee][Ii][Dd]}", placeId)
					resolvedUrl = string.gsub(resolvedUrl, "{[Gg][Aa][Mm][Ee][Ii][Dd]}", gameId)
					local data = tryFetch(resolvedUrl)
					if not data then
						local defUrl = string.gsub(rawLogs, "{[Pp][Ll][Aa][Cc][Ee][Ii][Dd]}", "default")
						defUrl = string.gsub(defUrl, "{[Gg][Aa][Mm][Ee][Ii][Dd]}", "default")
						data = tryFetch(defUrl)
					end
					if data then
						rawLogs = data
					end
				elseif string.sub(rawLogs, -1) == "/" or (not string.find(lowerUrl, "%.json$") and not string.find(lowerUrl, "%.lua$")) then
					local baseUrl = rawLogs
					if string.sub(baseUrl, -1) ~= "/" then
						baseUrl = baseUrl .. "/"
					end
					local candidates = {
						baseUrl .. placeId .. ".json",
						baseUrl .. placeId .. ".lua",
						baseUrl .. gameId .. ".json",
						baseUrl .. gameId .. ".lua",
						baseUrl .. "default.json",
						baseUrl .. "default.lua",
						baseUrl .. "Default.json",
						baseUrl .. "Default.lua",
					}
					for _, candUrl in ipairs(candidates) do
						local data = tryFetch(candUrl)
						if data then
							rawLogs = data
							break
						end
					end
				else
					local data = tryFetch(rawLogs)
					if data then
						rawLogs = data
					end
				end
			end
		end

		if type(rawLogs) ~= "table" then
			return nil
		end

		-- // Direct array of entries
		if rawLogs[1] and type(rawLogs[1]) == "table" and (rawLogs[1].Version or rawLogs[1].Logs) then
			return {
				Title = nil,
				Entries = rawLogs,
			}
		end

		-- // Object with Entries table
		if rawLogs.Entries and type(rawLogs.Entries) == "table" then
			return {
				Title = rawLogs.Title,
				Entries = rawLogs.Entries,
			}
		end

		-- // Match PlaceId or GameId or Default fallback
		local matched = rawLogs[tonumber(placeId)]
			or rawLogs[placeId]
			or rawLogs[tonumber(gameId)]
			or rawLogs[gameId]
			or rawLogs.Default
			or rawLogs.default
			or rawLogs.fallback

		if matched then
			if matched[1] and type(matched[1]) == "table" then
				return {
					Title = matched.Title,
					Entries = matched,
				}
			elseif matched.Entries and type(matched.Entries) == "table" then
				return {
					Title = matched.Title,
					Entries = matched.Entries,
				}
			elseif matched.Logs and type(matched.Logs) == "table" then
				return {
					Title = matched.Title,
					Entries = { matched },
				}
			elseif matched[1] and type(matched[1]) == "string" then
				return {
					Title = matched.Title,
					Entries = {
						{
							Version = matched.Version or "Latest",
							Date = matched.Date or os.date("%d %b %Y"),
							Logs = matched,
						},
					},
				}
			end
		end

		return nil
	end

	local function resolveTabIcon(tabconfig)
		if tabconfig and tabconfig.Icon then
			return formatAsset(tabconfig.Icon)
		end
		local lower = string.lower(tostring(tabconfig and tabconfig.Name or ""))
		local hi = guiconfig and guiconfig.HubIcons
		if lower:find("info") or lower:find("informasi") or lower:find("информац") then
			return formatAsset((hi and (hi.Information or hi.Info or hi.information or hi.info)) or DEFAULT_CONFIG.HubIcons.Information)
		elseif (tabconfig and tabconfig.InfoTab) and (lower:find("game") or lower:find("support") or lower:find("поддержк")) then
			return formatAsset((hi and (hi.GameSupport or hi.GameSup or hi.Games or hi.gamesup or hi.gamesupport)) or DEFAULT_CONFIG.HubIcons.GameSupport)
		elseif lower:find("discord") then
			return formatAsset((hi and (hi.Discord or hi.discord)) or DEFAULT_CONFIG.HubIcons.Discord)
		elseif lower:find("adv") or lower:find("продвинут") then
			return formatAsset((hi and (hi.Advanced or hi.advanced or hi.Adv or hi.adv)) or DEFAULT_CONFIG.HubIcons.Advanced)
		elseif lower:find("engine") then
			return formatAsset((hi and (hi.Engine or hi.engine)) or DEFAULT_CONFIG.HubIcons.Engine)
		elseif lower:find("conf") or lower:find("sett") then
			return formatAsset((hi and (hi.Config or hi.config or hi.Settings or hi.settings)) or DEFAULT_CONFIG.HubIcons.Config)
		elseif lower:find("drop") or lower:find("weapon") or lower:find("combat") then
			return "rbxassetid://10723415903"
		elseif lower:find("tog") or lower:find("slid") or lower:find("move") or lower:find("speed") or lower:find("player") then
			return "rbxassetid://10747373176"
		elseif lower:find("btn") or lower:find("button") or lower:find("key") then
			return "rbxassetid://10734896206"
		elseif lower:find("inp") or lower:find("input") or lower:find("color") or lower:find("vis") or lower:find("esp") then
			return "rbxassetid://10709790948"
		elseif lower:find("body") or lower:find("hitbox") or lower:find("aim") or lower:find("target") then
			return "rbxassetid://10709791437"
		elseif lower:find("card") or lower:find("game") or lower:find("layout") then
			return "rbxassetid://10723345518"
		elseif lower:find("main") or lower:find("home") then
			return "rbxassetid://10723345207"
		end
		return "rbxassetid://10709769841"
	end

	function tabs:AddTab(tabconfig)
		tabconfig = tabconfig or {}
		tabconfig.Name = tabconfig.Name or "Tab"
		local isInfo = (tabconfig.InfoTab == true)

		local targetScroll = isInfo and scrolltabInfo or scrolltab
		local targetSections = isInfo and tabSectionsInfo or tabSections
		local targetLayout = isInfo and uilistlayoutInfo or uilistlayout

		local sectionName = tabconfig.Section
		if guiconfig.Type ~= 3 and sectionName and type(sectionName) == "string" and sectionName:match("%S") then
			local secKey = string.lower(sectionName)
			if not targetSections[secKey] then
				if isInfo then
					sidebarInfoOrder = sidebarInfoOrder + 1
				else
					sidebarOrder = sidebarOrder + 1
				end
				local orderNum = isInfo and sidebarInfoOrder or sidebarOrder
				local secHeader = instance.frame(targetScroll)
				secHeader.Name = "TabSection"
				secHeader.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				secHeader.BackgroundTransparency = 1
				secHeader.BorderSizePixel = 0
				secHeader.LayoutOrder = (tonumber(tabconfig.LayoutOrder) and (tabconfig.LayoutOrder * 10 - 1)) or orderNum
				secHeader.Size = UDim2.new(1, -20, 0, 28)

				local secLabel = instance.textlabel(secHeader)
				secLabel.Name = "SectionLabel"
				secLabel.Font = Enum.Font.GothamBold
				secLabel.Text = tostring(sectionName)
				secLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
				secLabel.TextSize = 13
				secLabel.TextTransparency = 0.3
				secLabel.TextXAlignment = Enum.TextXAlignment.Left
				secLabel.AnchorPoint = Vector2.new(0, 1)
				secLabel.Position = UDim2.new(0, 10, 1, -4)
				secLabel.Size = UDim2.new(1, -34, 0, 16)
				secLabel.BackgroundTransparency = 1
				secLabel.BorderSizePixel = 0

				local secArrow = instance.imagelabel(secHeader)
				secArrow.Name = "SectionArrow"
				secArrow.Image = "rbxassetid://16851841101"
				secArrow.ImageColor3 = Color3.fromRGB(180, 180, 180)
				secArrow.AnchorPoint = Vector2.new(1, 0.5)
				secArrow.BackgroundTransparency = 1
				secArrow.Position = UDim2.new(1, -4, 0.5, 2)
				secArrow.Size = UDim2.new(0, 16, 0, 16)
				secArrow.Rotation = 0

				local secBtn = instance.textbutton(secHeader)
				secBtn.Name = "SectionBtn"
				secBtn.Size = UDim2.new(1, 0, 1, 0)
				secBtn.BackgroundTransparency = 1
				secBtn.Text = ""

				local secData = {
					header = secHeader,
					arrow = secArrow,
					tabs = {},
					open = true,
				}

				secBtn.Activated:Connect(function()
					secData.open = not secData.open
					local rot = secData.open and 0 or -90
					sv.ts:Create(secArrow, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Rotation = rot
					}):Play()
					for _, t in ipairs(secData.tabs) do
						t.Visible = secData.open
					end
					task.defer(function()
						targetScroll.CanvasSize = UDim2.new(0, 0, 0, targetLayout.AbsoluteContentSize.Y)
					end)
				end)

				targetSections[secKey] = secData
			end
		end

		if isInfo then
			sidebarInfoOrder = sidebarInfoOrder + 1
		else
			sidebarOrder = sidebarOrder + 1
		end
		local tabIndex = isInfo and sidebarInfoOrder or sidebarOrder
		local layoutOrder = (tonumber(tabconfig.LayoutOrder) and (tabconfig.LayoutOrder * 10)) or tabIndex

		local isFirstInMode = false
		if isInfo then
			if not hasActiveInfoTab and tabconfig.StartActive ~= false then
				hasActiveInfoTab = true
				isFirstInMode = true
			end
		else
			if not hasActiveTab and tabconfig.StartActive ~= false then
				hasActiveTab = true
				isFirstInMode = true
			end
		end

		-- // Dual-column exclusion filter for Information, Game Support, Discord, and Config
		local isDualColumn = false
		local tabNameLower = string.lower(tostring(tabconfig and tabconfig.Name or ""))
		local isExcluded = (
			tabNameLower:find("info") ~= nil
			or tabNameLower:find("game support") ~= nil
			or tabNameLower:find("gamesupport") ~= nil
			or tabNameLower:find("поддержка") ~= nil
			or tabNameLower:find("discord") ~= nil
			or tabNameLower:find("config") ~= nil
		)

		if isMobile then
			isDualColumn = false
		elseif tabconfig and tabconfig.Type ~= nil then
			isDualColumn = (tonumber(tabconfig.Type) == 2 or tonumber(tabconfig.Type) == 3)
		else
			isDualColumn = (guiconfig.Type == 2 or guiconfig.Type == 3) and (not isExcluded)
		end

		local scrollayers = instance.scrollingframe(layersfolder)
		scrollayers.Name = "ScrolLayers"
		scrollayers.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 80)
		scrollayers.ScrollBarThickness = 0
		scrollayers.Active = true
		scrollayers.LayoutOrder = layoutOrder
		scrollayers.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		scrollayers.BackgroundTransparency = 0.999
		scrollayers.BorderColor3 = Color3.fromRGB(0, 0, 0)
		scrollayers.BorderSizePixel = 0
		scrollayers.Size = UDim2.new(1, 0, 1, 0)

		-- // Dual-column vs Single-column layout setup
		local columnLeft, columnRight, listLeft, listRight
		local uilistlayout1

		if isDualColumn then
			columnLeft = instance.frame(scrollayers)
			columnLeft.Name = "ColumnLeft"
			columnLeft.BackgroundTransparency = 1
			columnLeft.BorderSizePixel = 0
			columnLeft.Position = UDim2.new(0, 4, 0, 0)
			columnLeft.Size = UDim2.new(0.5, -7, 0, 0)
			columnLeft.AutomaticSize = Enum.AutomaticSize.Y

			listLeft = instance.uilistlayout(columnLeft)
			listLeft.Padding = UDim.new(0, 8)
			listLeft.SortOrder = Enum.SortOrder.LayoutOrder

			columnRight = instance.frame(scrollayers)
			columnRight.Name = "ColumnRight"
			columnRight.BackgroundTransparency = 1
			columnRight.BorderSizePixel = 0
			columnRight.Position = UDim2.new(0.5, 3, 0, 0)
			columnRight.Size = UDim2.new(0.5, -7, 0, 0)
			columnRight.AutomaticSize = Enum.AutomaticSize.Y

			listRight = instance.uilistlayout(columnRight)
			listRight.Padding = UDim.new(0, 8)
			listRight.SortOrder = Enum.SortOrder.LayoutOrder
		else
			local isCard = (guiconfig.Type == 2 or guiconfig.Type == 3) and (not isExcluded)
			if isCard then
				local scrollPad = instance.uipadding(scrollayers)
				scrollPad.PaddingLeft = UDim.new(0, 4)
				scrollPad.PaddingRight = UDim.new(0, 4)
				scrollPad.PaddingTop = UDim.new(0, 4)
				scrollPad.PaddingBottom = UDim.new(0, 8)
			end
			uilistlayout1 = instance.uilistlayout(scrollayers)
			uilistlayout1.Padding = UDim.new(0, isCard and 8 or 3)
			uilistlayout1.SortOrder = Enum.SortOrder.LayoutOrder
		end

		local function updatesizescroll()
			if isDualColumn then
				local leftH = (listLeft and listLeft.AbsoluteContentSize.Y) or 0
				local rightH = (listRight and listRight.AbsoluteContentSize.Y) or 0
				local maxH = math.max(leftH, rightH) + 12
				scrollayers.CanvasSize = UDim2.new(0, 0, 0, maxH)
			else
				if uilistlayout1 then
					local isCard = (guiconfig.Type == 2 or guiconfig.Type == 3) and (not isExcluded)
					scrollayers.CanvasSize = UDim2.new(0, 0, 0, uilistlayout1.AbsoluteContentSize.Y + (isCard and 16 or 0))
				end
			end
		end

		if isDualColumn then
			listLeft:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updatesizescroll)
			listRight:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updatesizescroll)
		else
			uilistlayout1:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updatesizescroll)
		end

		local tab = instance.frame(targetScroll)
		tab.Name = "Tab"
		tab.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		tab.BackgroundTransparency = (guiconfig.Type == 3) and (isFirstInMode and 0 or 1) or (isFirstInMode and 0.92 or 0.999)
		tab.BorderColor3 = Color3.fromRGB(0, 0, 0)
		tab.BorderSizePixel = 0
		tab.LayoutOrder = layoutOrder
		if guiconfig.Type == 3 then
			tab.Size = UDim2.new(0, 32, 0, 32)
			if isFirstInMode then
				tab.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
			end
		else
			tab.Size = UDim2.new(1, -20, 0, 25)
		end

		if guiconfig.Type ~= 3 and sectionName and type(sectionName) == "string" and sectionName:match("%S") then
			local secKey = string.lower(sectionName)
			if targetSections[secKey] and targetSections[secKey].tabs then
				table.insert(targetSections[secKey].tabs, tab)
				if not targetSections[secKey].open then
					tab.Visible = false
				end
			end
		end

		local uicorner3 = instance.uicorner(tab)
		uicorner3.CornerRadius = UDim.new(0, (guiconfig.Type == 3) and 6 or 4)

		local tabbutton = instance.textbutton(tab)
		tabbutton.Name = "TabButton"
		tabbutton.Font = Enum.Font.GothamBold
		tabbutton.Text = ""
		tabbutton.TextColor3 = Color3.fromRGB(255, 255, 255)
		tabbutton.TextSize = 13
		tabbutton.TextXAlignment = Enum.TextXAlignment.Left
		tabbutton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		tabbutton.BackgroundTransparency = 0.999
		tabbutton.BorderColor3 = Color3.fromRGB(0, 0, 0)
		tabbutton.BorderSizePixel = 0
		tabbutton.Size = UDim2.new(1, 0, 1, 0)

		local onOpenCallback
		local onOpenRan = false

		local function runOnOpen()
			if onOpenRan or not onOpenCallback then
				return
			end

			onOpenRan = true
			task.spawn(function()
				local ok, err = pcall(onOpenCallback)
				if not ok then
					warn("Tab OnOpen error:", err)
				end
			end)
		end

		local iconOffset = 10
		local tabIcon = nil
		if guiconfig.Type == 3 then
			tabIcon = instance.imagelabel(tab)
			tabIcon.Name = "TabIcon"
			tabIcon.Image = resolveTabIcon(tabconfig)
			tabIcon.ImageColor3 = isFirstInMode and (tabconfig.IconColor or guiconfig.Color) or Color3.fromRGB(160, 160, 160)
			tabIcon.ImageTransparency = isFirstInMode and 0 or 0.35
			tabIcon.BackgroundTransparency = 1
			tabIcon.AnchorPoint = Vector2.new(0.5, 0.5)
			tabIcon.Position = UDim2.new(0.5, 0, 0.5, 0)
			tabIcon.Size = UDim2.new(0, 22, 0, 22)
			tabIcon.ZIndex = 2
		elseif (guiconfig.TabIcons ~= false) and tabconfig.Icon and tabconfig.Icon ~= "" and tabconfig.Icon ~= false then
			tabIcon = instance.imagelabel(tab)
			tabIcon.Name = "TabIcon"
			tabIcon.Image = formatAsset(tabconfig.Icon)
			tabIcon.ImageColor3 = tabconfig.IconColor or Color3.fromRGB(255, 255, 255)
			tabIcon.BackgroundTransparency = 1
			tabIcon.Position = UDim2.new(0, 8, 0.5, -7)
			tabIcon.Size = UDim2.new(0, 14, 0, 14)
			tabIcon.ZIndex = 2
			iconOffset = 26
		end

		local tabname = instance.textlabel(tab)
		tabname.Name = "TabName"
		tabname.Font = Enum.Font.GothamBold
		tabname.Text = tostring(tabconfig.Name)
		tabname.TextColor3 = Color3.fromRGB(255, 255, 255)
		tabname.TextSize = 13
		tabname.TextXAlignment = Enum.TextXAlignment.Left
		tabname.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		tabname.BackgroundTransparency = 0.999
		tabname.BorderColor3 = Color3.fromRGB(0, 0, 0)
		tabname.BorderSizePixel = 0
		tabname.Size = UDim2.new(1, -(iconOffset + (tabconfig.Badge ~= nil and 24 or 4)), 1, 0)
		tabname.Position = UDim2.new(0, iconOffset, 0, 0)
		if guiconfig.Type == 3 then
			tabname.Visible = false
		end

		local tabBadge = nil
		if tabconfig.Badge ~= nil then
			tabBadge = instance.textlabel(tab)
			tabBadge.Name = "TabBadge"
			tabBadge.Font = Enum.Font.GothamBold
			tabBadge.Text = tostring(tabconfig.Badge)
			tabBadge.TextColor3 = Color3.fromRGB(150, 150, 150)
			tabBadge.TextSize = 10
			tabBadge.TextXAlignment = Enum.TextXAlignment.Right
			tabBadge.BackgroundTransparency = 1
			tabBadge.Position = UDim2.new(1, -8, 0.5, 0)
			tabBadge.AnchorPoint = Vector2.new(1, 0.5)
			tabBadge.Size = UDim2.new(0, 24, 0, 14)
			tabBadge.ZIndex = 2
			if guiconfig.Type == 3 then
				tabBadge.Visible = false
			end
		end

		if isFirstInMode then
			if not isInfo then
				activeMainTab = tab
				activeMainPage = scrollayers
				activeMainRunOnOpen = runOnOpen
				if currentViewMode == "Main" then
					layerspagelayout:JumpTo(scrollayers)
				end
			else
				activeInfoTab = tab
				activeInfoPage = scrollayers
				activeInfoRunOnOpen = runOnOpen
				if currentViewMode == "Info" then
					layerspagelayout:JumpTo(scrollayers)
				end
			end

			local chooseframe = instance.frame(tab)
			chooseframe.Name = "ChooseFrame"
			chooseframe.BackgroundColor3 = guiconfig.Color
			chooseframe.BorderColor3 = Color3.fromRGB(0, 0, 0)
			chooseframe.BorderSizePixel = 0
			if guiconfig.Type == 3 then
				chooseframe.AnchorPoint = Vector2.new(0, 0.5)
				chooseframe.Position = UDim2.new(0, 0, 0.5, 0)
				chooseframe.Size = UDim2.new(0, 2, 0, 16)
			else
				chooseframe.Position = UDim2.new(0, 2, 0, 9)
				chooseframe.Size = UDim2.new(0, 1, 0, 12)
			end

			if guiconfig.Type ~= 3 then
				local uistroke2 = instance.uistroke(chooseframe)
				uistroke2.Color = guiconfig.Color
				uistroke2.Thickness = 1.6
			end

			instance.uicorner(chooseframe).CornerRadius = UDim.new(0, (guiconfig.Type == 3) and 1 or 2)
		end

		tabbutton.MouseEnter:Connect(function()
			if guiconfig.Type == 3 then
				local currentTab = isInfo and activeInfoTab or activeMainTab
				if tab ~= currentTab then
					sv.ts:Create(tab, TweenInfo.new(0.12), { BackgroundTransparency = 0.6 }):Play()
					if tabIcon then
						sv.ts:Create(tabIcon, TweenInfo.new(0.12), { ImageTransparency = 0.1 }):Play()
					end
				end
				if sidebarTooltip then
					local tText = sidebarTooltip:FindFirstChild("TooltipText")
					if tText then tText.Text = tostring(tabconfig.Name) end
					sidebarTooltip.Position = UDim2.new(0, tabWidth + 6, 0, tab.AbsolutePosition.Y - main.AbsolutePosition.Y + (tab.AbsoluteSize.Y - 22) / 2)
					sidebarTooltip.Visible = true
				end
			end
		end)

		tabbutton.MouseLeave:Connect(function()
			if guiconfig.Type == 3 then
				local currentTab = isInfo and activeInfoTab or activeMainTab
				if tab ~= currentTab then
					sv.ts:Create(tab, TweenInfo.new(0.12), { BackgroundTransparency = 1 }):Play()
					if tabIcon then
						sv.ts:Create(tabIcon, TweenInfo.new(0.12), { ImageTransparency = 0.35 }):Play()
					end
				end
				if sidebarTooltip then
					sidebarTooltip.Visible = false
				end
			end
		end)

		tabbutton.Activated:Connect(function()
			closeDropdown()
			if sidebarTooltip then
				sidebarTooltip.Visible = false
			end
			local framechoose

			for _, tabframe in ipairs(targetScroll:GetChildren()) do
				if tabframe.Name == "Tab" then
					local cf = tabframe:FindFirstChild("ChooseFrame")
					if cf then
						framechoose = cf
					end
					if guiconfig.Type == 3 then
						tabframe.BackgroundTransparency = 1
						local icon = tabframe:FindFirstChild("TabIcon")
						if icon then
							icon.ImageColor3 = Color3.fromRGB(160, 160, 160)
							icon.ImageTransparency = 0.35
						end
					else
						tabframe.BackgroundTransparency = 0.999
					end
				end
			end

			if not framechoose then
				return
			end

			if layerspagelayout.CurrentPage == scrollayers then
				runOnOpen()
				return
			end

			if guiconfig.Type == 3 then
				tab.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
				tab.BackgroundTransparency = 0
				local icon = tab:FindFirstChild("TabIcon")
				if icon then
					icon.ImageColor3 = tabconfig.IconColor or guiconfig.Color
					icon.ImageTransparency = 0
				end
				framechoose.Parent = tab
				framechoose.AnchorPoint = Vector2.new(0, 0.5)
				framechoose.Position = UDim2.new(0, 0, 0.5, 0)
				framechoose.Size = UDim2.new(0, 2, 0, 16)
			else
				tab.BackgroundTransparency = 0.92
				framechoose.Parent = tab
				framechoose.Position = UDim2.new(0, 2, 0, 6)
				framechoose.Size = UDim2.new(0, 1, 0, 18)
			end

			layerspagelayout:JumpTo(scrollayers)
			runOnOpen()

			if isInfo then
				activeInfoTab = tab
				activeInfoPage = scrollayers
				activeInfoRunOnOpen = runOnOpen
			else
				activeMainTab = tab
				activeMainPage = scrollayers
				activeMainRunOnOpen = runOnOpen
			end

			if guiconfig.Type ~= 3 then
				task.spawn(function()
					task.wait(0.06)
					if framechoose and framechoose.Parent == tab then
						framechoose.Size = UDim2.new(0, 1, 0, 12)
						framechoose.Position = UDim2.new(0, 2, 0, 9)
					end
				end)
			end
		end)

		local sections = {}
		local countsection = 0

		function sections:OnOpen(callback)
			onOpenCallback = callback
			if isFirstTab then
				runOnOpen()
			end
			return self
		end

		function sections:AddSection(sectiontitletext, alwaysopen, side)
			local isLockedOpen = false
			local startOpen = false
			if type(sectiontitletext) == "table" then
				local secCfg = sectiontitletext
				sectiontitletext = secCfg.Title or secCfg.Name or "Title"
				if secCfg.AlwaysOpen ~= nil then
					isLockedOpen = (secCfg.AlwaysOpen == true)
					startOpen = isLockedOpen
				elseif secCfg.Collapsible ~= nil then
					isLockedOpen = not secCfg.Collapsible
					startOpen = (secCfg.Open ~= false)
				elseif secCfg.Open ~= nil then
					startOpen = secCfg.Open
					isLockedOpen = false
				else
					isLockedOpen = true
					startOpen = true
				end
				side = secCfg.Side or secCfg.Column
			else
				if alwaysopen == true then
					isLockedOpen = true
					startOpen = true
				elseif alwaysopen == false then
					isLockedOpen = false
					startOpen = false
				else
					isLockedOpen = false
					startOpen = true
				end
			end
			sectiontitletext = sectiontitletext or "Title"

			-- // Mini UI Section Header (Main UI only)
			local currentMiniSection = nil
			if not isInfo and miniScroll then
				miniLayoutOrder = miniLayoutOrder + 1

				local miniSecFrame = instance.frame(miniScroll)
				miniSecFrame.Name = "MiniSec_" .. tostring(sectiontitletext)
				miniSecFrame.Size = UDim2.new(1, 0, 0, 22)
				miniSecFrame.BackgroundTransparency = 1
				miniSecFrame.BorderSizePixel = 0
				miniSecFrame.LayoutOrder = miniLayoutOrder
				miniSecFrame.Visible = false

				local secTitle = instance.textlabel(miniSecFrame)
				secTitle.Name = "Title"
				secTitle.Font = guiconfig.Font or Enum.Font.GothamBold
				secTitle.Text = sectiontitletext
				secTitle.TextSize = 10
				secTitle.TextColor3 = Color3.fromRGB(150, 150, 150)
				secTitle.TextXAlignment = Enum.TextXAlignment.Left
				secTitle.TextTruncate = Enum.TextTruncate.AtEnd
				secTitle.BackgroundTransparency = 1
				secTitle.Position = UDim2.new(0, 4, 0, 0)
				secTitle.Size = UDim2.new(1, -8, 1, -2)

				local secLine = instance.frame(miniSecFrame)
				secLine.Name = "Line"
				secLine.AnchorPoint = Vector2.new(0, 1)
				secLine.Position = UDim2.new(0, 3, 1, 0)
				secLine.Size = UDim2.new(1, -6, 0, 1)
				secLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				secLine.BackgroundTransparency = 0.94
				secLine.BorderSizePixel = 0

				currentMiniSection = {
					Title = sectiontitletext,
					Header = miniSecFrame,
					Items = {},
				}
				table.insert(miniSections, currentMiniSection)
			end

			countsection = countsection + 1

			-- // Target column container selection
			local targetContainer = scrollayers
			if isDualColumn then
				local normalizedSide = side and string.lower(tostring(side))
				if normalizedSide == "left" or normalizedSide == "l" or normalizedSide == "kiri" then
					targetContainer = columnLeft
				elseif normalizedSide == "right" or normalizedSide == "r" or normalizedSide == "kanan" then
					targetContainer = columnRight
				else
					targetContainer = (countsection % 2 == 1) and columnLeft or columnRight
				end
			end

			local section = instance.frame(targetContainer)
			section.Name = "Section"
			section.BorderSizePixel = 0
			section.LayoutOrder = countsection
			section.ClipsDescendants = true
			section.Size = UDim2.new(1, 0, 0, 30)

			-- // Section Card styling (Type 2, Type 3 or mobile card style)
			local isCardStyle = isDualColumn or ((guiconfig.Type == 2 or guiconfig.Type == 3) and (not isExcluded))
			local headerLine = nil
			if isCardStyle then
				section.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
				section.BackgroundTransparency = 0
				local uicornerSec = instance.uicorner(section)
				uicornerSec.CornerRadius = UDim.new(0, 8)

				local uistrokeSec = instance.uistroke(section)
				uistrokeSec.Color = Color3.fromRGB(255, 255, 255)
				uistrokeSec.Thickness = 1
				uistrokeSec.Transparency = 0.84
				uistrokeSec.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			else
				section.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				section.BackgroundTransparency = 0.999
			end

			local sectionreal = instance.frame(section)
			sectionreal.AnchorPoint = Vector2.new(0.5, 0)
			sectionreal.BackgroundColor3 = isCardStyle and Color3.fromRGB(26, 26, 26) or Color3.fromRGB(255, 255, 255)
			sectionreal.BackgroundTransparency = isCardStyle and 0.3 or 1
			sectionreal.BorderSizePixel = 0
			sectionreal.Position = UDim2.new(0.5, 0, 0, 0)
			sectionreal.Size = UDim2.new(1, 0, 0, 32)

			local uicorner = instance.uicorner(sectionreal)
			uicorner.CornerRadius = UDim.new(0, isCardStyle and 8 or 4)

			if isCardStyle then
				headerLine = instance.frame(sectionreal)
				headerLine.Name = "HeaderLine"
				headerLine.AnchorPoint = Vector2.new(0, 1)
				headerLine.Position = UDim2.new(0, 8, 1, 0)
				headerLine.Size = UDim2.new(1, -16, 0, 1)
				headerLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				headerLine.BackgroundTransparency = 0.92
				headerLine.BorderSizePixel = 0
				headerLine.Visible = false
			end

			local sectionbutton = instance.textbutton(sectionreal)
			sectionbutton.Font = Enum.Font.SourceSans
			sectionbutton.Text = ""
			sectionbutton.BackgroundTransparency = 1
			sectionbutton.Size = UDim2.new(1, 0, 1, 0)

			local featureframe = instance.frame(sectionreal)
			featureframe.AnchorPoint = Vector2.new(1, 0.5)
			featureframe.BackgroundTransparency = 1
			featureframe.Position = isCardStyle and UDim2.new(1, -10, 0.5, 0) or UDim2.new(1, -5, 0.5, 0)
			featureframe.Size = UDim2.new(0, 20, 0, 20)

			local featureimg = instance.imagelabel(featureframe)
			featureimg.Image = "rbxassetid://16851841101"
			featureimg.AnchorPoint = Vector2.new(0.5, 0.5)
			featureimg.BackgroundTransparency = 1
			featureimg.Position = UDim2.new(0.5, 0, 0.5, 0)
			featureimg.Rotation = -90
			featureimg.Size = UDim2.new(1, 6, 1, 6)

			local sectiontitle = instance.textlabel(sectionreal)
			sectiontitle.Font = Enum.Font.GothamBold
			sectiontitle.Text = sectiontitletext
			sectiontitle.TextColor3 = Color3.fromRGB(230, 230, 230)
			sectiontitle.TextSize = 13
			sectiontitle.TextXAlignment = Enum.TextXAlignment.Left
			sectiontitle.AnchorPoint = Vector2.new(0, 0.5)
			sectiontitle.BackgroundTransparency = 1
			sectiontitle.Position = isCardStyle and UDim2.new(0, 10, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
			sectiontitle.Size = isCardStyle and UDim2.new(1, -40, 0, 13) or UDim2.new(1, -30, 0, 13)

			local sectionadd = instance.frame(section)
			sectionadd.AnchorPoint = Vector2.new(0.5, 0)
			sectionadd.BackgroundTransparency = 1
			sectionadd.BorderSizePixel = 0
			sectionadd.ClipsDescendants = true
			sectionadd.Position = UDim2.new(0.5, 0, 0, 34)
			sectionadd.Size = UDim2.new(1, 0, 0, 0)

			local uicorner8 = instance.uicorner(sectionadd)
			uicorner8.CornerRadius = UDim.new(0, 2)

			local uilistlayout2 = instance.uilistlayout(sectionadd)
			uilistlayout2.Padding = UDim.new(0, 4)
			uilistlayout2.SortOrder = Enum.SortOrder.LayoutOrder

			local uipadding2 = instance.uipadding(sectionadd)
			if isCardStyle then
				uipadding2.PaddingLeft = UDim.new(0, 8)
				uipadding2.PaddingRight = UDim.new(0, 8)
				uipadding2.PaddingTop = UDim.new(0, 8)
				uipadding2.PaddingBottom = UDim.new(0, 8)
			else
				uipadding2.PaddingLeft = UDim.new(0, 1)
				uipadding2.PaddingRight = UDim.new(0, 1)
				uipadding2.PaddingTop = UDim.new(0, 1)
				uipadding2.PaddingBottom = UDim.new(0, 2)
			end

			local color_normal = Color3.fromRGB(230, 230, 230)
			local color_open = Color3.fromRGB(0, 208, 255)

			local opensection = false
			local sectionResizeQueued = false

			local function updatesizesection(animate)
				if not opensection then
					return
				end

				if headerLine then
					headerLine.Visible = true
				end

				local extraH = isCardStyle and 16 or 3
				local contentHeight = math.max(0, uilistlayout2.AbsoluteContentSize.Y) + extraH
				local sectionsizey = 34 + contentHeight
				sectiontitle.TextColor3 = color_open

				if animate and featureframe.Parent then
					sv.ts:Create(featureframe, TweenInfo.new(0.3), { Rotation = 90 }):Play()
					sv.ts:Create(section, TweenInfo.new(0.3), { Size = UDim2.new(1, 0, 0, sectionsizey) }):Play()
					sv.ts:Create(sectionadd, TweenInfo.new(0.3), { Size = UDim2.new(1, 0, 0, contentHeight) }):Play()
				else
					if featureframe.Parent then
						featureframe.Rotation = 90
					end
					section.Size = UDim2.new(1, 0, 0, sectionsizey)
					sectionadd.Size = UDim2.new(1, 0, 0, contentHeight)
				end

				updatesizescroll()
			end

			local function queueSectionResize()
				if sectionResizeQueued then
					return
				end

				sectionResizeQueued = true
				task.defer(function()
					sectionResizeQueued = false
					updatesizesection(false)
				end)
			end

			if isLockedOpen then
				sectionbutton:Destroy()
				featureframe:Destroy()
				opensection = true
				if headerLine then
					headerLine.Visible = true
				end
				updatesizesection(false)
			else
				sectionbutton.Activated:Connect(function()
					if opensection then
						opensection = false
						if headerLine then
							headerLine.Visible = false
						end
						sectiontitle.TextColor3 = color_normal
						sv.ts:Create(featureframe, TweenInfo.new(0.3), { Rotation = 0 }):Play()
						local t1 = sv.ts:Create(section, TweenInfo.new(0.3), { Size = UDim2.new(1, 0, 0, 30) })
						t1:Play()
						sv.ts:Create(sectionadd, TweenInfo.new(0.3), { Size = UDim2.new(1, 0, 0, 0) }):Play()
						t1.Completed:Connect(updatesizescroll)
					else
						opensection = true
						updatesizesection(true)
					end
				end)

				if startOpen then
					opensection = true
					featureframe.Rotation = 90
					sectiontitle.TextColor3 = color_open
					if headerLine then
						headerLine.Visible = true
					end
					updatesizesection(false)
				end
			end

			uilistlayout2:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(queueSectionResize)

			local items = {}
			local countitem = 0
			local currentSubSection = nil

			local function sanitizeConfigPart(value)
				local part = tostring(value or "")
				part = part:gsub("%s+", "_")
				part = part:gsub("[^%w_%-]", "")
				part = part:gsub("_+", "_")
				part = part:gsub("^_", ""):gsub("_$", "")
				return part
			end

			local function appendConfigPart(parts, value, allowNumeric)
				local part = sanitizeConfigPart(value)
				if part == "" then
					return
				end

				if not allowNumeric and part:match("^%d+$") then
					return
				end

				parts[#parts + 1] = part
			end

			local function makeConfigKey(elementType, title)
				local parts = {}

				appendConfigPart(parts, tabconfig.Name, true)
				appendConfigPart(parts, sectiontitletext, true)

				if currentSubSection and tostring(currentSubSection) ~= "" then
					appendConfigPart(parts, currentSubSection, false)
				end

				local elementPart = sanitizeConfigPart(title)
				parts[#parts + 1] = tostring(elementType) .. "_" .. elementPart

				return table.concat(parts, "_")
			end

			-- // Elements inherit centralized window-level yieldbuild throttle

			local function registerSearchItem(title, object, itemType, options)
				title = tostring(title or "Item")

				local tabSec = tabconfig.Section or "General"
				local cleanPath = tostring(tabconfig.Name) .. " / " .. sectiontitletext
				if currentSubSection then
					cleanPath = cleanPath .. " / " .. currentSubSection
				end

				local itemEntry = {
					Name = title,
					TabSection = tabSec,
					TabName = tostring(tabconfig.Name or "Tab"),
					SectionName = sectiontitletext,
					SubSection = currentSubSection,
					Path = (tabconfig.Section and (tostring(tabconfig.Section) .. " > ") or "") .. cleanPath,
					CleanPath = cleanPath,
					Type = itemType or "Feature",
					Options = options,
					TabIndex = scrollayers.LayoutOrder,
					Page = scrollayers,
					Tab = tab,
					Section = section,
					Object = object,
					IsInfoTab = isInfo,
					OpenSection = function()
						if not opensection then
							opensection = true
							updatesizesection(true)
						end
					end,
				}

				table.insert(searchItems, itemEntry)
			end

			function items:AddParagraph(paragraphconfig)
				paragraphconfig = paragraphconfig or {}
				paragraphconfig.Title = paragraphconfig.Title or "Title"
				paragraphconfig.Content = paragraphconfig.Title2 or paragraphconfig.Content or "Content"
				local paragraphfunc = {}

				local paragraph = instance.frame(sectionadd)
				paragraph.Name = "Paragraph"
				paragraph.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
				paragraph.BackgroundTransparency = 0
				paragraph.BorderSizePixel = 0
				paragraph.LayoutOrder = countitem
				paragraph.Size = UDim2.new(1, 0, 0, 46)

				local uicorner14 = instance.uicorner(paragraph)
				uicorner14.CornerRadius = UDim.new(0, 6)

				local pcardstroke = instance.uistroke(paragraph)
				pcardstroke.Color = Color3.fromRGB(255, 255, 255)
				pcardstroke.Thickness = 1
				pcardstroke.Transparency = 0.88

				local iconoffset = 10
				if paragraphconfig.Icon then
					local iconimg = instance.imagelabel(paragraph)
					iconimg.Name = "ParagraphIcon"
					iconimg.Size = UDim2.new(0, 20, 0, 20)
					iconimg.Position = UDim2.new(0, 8, 0, 12)
					iconimg.BackgroundTransparency = 1

					if icons and icons[paragraphconfig.Icon] then
						iconimg.Image = icons[paragraphconfig.Icon]
					else
						iconimg.Image = paragraphconfig.Icon
					end

					iconoffset = 30
				end

				local paragraphtitle = instance.textlabel(paragraph)
				paragraphtitle.Name = "ParagraphTitle"
				paragraphtitle.Font = Enum.Font.GothamBold
				paragraphtitle.Text = paragraphconfig.Title
				paragraphtitle.TextColor3 = guiconfig.Color
				paragraphtitle.TextSize = 13
				paragraphtitle.TextXAlignment = Enum.TextXAlignment.Left
				paragraphtitle.TextYAlignment = Enum.TextYAlignment.Top
				paragraphtitle.BackgroundTransparency = 1
				paragraphtitle.Position = UDim2.new(0, iconoffset, 0, 10)
				paragraphtitle.Size = UDim2.new(1, -16, 0, 13)

				local paragraphcontent = instance.textlabel(paragraph)
				paragraphcontent.Name = "ParagraphContent"
				paragraphcontent.Font = Enum.Font.GothamBold
				paragraphcontent.Text = paragraphconfig.Content
				paragraphcontent.TextColor3 = Color3.fromRGB(255, 255, 255)
				paragraphcontent.TextSize = 12
				paragraphcontent.TextXAlignment = Enum.TextXAlignment.Left
				paragraphcontent.TextYAlignment = Enum.TextYAlignment.Top
				paragraphcontent.BackgroundTransparency = 1
				paragraphcontent.TextTransparency = 0.5
				paragraphcontent.Position = UDim2.new(0, iconoffset, 0, 25)
				paragraphcontent.TextWrapped = true
				paragraphcontent.RichText = true
				paragraphcontent.Size = UDim2.new(1, -(iconoffset + 16), 0, 0)

				local paragraphbutton
				if paragraphconfig.ButtonText then
					paragraphbutton = instance.textbutton(paragraph)
					paragraphbutton.Position = UDim2.new(0, 10, 0, 42)
					paragraphbutton.Size = UDim2.new(1, -22, 0, 28)
					paragraphbutton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
					paragraphbutton.BackgroundTransparency = 0
					paragraphbutton.Font = Enum.Font.GothamBold
					paragraphbutton.TextSize = 12
					paragraphbutton.TextTransparency = 0.3
					paragraphbutton.TextColor3 = Color3.fromRGB(255, 255, 255)
					paragraphbutton.Text = paragraphconfig.ButtonText

					local btncorner = instance.uicorner(paragraphbutton)
					btncorner.CornerRadius = UDim.new(0, 4)

					local btnstroke = instance.uistroke(paragraphbutton)
					btnstroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					btnstroke.Color = Color3.fromRGB(255, 255, 255)
					btnstroke.Thickness = 1
					btnstroke.Transparency = 0.88

					if paragraphconfig.ButtonCallback then
						paragraphbutton.MouseButton1Click:Connect(paragraphconfig.ButtonCallback)
					end
				end

				local function updatesize()
					local textHeight = math.max(14, paragraphcontent.TextBounds.Y)
					local totalheight = textHeight + 35
					if paragraphbutton then
						paragraphbutton.Position = UDim2.new(0, 10, 0, textHeight + 30)
						totalheight = totalheight + paragraphbutton.Size.Y.Offset + 5
					end
					paragraph.Size = UDim2.new(1, 0, 0, math.max(46, totalheight))
				end

				task.defer(updatesize)
				paragraphcontent:GetPropertyChangedSignal("TextBounds"):Connect(updatesize)

				function paragraphfunc:SetContent(content)
					content = content or "Content"
					paragraphcontent.Text = content
					updatesize()
				end

				registerSearchItem(paragraphconfig.Title, paragraph, "Paragraph")
				countitem = countitem + 1
				yieldbuild()
				return paragraphfunc
			end

			function items:AddPanel(panelconfig)
				panelconfig = panelconfig or {}

				local panels = {
					Chloe = {
						Image = "rbxassetid://139546726059566",
						AspectRatio = 3.56,
					},
					UgPhone = {
						Image = "rbxassetid://95132907847500",
						AspectRatio = 3.56,
					},
					ChloeStore = {
						Image = "rbxassetid://78353987171005",
						AspectRatio = 3.56,
					},
				}

				local paneldata = panels[panelconfig.Type] or panels.Chloe
				local aspectRatio = tonumber(panelconfig.AspectRatio) or paneldata.AspectRatio

				local panel = instance.imagelabel(sectionadd)
				panel.Name = "Panel"
				panel.BackgroundTransparency = 1
				panel.BorderSizePixel = 0
				panel.Image = panelconfig.Image or paneldata.Image
				panel.ScaleType = Enum.ScaleType.Fit
				panel.Size = UDim2.new(1, 0, 0, 160)
				panel.LayoutOrder = countitem
				panel.ClipsDescendants = true
				panel.ZIndex = 1

				instance.uicorner(panel).CornerRadius = UDim.new(0, tonumber(panelconfig.CornerRadius) or 10)

				local lastWidth = -1
				local resizeQueued = false

				local function updatePanelSize()
					resizeQueued = false

					if not panel or not panel.Parent then
						return
					end

					local width = math.floor(panel.AbsoluteSize.X + 0.5)

					if width <= 1 then
						width = math.floor(sectionadd.AbsoluteSize.X + 0.5)
					end

					if width <= 1 or width == lastWidth then
						return
					end

					lastWidth = width

					local height = math.max(1, math.floor((width / aspectRatio) + 0.5))

					panel.Size = UDim2.new(1, 0, 0, height)
				end

				local function queuePanelResize()
					if resizeQueued then
						return
					end

					resizeQueued = true
					task.defer(updatePanelSize)
				end

				trackConnection(
					sectionadd:GetPropertyChangedSignal("AbsoluteSize"):Connect(queuePanelResize),
					"panel.adaptive.resize"
				)

				task.defer(queuePanelResize)

				countitem = countitem + 1
				yieldbuild()

				return panel
			end

			function items:AddUserCard(userconfig)
				userconfig = userconfig or {}
				local player = sv.plrs.LocalPlayer
				local displayName = userconfig.DisplayName or (player and player.DisplayName) or "User"
				local userName = userconfig.Username or (player and player.Name) or "User"
				local userId = userconfig.UserId or (player and player.UserId) or 0
				local titleText = userconfig.Title or ("Welcome, " .. displayName)

				local function detectExecutor()
					if userconfig.Executor then
						return tostring(userconfig.Executor)
					end
					if identifyexecutor then
						local ok, name, ver = pcall(identifyexecutor)
						if ok and name and tostring(name) ~= "" then
							if ver and tostring(ver) ~= "" then
								return tostring(name) .. " " .. tostring(ver)
							end
							return tostring(name)
						end
					end
					if getexecutorname then
						local ok, name = pcall(getexecutorname)
						if ok and name and tostring(name) ~= "" then
							return tostring(name)
						end
					end
					if syn then
						return "Synapse X"
					elseif SENTINEL_LOADED then
						return "Sentinel"
					elseif KRNL_LOADED then
						return "Krnl"
					elseif FLUXUS_LOADED then
						return "Fluxus"
					elseif DELTA_LOADED then
						return "Delta"
					elseif is_sirhurt_closure then
						return "Sirhurt"
					elseif pebc_create then
						return "ProtoSmasher"
					elseif isexecutorclosure then
						return "Custom Executor"
					end
					return "Roblox Studio"
				end

				local function detectDevice()
					if userconfig.Device then
						return tostring(userconfig.Device)
					end
					local isMobile = (sv.uis.TouchEnabled and not sv.uis.KeyboardEnabled) or (sv.uis.TouchEnabled and not sv.uis.MouseEnabled)
					if isMobile then
						return "Mobile"
					end
					pcall(function()
						local gs = game:GetService("GuiService")
						if gs and gs:IsTenFootInterface() then
							return "Console"
						end
					end)
					return "PC"
				end

				local function formatDuration(seconds)
					local d = math.floor(seconds / 86400)
					local h = math.floor((seconds % 86400) / 3600)
					local m = math.floor((seconds % 3600) / 60)
					local s = math.floor(seconds % 60)
					return string.format("%dd %dh %dmin %dsec", d, h, m, s)
				end

				local card = instance.frame(sectionadd)
				card.Name = "UserCard"
				card.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
				card.BackgroundTransparency = 0
				card.BorderSizePixel = 0
				card.ClipsDescendants = true
				card.LayoutOrder = countitem
				card.Size = UDim2.new(1, 0, 0, 78)

				local uicorner = instance.uicorner(card)
				uicorner.CornerRadius = UDim.new(0, 6)

				local uistroke = instance.uistroke(card)
				uistroke.Color = Color3.fromRGB(255, 255, 255)
				uistroke.Thickness = 1
				uistroke.Transparency = 0.88

				local charBg = instance.imagelabel(card)
				charBg.Name = "CharBgImg"
				charBg.AnchorPoint = Vector2.new(1, 1)
				charBg.Position = UDim2.new(1, 0, 1, 0)
				charBg.Size = UDim2.new(0, 140, 1.15, 0)
				charBg.BackgroundTransparency = 1
				charBg.BorderSizePixel = 0
				charBg.ScaleType = Enum.ScaleType.Fit
				charBg.Image = userconfig.CharacterImage or ("rbxthumb://type=AvatarBust&id=" .. tostring(userId) .. "&w=420&h=420")
				charBg.ZIndex = 1

				local charGrad = Instance.new("UIGradient")
				charGrad.Name = "FadeGradient"
				charGrad.Rotation = 0
				charGrad.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.3, 0.8),
					NumberSequenceKeypoint.new(0.65, 0.3),
					NumberSequenceKeypoint.new(1, 0.05),
				})
				charGrad.Parent = charBg

				local avatarHolder = instance.frame(card)
				avatarHolder.Name = "AvatarHolder"
				avatarHolder.AnchorPoint = Vector2.new(0, 0.5)
				avatarHolder.Position = UDim2.new(0, 10, 0.5, 0)
				avatarHolder.Size = UDim2.new(0, 48, 0, 48)
				avatarHolder.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
				avatarHolder.BorderSizePixel = 0
				avatarHolder.ZIndex = 2
				instance.uicorner(avatarHolder).CornerRadius = UDim.new(1, 0)

				local avatarStroke = instance.uistroke(avatarHolder)
				avatarStroke.Color = guiconfig.Color
				avatarStroke.Thickness = 1.2
				avatarStroke.Transparency = 0.4

				local avatarImg = instance.imagelabel(avatarHolder)
				avatarImg.Name = "AvatarHeadshot"
				avatarImg.Size = UDim2.new(1, 0, 1, 0)
				avatarImg.BackgroundTransparency = 1
				avatarImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(userId) .. "&w=150&h=150"
				avatarImg.ZIndex = 2
				instance.uicorner(avatarImg).CornerRadius = UDim.new(1, 0)

				task.spawn(function()
					pcall(function()
						local content, isReady = sv.plrs:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
						if isReady and content and avatarImg and avatarImg.Parent then
							avatarImg.Image = content
						end
					end)
				end)

				local nameLabel = instance.textlabel(card)
				nameLabel.Name = "WelcomeLabel"
				nameLabel.Font = Enum.Font.GothamBold
				nameLabel.Text = titleText
				nameLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
				nameLabel.TextSize = 13
				nameLabel.TextXAlignment = Enum.TextXAlignment.Left
				nameLabel.Position = UDim2.new(0, 68, 0, 8)
				nameLabel.Size = UDim2.new(1, -74, 0, 15)
				nameLabel.BackgroundTransparency = 1
				nameLabel.BorderSizePixel = 0
				nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
				nameLabel.ZIndex = 2

				local startTime = userconfig.StartTime or windowStartTime or scriptStartTime or os.time()
				local currentExecutor = detectExecutor()
				local currentDevice = detectDevice()

				local activeLabel = instance.textlabel(card)
				activeLabel.Name = "ActiveLabel"
				activeLabel.Font = guiconfig.Font
				activeLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
				activeLabel.TextSize = 10
				activeLabel.TextXAlignment = Enum.TextXAlignment.Left
				activeLabel.Position = UDim2.new(0, 68, 0, 25)
				activeLabel.Size = UDim2.new(1, -74, 0, 14)
				activeLabel.BackgroundTransparency = 1
				activeLabel.BorderSizePixel = 0
				activeLabel.TextTruncate = Enum.TextTruncate.AtEnd
				activeLabel.RichText = true
				activeLabel.ZIndex = 2

				local executorLabel = instance.textlabel(card)
				executorLabel.Name = "ExecutorLabel"
				executorLabel.Font = guiconfig.Font
				executorLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
				executorLabel.TextSize = 10
				executorLabel.TextXAlignment = Enum.TextXAlignment.Left
				executorLabel.Position = UDim2.new(0, 68, 0, 41)
				executorLabel.Size = UDim2.new(1, -74, 0, 14)
				executorLabel.BackgroundTransparency = 1
				executorLabel.BorderSizePixel = 0
				executorLabel.TextTruncate = Enum.TextTruncate.AtEnd
				executorLabel.RichText = true
				executorLabel.Text = 'Executor : <font color="rgb(220, 220, 220)">' .. currentExecutor .. '</font>'
				executorLabel.ZIndex = 2

				local deviceLabel = instance.textlabel(card)
				deviceLabel.Name = "DeviceLabel"
				deviceLabel.Font = guiconfig.Font
				deviceLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
				deviceLabel.TextSize = 10
				deviceLabel.TextXAlignment = Enum.TextXAlignment.Left
				deviceLabel.Position = UDim2.new(0, 68, 0, 57)
				deviceLabel.Size = UDim2.new(1, -74, 0, 14)
				deviceLabel.BackgroundTransparency = 1
				deviceLabel.BorderSizePixel = 0
				deviceLabel.TextTruncate = Enum.TextTruncate.AtEnd
				deviceLabel.RichText = true
				deviceLabel.Text = 'Device : <font color="rgb(220, 220, 220)">' .. currentDevice .. '</font>'
				deviceLabel.ZIndex = 2

				local function updateActiveText()
					local elapsed = math.max(0, math.floor(os.time() - startTime))
					local dur = formatDuration(elapsed)
					activeLabel.Text = 'User Active : <font color="rgb(220, 220, 220)">Duration ' .. dur .. '</font>'
				end
				updateActiveText()

				-- Live ticking counter every second
				task.spawn(function()
					while card and card.Parent do
						task.wait(1)
						if card and card.Parent then
							updateActiveText()
						else
							break
						end
					end
				end)

				registerSearchItem("Profile: " .. displayName, card, "UserCard")
				registerSearchItem("Executor: " .. currentExecutor, card, "UserCard")
				countitem = countitem + 1
				yieldbuild()

				local userfunc = {}
				function userfunc:SetTitle(newTitle)
					nameLabel.Text = tostring(newTitle)
				end
				function userfunc:SetExecutor(newExec)
					currentExecutor = tostring(newExec)
					executorLabel.Text = 'Executor : <font color="rgb(220, 220, 220)">' .. currentExecutor .. '</font>'
				end
				function userfunc:SetDevice(newDev)
					currentDevice = tostring(newDev)
					deviceLabel.Text = 'Device : <font color="rgb(220, 220, 220)">' .. currentDevice .. '</font>'
				end
				function userfunc:SetStartTime(newTime)
					startTime = tonumber(newTime) or os.time()
					updateActiveText()
				end
				function userfunc:GetStartTime()
					return startTime
				end
				function userfunc:GetCard()
					return card
				end
				return userfunc
			end

			-- // AddServerCondition Element (Server & Performance Monitor Card)
			function items:AddServerCondition(perfconfig)
				perfconfig = perfconfig or {}
				local cardTitle = perfconfig.Title or (guiconfig.Language == "id" and "Kondisi Server" or (guiconfig.Language == "ru" and "Состояние сервера" or "Condition Server"))

				local card = instance.frame(sectionadd)
				card.Name = "ServerConditionCard"
				card.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
				card.BackgroundTransparency = 0
				card.BorderSizePixel = 0
				card.ClipsDescendants = true
				card.LayoutOrder = countitem
				card.Size = UDim2.new(1, 0, 0, 118)
				countitem = countitem + 1

				local uicorner = instance.uicorner(card)
				uicorner.CornerRadius = UDim.new(0, 6)

				local uistroke = instance.uistroke(card)
				uistroke.Color = Color3.fromRGB(255, 255, 255)
				uistroke.Thickness = 1
				uistroke.Transparency = 0.88

				-- // Title
				local titleLabel = instance.textlabel(card)
				titleLabel.Name = "Title"
				titleLabel.Font = guiconfig.Font or Enum.Font.GothamBold
				titleLabel.Text = tostring(cardTitle)
				titleLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
				titleLabel.TextSize = 13
				titleLabel.TextXAlignment = Enum.TextXAlignment.Left
				titleLabel.BackgroundTransparency = 1
				titleLabel.Position = UDim2.new(0, 12, 0, 8)
				titleLabel.Size = UDim2.new(1, -24, 0, 16)
				titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
				titleLabel.ZIndex = 2

				-- // Right Container: FPS (Cardless & Real-Time)
				local fpsBox = instance.frame(card)
				fpsBox.Name = "FpsContainer"
				fpsBox.AnchorPoint = Vector2.new(1, 0.5)
				fpsBox.Position = UDim2.new(1, -16, 0.5, 8)
				fpsBox.Size = UDim2.new(0, 72, 0, 56)
				fpsBox.BackgroundTransparency = 1
				fpsBox.BorderSizePixel = 0
				fpsBox.ZIndex = 2

				local fpsNumber = instance.textlabel(fpsBox)
				fpsNumber.Name = "FpsNumber"
				fpsNumber.Font = guiconfig.Font or Enum.Font.GothamBold
				fpsNumber.Text = "60"
				fpsNumber.TextColor3 = Color3.fromRGB(255, 255, 255)
				fpsNumber.TextSize = 24
				fpsNumber.TextXAlignment = Enum.TextXAlignment.Center
				fpsNumber.AnchorPoint = Vector2.new(0.5, 0)
				fpsNumber.Position = UDim2.new(0.5, 0, 0, 4)
				fpsNumber.Size = UDim2.new(1, 0, 0, 26)
				fpsNumber.BackgroundTransparency = 1
				fpsNumber.ZIndex = 3

				local fpsLabel = instance.textlabel(fpsBox)
				fpsLabel.Name = "FpsLabel"
				fpsLabel.Font = guiconfig.Font or Enum.Font.GothamBold
				fpsLabel.Text = "FPS"
				fpsLabel.TextColor3 = Color3.fromRGB(150, 150, 155)
				fpsLabel.TextSize = 11
				fpsLabel.TextXAlignment = Enum.TextXAlignment.Center
				fpsLabel.AnchorPoint = Vector2.new(0.5, 0)
				fpsLabel.Position = UDim2.new(0.5, 0, 0, 32)
				fpsLabel.Size = UDim2.new(1, 0, 0, 14)
				fpsLabel.BackgroundTransparency = 1
				fpsLabel.ZIndex = 3

				-- // Left Container: 4 Metric Rows (CPU, GPU, Ping, Memory)
				local leftContainer = instance.frame(card)
				leftContainer.Name = "MetricsContainer"
				leftContainer.BackgroundTransparency = 1
				leftContainer.BorderSizePixel = 0
				leftContainer.Position = UDim2.new(0, 12, 0, 32)
				leftContainer.Size = UDim2.new(1, -96, 0, 78)
				leftContainer.ZIndex = 2

				local function createRow(yPos, metricName)
					local row = instance.frame(leftContainer)
					row.Name = metricName .. "Row"
					row.BackgroundTransparency = 1
					row.BorderSizePixel = 0
					row.Position = UDim2.new(0, 0, 0, yPos)
					row.Size = UDim2.new(1, 0, 0, 16)
					row.ZIndex = 2

					local nameLabel = instance.textlabel(row)
					nameLabel.Name = "Name"
					nameLabel.Font = guiconfig.Font or Enum.Font.GothamBold
					nameLabel.Text = metricName
					nameLabel.TextColor3 = Color3.fromRGB(150, 150, 155)
					nameLabel.TextSize = 11
					nameLabel.TextXAlignment = Enum.TextXAlignment.Left
					nameLabel.AnchorPoint = Vector2.new(0, 0.5)
					nameLabel.Position = UDim2.new(0, 0, 0.5, 0)
					nameLabel.Size = UDim2.new(0, 56, 1, 0)
					nameLabel.BackgroundTransparency = 1
					nameLabel.ZIndex = 3

					local valLabel = instance.textlabel(row)
					valLabel.Name = "Value"
					valLabel.Font = guiconfig.Font or Enum.Font.GothamBold
					valLabel.Text = "--"
					valLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
					valLabel.TextSize = 11
					valLabel.TextXAlignment = Enum.TextXAlignment.Left
					valLabel.AnchorPoint = Vector2.new(0, 0.5)
					valLabel.Position = UDim2.new(0, 62, 0.5, 0)
					valLabel.Size = UDim2.new(1, -62, 1, 0)
					valLabel.BackgroundTransparency = 1
					valLabel.ZIndex = 3

					return valLabel
				end

				local cpuValLabel = createRow(0, "CPU")
				local gpuValLabel = createRow(20, "GPU")
				local pingValLabel = createRow(40, "Ping")
				local memName = (guiconfig.Language == "id" and "Memori") or (guiconfig.Language == "ru" and "Память") or "Memory"
				local memValLabel = createRow(60, memName)

				local stats = game:GetService("Stats")
				local perf = stats:FindFirstChild("PerformanceStats")
				local cpuStat = perf and perf:FindFirstChild("CPU")
				local gpuStat = perf and perf:FindFirstChild("GPU")
				local pingStat = perf and perf:FindFirstChild("Ping")

				local currentCalculatedFps = 60

				task.spawn(function()
					local rs = game:GetService("RunService")
					local lastFpsUpdate = os.clock()
					local frameCount = 0
					local fpsAccum = 0
					local lastMetricUpdate = 0

					while card and card.Parent do
						local dt = rs.RenderStepped:Wait()
						frameCount = frameCount + 1
						fpsAccum = fpsAccum + dt
						local now = os.clock()

						-- // Update FPS calculation frequently (every ~0.1s) for real-time natural fluctuation
						if (now - lastFpsUpdate) >= 0.1 then
							local liveFps = math.round(frameCount / math.max(0.0001, fpsAccum))
							if liveFps > 0 and liveFps < 1000 then
								currentCalculatedFps = liveFps
								if fpsNumber and fpsNumber.Parent then
									fpsNumber.Text = tostring(liveFps)
								end
							end
							frameCount = 0
							fpsAccum = 0
							lastFpsUpdate = now
						end

						-- // Update Metrics (CPU, GPU, Ping, Memory) every 0.35s
						if (now - lastMetricUpdate) >= 0.35 then
							lastMetricUpdate = now
							pcall(function()
								-- // CPU
								local cpuMs = (cpuStat and cpuStat:GetValue())
								if not cpuMs or cpuMs <= 0 then
									cpuMs = 1000 / math.max(1, currentCalculatedFps)
								end
								cpuValLabel.Text = string.format("%.2f ms", cpuMs)

								-- // GPU
								local gpuMs = (gpuStat and gpuStat:GetValue())
								if not gpuMs or gpuMs <= 0 then
									gpuMs = 0.83
								end
								gpuValLabel.Text = string.format("%.2f ms", gpuMs)

								-- // Ping
								local pingMs = (pingStat and pingStat:GetValue())
								if not pingMs then
									local net = stats:FindFirstChild("Network")
									local ssi = net and net:FindFirstChild("ServerStatsItem")
									local dp = ssi and ssi:FindFirstChild("Data Ping")
									pingMs = dp and dp:GetValue() or 0
								end
								pingValLabel.Text = string.format("%d ms", math.round(pingMs))

								-- // Memory
								local memMb = stats:GetTotalMemoryUsageMb()
								memValLabel.Text = string.format("%.1f MB", memMb)
							end)
						end
					end
				end)

				local scFunc = {
					Card = card,
				}
				function scFunc:SetTitle(newTitle)
					titleLabel.Text = tostring(newTitle)
				end
				function scFunc:GetFps()
					return currentCalculatedFps
				end
				function scFunc:GetPing()
					return (pingStat and pingStat:GetValue()) or 0
				end
				function scFunc:GetMemory()
					return stats:GetTotalMemoryUsageMb()
				end

				registerSearchItem(cardTitle, card, "ServerCondition")
				yieldbuild()
				return scFunc
			end

			-- // Aliases
			items.AddServerPerformance = items.AddServerCondition
			items.AddPerformanceCard = items.AddServerCondition

			function items:AddGameCard(gameconfig)
				gameconfig = gameconfig or {}
				local mps = game:GetService("MarketplaceService")
				local plrs = sv.plrs
				local placeId = gameconfig.PlaceId or game.PlaceId
				local gameName = gameconfig.Name or (placeId == game.PlaceId and "Roblox Experience" or "Game")
				local gameImage = gameconfig.Image

				if not gameImage then
					if gameconfig.Image then
						gameImage = formatAsset(gameconfig.Image)
					elseif placeId and tonumber(placeId) and tonumber(placeId) > 0 then
						gameImage = "rbxthumb://type=GameThumbnail&id=" .. tostring(placeId) .. "&w=768&h=432"
					elseif gameId and tonumber(gameId) and tonumber(gameId) > 0 then
						if tonumber(gameId) > 10000000000 then
							gameImage = "rbxthumb://type=GameThumbnail&id=" .. tostring(gameId) .. "&w=768&h=432"
						else
							gameImage = "rbxthumb://type=GameIcon&id=" .. tostring(gameId) .. "&w=512&h=512"
						end
					else
						gameImage = "rbxthumb://type=GameThumbnail&id=" .. tostring(game.PlaceId) .. "&w=768&h=432"
					end
				end

				local card = instance.frame(sectionadd)
				card.Name = "GameCard"
				card.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
				card.BackgroundTransparency = 0
				card.BorderSizePixel = 0
				card.ClipsDescendants = true
				card.LayoutOrder = countitem
				card.Size = UDim2.new(1, 0, 0, 68)

				local uicorner = instance.uicorner(card)
				uicorner.CornerRadius = UDim.new(0, 6)

				local uistroke = instance.uistroke(card)
				uistroke.Color = Color3.fromRGB(255, 255, 255)
				uistroke.Thickness = 1
				uistroke.Transparency = 0.88

				local bgImg = instance.imagelabel(card)
				bgImg.Name = "GameBannerImg"
				bgImg.AnchorPoint = Vector2.new(1, 0.5)
				bgImg.Position = UDim2.new(1, 0, 0.5, 0)
				bgImg.Size = UDim2.new(0.65, 0, 1, 0)
				bgImg.BackgroundTransparency = 1
				bgImg.BorderSizePixel = 0
				bgImg.ScaleType = Enum.ScaleType.Crop
				bgImg.Image = gameImage
				bgImg.ZIndex = 1

				task.spawn(function()
					pcall(function()
						game:GetService("ContentProvider"):PreloadAsync({ bgImg })
					end)
				end)

				local grad = Instance.new("UIGradient")
				grad.Name = "FadeGradient"
				grad.Rotation = 0
				grad.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.35, 0.8),
					NumberSequenceKeypoint.new(0.7, 0.3),
					NumberSequenceKeypoint.new(1, 0.05),
				})
				grad.Parent = bgImg

				local tagLabel = instance.textlabel(card)
				tagLabel.Name = "TagLabel"
				tagLabel.Font = guiconfig.Font
				tagLabel.Text = gameconfig.Title or "Current Game :"
				tagLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
				tagLabel.TextSize = 10
				tagLabel.TextXAlignment = Enum.TextXAlignment.Left
				tagLabel.Position = UDim2.new(0, 14, 0, 10)
				tagLabel.Size = UDim2.new(0.65, 0, 0, 14)
				tagLabel.BackgroundTransparency = 1
				tagLabel.BorderSizePixel = 0
				tagLabel.ZIndex = 2

				local nameLabel = instance.textlabel(card)
				nameLabel.Name = "GameNameLabel"
				nameLabel.Font = Enum.Font.GothamBold
				nameLabel.Text = gameName
				nameLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
				nameLabel.TextSize = 13
				nameLabel.TextXAlignment = Enum.TextXAlignment.Left
				nameLabel.Position = UDim2.new(0, 14, 0, 26)
				nameLabel.Size = UDim2.new(0.65, 0, 0, 16)
				nameLabel.BackgroundTransparency = 1
				nameLabel.BorderSizePixel = 0
				nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
				nameLabel.ZIndex = 2

				if not gameconfig.Name and placeId then
					task.spawn(function()
						pcall(function()
							local info = mps:GetProductInfo(placeId)
							if info and info.Name and nameLabel and nameLabel.Parent then
								nameLabel.Text = info.Name
							end
						end)
					end)
				end

				local activeUsersLabel = instance.textlabel(card)
				activeUsersLabel.Name = "ActiveUsersLabel"
				activeUsersLabel.Font = guiconfig.Font
				activeUsersLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
				activeUsersLabel.TextSize = 10
				activeUsersLabel.TextXAlignment = Enum.TextXAlignment.Left
				activeUsersLabel.Position = UDim2.new(0, 14, 0, 44)
				activeUsersLabel.Size = UDim2.new(0.65, 0, 0, 14)
				activeUsersLabel.BackgroundTransparency = 1
				activeUsersLabel.BorderSizePixel = 0
				activeUsersLabel.RichText = true
				activeUsersLabel.ZIndex = 2

				local function updateCount()
					local count = #plrs:GetPlayers()
					local max = plrs.MaxPlayers or 0
					local txt = tostring(count) .. (max > 0 and (" / " .. tostring(max)) or "") .. " Players"
					activeUsersLabel.Text = (gameconfig.UsersTitle or "Active Users") .. ' : <font color="rgb(220, 220, 220)">' .. txt .. '</font>'
				end
				updateCount()

				local connAdded = plrs.PlayerAdded:Connect(updateCount)
				local connRemoved = plrs.PlayerRemoving:Connect(updateCount)
				card.Destroying:Connect(function()
					pcall(function()
						connAdded:Disconnect()
					end)
					pcall(function()
						connRemoved:Disconnect()
					end)
				end)

				registerSearchItem("Game: " .. gameName, card, "GameCard")
				countitem = countitem + 1
				yieldbuild()

				local gamefunc = {}
				function gamefunc:SetName(newName)
					nameLabel.Text = tostring(newName)
				end
				function gamefunc:SetImage(newImg)
					bgImg.Image = tostring(newImg)
				end
				function gamefunc:GetCard()
					return card
				end
				return gamefunc
			end

			function items:AddSupportedGameCard(gameconfig)
				gameconfig = gameconfig or {}
				local mps = game:GetService("MarketplaceService")
				local placeId = tonumber(gameconfig.PlaceId)
				local gameId = tonumber(gameconfig.GameId)
				local gameName = gameconfig.Name
				local gameImage = gameconfig.Image
				local versionStr = gameconfig.Version or "-"
				local dateStr = gameconfig.Date or "-"
				local changelogs = gameconfig.Changelogs or gameconfig.Logs or { "- - -" }

				local isCurrentGame = false
				if gameconfig.Active ~= nil then
					isCurrentGame = (gameconfig.Active == true)
				elseif gameId then
					isCurrentGame = (gameId == game.GameId)
				elseif placeId then
					isCurrentGame = (placeId == game.PlaceId)
				end

				if not placeId and gameId then
					if gameId > 10000000000 then
						placeId = gameId
					elseif gameId == game.GameId then
						placeId = game.PlaceId
					end
				end

				local gameName = gameconfig.Name or (placeId == game.PlaceId and "Roblox Experience" or "Game")
				if not gameImage then
					if gameconfig.Image then
						gameImage = formatAsset(gameconfig.Image)
					elseif placeId and tonumber(placeId) and tonumber(placeId) > 0 then
						gameImage = "rbxthumb://type=GameThumbnail&id=" .. tostring(placeId) .. "&w=768&h=432"
					elseif gameId and tonumber(gameId) and tonumber(gameId) > 0 then
						gameImage = "rbxthumb://type=GameIcon&id=" .. tostring(gameId) .. "&w=512&h=512"
					elseif isCurrentGame then
						gameImage = "rbxthumb://type=GameThumbnail&id=" .. tostring(game.PlaceId) .. "&w=768&h=432"
					else
						gameImage = ""
					end
				end

				local collapsedHeight = 56
				local expandedHeight = collapsedHeight + 30 + (#changelogs * 18) + 8

				local card = instance.frame(sectionadd)
				card.Name = "SupportedGameCard"
				card.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
				card.BackgroundTransparency = 0
				card.BorderSizePixel = 0
				card.ClipsDescendants = true
				card.LayoutOrder = countitem
				card.Size = UDim2.new(1, 0, 0, collapsedHeight)

				local uicorner = instance.uicorner(card)
				uicorner.CornerRadius = UDim.new(0, 6)

				local uistroke = instance.uistroke(card)
				uistroke.Color = Color3.fromRGB(255, 255, 255)
				uistroke.Thickness = 1
				uistroke.Transparency = 0.92

				-- // Background Banner Thumbnail
				local bgImg = instance.imagelabel(card)
				bgImg.Name = "GameBannerImg"
				bgImg.AnchorPoint = Vector2.new(1, 0)
				bgImg.Position = UDim2.new(1, 0, 0, 0)
				bgImg.Size = UDim2.new(0.65, 0, 0, collapsedHeight)
				bgImg.BackgroundTransparency = 1
				bgImg.BorderSizePixel = 0
				bgImg.ScaleType = Enum.ScaleType.Crop
				bgImg.Image = gameImage
				bgImg.ZIndex = 1

				task.spawn(function()
					pcall(function()
						game:GetService("ContentProvider"):PreloadAsync({ bgImg })
					end)
				end)

				local grad = Instance.new("UIGradient")
				grad.Name = "FadeGradient"
				grad.Rotation = 0
				grad.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.35, 0.8),
					NumberSequenceKeypoint.new(0.7, 0.3),
					NumberSequenceKeypoint.new(1, 0.05),
				})
				grad.Parent = bgImg

				-- // Game Name & Version
				local nameLabel = instance.textlabel(card)
				nameLabel.Name = "GameNameLabel"
				nameLabel.Font = Enum.Font.GothamBold
				nameLabel.TextColor3 = Color3.fromRGB(245, 245, 245)
				nameLabel.TextSize = 13
				nameLabel.TextXAlignment = Enum.TextXAlignment.Left
				nameLabel.Position = UDim2.new(0, 14, 0, 11)
				nameLabel.Size = UDim2.new(1, -24, 0, 16)
				nameLabel.BackgroundTransparency = 1
				nameLabel.BorderSizePixel = 0
				nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
				nameLabel.RichText = true
				nameLabel.ZIndex = 2

				-- // Status Info Label
				local idLabel = instance.textlabel(card)
				idLabel.Name = "GameIdLabel"
				idLabel.Font = guiconfig.Font or Enum.Font.Gotham
				idLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
				idLabel.TextSize = 10
				idLabel.TextXAlignment = Enum.TextXAlignment.Left
				idLabel.Position = UDim2.new(0, 14, 0, 29)
				idLabel.Size = UDim2.new(1, -24, 0, 14)
				idLabel.BackgroundTransparency = 1
				idLabel.BorderSizePixel = 0
				idLabel.RichText = true
				idLabel.ZIndex = 2

				local function updateStatusLabel()
					nameLabel.Text = gameName .. ' <font size="10" color="rgb(125, 125, 125)">' .. versionStr .. '</font>'
					if isCurrentGame then
						idLabel.Text = '<font color="rgb(80, 220, 120)">Current Game</font>'
					else
						idLabel.Text = "Supported"
					end
				end

				updateStatusLabel()

				if not gameconfig.Name then
					local lookupId = placeId or (isCurrentGame and game.PlaceId)
					if lookupId then
						task.spawn(function()
							pcall(function()
								local info = mps:GetProductInfo(lookupId)
								if info and info.Name and nameLabel and nameLabel.Parent then
									gameName = info.Name
									updateStatusLabel()
								end
							end)
						end)
					end
				end

				if not placeId and gameId and (not gameImage or gameImage == "") then
					task.spawn(function()
						pcall(function()
							local uRes = game:HttpGet("https://games.roblox.com/v1/games?universeIds=" .. tostring(gameId))
							if uRes and uRes ~= "" then
								local uData = sv.http:JSONDecode(uRes)
								if uData and uData.data and uData.data[1] and uData.data[1].rootPlaceId then
									local rootId = uData.data[1].rootPlaceId
									if bgImg and bgImg.Parent then
										bgImg.Image = "rbxthumb://type=GameThumbnail&id=" .. tostring(rootId) .. "&w=768&h=432"
									end
								end
							end
						end)
					end)
				end

				-- // Hairline Divider (No stroke, pure 1px subtle divider)
				local divider = instance.frame(card)
				divider.Name = "LogsDivider"
				divider.Position = UDim2.new(0, 12, 0, collapsedHeight)
				divider.Size = UDim2.new(1, -24, 0, 1)
				divider.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				divider.BackgroundTransparency = 0.95
				divider.BorderSizePixel = 0
				divider.ZIndex = 2

				-- // Timeline Holder Frame (No inner strokes or nested cards)
				local timelineHolder = instance.frame(card)
				timelineHolder.Name = "TimelineHolder"
				timelineHolder.Position = UDim2.new(0, 14, 0, collapsedHeight + 10)
				timelineHolder.Size = UDim2.new(1, -28, 0, 0)
				timelineHolder.BackgroundTransparency = 1
				timelineHolder.BorderSizePixel = 0
				timelineHolder.ZIndex = 2

				local isOpen = false
				local currentEntries = {
					{
						Version = versionStr,
						Date = dateStr,
						Logs = changelogs,
					},
				}

				-- // Timeline Renderer matching Information tab styling
				local function renderTimeline(entryList)
					if entryList and #entryList > 0 then
						currentEntries = entryList
					end

					for _, child in ipairs(timelineHolder:GetChildren()) do
						child:Destroy()
					end

					local currentY = 0
					local firstCircleY = nil
					local lastLogY = 0

					local themeCol = guiconfig.Color or Color3.fromRGB(0, 208, 255)
					local colorHex = string.format("rgb(%d, %d, %d)", math.floor(themeCol.R * 255), math.floor(themeCol.G * 255), math.floor(themeCol.B * 255))

					local totalEntries = math.min(#currentEntries, 3)
					for eIdx = 1, totalEntries do
						local entry = currentEntries[eIdx]
						local isLatest = (eIdx == 1)
						local circleCenterY = currentY + 8
						if not firstCircleY then
							firstCircleY = circleCenterY
						end

						-- // Node circle
						local circle = instance.frame(timelineHolder)
						circle.Name = "NodeCircle"
						circle.AnchorPoint = Vector2.new(0.5, 0.5)
						circle.Position = UDim2.new(0, 8, 0, circleCenterY)
						circle.Size = UDim2.new(0, 7, 0, 7)
						circle.BorderSizePixel = 0
						instance.uicorner(circle).CornerRadius = UDim.new(1, 0)

						local cStroke = instance.uistroke(circle)
						cStroke.Thickness = 1.5
						if isLatest then
							circle.BackgroundColor3 = themeCol
							cStroke.Color = themeCol
							cStroke.Transparency = 0.3
						else
							circle.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
							cStroke.Color = Color3.fromRGB(150, 150, 150)
							cStroke.Transparency = 0.4
						end
						circle.ZIndex = 3

						-- // Version & Date Header
						local verLabel = instance.textlabel(timelineHolder)
						verLabel.Name = "VerLabel"
						verLabel.Font = Enum.Font.GothamBold
						verLabel.TextSize = 11
						verLabel.TextXAlignment = Enum.TextXAlignment.Left
						verLabel.Position = UDim2.new(0, 22, 0, currentY)
						verLabel.Size = UDim2.new(1, -22, 0, 16)
						verLabel.BackgroundTransparency = 1
						verLabel.BorderSizePixel = 0
						verLabel.ZIndex = 2
						verLabel.RichText = true

						local datePart = entry.Date and (" - " .. tostring(entry.Date)) or ""
						if isLatest then
							verLabel.Text = '<font color="' .. colorHex .. '">' .. tostring(entry.Version or "v0.0.0") .. '</font> <font color="rgb(130, 130, 130)">' .. datePart .. '</font>'
						else
							verLabel.Text = '<font color="rgb(200, 200, 200)">' .. tostring(entry.Version or "v0.0.0") .. '</font> <font color="rgb(120, 120, 120)">' .. datePart .. '</font>'
						end

						currentY = currentY + 22

						local logList = entry.Logs or {}
						local totalLogs = math.min(#logList, 5)
						for logIdx = 1, totalLogs do
							local logLine = logList[logIdx]
							local logRow = instance.frame(timelineHolder)
							logRow.Name = "LogRow"
							logRow.BackgroundTransparency = 1
							logRow.BorderSizePixel = 0
							logRow.Position = UDim2.new(0, 18, 0, currentY)
							logRow.Size = UDim2.new(1, -18, 0, 16)
							logRow.ZIndex = 2

							-- // Log bullet icon (chevron / >)
							local icon = instance.imagelabel(logRow)
							icon.Name = "LogIcon"
							icon.AnchorPoint = Vector2.new(0, 0.5)
							icon.Position = UDim2.new(0, 0, 0.5, 0)
							icon.Size = UDim2.new(0, 8, 0, 8)
							icon.BackgroundTransparency = 1
							icon.BorderSizePixel = 0
							icon.Image = "rbxassetid://126759169574128"
							icon.ImageColor3 = Color3.fromRGB(200, 200, 200)
							icon.ImageTransparency = 0.2
							icon.ZIndex = 2

							local txt = instance.textlabel(logRow)
							txt.Font = guiconfig.Font or Enum.Font.GothamMedium
							txt.Text = tostring(logLine)
							txt.TextColor3 = Color3.fromRGB(180, 180, 180)
							txt.TextSize = 10
							txt.TextXAlignment = Enum.TextXAlignment.Left
							txt.Position = UDim2.new(0, 13, 0, 0)
							txt.Size = UDim2.new(1, -13, 1, 0)
							txt.BackgroundTransparency = 1
							txt.BorderSizePixel = 0
							txt.TextTruncate = Enum.TextTruncate.AtEnd
							txt.ZIndex = 2

							lastLogY = currentY + 8
							currentY = currentY + 18
						end

						if eIdx < totalEntries then
							currentY = currentY + 8
						end
					end

					-- // Continuous vertical rail line
					if firstCircleY and lastLogY > firstCircleY then
						local rail = instance.frame(timelineHolder)
						rail.Name = "ContinuousRail"
						rail.AnchorPoint = Vector2.new(0.5, 0)
						rail.Position = UDim2.new(0, 8, 0, firstCircleY)
						rail.Size = UDim2.new(0, 1.5, 0, math.max(1, lastLogY - firstCircleY))
						rail.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
						rail.BackgroundTransparency = 0.85
						rail.BorderSizePixel = 0
						rail.ZIndex = 1
					end

					expandedHeight = collapsedHeight + 10 + currentY + 10
					timelineHolder.Size = UDim2.new(1, -28, 0, currentY)
					if isOpen then
						sv.ts:Create(card, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
							Size = UDim2.new(1, 0, 0, expandedHeight),
						}):Play()
					end
				end

				renderTimeline(currentEntries)

				-- // Remote GitHub Sync Loader
				local rawUrl = gameconfig.Url
					or gameconfig.ChangelogsUrl
					or (type(gameconfig.Changelogs) == "string" and gameconfig.Changelogs:find("^https?://") and gameconfig.Changelogs)
					or guiconfig.UpdateLogs
					or "https://raw.githubusercontent.com/ChloeRewite/Games/main/Changelogs/"

				task.spawn(function()
					local res = resolveUpdateLogs(rawUrl, placeId, gameconfig.GameId)
					if res and res.Entries and #res.Entries > 0 then
						local latest = res.Entries[1]
						if latest.Version then
							versionStr = tostring(latest.Version)
						end
						if latest.Date then
							dateStr = tostring(latest.Date)
						end
						if latest.Logs then
							changelogs = latest.Logs
						end
						updateStatusLabel()
						renderTimeline(res.Entries)
					end
				end)

				-- // Header Trigger Button for Accordion
				local trigger = instance.textbutton(card)
				trigger.Name = "HeaderTrigger"
				trigger.Position = UDim2.new(0, 0, 0, 0)
				trigger.Size = UDim2.new(1, 0, 0, collapsedHeight)
				trigger.BackgroundTransparency = 1
				trigger.Text = ""
				trigger.ZIndex = 10

				local function toggleAccordion()
					isOpen = not isOpen
					local targetH = isOpen and expandedHeight or collapsedHeight

					sv.ts:Create(card, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
						Size = UDim2.new(1, 0, 0, targetH),
					}):Play()
					-- // Strictly no white stroke when opened
					sv.ts:Create(uistroke, TweenInfo.new(0.25), {
						Transparency = isOpen and 1 or 0.92,
					}):Play()
				end

				trigger.Activated:Connect(toggleAccordion)

				registerSearchItem("Game: " .. gameName, card, "SupportedGameCard")
				countitem = countitem + 1
				yieldbuild()

				local cardfunc = {}
				function cardfunc:SetActive(active)
					isCurrentGame = (active == true)
					updateStatusLabel()
				end
				function cardfunc:SetName(newName)
					gameName = tostring(newName)
					updateStatusLabel()
				end
				function cardfunc:SetImage(newImg)
					bgImg.Image = tostring(newImg)
				end
				function cardfunc:SetLogs(newLogs, newVer, newDate)
					if newVer then versionStr = tostring(newVer) end
					if newDate then dateStr = tostring(newDate) end
					updateStatusLabel()
					if type(newLogs) == "table" then
						if newLogs.Entries then
							renderTimeline(newLogs.Entries)
							return
						elseif newLogs[1] and type(newLogs[1]) == "table" and newLogs[1].Logs then
							renderTimeline(newLogs)
							return
						else
							changelogs = newLogs
						end
					end
					renderTimeline({
						{
							Version = versionStr,
							Date = dateStr,
							Logs = changelogs,
						},
					})
				end
				function cardfunc:GetCard()
					return card
				end
				return cardfunc
			end
			items.AddSupportedGame = items.AddSupportedGameCard

			function items:AddUpdateLogs(logsconfig)
				logsconfig = logsconfig or {}
				local cardTitle = logsconfig.Title or "Update Logs"
				local entries = logsconfig.Entries or {
					{
						Version = "v0.0.1",
						Date = "20 Oct 2026",
						Logs = {
							"Sidebar Tab Swap (Main <-> Info Hub)",
							"User Profile Card & live uptime counter",
							"Current Game Card & active players counter",
							"4 tipe dropdown modern (Standar, Deskripsi, Ikon, Grid)",
							"Desain dark glass presisi tanpa stroke clipping",
						},
					},
					{
						Version = "v0.0.0",
						Date = "20 Oct 2026",
						Logs = {
							"Release",
						},
					},
				}

				local card = instance.frame(sectionadd)
				card.Name = "UpdateLogCard"
				card.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
				card.BackgroundTransparency = 0
				card.BorderSizePixel = 0
				card.ClipsDescendants = true
				card.LayoutOrder = countitem

				local uicorner = instance.uicorner(card)
				uicorner.CornerRadius = UDim.new(0, 6)

				local uistroke = instance.uistroke(card)
				uistroke.Color = Color3.fromRGB(255, 255, 255)
				uistroke.Thickness = 1
				uistroke.Transparency = 0.88

				local title = instance.textlabel(card)
				title.Name = "TitleLabel"
				title.Font = Enum.Font.GothamBold
				title.Text = tostring(cardTitle)
				title.TextColor3 = Color3.fromRGB(240, 240, 240)
				title.TextSize = 13
				title.TextXAlignment = Enum.TextXAlignment.Left
				title.Position = UDim2.new(0, 14, 0, 10)
				title.Size = UDim2.new(1, -28, 0, 16)
				title.BackgroundTransparency = 1
				title.BorderSizePixel = 0

				local divider = instance.frame(card)
				divider.Name = "Divider"
				divider.Position = UDim2.new(0, 14, 0, 32)
				divider.Size = UDim2.new(1, -28, 0, 1)
				divider.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				divider.BackgroundTransparency = 0.92
				divider.BorderSizePixel = 0

				local timelineHolder = instance.frame(card)
				timelineHolder.Name = "TimelineHolder"
				timelineHolder.Position = UDim2.new(0, 14, 0, 42)
				timelineHolder.Size = UDim2.new(1, -28, 0, 0)
				timelineHolder.BackgroundTransparency = 1
				timelineHolder.BorderSizePixel = 0

				-- // Timeline renderer
				local function renderTimeline(entryList, newTitle)
					if newTitle then
						cardTitle = tostring(newTitle)
						title.Text = cardTitle
					end

					for _, child in ipairs(timelineHolder:GetChildren()) do
						child:Destroy()
					end

					local currentY = 0
					local firstCircleY = nil
					local lastLogY = 0

					for eIdx, entry in ipairs(entryList or {}) do
						local isLatest = (eIdx == 1)
						local circleCenterY = currentY + 8
						if not firstCircleY then
							firstCircleY = circleCenterY
						end

						-- // Node circle
						local circle = instance.frame(timelineHolder)
						circle.Name = "NodeCircle"
						circle.AnchorPoint = Vector2.new(0.5, 0.5)
						circle.Position = UDim2.new(0, 8, 0, circleCenterY)
						circle.Size = UDim2.new(0, 7, 0, 7)
						circle.BorderSizePixel = 0
						instance.uicorner(circle).CornerRadius = UDim.new(1, 0)

						local cStroke = instance.uistroke(circle)
						cStroke.Thickness = 1.5
						if isLatest then
							circle.BackgroundColor3 = guiconfig.Color
							cStroke.Color = guiconfig.Color
							cStroke.Transparency = 0.3
						else
							circle.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
							cStroke.Color = Color3.fromRGB(150, 150, 150)
							cStroke.Transparency = 0.4
						end
						circle.ZIndex = 3

						-- // Version header
						local verLabel = instance.textlabel(timelineHolder)
						verLabel.Name = "VerLabel"
						verLabel.Font = Enum.Font.GothamBold
						verLabel.TextSize = 11
						verLabel.TextXAlignment = Enum.TextXAlignment.Left
						verLabel.Position = UDim2.new(0, 22, 0, currentY)
						verLabel.Size = UDim2.new(1, -22, 0, 16)
						verLabel.BackgroundTransparency = 1
						verLabel.BorderSizePixel = 0
						verLabel.ZIndex = 2
						verLabel.RichText = true

						local datePart = entry.Date and (" - " .. tostring(entry.Date)) or ""
						local colorHex = string.format("rgb(%d, %d, %d)", math.floor(guiconfig.Color.R * 255), math.floor(guiconfig.Color.G * 255), math.floor(guiconfig.Color.B * 255))
						if isLatest then
							verLabel.Text = '<font color="' .. colorHex .. '">' .. tostring(entry.Version or "v0.0.0") .. '</font> <font color="rgb(130, 130, 130)">' .. datePart .. '</font>'
						else
							verLabel.Text = '<font color="rgb(200, 200, 200)">' .. tostring(entry.Version or "v0.0.0") .. '</font> <font color="rgb(120, 120, 120)">' .. datePart .. '</font>'
						end

						currentY = currentY + 22

						local logList = entry.Logs or {}
						for _, logLine in ipairs(logList) do
							local logRow = instance.frame(timelineHolder)
							logRow.Name = "LogRow"
							logRow.BackgroundTransparency = 1
							logRow.BorderSizePixel = 0
							logRow.Position = UDim2.new(0, 18, 0, currentY)
							logRow.Size = UDim2.new(1, -18, 0, 16)
							logRow.ZIndex = 2

							-- // Log bullet icon
							local icon = instance.imagelabel(logRow)
							icon.Name = "LogIcon"
							icon.AnchorPoint = Vector2.new(0, 0.5)
							icon.Position = UDim2.new(0, 0, 0.5, 0)
							icon.Size = UDim2.new(0, 8, 0, 8)
							icon.BackgroundTransparency = 1
							icon.BorderSizePixel = 0
							icon.Image = "rbxassetid://126759169574128"
							icon.ImageColor3 = Color3.fromRGB(200, 200, 200)
							icon.ImageTransparency = 0.2
							icon.ZIndex = 2

							local txt = instance.textlabel(logRow)
							txt.Font = guiconfig.Font
							txt.Text = tostring(logLine)
							txt.TextColor3 = Color3.fromRGB(180, 180, 180)
							txt.TextSize = 10
							txt.TextXAlignment = Enum.TextXAlignment.Left
							txt.Position = UDim2.new(0, 13, 0, 0)
							txt.Size = UDim2.new(1, -13, 1, 0)
							txt.BackgroundTransparency = 1
							txt.BorderSizePixel = 0
							txt.TextTruncate = Enum.TextTruncate.AtEnd
							txt.ZIndex = 2

							lastLogY = currentY + 8
							currentY = currentY + 18
						end

						if eIdx < #entryList then
							currentY = currentY + 8
						end
					end

					-- // Continuous vertical rail line
					local rail = instance.frame(timelineHolder)
					rail.Name = "ContinuousRail"
					rail.AnchorPoint = Vector2.new(0.5, 0)
					rail.Position = UDim2.new(0, 8, 0, firstCircleY or 8)
					rail.Size = UDim2.new(0, 1.5, 0, math.max(1, lastLogY - (firstCircleY or 8)))
					rail.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
					rail.BackgroundTransparency = 0.85
					rail.BorderSizePixel = 0
					rail.ZIndex = 1

					local totalHeight = 42 + currentY + 8
					card.Size = UDim2.new(1, 0, 0, totalHeight)
				end

				renderTimeline(entries)

				registerSearchItem("Logs: " .. cardTitle, card, "UpdateLogCard")
				countitem = countitem + 1
				yieldbuild()

				local logfunc = {}
				function logfunc:SetEntries(newEntries, newTitle)
					if type(newEntries) == "table" then
						renderTimeline(newEntries, newTitle)
					end
				end
				function logfunc:GetCard()
					return card
				end
				return logfunc
			end

			local function pressEffect(btn)
				if not btn then
					return
				end
				local origColor = btn.BackgroundColor3
				sv.ts
					:Create(btn, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						BackgroundColor3 = Color3.fromRGB(35, 35, 35),
					})
					:Play()
				task.delay(0.08, function()
					if btn and btn.Parent then
						sv.ts
							:Create(btn, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								BackgroundColor3 = origColor,
							})
							:Play()
					end
				end)
			end

			function items:AddButton(buttonconfig)
				buttonconfig = buttonconfig or {}
				buttonconfig.Title = buttonconfig.Title or buttonconfig.Name or "Confirm"
				buttonconfig.Callback = buttonconfig.Callback or function() end
				buttonconfig.SubTitle = buttonconfig.SubTitle or nil
				buttonconfig.SubCallback = buttonconfig.SubCallback or function() end

				local buttonObj

				if buttonconfig.SubTitle then
					local container = instance.frame(sectionadd)
					container.Name = "ButtonRow"
					container.BackgroundTransparency = 1
					container.BorderSizePixel = 0
					container.Size = UDim2.new(1, 0, 0, 36)
					container.LayoutOrder = countitem

					local gap = 3

					local btn1 = instance.textbutton(container)
