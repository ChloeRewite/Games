					if queueMiniRefresh then
						queueMiniRefresh()
					end
				end

				local style = dropdownconfig.Style or "Accordion"

				if style == "Accordion" then
					local dropSubText = dropdownconfig.Title2 or dropdownconfig.Content or dropdownconfig.SubTitle or dropdownconfig.Description
