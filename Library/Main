		-- // Format uptime helper
		local function formatUptime(sec)
			sec = math.max(0, math.floor(sec))
			local d = math.floor(sec / 86400)
			local h = math.floor((sec % 86400) / 3600)
			local m = math.floor((sec % 3600) / 60)
			return string.format("%dD %dH %dM", d, h, m)
		end

		task.spawn(function()
			while card and card.Parent do
				local serverSec = workspace.DistributedGameTime
				local scriptSec = os.time() - (scriptStartTime or os.time())
				serverUptimeLabel.Text = "Server Uptime: " .. formatUptime(serverSec)
				scriptUptimeLabel.Text = "Script Uptime: " .. formatUptime(scriptSec)
				task.wait(1)
			end
		end)

