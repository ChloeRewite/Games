	local toggleScreenGui = nil
	local toggleInputConn = nil

	function guifunc:DestroyGui()
		disconnectAll()
		for key, timer in pairs(resizeDebounceTable) do
			if timer then
				task.cancel(timer)
			end
		end
		resizeDebounceTable = {}
		for name in pairs(heartbeatCallbacks) do
			unregisterHeartbeat(name)
		end

		if elementHudDragConn then
			elementHudDragConn:Disconnect()
			elementHudDragConn = nil
		end

		if elementHud then
			elementHud:Destroy()
			elementHud = nil
		end

		if miniHolder and miniHolder.Parent then
			miniHolder:Destroy()
			miniHolder = nil
		end

		if footerOverlay then
			footerOverlay:Destroy()
			footerOverlay = nil
		end

		if statConn then
			statConn:Disconnect()
			statConn = nil
		end

		if toggleInputConn then
			toggleInputConn:Disconnect()
			toggleInputConn = nil
		end

		if toggleScreenGui and toggleScreenGui.Parent then
			toggleScreenGui:Destroy()
			toggleScreenGui = nil
		end

		if dropshadowholder then
			pcall(function() dropshadowholder:Destroy() end)
		end

		if chloeex then
			pcall(function() chloeex:Destroy() end)
		end

		local possibleParents = { (gethui and gethui()), sv.coregui, sv.plrs.LocalPlayer and sv.plrs.LocalPlayer:FindFirstChild("PlayerGui") }
		for _, parent in ipairs(possibleParents) do
			if parent then
				for _, child in ipairs(parent:GetChildren()) do
					if child.Name == "ToggleUIButton" or child.Name == "Chloeex" or child.Name == "ChloeX_ActiveElements" then
						pcall(function() child:Destroy() end)
					end
				end
			end
		end

		if getinstances then
			pcall(function()
				for _, inst in ipairs(getinstances()) do
					if (inst.Name == "Chloeex" or inst.Name == "ToggleUIButton" or inst.Name == "DropShadowHolder") and (inst:IsA("ScreenGui") or inst:IsA("Frame")) then
						pcall(function() inst:Destroy() end)
					end
				end
			end)
		end

		getgenv().ChloeX_Instance = nil
		getgenv().ChloeX_Running = nil
		getgenv().ChloeX_ReopenPrompt = nil
	end

	local function showClosePrompt()
		local existing = dropshadowholder:FindFirstChild("CloseOverlay") or main:FindFirstChild("CloseOverlay")
		if existing then
			return
		end

		local overlay = instance.frame(dropshadowholder)
		overlay.Name = "CloseOverlay"
		overlay.Size = UDim2.new(1, 0, 1, 0)
		overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		overlay.BackgroundTransparency = 0.35
		overlay.BorderSizePixel = 0
		overlay.ZIndex = 5000

		local overlayCorner = instance.uicorner(overlay)
