	-- // Purge lingering Chloe X guis to prevent duplicate cards or windows
	local function purgeLingeringGuis(p)
		if p then
			for _, child in ipairs(p:GetChildren()) do
				if child.Name == "Chloeex" or child.Name == "ToggleUIButton" or child.Name == "ChloeX_ActiveElements" or child.Name == "NotifyGui" or child.Name == "OverlayGui" then
					pcall(function() child:Destroy() end)
				end
			end
		end
		if getinstances then
			pcall(function()
				for _, inst in ipairs(getinstances()) do
					if (inst.Name == "Chloeex" or inst.Name == "ToggleUIButton") and inst:IsA("ScreenGui") then
						pcall(function() inst:Destroy() end)
					end
				end
			end)
		end
	end
	local guiParent = (gethui and gethui()) or sv.coregui
	purgeLingeringGuis(guiParent)
	if sv.plrs.LocalPlayer then
		purgeLingeringGuis(sv.plrs.LocalPlayer:FindFirstChild("PlayerGui"))
	end
