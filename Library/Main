	miniEmptyLabel.Name = "EmptyLabel"
	miniEmptyLabel.Size = UDim2.new(1, -16, 1, 0)
	miniEmptyLabel.Position = UDim2.new(0, 8, 0, 0)
	miniEmptyLabel.BackgroundTransparency = 1
	miniEmptyLabel.Font = guiconfig.Font or Enum.Font.GothamBold
	miniEmptyLabel.TextSize = 10
	miniEmptyLabel.TextColor3 = Color3.fromRGB(130, 130, 130)
	miniEmptyLabel.TextWrapped = true
	miniEmptyLabel.Text = "No active modules.\nSearch above to add features."

	refreshMiniItems = function()
		if not miniSearchInput then return end
		local query = string.lower(miniSearchInput.Text or "")
		local hasQuery = (query ~= "")
		local visibleCount = 0

		if miniSearchClear then
			miniSearchClear.Visible = hasQuery
		end

		for _, item in ipairs(miniElements) do
			if item.Row and item.Row.Parent then
				local matchesSearch = false
				if hasQuery then
					matchesSearch = (string.find(string.lower(item.Title), query, 1, true) ~= nil)
					if not matchesSearch and item.SectionTitle then
						matchesSearch = (string.find(string.lower(item.SectionTitle), query, 1, true) ~= nil)
					end
				end

				local shouldShow = false
				if hasQuery then
					shouldShow = matchesSearch
				else
					local active = false
					pcall(function()
						active = item.IsActive()
					end)
					shouldShow = active or (item.IsPinned == true)
				end

				item.Row.Visible = shouldShow
				if shouldShow then
					visibleCount = visibleCount + 1
				end
			end
		end

		-- // Update Mini UI section headers visibility
		for _, sec in ipairs(miniSections) do
			if sec.Header and sec.Header.Parent then
				local secHasVisible = false
				for _, item in ipairs(sec.Items) do
					if item.Row and item.Row.Parent and item.Row.Visible then
						secHasVisible = true
						break
					end
				end
				sec.Header.Visible = secHasVisible
			end
		end

		if miniEmptyState then
			miniEmptyState.Visible = (visibleCount == 0)
			if hasQuery then
				miniEmptyLabel.Text = "No modules match \"" .. query .. "\""
			else
				miniEmptyLabel.Text = "No active modules.\nSearch above to add features."
			end
		end
	end

	miniSearchInput:GetPropertyChangedSignal("Text"):Connect(function()
		refreshMiniItems()
	end)

	local miniRefreshQueued = false
	queueMiniRefresh = function()
		if miniRefreshQueued then return end
		miniRefreshQueued = true
		task.defer(function()
			miniRefreshQueued = false
			if refreshMiniItems then
				refreshMiniItems()
			end
		end)
	end

	-- // Mini UI Resizing Grip
	local isMiniResizing = false
	local miniResizeStart = nil
	local miniStartSize = nil

	local miniResize = instance.frame(miniHolder)
	miniResize.Name = "MiniResize"
	miniResize.AnchorPoint = Vector2.new(1, 1)
	miniResize.Position = UDim2.new(1, 0, 1, 0)
	miniResize.Size = UDim2.new(0, 18, 0, 18)
	miniResize.BackgroundTransparency = 1
	miniResize.Active = true
	miniResize.ZIndex = 70

	local miniResizeIcon = instance.imagelabel(miniResize)
	miniResizeIcon.Name = "ResizeIcon"
	miniResizeIcon.Image = "rbxassetid://13212534398"
	miniResizeIcon.ImageColor3 = Color3.fromRGB(160, 160, 160)
	miniResizeIcon.ImageTransparency = 0.5
	miniResizeIcon.AnchorPoint = Vector2.new(1, 1)
	miniResizeIcon.Position = UDim2.new(1, -3, 1, -3)
	miniResizeIcon.Size = UDim2.new(0, 10, 0, 10)
	miniResizeIcon.BackgroundTransparency = 1
	miniResizeIcon.ZIndex = 71

	miniResize.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isMiniResizing = true
			miniResizeStart = input.Position
			miniStartSize = Vector2.new(miniHolder.AbsoluteSize.X, miniHolder.AbsoluteSize.Y)

			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					isMiniResizing = false
					conn:Disconnect()
				end
			end)
		end
	end)

	trackConnection(sv.uis.InputChanged:Connect(function(input)
		if isMiniResizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - miniResizeStart
			local newW = math.clamp(miniStartSize.X + delta.X, 160, 450)
			miniWidth = newW

			if dropshadowholder.Visible then
				local mainH = math.max(150, dropshadowholder.AbsoluteSize.Y)
				miniHeight = mainH
				miniHolder.Size = UDim2.new(0, newW, 0, mainH)
				if autoDockMini and not isMiniDragging then
					updateMiniPosition(false)
				end
			else
				local newH = math.clamp(miniStartSize.Y + delta.Y, 180, 700)
				miniHeight = newH
				miniHolder.Size = UDim2.new(0, newW, 0, newH)
			end
		end
	end), "miniHolder.resize")

	do
		local dragging = false
		local dragstart, startpos
		local pressPos = Vector2.new(0, 0)
		local hasMoved = false

		local function onHeaderInputBegan(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				isMiniDragging = false
				dragstart = input.Position
				pressPos = Vector2.new(input.Position.X, input.Position.Y)
				startpos = miniHolder.Position
				hasMoved = false
			end
		end

		miniTop.InputBegan:Connect(onHeaderInputBegan)
		miniTitle.InputBegan:Connect(onHeaderInputBegan)

		trackConnection(sv.uis.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				if (Vector2.new(input.Position.X, input.Position.Y) - pressPos).Magnitude > 6 then
					hasMoved = true
					isMiniDragging = true
				end
				if isMiniDragging then
					local delta = input.Position - dragstart
					miniHolder.Position = clampPositionToScreen(
						miniHolder,
						startpos.X.Scale,
						startpos.X.Offset + delta.X,
						startpos.Y.Scale,
						startpos.Y.Offset + delta.Y
					)
				end
			end
		end), "miniHolder.drag")

		trackConnection(sv.uis.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				if dragging then
					dragging = false
					isMiniDragging = false
				end
			end
		end), "miniHolder.dragEnd")
	end

	-- // Docking & Swap-to-Center Animation (Height always syncs with main script window)
	updateMiniPosition = function(animate, force)
		if not miniHolder or not miniHolder.Parent then return end
		if not autoDockMini then return end
		if not force and (isMiniDragging or isMiniResizing) then return end

		local isMainOpen = dropshadowholder and dropshadowholder.Visible
		local targetUDim2
		local curW = miniWidth
		local mainSize = dropshadowholder.AbsoluteSize
		local screenW = chloeex.AbsoluteSize.X
		local gap = 12

		-- // Height always matches main script window exactly when expanded
		if mainSize.Y > 50 then
			miniHeight = mainSize.Y
			miniHolder.Size = UDim2.new(0, miniWidth, 0, miniHeight)
		end
		local curH = miniHeight

		if isMainOpen and miniHolder.Visible then
			local mainPos = dropshadowholder.AbsolutePosition
			local totalW = mainSize.X + gap + curW
			local fitsOnScreen = (totalW <= screenW - 16)
			local fitsOnRight = (mainPos.X + mainSize.X + gap + curW <= screenW - 8)

			if not hasInitializedLayout and fitsOnScreen and (isMobile or not fitsOnRight) and not draggable.dragging then
				hasInitializedLayout = true
				-- // Symmetrically center Main UI and Mini UI together so neither hits the screen edges
				local groupMargin = math.max(8, math.floor((screenW - totalW) / 2))
				local mainTargetX = groupMargin + math.floor(mainSize.X / 2)
				local miniTargetX = groupMargin + mainSize.X + gap + math.floor(curW / 2)
				local yOffset = isMobile and 30 or 0

				local mainTargetUDim2 = UDim2.new(0, mainTargetX, 0.5, yOffset)
				local miniTargetUDim2 = UDim2.new(0, miniTargetX, 0.5, yOffset)

				if animate then
					sv.ts:Create(dropshadowholder, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
						Position = mainTargetUDim2
					}):Play()
					sv.ts:Create(miniHolder, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
						Position = miniTargetUDim2
					}):Play()
				else
					dropshadowholder.Position = mainTargetUDim2
					miniHolder.Position = miniTargetUDim2
				end
				if updateCardPosition and not isCardDragging then
					updateCardPosition(animate, mainTargetUDim2)
				end
				return
			else
				local rightX = mainPos.X + mainSize.X + gap + (curW / 2)
				if (rightX + (curW / 2)) > (screenW - 8) then
					rightX = mainPos.X - gap - (curW / 2)
				end
				rightX = math.clamp(rightX, (curW / 2) + 8, math.max(screenW - (curW / 2) - 8, (curW / 2) + 8))

				targetUDim2 = UDim2.new(0, rightX, dropshadowholder.Position.Y.Scale, dropshadowholder.Position.Y.Offset)
			end
		else
			local yOffset = isMobile and 30 or 0
			targetUDim2 = UDim2.new(0.5, 0, 0.5, yOffset)
		end

		if animate then
			sv.ts:Create(miniHolder, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Position = targetUDim2
			}):Play()
		else
			miniHolder.Position = targetUDim2
		end
		if updateCardPosition and not isCardDragging then
			updateCardPosition(animate)
		end
	end

	trackConnection(miniHolder:GetPropertyChangedSignal("Visible"):Connect(function()
		if updateToggleUIVisibility then
			updateToggleUIVisibility()
		end
		if not miniHolder.Visible then
			if not hasInitializedLayout and dropshadowholder and dropshadowholder.Visible and not draggable.dragging then
				local yOffset = isMobile and 30 or 0
				local centerUDim2 = UDim2.new(0.5, 0, 0.5, yOffset)
				sv.ts:Create(dropshadowholder, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Position = centerUDim2
				}):Play()
				if updateCardPosition and not isCardDragging then
					updateCardPosition(true, centerUDim2)
				end
			end
		else
			updateMiniPosition(true)
		end
	end), "miniHolder.onVisibleChanged")

	trackConnection(dropshadowholder:GetPropertyChangedSignal("Visible"):Connect(function()
		updateMiniPosition(true)
		if updateToggleUIVisibility then
			updateToggleUIVisibility()
		end
		if updateCardPosition and not isCardDragging then
			updateCardPosition(true)
		end
	end), "miniHolder.onMainVisibleChanged")

	trackConnection(dropshadowholder:GetPropertyChangedSignal("Position"):Connect(function()
		if dropshadowholder.Visible and autoDockMini and not isMiniDragging and not isMiniResizing then
			updateMiniPosition(false)
		end
		if updateCardPosition and not isCardDragging then
			updateCardPosition(false)
		end
	end), "miniHolder.onMainPositionChanged")

	trackConnection(dropshadowholder:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if dropshadowholder.Visible and autoDockMini and not isMiniDragging and not isMiniResizing then
			updateMiniPosition(false)
		end
		if updateCardPosition and not isCardDragging then
			updateCardPosition(false)
		end
	end), "miniHolder.onMainAbsoluteSizeChanged")

	task.defer(function()
		updateMiniPosition(false)
	end)

	-- // Global Keybind Listener (Main UI: F3, Mini UI: F4)
	trackConnection(sv.uis.InputBegan:Connect(function(input, gpe)
		if gpe or isKeybindListening then
			return
		end
		if input.KeyCode == mainToggleKey then
			if dropshadowholder then
				dropshadowholder.Visible = not dropshadowholder.Visible
			end
		elseif input.KeyCode == miniToggleKey then
			if isMiniUIEnabled and miniHolder then
				miniHolder.Visible = not miniHolder.Visible
			end
		end
	end), "window.globalKeybinds")

	-- // ToggleUI Button (Classic Square Icon)
