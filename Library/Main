		makeFooterToggle(footerOverlay, "Hide Identity", "HideIdentity", updateIdent)
		makeFooterToggle(footerOverlay, "Show Element", "ShowElement", updateElementHud)
	end)

	if guiconfig.LoadUserThumbnail then
