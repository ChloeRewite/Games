		local function updateMainBtnVisual()
			if updateAllBtnVisuals then updateAllBtnVisuals() return end
		end

		local function updateMiniBtnVisual()
			if updateAllBtnVisuals then updateAllBtnVisuals() return end
		end

		btnMain.MouseEnter:Connect(function()
