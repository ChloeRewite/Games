					inputsub.TextColor3 = Color3.fromRGB(255, 255, 255)
					inputsub.TextTransparency = 0.5
					inputsub.TextXAlignment = Enum.TextXAlignment.Left
					inputsub.TextYAlignment = Enum.TextYAlignment.Top
					inputsub.BackgroundTransparency = 1
					inputsub.Position = UDim2.new(0, 10, 0, 21)
					inputsub.Size = UDim2.new(1, -20, 0, 14)
					inputsub.TextTruncate = Enum.TextTruncate.AtEnd
				end

				local inputtextbox = instance.textbox(inputcontainer)
				inputtextbox.Font = Enum.Font.GothamBold
				inputtextbox.PlaceholderText = inputconfig.Placeholder
				inputtextbox.PlaceholderColor3 = Color3.fromRGB(180, 180, 180)
				inputtextbox.TextTransparency = 0
				inputtextbox.Text = inputconfig.Default
				inputtextbox.TextSize = 11
				inputtextbox.TextColor3 = Color3.fromRGB(255, 255, 255)
				inputtextbox.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
				inputtextbox.BackgroundTransparency = 0
				inputtextbox.TextXAlignment = Enum.TextXAlignment.Left
				inputtextbox.ClearTextOnFocus = false
				inputtextbox.Position = inputSubText and UDim2.new(0, 10, 0, 39) or UDim2.new(0, 10, 0, 26)
				inputtextbox.Size = UDim2.new(1, -20, 0, 24)
				inputtextbox.ClipsDescendants = true
				inputtextbox.TextTruncate = Enum.TextTruncate.AtEnd
				instance.uicorner(inputtextbox).CornerRadius = UDim.new(0, 4)
				local iboxstroke = instance.uistroke(inputtextbox)
				iboxstroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				iboxstroke.Color = Color3.fromRGB(255, 255, 255)
				iboxstroke.Thickness = 1
				iboxstroke.Transparency = 0.88

