						sv.ts:Create(searchStroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(255, 255, 255), Transparency = 0.5 }):Play()
						sv.ts:Create(searchIcon, TweenInfo.new(0.15), { ImageColor3 = Color3.fromRGB(220, 220, 220) }):Play()
					end)
					searchbox.FocusLost:Connect(function()
						sv.ts:Create(searchStroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(255, 255, 255), Transparency = 0.9 }):Play()
						sv.ts:Create(searchIcon, TweenInfo.new(0.15), { ImageColor3 = Color3.fromRGB(160, 160, 160) }):Play()
					end)

					local scrollselect = instance.scrollingframe(dropdown)
					scrollselect.Name = "ScrollSelect"
					scrollselect.Position = UDim2.new(0, 8, 0, headHeight + 32)
					scrollselect.Size = UDim2.new(1, -16, 0, 0)
					scrollselect.BackgroundTransparency = 1
					scrollselect.BorderSizePixel = 0
					scrollselect.ScrollBarThickness = 0
					scrollselect.ScrollBarImageTransparency = 1
					scrollselect.CanvasSize = UDim2.new(0, 0, 0, 0)

					local uilist = instance.uilistlayout(scrollselect)
					uilist.Padding = UDim.new(0, 4)
					uilist.SortOrder = Enum.SortOrder.LayoutOrder

					uilist:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
						scrollselect.CanvasSize = UDim2.new(0, 0, 0, uilist.AbsoluteContentSize.Y)
					end)

					local isOpen = false
					local optionCount = 0

					local function updateAccordionSize(animate)
						local visibleCount = 0
						for _, opt in ipairs(scrollselect:GetChildren()) do
							if opt.Name == "Option" and opt.Visible then
								visibleCount = visibleCount + 1
							end
						end
						local contentHeight = math.min(140, uilist.AbsoluteContentSize.Y + 4)
						if visibleCount == 0 then contentHeight = 20 end
						local totalH = isOpen and (headHeight + 32 + contentHeight + 8) or headHeight
						local rot = isOpen and 0 or -90

						if animate then
							sv.ts:Create(dropdown, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								Size = UDim2.new(1, 0, 0, totalH)
							}):Play()
							sv.ts:Create(scrollselect, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								Size = UDim2.new(1, -16, 0, isOpen and contentHeight or 0)
							}):Play()
							sv.ts:Create(optionimg, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								Rotation = rot
							}):Play()
						else
							dropdown.Size = UDim2.new(1, 0, 0, totalH)
							scrollselect.Size = UDim2.new(1, -16, 0, isOpen and contentHeight or 0)
							optionimg.Rotation = rot
						end
						task.defer(queueSectionResize)
					end

					local function updateClearBtnVisibility()
						if not clearBtn then return end
						local hasSearch = (searchbox.Text ~= "")
						local hasVal = false
						if dropdownconfig.Multi then
							hasVal = (type(dropdownfunc.Value) == "table" and #dropdownfunc.Value > 0)
						else
							hasVal = (dropdownfunc.Value ~= nil and dropdownfunc.Value ~= "")
						end
						clearBtn.Visible = hasSearch or hasVal
					end

					searchbox:GetPropertyChangedSignal("Text"):Connect(function()
						local query = string.lower(searchbox.Text)
						for _, opt in ipairs(scrollselect:GetChildren()) do
							if opt.Name == "Option" and opt:FindFirstChild("OptionText") then
								local text = string.lower(opt.OptionText.Text)
								local d = opt:FindFirstChild("OptionDesc")
								local descText = d and string.lower(d.Text) or ""
								opt.Visible = (query == "") or string.find(text, query, 1, true) or string.find(descText, query, 1, true)
							end
						end
						updateClearBtnVisibility()
						task.defer(function()
							updateAccordionSize(true)
						end)
					end)

					clearBtn.Activated:Connect(function()
						if searchbox.Text ~= "" then
							searchbox.Text = ""
						else
							dropdownfunc:ClearSelection()
						end
					end)

					headbtn.Activated:Connect(function()
						isOpen = not isOpen
						updateAccordionSize(true)
					end)

					function dropdownfunc:Clear()
						for _, dropframe in ipairs(scrollselect:GetChildren()) do
							if dropframe.Name == "Option" then
								dropframe:Destroy()
							end
						end
						optionCount = 0
						dropdownfunc.Value = dropdownconfig.Multi and {} or nil
						dropdownfunc.Options = {}
