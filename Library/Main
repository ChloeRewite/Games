							txtBox.Size = UDim2.new(1, -24, 0, 24)
						else
							box.Size = isSub and UDim2.new(0.5, -1, 1, 0) or UDim2.new(0.5, 0, 1, 0)
							box.Position = isSub and UDim2.new(0.5, 1, 0, 0) or UDim2.new(0, 0, 0, 0)
							titleLbl.Position = isSub and UDim2.new(0, 8, 0, 6) or UDim2.new(0, 10, 0, 6)
							titleLbl.Size = UDim2.new(1, -18, 0, 14)
							titleLbl.TextSize = 11
							txtBox.Position = isSub and UDim2.new(0, 8, 0, 26) or UDim2.new(0, 10, 0, 26)
							txtBox.Size = UDim2.new(1, -18, 0, 24)
						end

