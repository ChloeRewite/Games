				if not isInfo and miniScroll then
					miniLayoutOrder = miniLayoutOrder + 1
					local mRow = instance.frame(miniScroll)
					mRow.Name = "MiniInput_" .. inputconfig.Title
					mRow.LayoutOrder = miniLayoutOrder
					mRow.Size = UDim2.new(1, 0, 0, 42)
					mRow.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
					mRow.BackgroundTransparency = 0.3
					mRow.BorderSizePixel = 0
					instance.uicorner(mRow).CornerRadius = UDim.new(0, 5)

					local mStroke = instance.uistroke(mRow)
					mStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					mStroke.Color = Color3.fromRGB(255, 255, 255)
					mStroke.Thickness = 1
					mStroke.Transparency = 0.92

					local mTitle = instance.textlabel(mRow)
					mTitle.Font = guiconfig.Font or Enum.Font.GothamBold
					mTitle.Text = inputconfig.Title
					mTitle.TextSize = 11
					mTitle.TextColor3 = Color3.fromRGB(210, 210, 210)
					mTitle.TextXAlignment = Enum.TextXAlignment.Left
					mTitle.TextTruncate = Enum.TextTruncate.AtEnd
					mTitle.BackgroundTransparency = 1
					mTitle.Position = UDim2.new(0, 8, 0, 4)
					mTitle.Size = UDim2.new(1, -16, 0, 14)

					local mBox = instance.textbox(mRow)
					mBox.Font = guiconfig.Font or Enum.Font.GothamBold
					mBox.Text = tostring(inputfunc.Value or "")
					mBox.PlaceholderText = inputconfig.Placeholder or "Type here..."
					mBox.TextSize = 10
					mBox.TextColor3 = Color3.fromRGB(240, 240, 240)
					mBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
					mBox.TextXAlignment = Enum.TextXAlignment.Left
					mBox.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
					mBox.BorderSizePixel = 0
					mBox.Position = UDim2.new(0, 8, 0, 20)
					mBox.Size = UDim2.new(1, -16, 0, 18)
					mBox.ClearTextOnFocus = false
					instance.uicorner(mBox).CornerRadius = UDim.new(0, 3)

					local mBoxStroke = instance.uistroke(mBox)
					mBoxStroke.Color = Color3.fromRGB(255, 255, 255)
					mBoxStroke.Thickness = 1
					mBoxStroke.Transparency = 0.9

					local mPadding = instance.uipadding(mBox)
					mPadding.PaddingLeft = UDim.new(0, 4)

					mBox.FocusLost:Connect(function()
						inputfunc:Set(mBox.Text)
					end)

					local oldInputSet = inputfunc.Set
					function inputfunc:Set(val)
						oldInputSet(self, val)
						if mBox.Text ~= tostring(val or "") then
							mBox.Text = tostring(val or "")
						end
						if refreshMiniItems then
							refreshMiniItems()
						end
					end

					local mItemEntry = {
						Type = "Input",
						Title = inputconfig.Title,
						SectionTitle = sectiontitletext,
						Row = mRow,
						IsActive = function()
							return inputfunc.Value ~= nil and inputfunc.Value ~= ""
						end,
					}
					table.insert(miniElements, mItemEntry)
					if currentMiniSection then
						table.insert(currentMiniSection.Items, mItemEntry)
					end
					if queueMiniRefresh then
						queueMiniRefresh()
					end
				end

				countitem = countitem + 1
				yieldbuild()
				config.elements[configkey] = inputfunc
				registerSearchItem(inputconfig.Title, inputcontainer, "Input")
				return inputfunc
			end

			-- // AddKeybind Element
			function items:AddKeybind(keybindconfig)
				keybindconfig = keybindconfig or {}
				keybindconfig.Title = keybindconfig.Title or "Keybind"
				keybindconfig.Default = keybindconfig.Default or Enum.KeyCode.None
				keybindconfig.Callback = keybindconfig.Callback or function(key) end

				local configkey = makeConfigKey("Keybind", keybindconfig.Title)
				local normKey = normalizeConfigKey(configkey)
				if config.data[configkey] ~= nil then
					local savedName = config.data[configkey]
					if typeof(savedName) == "string" and Enum.KeyCode[savedName] then
						keybindconfig.Default = Enum.KeyCode[savedName]
					end
				elseif config.data[normKey] ~= nil then
					local savedName = config.data[normKey]
					if typeof(savedName) == "string" and Enum.KeyCode[savedName] then
						keybindconfig.Default = Enum.KeyCode[savedName]
					end
				end

				local keybindfunc = {
					Value = keybindconfig.Default,
					Default = keybindconfig.Default,
					_configType = "Keybind",
				}

				local keyRow = instance.frame(sectionadd)
				keyRow.Name = "Keybind_" .. keybindconfig.Title
				keyRow.Size = UDim2.new(1, 0, 0, 46)
				keyRow.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
				keyRow.BackgroundTransparency = 0
				keyRow.BorderSizePixel = 0
				keyRow.LayoutOrder = countitem
				instance.uicorner(keyRow).CornerRadius = UDim.new(0, 6)

				local kStroke = instance.uistroke(keyRow)
				kStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				kStroke.Color = Color3.fromRGB(255, 255, 255)
				kStroke.Thickness = 1
				kStroke.Transparency = 0.88

				local kTitle = instance.textlabel(keyRow)
				kTitle.Font = guiconfig.Font or Enum.Font.GothamBold
				kTitle.Text = keybindconfig.Title
				kTitle.TextSize = 13
				kTitle.TextColor3 = Color3.fromRGB(230, 230, 230)
				kTitle.TextXAlignment = Enum.TextXAlignment.Left
				kTitle.BackgroundTransparency = 1
				kTitle.Position = UDim2.new(0, 10, 0, 0)
				kTitle.Size = UDim2.new(1, -110, 1, 0)

				local keySubText = keybindconfig.Title2 or keybindconfig.Content or keybindconfig.SubTitle or keybindconfig.Description
				if keySubText and tostring(keySubText) ~= "" then
					keyRow.Size = UDim2.new(1, 0, 0, 56)
					kTitle.Position = UDim2.new(0, 10, 0, 10)
					kTitle.Size = UDim2.new(1, -110, 0, 13)

					local kSub = instance.textlabel(keyRow)
					kSub.Name = "KeybindSubTitle"
					kSub.Font = kTitle.Font
					kSub.Text = tostring(keySubText)
					kSub.TextSize = kTitle.TextSize - 1
					kSub.TextColor3 = Color3.fromRGB(255, 255, 255)
					kSub.TextTransparency = 0.5
					kSub.TextXAlignment = Enum.TextXAlignment.Left
					kSub.TextYAlignment = Enum.TextYAlignment.Top
					kSub.BackgroundTransparency = 1
					kSub.Position = UDim2.new(0, 10, 0, 28)
					kSub.Size = UDim2.new(1, -110, 0, 16)
					kSub.TextTruncate = Enum.TextTruncate.AtEnd
				end

				local kBadge = instance.frame(keyRow)
				kBadge.Name = "KeyBadge"
				kBadge.AnchorPoint = Vector2.new(1, 0.5)
				kBadge.Position = UDim2.new(1, -10, 0.5, 0)
				kBadge.Size = UDim2.new(0, 75, 0, 26)
				kBadge.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
				kBadge.BorderSizePixel = 0
				instance.uicorner(kBadge).CornerRadius = UDim.new(0, 4)

				local kBadgeStroke = instance.uistroke(kBadge)
				kBadgeStroke.Color = Color3.fromRGB(255, 255, 255)
				kBadgeStroke.Thickness = 1
				kBadgeStroke.Transparency = 0.85

				local kLabel = instance.textlabel(kBadge)
				kLabel.Font = Enum.Font.GothamBold
				kLabel.Text = (keybindfunc.Value and keybindfunc.Value.Name) or "None"
				kLabel.TextSize = 11
				kLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
				kLabel.TextXAlignment = Enum.TextXAlignment.Center
				kLabel.BackgroundTransparency = 1
				kLabel.Size = UDim2.new(1, 0, 1, 0)

				local kBtn = instance.textbutton(kBadge)
				kBtn.Text = ""
				kBtn.BackgroundTransparency = 1
				kBtn.Size = UDim2.new(1, 0, 1, 0)

				local listening = false
				local tempConn = nil

				local function stopListening()
					listening = false
					isKeybindListening = false
					kLabel.Text = (keybindfunc.Value and keybindfunc.Value.Name) or "None"
					sv.ts:Create(kBadgeStroke, TweenInfo.new(0.2), { Color = Color3.fromRGB(255, 255, 255), Transparency = 0.85 }):Play()
					if tempConn then
						tempConn:Disconnect()
						tempConn = nil
					end
				end

				local function startListening()
					if listening then
						stopListening()
						return
					end
					listening = true
					isKeybindListening = true
					kLabel.Text = "..."
					sv.ts:Create(kBadgeStroke, TweenInfo.new(0.2), { Color = guiconfig.Color or Color3.fromRGB(0, 208, 255), Transparency = 0.1 }):Play()

					tempConn = sv.uis.InputBegan:Connect(function(input, gpe)
						if input.UserInputType == Enum.UserInputType.Keyboard then
							if input.KeyCode == Enum.KeyCode.Escape then
								stopListening()
							else
								keybindfunc:Set(input.KeyCode)
								stopListening()
							end
						end
					end)
				end

				kBtn.Activated:Connect(startListening)

				function keybindfunc:Set(newKey)
					if typeof(newKey) == "string" and Enum.KeyCode[newKey] then
						newKey = Enum.KeyCode[newKey]
					end
					if typeof(newKey) == "EnumItem" then
						keybindfunc.Value = newKey
						config.data[configkey] = newKey.Name
						kLabel.Text = newKey.Name
						if typeof(keybindconfig.Callback) == "function" then
							pcall(keybindconfig.Callback, newKey)
						end
					end
				end

				function keybindfunc:Get()
					return keybindfunc.Value
				end

				countitem = countitem + 1
				yieldbuild()
				config.elements[configkey] = keybindfunc
				registerSearchItem(keybindconfig.Title, keyRow, "Keybind")
				return keybindfunc
			end

			function items:AddDropdown(dropdownconfig)
				dropdownconfig = dropdownconfig or {}
				dropdownconfig.Title = dropdownconfig.Title or "Title"
				dropdownconfig.Multi = dropdownconfig.Multi or false
				dropdownconfig.Advanced = dropdownconfig.Advanced or false
				dropdownconfig.Options = dropdownconfig.Options or {}
				dropdownconfig.Default = dropdownconfig.Default or (dropdownconfig.Multi and {} or nil)
				dropdownconfig.Callback = dropdownconfig.Callback or function() end

				local configkey = makeConfigKey("Dropdown", dropdownconfig.Title)
				local normKey = normalizeConfigKey(configkey)
				if config.data[configkey] ~= nil then
					dropdownconfig.Default = config.data[configkey]
				elseif config.data[normKey] ~= nil then
					dropdownconfig.Default = config.data[normKey]
				end

				local dropdownfunc = {
					Value = dropdownconfig.Default,
					Default = dropdownconfig.Default,
					Options = dropdownconfig.Options,
					_configType = "Dropdown",
				}

				local function parseOption(option)
					local label, desc, img, value

					if typeof(option) == "table" then
						label = tostring(option.Label or option.Title or option.Name or option[1] or "Option")
						value = option.Value ~= nil and option.Value or label
						desc = option.Description or option.Desc or option[2]
						img = option.Image or option.Icon or option[3]
					else
						label = tostring(option)
						value = option
					end

					if img and type(img) == "number" then
						img = "rbxassetid://" .. tostring(img)
					elseif img and type(img) == "string" and img ~= "" and not img:find("rbxassetid://") then
						img = "rbxassetid://" .. img
					end

					return label, desc, img, value
				end

				local function setupMiniDropdown()
					if isInfo or not miniScroll then return end

					miniLayoutOrder = miniLayoutOrder + 1
					local mRow = instance.frame(miniScroll)
					mRow.Name = "MiniDropdown_" .. dropdownconfig.Title
					mRow.LayoutOrder = miniLayoutOrder
					mRow.Size = UDim2.new(1, 0, 0, 44)
					mRow.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
					mRow.BackgroundTransparency = 0.3
					mRow.BorderSizePixel = 0
					mRow.ClipsDescendants = true
					instance.uicorner(mRow).CornerRadius = UDim.new(0, 5)

					local mStroke = instance.uistroke(mRow)
					mStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					mStroke.Color = Color3.fromRGB(255, 255, 255)
					mStroke.Thickness = 1
					mStroke.Transparency = 0.92

					-- // Title
					local mTitle = instance.textlabel(mRow)
					mTitle.Font = guiconfig.Font or Enum.Font.GothamBold
					mTitle.Text = dropdownconfig.Title
					mTitle.TextSize = 11
					mTitle.TextColor3 = Color3.fromRGB(210, 210, 210)
					mTitle.TextXAlignment = Enum.TextXAlignment.Left
					mTitle.TextTruncate = Enum.TextTruncate.AtEnd
					mTitle.BackgroundTransparency = 1
					mTitle.Position = UDim2.new(0, 8, 0, 4)
					mTitle.Size = UDim2.new(1, -16, 0, 14)

					-- // Select Button Header
					local mSelectBtn = instance.textbutton(mRow)
					mSelectBtn.Name = "SelectBtn"
					mSelectBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
					mSelectBtn.Position = UDim2.new(0, 8, 0, 20)
					mSelectBtn.Size = UDim2.new(1, -16, 0, 20)
					mSelectBtn.BorderSizePixel = 0
					mSelectBtn.Text = ""
					mSelectBtn.AutoButtonColor = false
					instance.uicorner(mSelectBtn).CornerRadius = UDim.new(0, 3)

					local mSelectStroke = instance.uistroke(mSelectBtn)
					mSelectStroke.Color = Color3.fromRGB(255, 255, 255)
					mSelectStroke.Thickness = 1
					mSelectStroke.Transparency = 0.9

					local mValLabel = instance.textlabel(mSelectBtn)
					mValLabel.Font = guiconfig.Font or Enum.Font.GothamBold
					mValLabel.TextSize = 10
					mValLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
					mValLabel.TextXAlignment = Enum.TextXAlignment.Left
					mValLabel.TextTruncate = Enum.TextTruncate.AtEnd
					mValLabel.BackgroundTransparency = 1
					mValLabel.Position = UDim2.new(0, 6, 0, 0)
					mValLabel.Size = UDim2.new(1, -24, 1, 0)

					local mArrow = instance.imagelabel(mSelectBtn)
					mArrow.Image = "rbxassetid://16851841101"
					mArrow.ImageColor3 = Color3.fromRGB(180, 180, 180)
					mArrow.AnchorPoint = Vector2.new(1, 0.5)
					mArrow.Position = UDim2.new(1, -4, 0.5, 0)
					mArrow.Size = UDim2.new(0, 12, 0, 12)
					mArrow.BackgroundTransparency = 1
					mArrow.Rotation = -90

					-- // Search box inside dropdown
					local mDropSearchFrame = instance.frame(mRow)
					mDropSearchFrame.Name = "DropSearchFrame"
					mDropSearchFrame.Position = UDim2.new(0, 8, 0, 44)
					mDropSearchFrame.Size = UDim2.new(1, -16, 0, 22)
					mDropSearchFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
					mDropSearchFrame.BorderSizePixel = 0
					instance.uicorner(mDropSearchFrame).CornerRadius = UDim.new(0, 3)

					local mDropSearchStroke = instance.uistroke(mDropSearchFrame)
					mDropSearchStroke.Color = Color3.fromRGB(255, 255, 255)
					mDropSearchStroke.Thickness = 1
					mDropSearchStroke.Transparency = 0.9

					local mDropSearchIcon = instance.imagelabel(mDropSearchFrame)
					mDropSearchIcon.Image = "rbxassetid://8447654914"
					mDropSearchIcon.ImageColor3 = Color3.fromRGB(140, 140, 140)
					mDropSearchIcon.BackgroundTransparency = 1
					mDropSearchIcon.Position = UDim2.new(0, 5, 0.5, -5)
					mDropSearchIcon.Size = UDim2.new(0, 10, 0, 10)

					local mDropSearchInput = instance.textbox(mDropSearchFrame)
					mDropSearchInput.Name = "DropSearchInput"
					mDropSearchInput.Position = UDim2.new(0, 20, 0, 0)
					mDropSearchInput.Size = UDim2.new(1, -24, 1, 0)
					mDropSearchInput.BackgroundTransparency = 1
					mDropSearchInput.Font = guiconfig.Font or Enum.Font.GothamBold
					mDropSearchInput.TextSize = 10
					mDropSearchInput.TextColor3 = Color3.fromRGB(230, 230, 230)
					mDropSearchInput.PlaceholderColor3 = Color3.fromRGB(110, 110, 110)
					mDropSearchInput.PlaceholderText = "Search options..."
					mDropSearchInput.TextXAlignment = Enum.TextXAlignment.Left
					mDropSearchInput.ClearTextOnFocus = false
					mDropSearchInput.Text = ""

					-- // Options scrolling list
					local mOptScroll = instance.scrollingframe(mRow)
					mOptScroll.Name = "OptScroll"
					mOptScroll.Position = UDim2.new(0, 8, 0, 70)
					mOptScroll.Size = UDim2.new(1, -16, 0, 0)
					mOptScroll.BackgroundTransparency = 1
					mOptScroll.BorderSizePixel = 0
					mOptScroll.ScrollBarThickness = 0
					mOptScroll.ScrollBarImageTransparency = 1
					mOptScroll.CanvasSize = UDim2.new(0, 0, 0, 0)

					local mOptLayout = instance.uilistlayout(mOptScroll)
					mOptLayout.Padding = UDim.new(0, 2)
					mOptLayout.SortOrder = Enum.SortOrder.LayoutOrder

					mOptLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
						mOptScroll.CanvasSize = UDim2.new(0, 0, 0, mOptLayout.AbsoluteContentSize.Y)
					end)

					local isOpen = false
					local optionButtons = {}

					local function formatValText(val)
						if typeof(val) == "table" then
							if #val == 0 then return "Select..." end
							return table.concat(val, ", ")
						elseif val ~= nil and val ~= "" then
							return tostring(val)
						else
							return "Select..."
						end
					end

					local function isSelected(val)
						if dropdownconfig.Multi then
							if type(dropdownfunc.Value) == "table" then
								for _, v in ipairs(dropdownfunc.Value) do
									if tostring(v) == tostring(val) then return true end
								end
							end
							return false
						else
							return dropdownfunc.Value ~= nil and tostring(dropdownfunc.Value) == tostring(val)
						end
					end

					local function updateOptionVisuals()
						mValLabel.Text = formatValText(dropdownfunc.Value)
						for _, item in ipairs(optionButtons) do
							local sel = isSelected(item.Value)
							local targetH = item.Bar:GetAttribute("TargetHeight") or 14
							local targetBar = sel and UDim2.new(0, 3, 0, targetH) or UDim2.new(0, 0, 0, targetH)
							local targetTextCol = sel and (guiconfig.Color or Color3.fromRGB(0, 208, 255)) or Color3.fromRGB(190, 190, 190)

							sv.ts:Create(item.Bar, TweenInfo.new(0.15), { Size = targetBar }):Play()
							sv.ts:Create(item.Text, TweenInfo.new(0.15), { TextColor3 = targetTextCol }):Play()
						end
					end

					local function updateAccordion(animate)
						local visibleCount = 0
						for _, item in ipairs(optionButtons) do
							if item.Btn.Visible then visibleCount = visibleCount + 1 end
						end

						local listH = math.clamp(visibleCount * 26, 26, 120)
						local totalH = isOpen and (70 + listH + 6) or 44
						local rot = isOpen and 0 or -90

						if animate then
							sv.ts:Create(mRow, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								Size = UDim2.new(1, 0, 0, totalH)
							}):Play()
							sv.ts:Create(mOptScroll, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								Size = UDim2.new(1, -16, 0, isOpen and listH or 0)
							}):Play()
							sv.ts:Create(mArrow, TweenInfo.new(0.2), { Rotation = rot }):Play()
						else
							mRow.Size = UDim2.new(1, 0, 0, totalH)
							mOptScroll.Size = UDim2.new(1, -16, 0, isOpen and listH or 0)
							mArrow.Rotation = rot
						end
					end

					local function buildOptions()
						for _, child in ipairs(mOptScroll:GetChildren()) do
							if child:IsA("GuiObject") and not child:IsA("UIListLayout") then
								child:Destroy()
							end
						end
						optionButtons = {}

						local opts = dropdownfunc.Options or {}
						for i, opt in ipairs(opts) do
							local label, _, _, val = parseOption(opt)

							local btn = instance.textbutton(mOptScroll)
							btn.Name = "Opt_" .. label
							btn.Size = UDim2.new(1, 0, 0, 24)
							btn.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
							btn.BackgroundTransparency = 0.5
							btn.BorderSizePixel = 0
							btn.Text = ""
							btn.AutoButtonColor = false
							btn.LayoutOrder = i
							instance.uicorner(btn).CornerRadius = UDim.new(0, 3)

							local bStroke = instance.uistroke(btn)
							bStroke.Color = Color3.fromRGB(255, 255, 255)
							bStroke.Thickness = 1
							bStroke.Transparency = 0.94

							local barHeight = 14
							local bar = instance.frame(btn)
							bar.Name = "Bar"
							bar.BackgroundColor3 = guiconfig.Color or Color3.fromRGB(0, 208, 255)
							bar.BorderSizePixel = 0
							bar.Position = UDim2.new(0, 3, 0.5, -math.floor(barHeight / 2))
							bar.Size = UDim2.new(0, 0, 0, barHeight)
							bar:SetAttribute("TargetHeight", barHeight)
							instance.uicorner(bar).CornerRadius = UDim.new(0, 2)

							local lbl = instance.textlabel(btn)
							lbl.Font = guiconfig.Font or Enum.Font.GothamBold
							lbl.Text = label
							lbl.TextSize = 10
							lbl.TextColor3 = Color3.fromRGB(190, 190, 190)
							lbl.TextXAlignment = Enum.TextXAlignment.Left
							lbl.BackgroundTransparency = 1
							lbl.Position = UDim2.new(0, 10, 0, 0)
							lbl.Size = UDim2.new(1, -16, 1, 0)

							local itemData = {
								Btn = btn,
								Text = lbl,
								Bar = bar,
								Label = label,
								Value = val,
							}

							btn.MouseEnter:Connect(function()
								sv.ts:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(30, 30, 30) }):Play()
							end)
							btn.MouseLeave:Connect(function()
								sv.ts:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(24, 24, 24) }):Play()
							end)

							btn.Activated:Connect(function()
								if dropdownconfig.Multi then
									local cur = type(dropdownfunc.Value) == "table" and dropdownfunc.Value or {}
									local foundIdx = nil
									for idx, v in ipairs(cur) do
										if tostring(v) == tostring(val) then
											foundIdx = idx
											break
										end
									end
									local newTbl = {}
									for _, v in ipairs(cur) do
										table.insert(newTbl, v)
									end
									if foundIdx then
										table.remove(newTbl, foundIdx)
									else
										table.insert(newTbl, val)
									end
									dropdownfunc:Set(newTbl)
								else
									dropdownfunc:Set(val)
									isOpen = false
									updateAccordion(true)
								end
							end)

							table.insert(optionButtons, itemData)
						end

						updateOptionVisuals()
						updateAccordion(false)
					end

					mDropSearchInput:GetPropertyChangedSignal("Text"):Connect(function()
						local q = string.lower(mDropSearchInput.Text)
						for _, item in ipairs(optionButtons) do
							local matches = (q == "") or string.find(string.lower(item.Label), q, 1, true) ~= nil
							item.Btn.Visible = matches
						end
						updateAccordion(true)
					end)

					mSelectBtn.Activated:Connect(function()
						isOpen = not isOpen
						updateAccordion(true)
					end)

					local oldDropSet = dropdownfunc.Set
					function dropdownfunc:Set(val, instant)
						oldDropSet(self, val, instant)
						updateOptionVisuals()
						if refreshMiniItems then
							refreshMiniItems()
						end
					end

					buildOptions()

					local mItemEntry = {
						Type = "Dropdown",
