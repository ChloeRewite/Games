		local hasUserMovedCard = false

		-- // Docking Card: Tepat diatas Main UI (kecuali user sudah menggeser Card secara manual)
		updateCardPosition = function(animate, overrideMainPos)
			if not card or not card.Parent or not card.Visible then return end
			if isCardDragging then return end
			if hasUserMovedCard then return end

			local targetUDim2
			local gap = 6

			if dropshadowholder and dropshadowholder.Visible then
				local mainPos = overrideMainPos or dropshadowholder.Position
				local mainH = dropshadowholder.AbsoluteSize.Y > 50 and dropshadowholder.AbsoluteSize.Y or (isMobile and 270 or 436)
				local cardH = card.AbsoluteSize.Y > 20 and card.AbsoluteSize.Y or (isMobile and 66 or 82)

				-- // X selaras dengan Main UI, Y tepat di atas tepi atas Main UI
				local targetYOffset = mainPos.Y.Offset - math.floor(mainH / 2) - cardH - gap
				targetUDim2 = UDim2.new(mainPos.X.Scale, mainPos.X.Offset, mainPos.Y.Scale, targetYOffset)
			else
				-- // Saat Main UI tertutup, Card berada di posisi idle center atas layar
				targetUDim2 = UDim2.new(0.5, 0, 0, 10)
			end

			if animate then
				sv.ts:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Position = targetUDim2
				}):Play()
			else
				card.Position = targetUDim2
			end
		end

		updateCardPosition(false)

		-- // Drag handling untuk Card
		local cardDragging = false
		local cardDragStart, cardStartPos
		local cardPressPos = Vector2.new(0, 0)
		local cardHasDragged = false

		local function updateCardDrag(input)
			local delta = input.Position - cardDragStart
			card.Position = clampPositionToScreen(
				card,
				cardStartPos.X.Scale,
				cardStartPos.X.Offset + delta.X,
				cardStartPos.Y.Scale,
				cardStartPos.Y.Offset + delta.Y,
				true
			)
		end

		local function onCardDragBegan(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				cardDragging = true
				isCardDragging = true
				cardHasDragged = false
				cardDragStart = input.Position
				cardPressPos = Vector2.new(input.Position.X, input.Position.Y)
				cardStartPos = card.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						cardDragging = false
						isCardDragging = false
					end
				end)
			end
		end

		card.InputBegan:Connect(onCardDragBegan)
		icon.InputBegan:Connect(onCardDragBegan)
		brandLabel.InputBegan:Connect(onCardDragBegan)
		serverUptimeLabel.InputBegan:Connect(onCardDragBegan)
		scriptUptimeLabel.InputBegan:Connect(onCardDragBegan)

		trackConnection(sv.uis.InputChanged:Connect(function(input)
			if
				cardDragging
				and (
					input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch
				)
			then
				if (Vector2.new(input.Position.X, input.Position.Y) - cardPressPos).Magnitude > 4 then
					cardHasDragged = true
					hasUserMovedCard = true
				end
				if cardHasDragged then
					updateCardDrag(input)
				end
			end
		end), "cardToggle.drag")

		trackConnection(sv.uis.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				if cardDragging and cardDragStart then
					local delta = input.Position - cardDragStart
					if delta.Magnitude > 4 then
						hasUserMovedCard = true
					end
				end
				cardDragging = false
				isCardDragging = false
			end
		end), "cardToggle.dragEnd")

