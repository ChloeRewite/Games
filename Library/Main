if isfolder and makefolder and not isfolder("Chloe X") then
	makefolder("Chloe X")
end

function config:getlist()
	local configs = {}

	if isfolder and listfiles and self.gamefolder and isfolder(self.gamefolder) then
		for _, filepath in pairs(listfiles(self.gamefolder)) do
			local filename = filepath:match("([^/\\]+)%.json$")
			if filename then
				table.insert(configs, filename)
			end
		end
	end

	return configs
end

function config:getautoload()
	if isfile and self.autoloadfile and isfile(self.autoloadfile) then
		local success, content = pcall(readfile, self.autoloadfile)

		if success and content and content ~= "" then
			return content:match("^%s*(.-)%s*$")
		end
	end

	return nil
end

function config:setautoload(name)
	if not name or name == "" then
		return false
	end

	if writefile and self.autoloadfile then
		writefile(self.autoloadfile, tostring(name))
		print("[CHX] Autoload config set to: " .. tostring(name))
		return true
	end

	return false
end

function config:clearautoload()
	if delfile and self.autoloadfile and isfile(self.autoloadfile) then
		delfile(self.autoloadfile)
		print("[CHX] Autoload config cleared")
		return true
	end

	return false
end

local function normalizeConfigKey(key)
	key = tostring(key or "")

	local parts = {}
	for part in key:gmatch("[^_]+") do
		if part ~= "" then
			parts[#parts + 1] = part
		end
	end

	local i = 1
	while i < #parts do
		if parts[i]:match("^%d+$") then
			local nextPart = parts[i + 1]
			if nextPart == "Toggle" or nextPart == "Slider" or nextPart == "Input" or nextPart == "Dropdown" then
				table.remove(parts, i)
			else
				i = i + 1
			end
		else
			i = i + 1
		end
	end

	return table.concat(parts, "_")
end

function config:getcurrentdata()
	local savedata = {}

	for key, element in pairs(self.elements) do
		local saveKey = normalizeConfigKey(key)
		local value = element.Value
		local elementType = element._configType

		if elementType == "Toggle" then
			if saveKey ~= "" then
				savedata[saveKey] = (value == true)
			end
		elseif elementType == "Keybind" then
			if saveKey ~= "" and value then
				savedata[saveKey] = typeof(value) == "EnumItem" and value.Name or tostring(value)
			end
		elseif elementType == "ColorPicker" then
			if saveKey ~= "" and typeof(value) == "Color3" then
				savedata[saveKey] = "#" .. value:ToHex()
			end
		elseif elementType == "Body" then
			if saveKey ~= "" and value ~= nil then
				savedata[saveKey] = value
			end
		elseif value ~= nil and saveKey ~= "" then
			savedata[saveKey] = value
		end
	end

	savedata._version = self.version
	return savedata
end

function config:save(name)
	if not name or name == "" then
		warn("[CHX] Config name cannot be empty")
		return false
	end

	if not writefile or not self.gamefolder then
		return false
	end

	local savedata = self:getcurrentdata()
	self.data = savedata

	local filepath = self.gamefolder .. "/" .. name .. ".json"
	writefile(filepath, sv.http:JSONEncode(savedata))

	self.current = name
	print("[CHX] Config saved as: " .. name)

	return true
end

local function normalizeConfigData(data)
	local normalized = {}

	for key, value in pairs(data or {}) do
		if key == "_version" then
			normalized._version = value
		elseif type(key) == "string" then
			local newKey = normalizeConfigKey(key)

			if newKey ~= "" then
				if normalized[newKey] == nil or newKey == key then
					normalized[newKey] = value
				end
			end
		end
	end

	return normalized
end

function config:load(name)
	if not name or name == "" then
		warn("[CHX] Config name cannot be empty")
		return false
	end

	if not self.version then
		return false
	end

	local filepath = self.gamefolder .. "/" .. name .. ".json"

	if not isfile or not isfile(filepath) then
		warn("[CHX] Config file not found: " .. name)
		return false
	end

	local success, result = pcall(function()
		return sv.http:JSONDecode(readfile(filepath))
	end)

	if not success or type(result) ~= "table" then
		warn("[CHX] Failed to decode config")
		return false
	end

	if result._version ~= self.version then
		warn("[CHX] Config version mismatch")
		return false
	end

	self.data = normalizeConfigData(result)
	self.current = name
	if next(self.elements) then
		self:loadelements()
	end

	print("[CHX] Config loaded: " .. name)
	return true
end

function config:delete(name)
	if not name or name == "" then
		warn("[CHX] Config name cannot be empty")
		return false
	end

	local filepath = self.gamefolder .. "/" .. name .. ".json"

	if not delfile or not isfile or not isfile(filepath) then
		warn("[CHX] Config file not found: " .. name)
		return false
	end

	delfile(filepath)
	print("[CHX] Config deleted: " .. name)

	if self:getautoload() == name then
		self:clearautoload()
	end

	if self.current == name then
		self.current = nil
	end

	return true
end

function config:loadelements()
	for key, element in pairs(self.elements) do
		if element.Set then
			local normalizedKey = normalizeConfigKey(key)
			local value = self.data[normalizedKey]

			if value == nil and normalizedKey ~= key then
				value = self.data[key]
			end

			if value == nil and element._configType == "Toggle" then
				value = false
			end

			if element._configType == "Keybind" and typeof(value) == "string" and Enum.KeyCode[value] then
				value = Enum.KeyCode[value]
			end

			if element._configType == "ColorPicker" and typeof(value) == "string" and value:sub(1, 1) == "#" then
				pcall(function() value = Color3.fromHex(value) end)
			end

			if value ~= nil then
				pcall(function()
					element:Set(value, true)
				end)
			end
		end
	end
end

function config:reset()
	self.data = {
		_version = self.version,
	}

	for _, element in pairs(self.elements) do
		if element.Set then
			pcall(function()
				local elementType = element._configType

				if element.Default ~= nil then
					element:Set(element.Default)
				elseif elementType == "Toggle" then
					element:Set(false)
				elseif elementType == "Slider" then
					element:Set(element.Min or 0)
				elseif elementType == "Input" then
					element:Set("")
				elseif elementType == "Dropdown" then
					if type(element.Value) == "table" then
						element:Set({})
					else
						element:Set(nil)
					end
				elseif elementType == "ColorPicker" then
					element:Set(element.Default or Color3.fromRGB(0, 220, 255))
				elseif elementType == "Body" then
					element:Set(element.Default or "Head")
				end
			end)
		end
	end

	print("[CHX] Elements reset to defaults")
end

function config:loadexternal(json)
	if not json or json == "" then
		warn("[CHX] External config JSON kosong")
		return false
	end

	local success, data = pcall(function()
		return sv.http:JSONDecode(json)
	end)

	if not success or type(data) ~= "table" then
		warn("[CHX] External config JSON invalid")
		return false
	end

	if data._version and self.version and data._version ~= self.version then
		warn("[CHX] External config version mismatch")
		return false
	end

	self.data = normalizeConfigData(data)
	self:loadelements()

	print("[CHX] External config loaded from JSON input")
	return true
end

-- // Pure Luau Base64 Utilities
local b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local b64lookup = {}
for i = 1, 64 do
	b64lookup[b64chars:sub(i, i)] = i - 1
end

local function pureBase64Encode(data)
	local result = {}
	local len = #data
	local pad = (3 - (len % 3)) % 3
	local padded = data .. string.rep("\0", pad)
	for i = 1, #padded, 3 do
		local b1, b2, b3 = string.byte(padded, i, i + 2)
		local n = bit32.bor(bit32.lshift(b1, 16), bit32.lshift(b2, 8), b3)
		local c1 = bit32.band(bit32.rshift(n, 18), 63) + 1
		local c2 = bit32.band(bit32.rshift(n, 12), 63) + 1
		local c3 = bit32.band(bit32.rshift(n, 6), 63) + 1
		local c4 = bit32.band(n, 63) + 1
		table.insert(result, b64chars:sub(c1, c1) .. b64chars:sub(c2, c2) .. b64chars:sub(c3, c3) .. b64chars:sub(c4, c4))
	end
	local str = table.concat(result)
	if pad > 0 then
		str = str:sub(1, -pad - 1) .. string.rep("=", pad)
	end
	return str
end

local function pureBase64Decode(data)
	data = string.gsub(data, "[^A-Za-z0-9+/=]", "")
	local result = {}
	local len = #data
	if len % 4 ~= 0 then return nil end
	local pad = 0
	if data:sub(-2) == "==" then pad = 2
	elseif data:sub(-1) == "=" then pad = 1 end
	for i = 1, len, 4 do
		local c1 = b64lookup[data:sub(i, i)]
		local c2 = b64lookup[data:sub(i + 1, i + 1)]
		local c3 = b64lookup[data:sub(i + 2, i + 2)] or 0
		local c4 = b64lookup[data:sub(i + 3, i + 3)] or 0
		if not c1 or not c2 then return nil end
		local n = bit32.bor(bit32.lshift(c1, 18), bit32.lshift(c2, 12), bit32.lshift(c3, 6), c4)
		local b1 = bit32.band(bit32.rshift(n, 16), 255)
		local b2 = bit32.band(bit32.rshift(n, 8), 255)
		local b3 = bit32.band(n, 255)
		table.insert(result, string.char(b1))
		if i + 2 <= len - pad then
			table.insert(result, string.char(b2))
		end
		if i + 3 <= len - pad then
			table.insert(result, string.char(b3))
		end
	end
	return table.concat(result)
end

local function encodeBase64(str)
	if crypt and crypt.base64encode then
		local ok, res = pcall(crypt.base64encode, str)
		if ok and res then return res end
	elseif syn and syn.crypt and syn.crypt.base64 and syn.crypt.base64.encode then
		local ok, res = pcall(syn.crypt.base64.encode, str)
		if ok and res then return res end
	elseif base64_encode then
		local ok, res = pcall(base64_encode, str)
		if ok and res then return res end
	end
	return pureBase64Encode(str)
end

local function decodeBase64(str)
	if crypt and crypt.base64decode then
		local ok, res = pcall(crypt.base64decode, str)
		if ok and res then return res end
	elseif syn and syn.crypt and syn.crypt.base64 and syn.crypt.base64.decode then
		local ok, res = pcall(syn.crypt.base64.decode, str)
		if ok and res then return res end
	elseif base64_decode then
		local ok, res = pcall(base64_decode, str)
		if ok and res then return res end
	end
	return pureBase64Decode(str)
end

function config:export(name)
	local targetData = nil

	if name and name ~= "" and self.gamefolder and isfile and isfile(self.gamefolder .. "/" .. name .. ".json") then
		pcall(function()
			local content = readfile(self.gamefolder .. "/" .. name .. ".json")
			targetData = sv.http:JSONDecode(content)
		end)
	end

	if not targetData or type(targetData) ~= "table" then
		targetData = self:getcurrentdata()
	end

	local ok, json = pcall(function()
		return sv.http:JSONEncode(targetData)
	end)
	if not ok or not json then
		warn("[CHX] Failed to serialize config to JSON")
		return nil
	end

	local b64 = encodeBase64(json)
	if not b64 or b64 == "" then
		warn("[CHX] Failed to base64 encode config")
		return nil
	end

	local shareCode = "CHLOEX:" .. b64

	local copyFunc = setclipboard or toclipboard
	if copyFunc then
		pcall(copyFunc, shareCode)
	end

	return shareCode
end

function config:import(rawCode, saveAsName)
	if not rawCode or rawCode == "" then
		return false, "Empty share code"
	end

	rawCode = string.gsub(rawCode, "^%s+", "")
	rawCode = string.gsub(rawCode, "%s+$", "")

	local b64 = rawCode
	if b64:sub(1, 7):upper() == "CHLOEX:" then
		b64 = b64:sub(8)
	elseif b64:sub(1, 6):upper() == "CHLOE:" then
		b64 = b64:sub(7)
	end

	b64 = string.gsub(b64, "^%s+", "")
	b64 = string.gsub(b64, "%s+$", "")

	local json = nil
	if b64:sub(1, 1) == "{" then
		json = b64
	else
		json = decodeBase64(b64)
	end

	if not json or json == "" then
		return false, "Failed to decode base64 code"
	end

	local ok, data = pcall(function()
		return sv.http:JSONDecode(json)
	end)

	if not ok or type(data) ~= "table" then
		return false, "Invalid JSON data in share code"
	end

	self.data = normalizeConfigData(data)
	self:loadelements()

	if saveAsName and saveAsName ~= "" and writefile and self.gamefolder then
		pcall(function()
			self:save(saveAsName)
		end)
	end

	return true, self.data
end

local function isMobileDevice()
	local isTouch = (sv.uis.TouchEnabled and not sv.uis.MouseEnabled)
		or (sv.uis.TouchEnabled and not sv.uis.KeyboardEnabled)
	pcall(function()
		local plat = sv.uis:GetPlatform()
		if plat == Enum.Platform.IOS or plat == Enum.Platform.Android then
			isTouch = true
		end
	end)
	return isTouch
end

local isMobile = isMobileDevice()

local function safesize(width, height)
	local viewport = workspace.CurrentCamera.ViewportSize

	local x = width / viewport.X
	local y = height / viewport.Y

	if isMobile then
		x = math.min(x, 0.5)
		y = math.min(y, 0.3)
	end

	return UDim2.new(x, 0, y, 0)
end

local function formatAsset(asset)
	if not asset or asset == "" then
		return ""
	end
	local s = tostring(asset)
	if s:find("rbxassetid://") or s:find("rbxasset://") or s:find("http://") or s:find("https://") then
		return s
	end
	return "rbxassetid://" .. s
end

-- // Helper to clamp any GUI element strictly within viewport boundaries (opsional tanpa batas atas jika allowTopOverflow)
local function clampPositionToScreen(obj, targetScaleX, targetOffsetX, targetScaleY, targetOffsetY, allowTopOverflow)
	local screen = obj:FindFirstAncestorWhichIsA("ScreenGui")
	local sw = (screen and screen.AbsoluteSize.X > 0) and screen.AbsoluteSize.X
		or (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.X or 1920)
	local sh = (screen and screen.AbsoluteSize.Y > 0) and screen.AbsoluteSize.Y
		or (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.Y or 1080)

	local w = obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.X or obj.Size.X.Offset
	local h = obj.AbsoluteSize.Y > 0 and obj.AbsoluteSize.Y or obj.Size.Y.Offset
	local ax = obj.AnchorPoint.X
	local ay = obj.AnchorPoint.Y

	local rawPixelX = targetScaleX * sw + targetOffsetX
	local rawPixelY = targetScaleY * sh + targetOffsetY

	local minX = w * ax
	local maxX = math.max(minX, sw - w * (1 - ax))
	local maxY = math.max(0, sh - h * (1 - ay))

	local clampedPixelX = math.clamp(rawPixelX, minX, maxX)
	local clampedPixelY
	if allowTopOverflow then
		-- // Bebas ditarik ke atas layar tanpa pembatas keluar layar atas
		clampedPixelY = math.min(rawPixelY, maxY)
	else
		local minY = h * ay
		clampedPixelY = math.clamp(rawPixelY, minY, maxY)
	end

	return UDim2.new(targetScaleX, clampedPixelX - targetScaleX * sw, targetScaleY, clampedPixelY - targetScaleY * sh)
end

local function makedraggable(topbar, object)
	if isMobile then
		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 450)
		local maxW = math.max(320, vp.X - 24)
		local maxH = math.max(220, vp.Y - 24)
		draggable.defx = math.min(470, maxW)
		draggable.defy = math.min(270, maxH)
	end

	object.Size = UDim2.new(0, draggable.defx, 0, draggable.defy)

	local resize = instance.frame(object)
	resize.Name = "resize"
	resize.AnchorPoint = Vector2.new(1, 1)
	resize.BackgroundTransparency = 1
	resize.Size = UDim2.new(0, 40, 0, 40)
	resize.Position = UDim2.new(1, 20, 1, 20)
	resize.Active = true
	local dragConnection = nil
	local resizeConnection = nil

	trackConnection(
		topbar.InputBegan:Connect(function(input)
			if
				input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch
			then
				return
			end

			draggable.dragging = true
			draggable.dragstart = input.Position
			draggable.draginput = input
			draggable.startpos = object.Position

			if dragConnection then
				dragConnection:Disconnect()
			end
			dragConnection = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					if draggable.dragging and draggable.dragstart then
						local delta = input.Position - draggable.dragstart
						if delta.Magnitude > 3 then
							draggable.hasUserMoved = true
						end
					end
					draggable.dragging = false
					dragConnection:Disconnect()
					dragConnection = nil
				end
			end)
		end),
		"makedraggable.drag.InputBegan"
	)

	trackConnection(
		topbar.InputChanged:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			then
				draggable.draginput = input
			end
		end),
		"makedraggable.drag.InputChanged"
	)

	trackConnection(
		resize.InputBegan:Connect(function(input)
			if
				input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch
			then
				return
			end

			draggable.resizing = true
			draggable.resizestart = input.Position
			draggable.resizeinput = input
			draggable.startsize = object.Size

			if resizeConnection then
				resizeConnection:Disconnect()
			end
			resizeConnection = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					if draggable.resizing and draggable.resizestart then
						local delta = input.Position - draggable.resizestart
						if delta.Magnitude > 3 then
							draggable.hasUserMoved = true
						end
					end
					draggable.resizing = false
					resizeConnection:Disconnect()
					resizeConnection = nil
				end
			end)
		end),
		"makedraggable.resize.InputBegan"
	)

	trackConnection(
		resize.InputChanged:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			then
				draggable.resizeinput = input
			end
		end),
		"makedraggable.resize.InputChanged"
	)

	trackConnection(
		sv.uis.InputChanged:Connect(function(input)
			if draggable.dragging and (input == draggable.draginput or input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
				local delta = input.Position - draggable.dragstart
				if delta.Magnitude > 3 then
					draggable.hasUserMoved = true
				end

				object.Position = clampPositionToScreen(
					object,
					draggable.startpos.X.Scale,
					draggable.startpos.X.Offset + delta.X,
					draggable.startpos.Y.Scale,
					draggable.startpos.Y.Offset + delta.Y
				)
			end

			if draggable.resizing and (input == draggable.resizeinput or input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
				local delta = input.Position - draggable.resizestart
				if delta.Magnitude > 3 then
					draggable.hasUserMoved = true
				end

				local width = math.max(draggable.startsize.X.Offset + delta.X, draggable.minx)
				local height = math.max(draggable.startsize.Y.Offset + delta.Y, draggable.miny)

				object.Size = UDim2.new(0, width, 0, height)
				object.Position = clampPositionToScreen(
					object,
					object.Position.X.Scale,
					object.Position.X.Offset,
					object.Position.Y.Scale,
					object.Position.Y.Offset
				)
			end
		end),
		"makedraggable.global.InputChanged"
	)
end

local Chloex = {}

function Chloex:MakeNotify(notifyconfig)
	notifyconfig = notifyconfig or {}
	notifyconfig.Title = notifyconfig.Title or "ChloeX"
	notifyconfig.Description = notifyconfig.Description or "Notification"
	notifyconfig.Content = notifyconfig.Content or "Content"
	notifyconfig.Color = notifyconfig.Color or Color3.fromRGB(255, 0, 255)
	notifyconfig.Time = notifyconfig.Time or 0.5
	notifyconfig.Delay = notifyconfig.Delay or 5

	local notifyfunction = {}
	local internalClose = nil
	local isClosed = false

	function notifyfunction:Close()
		isClosed = true
		if internalClose then
			internalClose()
		end
	end

	task.spawn(function()
		if not sv.coregui:FindFirstChild("NotifyGui") then
			local notifygui = instance.screengui(sv.coregui)
			notifygui.Name = "NotifyGui"
			notifygui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		end

		if not sv.coregui.NotifyGui:FindFirstChild("NotifyLayout") then
			local notifylayout = instance.frame(sv.coregui.NotifyGui)
			notifylayout.Name = "NotifyLayout"
			notifylayout.AnchorPoint = Vector2.new(1, 1)
			notifylayout.Position = UDim2.new(1, -30, 1, -30)
			notifylayout.Size = UDim2.new(0, 320, 1, 0)
			notifylayout.BackgroundTransparency = 1
			notifylayout.BorderSizePixel = 0

			sv.coregui.NotifyGui.NotifyLayout.ChildRemoved:Connect(function()
				local count = 0
				for _, v in ipairs(sv.coregui.NotifyGui.NotifyLayout:GetChildren()) do
					sv.ts
						:Create(
							v,
							TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
							{ Position = UDim2.new(0, 0, 1, -((v.Size.Y.Offset + 12) * count)) }
						)
						:Play()
					count = count + 1
				end
			end)
		end

		local notifyposheigh = 0
		for _, v in ipairs(sv.coregui.NotifyGui.NotifyLayout:GetChildren()) do
			notifyposheigh = -v.Position.Y.Offset + v.Size.Y.Offset + 12
		end

		local notifyframe = instance.frame(sv.coregui.NotifyGui.NotifyLayout)
		notifyframe.Name = "NotifyFrame"
		notifyframe.BackgroundTransparency = 1
		notifyframe.BorderSizePixel = 0
		notifyframe.Size = UDim2.new(1, 0, 0, 150)
		notifyframe.AnchorPoint = Vector2.new(0, 1)
		notifyframe.Position = UDim2.new(0, 0, 1, -notifyposheigh)

		local notifyframereal = instance.frame(notifyframe)
		notifyframereal.Name = "NotifyFrameReal"
		notifyframereal.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		notifyframereal.BorderSizePixel = 0
		notifyframereal.Position = UDim2.new(0, 400, 0, 0)
		notifyframereal.Size = UDim2.new(1, 0, 1, 0)

		local uicorner = instance.uicorner(notifyframereal)
		uicorner.CornerRadius = UDim.new(0, 8)

		local top = instance.frame(notifyframereal)
		top.Name = "Top"
		top.Size = UDim2.new(1, 0, 0, 36)
		top.BackgroundTransparency = 1
		top.BorderSizePixel = 0

		local icon = instance.imagelabel(top)
		icon.BackgroundTransparency = 1
		icon.Size = UDim2.new(0, 50, 0, 50)
		icon.Position = UDim2.new(0, -12, 0.9, 0)
		icon.AnchorPoint = Vector2.new(0, 0.5)
		icon.Image = "rbxassetid://6859372539"

		local titleHolder = instance.frame(top)
		titleHolder.Name = "TitleHolder"
		titleHolder.BackgroundTransparency = 1
		titleHolder.BorderSizePixel = 0
		titleHolder.Position = UDim2.new(0, 38, 0, 0)
		titleHolder.Size = UDim2.new(1, -70, 1, 0)

		local titleLayout = Instance.new("UIListLayout")
		titleLayout.FillDirection = Enum.FillDirection.Horizontal
		titleLayout.SortOrder = Enum.SortOrder.LayoutOrder
		titleLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		titleLayout.Padding = UDim.new(0, 4)
		titleLayout.Parent = titleHolder

		local title = instance.textlabel(titleHolder)
		title.Name = "Title"
		title.Font = Enum.Font.GothamBold
		title.Text = notifyconfig.Title or ""
		title.TextSize = 14
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.BackgroundTransparency = 1
		title.TextColor3 = Color3.fromRGB(255, 255, 255)
		title.AutomaticSize = Enum.AutomaticSize.X
		title.Size = UDim2.new(0, 0, 1, 0)
		title.LayoutOrder = 1

		local desc = instance.textlabel(titleHolder)
		desc.Name = "Desc"
		desc.Font = Enum.Font.GothamBold
		desc.Text = notifyconfig.Description or ""
		desc.TextSize = 14
		desc.TextXAlignment = Enum.TextXAlignment.Left
		desc.BackgroundTransparency = 1
		desc.TextColor3 = notifyconfig.Color or Color3.fromRGB(0, 208, 255)
		desc.AutomaticSize = Enum.AutomaticSize.X
		desc.Size = UDim2.new(0, 0, 1, 0)
		desc.LayoutOrder = 2
		if not notifyconfig.Description or notifyconfig.Description == "" then
			desc.Visible = false
		end

		local close = instance.textbutton(top)
		close.Text = ""
		close.Size = UDim2.new(0, 25, 0, 25)
		close.AnchorPoint = Vector2.new(1, 0.5)
		close.Position = UDim2.new(1, -5, 0.5, 0)
		close.BackgroundTransparency = 1
		close.BorderSizePixel = 0

		local closeicon = instance.imagelabel(close)
		closeicon.Image = "rbxassetid://9886659671"
		closeicon.BackgroundTransparency = 1
		closeicon.Size = UDim2.new(1, -8, 1, -8)
		closeicon.Position = UDim2.new(0.5, 0, 0.5, 0)
		closeicon.AnchorPoint = Vector2.new(0.5, 0.5)

		local content = instance.textlabel(notifyframereal)
		content.Font = Enum.Font.GothamBold
		content.Text = notifyconfig.Content
		content.TextWrapped = true
		content.TextXAlignment = Enum.TextXAlignment.Left
		content.TextYAlignment = Enum.TextYAlignment.Top
		content.TextSize = 13
		content.BackgroundTransparency = 1
		content.TextColor3 = Color3.fromRGB(150, 150, 150)
		content.Position = UDim2.new(0, 38, 0, 27)
		content.Size = UDim2.new(1, -50, 0, 13)

		task.wait()
		local lines = math.max(1, math.ceil(content.TextBounds.X / math.max(1, content.AbsoluteSize.X)))
		content.Size = UDim2.new(1, -50, 0, 13 + (13 * (lines - 1)))

		if content.AbsoluteSize.Y < 27 then
			notifyframe.Size = UDim2.new(1, 0, 0, 65)
		else
			notifyframe.Size = UDim2.new(1, 0, 0, content.AbsoluteSize.Y + 40)
		end

		local closed = false
		internalClose = function()
			if closed then
				return
			end
			closed = true
			if notifyframereal and notifyframereal.Parent then
				sv.ts
					:Create(
						notifyframereal,
						TweenInfo.new(notifyconfig.Time, Enum.EasingStyle.Back, Enum.EasingDirection.InOut),
						{ Position = UDim2.new(0, 400, 0, 0) }
					)
					:Play()
				task.wait(notifyconfig.Time / 1.2)
			end
			if notifyframe and notifyframe.Parent then
				notifyframe:Destroy()
			end
		end

		if isClosed then
			internalClose()
			return
		end

		close.Activated:Connect(function()
			internalClose()
		end)

		sv.ts
			:Create(
				notifyframereal,
				TweenInfo.new(notifyconfig.Time, Enum.EasingStyle.Back, Enum.EasingDirection.InOut),
				{ Position = UDim2.new(0, 0, 0, 0) }
			)
			:Play()

		task.wait(notifyconfig.Delay)
		internalClose()
	end)

	return notifyfunction
end

local function chloex(msg, delay, color, title, desc)
	return Chloex:MakeNotify({
		Title = title or "Chloe X",
		Description = desc or "Notification",
		Content = msg or "Content",
		Color = color or Color3.fromRGB(0, 208, 255),
		Delay = delay or 4,
	})
end
Chloex.Notify = chloex


function Chloex:MakeOverlay(overlayconfig)
	overlayconfig = overlayconfig or {}
	overlayconfig.Content = overlayconfig.Content or "Status"
	overlayconfig.Position = UDim2.new(0, 20, 0, 20)

	local overlayfunc = {}

	local overlaygui = instance.screengui(sv.coregui)
	overlaygui.Name = "OverlayGui"
	overlaygui.ResetOnSpawn = false
	overlaygui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local overlayframe = instance.frame(overlaygui)
	overlayframe.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	overlayframe.BackgroundTransparency = 0.4
	overlayframe.BorderSizePixel = 0
	overlayframe.Position = overlayconfig.Position
	overlayframe.Size = UDim2.new(0, 150, 0, 30)
	overlayframe.AutomaticSize = Enum.AutomaticSize.Y

	local uicorner = instance.uicorner(overlayframe)
	uicorner.CornerRadius = UDim.new(0, 6)

	local contentlabel = instance.textlabel(overlayframe)
	contentlabel.Font = Enum.Font.GothamBold
	contentlabel.Text = overlayconfig.Content
	contentlabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	contentlabel.TextSize = 13
	contentlabel.BackgroundTransparency = 1
	contentlabel.TextWrapped = true
	contentlabel.AutomaticSize = Enum.AutomaticSize.Y
	contentlabel.Size = UDim2.new(1, -10, 0, 0)
	contentlabel.Position = UDim2.new(0, 10, 0, 5)
	contentlabel.TextXAlignment = Enum.TextXAlignment.Left

	local dragging, dragstart, startpos
	overlayframe.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = true
			dragstart = input.Position
			startpos = overlayframe.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	local overlayInputConn = sv.uis.InputChanged:Connect(function(input)
		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			local delta = input.Position - dragstart
			overlayframe.Position =
				UDim2.new(startpos.X.Scale, startpos.X.Offset + delta.X, startpos.Y.Scale, startpos.Y.Offset + delta.Y)
		end
	end)

	function overlayfunc:SetContent(text)
		contentlabel.Text = text or ""
	end

	function overlayfunc:SetVisible(bool)
		overlayframe.Visible = bool
	end

	function overlayfunc:Destroy()
		if overlayInputConn then
			overlayInputConn:Disconnect()
			overlayInputConn = nil
		end
		overlaygui:Destroy()
	end

	return overlayfunc
end

function Chloex:Watermark(watermarkconfig)
	watermarkconfig = watermarkconfig or {}
	local titleText = watermarkconfig.Title or "Chloe X"
	local versionText = watermarkconfig.Version
	local showFps = (watermarkconfig.ShowFPS ~= false)
	local showPing = (watermarkconfig.ShowPing ~= false)
	local showTime = (watermarkconfig.ShowTime ~= false)
	local isVisible = (watermarkconfig.Visible ~= false)
	local isDraggable = (watermarkconfig.Draggable ~= false)
	local accentColor = watermarkconfig.Color or Color3.fromRGB(0, 208, 255)
	local font = watermarkconfig.Font or Enum.Font.GothamBold

	local parentGui = watermarkconfig.Parent
	local createdGui = false
	if not parentGui then
		local core = game:GetService("CoreGui")
		local chloexGui = core:FindFirstChild("Chloeex")
		if chloexGui then
			parentGui = chloexGui
		else
			local pcallOk, result = pcall(function()
				local g = Instance.new("ScreenGui")
				g.Name = "ChloeX_WatermarkGui"
				g.ResetOnSpawn = false
				g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
				if gethui then
					g.Parent = gethui()
				elseif syn and syn.protect_gui then
					syn.protect_gui(g)
					g.Parent = core
				else
					g.Parent = core
				end
				return g
			end)
			if pcallOk and result then
				parentGui = result
				createdGui = true
			else
				local player = game:GetService("Players").LocalPlayer
				if player then
					local g = Instance.new("ScreenGui")
					g.Name = "ChloeX_WatermarkGui"
					g.ResetOnSpawn = false
					g.Parent = player:WaitForChild("PlayerGui")
					parentGui = g
					createdGui = true
				end
			end
		end
	end

	local wm = instance.frame(parentGui)
	wm.Name = "Watermark"
	wm.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	wm.BackgroundTransparency = 0.2
	wm.BorderSizePixel = 0
	wm.Position = watermarkconfig.Position or UDim2.new(0, 16, 0, 16)
	wm.AutomaticSize = Enum.AutomaticSize.XY
	wm.Visible = isVisible
	wm.ZIndex = 1000

	local corner = instance.uicorner(wm)
	corner.CornerRadius = UDim.new(0, 6)

	local stroke = instance.uistroke(wm)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = 1
	stroke.Transparency = 0.88

	local pad = instance.uipadding(wm)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)

	local list = instance.uilistlayout(wm)
	list.FillDirection = Enum.FillDirection.Horizontal
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 8)

	local dot = instance.frame(wm)
	dot.Name = "Dot"
	dot.Size = UDim2.new(0, 6, 0, 6)
	dot.BackgroundColor3 = accentColor
	dot.BorderSizePixel = 0
	dot.LayoutOrder = 1
	instance.uicorner(dot).CornerRadius = UDim.new(1, 0)

	local fullTitle = titleText
	if versionText and versionText ~= "" then
		fullTitle = fullTitle .. "  " .. versionText
	end
	local titleLabel = instance.textlabel(wm)
	titleLabel.Name = "TitleLabel"
	titleLabel.Text = fullTitle
	titleLabel.Font = font
	titleLabel.TextSize = 11
	titleLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
	titleLabel.BackgroundTransparency = 1
	titleLabel.BorderSizePixel = 0
	titleLabel.AutomaticSize = Enum.AutomaticSize.XY
	titleLabel.LayoutOrder = 2

	local function makeSep(order)
		local sep = instance.textlabel(wm)
		sep.Name = "Sep" .. tostring(order)
		sep.Text = "•"
		sep.Font = font
		sep.TextSize = 10
		sep.TextColor3 = Color3.fromRGB(90, 90, 90)
		sep.BackgroundTransparency = 1
		sep.BorderSizePixel = 0
		sep.AutomaticSize = Enum.AutomaticSize.XY
		sep.LayoutOrder = order
		return sep
	end

	local function makeStat(name, order)
		local lbl = instance.textlabel(wm)
		lbl.Name = name
		lbl.Text = "--"
		lbl.Font = font
		lbl.TextSize = 11
		lbl.TextColor3 = Color3.fromRGB(165, 165, 165)
		lbl.BackgroundTransparency = 1
		lbl.BorderSizePixel = 0
		lbl.AutomaticSize = Enum.AutomaticSize.XY
		lbl.LayoutOrder = order
		return lbl
	end

	local fpsLabel, pingLabel, timeLabel
	local orderIdx = 3

	if showFps then
		makeSep(orderIdx)
		orderIdx = orderIdx + 1
		fpsLabel = makeStat("FPS", orderIdx)
		orderIdx = orderIdx + 1
	end

	if showPing then
		makeSep(orderIdx)
		orderIdx = orderIdx + 1
		pingLabel = makeStat("Ping", orderIdx)
		orderIdx = orderIdx + 1
	end

	if showTime then
		makeSep(orderIdx)
		orderIdx = orderIdx + 1
		timeLabel = makeStat("Time", orderIdx)
		orderIdx = orderIdx + 1
	end

	local frameCount = 0
	local timer = 0
	local updateConn
	updateConn = sv.run.RenderStepped:Connect(function(dt)
		frameCount = frameCount + 1
		timer = timer + dt
		if timer >= 0.4 then
			if showFps and fpsLabel and fpsLabel.Parent then
				local fps = math.floor(frameCount / timer)
				fpsLabel.Text = tostring(fps) .. " FPS"
			end
			frameCount = 0
			timer = 0

			if showPing and pingLabel and pingLabel.Parent then
				local ping = 0
				pcall(function()
					local stats = game:GetService("Stats")
					ping = math.floor(stats.Network.ServerStatsItem["Data Ping"]:GetValue())
				end)
				pingLabel.Text = tostring(ping) .. " ms"
			end

			if showTime and timeLabel and timeLabel.Parent then
				timeLabel.Text = os.date("%H:%M:%S")
			end
		end
	end)

	local dragInputConn
	if isDraggable then
		local dragging = false
		local dragstart, startpos
		wm.InputBegan:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				dragging = true
				dragstart = input.Position
				startpos = wm.Position

				local conn
				conn = input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						conn:Disconnect()
					end
				end)
			end
		end)

		dragInputConn = sv.uis.InputChanged:Connect(function(input)
			if
				dragging
				and (
					input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch
				)
			then
				local delta = input.Position - dragstart
				wm.Position = clampPositionToScreen(
					wm,
					startpos.X.Scale,
					startpos.X.Offset + delta.X,
					startpos.Y.Scale,
					startpos.Y.Offset + delta.Y
				)
			end
		end)
	end

	local wmApi = {}
	function wmApi:SetVisible(bool)
		wm.Visible = bool
	end
	function wmApi:SetTitle(newTitle)
		titleText = newTitle
		titleLabel.Text = titleText .. (versionText and ("  " .. versionText) or "")
	end
	function wmApi:SetText(customText)
		titleLabel.Text = customText
	end
	function wmApi:Destroy()
		if updateConn then
			updateConn:Disconnect()
			updateConn = nil
		end
		if dragInputConn then
			dragInputConn:Disconnect()
			dragInputConn = nil
		end
		if createdGui and parentGui then
			parentGui:Destroy()
		else
			wm:Destroy()
		end
	end

	return wmApi
end

function Chloex:Window(guiconfig)
	-- // Destroy any previous window before creating a new one
	if getgenv().ChloeX_Instance then
		pcall(function()
			getgenv().ChloeX_Instance:DestroyGui()
		end)
		getgenv().ChloeX_Instance = nil
	end
	guiconfig = guiconfig or {}
	guiconfig.Title = guiconfig.Title or "Chloe X"
	guiconfig.Footer = guiconfig.Footer or "Chloee :3"
	guiconfig.Color = guiconfig.Color or Color3.fromRGB(0, 208, 255)
	guiconfig.Font = guiconfig.Font or Enum.Font.GothamBold
	if guiconfig.Type == 3 then
		guiconfig["Tab Width"] = guiconfig["Tab Width"] or 40
	else
		guiconfig["Tab Width"] = guiconfig["Tab Width"] or 120
	end
	guiconfig.Version = guiconfig.Version or 1
	guiconfig.Image = guiconfig.Image or "132435516080103"
	guiconfig.Language = guiconfig.Language or "en"
	guiconfig.Search = (guiconfig.Search ~= false)
	guiconfig.AutoConfigTab = (guiconfig.AutoConfigTab ~= false)
	guiconfig.LazyConfigTab = (guiconfig.LazyConfigTab ~= false)
	guiconfig.LoadUserThumbnail = guiconfig.LoadUserThumbnail ~= false
	guiconfig.ThumbnailDelay = tonumber(guiconfig.ThumbnailDelay) or 8
	guiconfig.Type = tonumber(guiconfig.Type) or 1
	guiconfig.MiniUI = (guiconfig.MiniUI == true)
	guiconfig.ToggleUIStyle = guiconfig.ToggleUIStyle or (guiconfig.MiniUI and "Overlay" or "Square")
	local toggleUIStyle = guiconfig.ToggleUIStyle
	guiconfig.PerformanceMode = (guiconfig.PerformanceMode ~= nil) and (guiconfig.PerformanceMode == true) or isMobile
	local windowBuildStartTime = 0
	local frameBudget = (guiconfig.PerformanceMode == true) and 0.008 or 0.012

	-- // Centralized Window Layout Throttle
	local function yieldbuild()
		if windowBuildStartTime == 0 then
			windowBuildStartTime = os.clock()
		end
		if (os.clock() - windowBuildStartTime) > frameBudget then
			task.wait()
			windowBuildStartTime = os.clock()
		end
	end

	-- // Centralized Game Support Resolver (GameId matching)
	guiconfig.Game = guiconfig.Game or guiconfig.GameSupport or DEFAULT_CONFIG.GameSupport
	guiconfig.Logs = guiconfig.Logs or guiconfig.UpdateLogs or DEFAULT_CONFIG.Changelogs
	guiconfig.Advanced = (guiconfig.Advanced == false and false) or (type(guiconfig.Advanced) == "string" and guiconfig.Advanced) or DEFAULT_CONFIG.Advanced
	guiconfig.Discord = guiconfig.Discord or DEFAULT_CONFIG.Discord
	local function resolveGameSupport(rawGame)
		rawGame = rawGame or guiconfig.Game

		if type(rawGame) == "table" then
			return rawGame
		end

		if type(rawGame) == "string" then
			local s, res = pcall(function()
				return game:HttpGet(rawGame)
			end)
			if (not s or not res or res == "" or string.find(res, "404")) then
				if string.find(rawGame, "/Add%-On/GameSupport") then
					pcall(function()
						res = game:HttpGet("https://raw.githubusercontent.com/ChloeRewite/Games/refs/heads/main/GameSupport")
					end)
				elseif string.find(rawGame, "/GameSupport$") then
					pcall(function()
						res = game:HttpGet("https://raw.githubusercontent.com/ChloeRewite/Games/refs/heads/main/Add-On/GameSupport.lua")
					end)
				end
			end
			if res and type(res) == "string" and res ~= "" and not string.find(res, "404") then
				local lOk, lFunc = pcall(loadstring, res)
				if lOk and type(lFunc) == "function" then
					local rOk, rData = pcall(lFunc)
					if rOk and type(rData) == "table" then
						return rData
					end
				end
			end
		end

		return nil
	end

	local _gInfo = {
		Data = resolveGameSupport(guiconfig.Game),
		CurrentId = game.GameId,
		Matched = nil,
		MatchedName = nil,
		IsSupported = true,
	}

	if _gInfo.Data then
		for name, data in pairs(_gInfo.Data) do
			if data.GameId == _gInfo.CurrentId then
				_gInfo.Matched = data
				_gInfo.MatchedName = name
				break
			elseif type(data.GameId) == "table" and table.find(data.GameId, _gInfo.CurrentId) then
				_gInfo.Matched = data
				_gInfo.MatchedName = name
				break
			end
		end
		_gInfo.IsSupported = (_gInfo.Matched ~= nil)
	end

	local foldername = guiconfig.Folder
	if not foldername and _gInfo.Matched and _gInfo.Matched.Folder then
		foldername = _gInfo.Matched.Folder
	end
	if not foldername then
		foldername = guiconfig.Title:gsub("[^%w_ ]", ""):gsub("%s+", "_")
	end

	config.gamefolder = "Chloe X/" .. foldername
	config.autoloadfile = config.gamefolder .. "/autoload.txt"

	if isfolder and makefolder then
		if not isfolder("Chloe X") then makefolder("Chloe X") end
		if not isfolder(config.gamefolder) then makefolder(config.gamefolder) end
	end

	config.version = guiconfig.Version

