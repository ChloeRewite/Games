                for _, child in ipairs(char:GetChildren()) do
                    if string.sub(child.Name, 1, 11) == "ChloeX_Acc_" then
                        local id = tonumber(string.sub(child.Name, 12))
                        if id and not targetIds[id] then child:Destroy() end
                    elseif string.sub(child.Name, 1, 15) == "ChloeX_HeadAcc_" then
                        local id = tonumber(string.sub(child.Name, 16))
                        if id and not targetIds[id] then child:Destroy() end
