	local function isRoadOrFloorSurface(part)
		local sz = part.Size
		if math.max(sz.X, sz.Z) >= 24 and sz.Y <= 4 then
			return true
		end
		if not part.CanCollide then
			return false
		end
		if nameMatch(part.Name, structuralKeepPatterns) then
			return true
		end
		local p = part.Parent
		if p and p ~= workspace and nameMatch(p.Name, structuralKeepPatterns) then
			return true
		end
		return false
	end

	local function registerWorldGui(gui)
		if worldGuiOrig[gui] or not gui.Parent then
			return
		end
		if isCharacterOrToolDescendant(gui) then
			local lpChar = env.lp and env.lp.Character
			if lpChar and gui:IsDescendantOf(lpChar) then
				return
			end
		end
		worldGuiOrig[gui] = {
			enabled = gui.Enabled,
			maxDist = gui.MaxDistance,
		}
		if gui.ClassName == "BillboardGui" then
			gui.AlwaysOnTop = false
		end
		worldGuis[#worldGuis + 1] = gui
	end

	local function registerPartToRenderBlock(part)
		if trackedPartBlocks[part] or not part.Parent then
			return
		end
		if part.Transparency >= 0.99 then
			return
		end
		if isCharacterOrToolDescendant(part) then
			return
		end

		local sz = part.Size
		local maxDim = math.max(sz.X, sz.Y, sz.Z)
		local block

		if maxDim > BLOCK_CELL_SIZE then
			local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = part.CFrame:GetComponents()
			local hx, hy, hz = sz.X * 0.5, sz.Y * 0.5, sz.Z * 0.5
			block = {
				cx = x,
				cy = y,
				cz = z,
				hx = math.abs(r00) * hx + math.abs(r01) * hy + math.abs(r02) * hz,
				hy = math.abs(r10) * hx + math.abs(r11) * hy + math.abs(r12) * hz,
				hz = math.abs(r20) * hx + math.abs(r21) * hy + math.abs(r22) * hz,
				parts = { part },
				hidden = false,
				distSq = 0,
			}
			spatialBlocks[#spatialBlocks + 1] = block
		else
			local pos = part.Position
			local bx = math.floor(pos.X / BLOCK_CELL_SIZE)
			local by = math.floor(pos.Y / BLOCK_CELL_SIZE)
			local bz = math.floor(pos.Z / BLOCK_CELL_SIZE)
			local key = bx .. ":" .. by .. ":" .. bz
			block = spatialBlockMap[key]
			if not block then
				block = {
					cx = (bx + 0.5) * BLOCK_CELL_SIZE,
					cy = (by + 0.5) * BLOCK_CELL_SIZE,
					cz = (bz + 0.5) * BLOCK_CELL_SIZE,
					hx = BLOCK_CELL_SIZE * 0.5,
					hy = BLOCK_CELL_SIZE * 0.5,
					hz = BLOCK_CELL_SIZE * 0.5,
					parts = { part },
					hidden = false,
					distSq = 0,
				}
				spatialBlockMap[key] = block
				spatialBlocks[#spatialBlocks + 1] = block
			else
				block.parts[#block.parts + 1] = part
			end
		end

		trackedPartBlocks[part] = block
	end

	local function rebuildSpatialBlocksBudgeted()
		refreshCharModelSet()
		table.clear(spatialBlocks)
		table.clear(spatialBlockMap)
		table.clear(worldGuis)
		trackedPartBlocks = setmetatable({}, { __mode = "k" })
		worldGuiOrig = setmetatable({}, { __mode = "k" })

		local desc = workspace:GetDescendants()
		local t0 = os.clock()
		for i = 1, #desc do
			local obj = desc[i]
			if obj:IsA("BasePart") and obj ~= terrain then
				registerPartToRenderBlock(obj)
			elseif obj.ClassName == "BillboardGui" or obj.ClassName == "SurfaceGui" then
				registerWorldGui(obj)
			end
			if i % 256 == 0 and (os.clock() - t0) > 0.0025 then
				task.wait()
				t0 = os.clock()
			end
		end
	end

	local function restoreAllRenderBlocks()
		local t0 = os.clock()
		local changed = 0
		for i = 1, #spatialBlocks do
			local b = spatialBlocks[i]
			if b.hidden then
				b.hidden = false
				local parts = b.parts
				for j = 1, #parts do
					local p = parts[j]
					if p and p.Parent then
						p.LocalTransparencyModifier = 0
						changed = changed + 1
					end
				end
			end
			if changed >= 600 or (i % 128 == 0 and (os.clock() - t0) > 0.002) then
				changed = 0
				task.wait()
				t0 = os.clock()
			end
		end

		for i = 1, #worldGuis do
			local g = worldGuis[i]
			if g and g.Parent then
				local orig = worldGuiOrig[g]
				if orig then
					g.Enabled = orig.enabled
					g.MaxDistance = orig.maxDist
				else
					g.Enabled = true
				end
			end
		end
	end

	local function sortBlockByDist(a, b)
		return a.distSq < b.distSq
	end

	local function evaluateRenderBlocks(px, py, pz)
		local total = #spatialBlocks
		if total == 0 then
			return
		end

		local aliveCount = 0
		for i = 1, total do
			local b = spatialBlocks[i]
			local parts = b.parts
			local writeIdx = 0
			for j = 1, #parts do
				local p = parts[j]
				if p and p.Parent then
					writeIdx = writeIdx + 1
					parts[writeIdx] = p
				end
			end
			for j = writeIdx + 1, #parts do
				parts[j] = nil
			end

			if writeIdx > 0 then
				aliveCount = aliveCount + 1
				spatialBlocks[aliveCount] = b
				local dx = math.abs(px - b.cx) - b.hx
				local dy = math.abs(py - b.cy) - b.hy
				local dz = math.abs(pz - b.cz) - b.hz
				if dx < 0 then dx = 0 end
				if dy < 0 then dy = 0 end
				if dz < 0 then dz = 0 end
				b.distSq = dx * dx + dy * dy + dz * dz
			end
		end
		for i = aliveCount + 1, total do
			spatialBlocks[i] = nil
		end

		if aliveCount == 0 then
			return
		end

		table.sort(spatialBlocks, sortBlockByDist)

		local limit = st.maxrenderblocks or 100
		local cutoffIdx = limit < aliveCount and limit or aliveCount
		local cutoffDist = math.max(24, math.sqrt(spatialBlocks[cutoffIdx].distSq) + 12)
		local cutoffDistSq = cutoffDist * cutoffDist

		local t0 = os.clock()
		local changed = 0

		for i = 1, aliveCount do
			local b = spatialBlocks[i]
			local shouldHide = i > limit
			if b.hidden ~= shouldHide then
				b.hidden = shouldHide
				local mod = shouldHide and 1 or 0
				local parts = b.parts
				for j = 1, #parts do
					parts[j].LocalTransparencyModifier = mod
					changed = changed + 1
				end
			end
			if changed >= 800 or (i % 160 == 0 and (os.clock() - t0) > 0.0025) then
				changed = 0
				task.wait()
				t0 = os.clock()
			end
		end

		local aliveGuis = 0
		for i = 1, #worldGuis do
			local g = worldGuis[i]
			if g and g.Parent then
				aliveGuis = aliveGuis + 1
				worldGuis[aliveGuis] = g
				local host = g.Adornee
				if not host or not host:IsA("BasePart") then
					host = g:FindFirstAncestorWhichIsA("BasePart")
				end
				local orig = worldGuiOrig[g]
				local allowOrig = (not orig) or orig.enabled
				if not allowOrig then
					g.Enabled = false
				elseif host and host:IsA("BasePart") then
					if host.LocalTransparencyModifier >= 0.99 then
						g.Enabled = false
					else
						local hp = host.Position
						local gx, gy, gz = hp.X - px, hp.Y - py, hp.Z - pz
						if (gx * gx + gy * gy + gz * gz) > cutoffDistSq then
							g.Enabled = false
						else
							g.Enabled = true
							g.MaxDistance = cutoffDist
						end
					end
				else
					g.MaxDistance = cutoffDist
				end
			end
		end
		for i = aliveGuis + 1, #worldGuis do
			worldGuis[i] = nil
		end
	end

	local function startRenderBlockLimiter(skipInitialScan)
		if cache.blockloop then
			return
		end
		cache.blockloop = true

		task.spawn(function()
			if not skipInitialScan or #spatialBlocks == 0 then
				rebuildSpatialBlocksBudgeted()
			end
			local lastX, lastY, lastZ = 9e9, 9e9, 9e9
			local lastLimit = -1

			while st.renderblockenabled and cache.blockloop do
				local refPos
				local char = env.lp and env.lp.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if hrp then
					refPos = hrp.Position
				elseif workspace.CurrentCamera then
					refPos = workspace.CurrentCamera.CFrame.Position
				end

				if refPos then
					local dx = refPos.X - lastX
					local dy = refPos.Y - lastY
					local dz = refPos.Z - lastZ
					local movedSq = dx * dx + dy * dy + dz * dz
					if movedSq >= 36 or lastLimit ~= st.maxrenderblocks then
						lastX, lastY, lastZ = refPos.X, refPos.Y, refPos.Z
						lastLimit = st.maxrenderblocks
						evaluateRenderBlocks(refPos.X, refPos.Y, refPos.Z)
					end
				end

				task.wait(0.15)
			end

			cache.blockloop = false
			restoreAllRenderBlocks()
		end)
	end

	local function optimizeCharacterFast(char, isExtended)
		if not char then
			return
		end
		local isLocal = (env.lp and char == env.lp.Character)
		local desc = char:GetDescendants()
		for i = 1, #desc do
			local obj = desc[i]
			local cls = obj.ClassName
			if charStripClassSet[cls] then
				if not isLocal or cls ~= "Shirt" and cls ~= "Pants" then
					pcall(safeDestroy, obj)
				end
			elseif cls == "Decal" or cls == "Texture" then
				if not isLocal or obj.Name ~= "face" then
					pcall(safeDestroy, obj)
				end
			elseif obj:IsA("BasePart") then
				obj.CastShadow = false
				obj.Reflectance = 0
				if isExtended then
