	servermanager:AddButton({
		Title = "Server Hop",
		Callback = function()
			local cursor = ""
			local servers = {}

			for _ = 1, st.hopretry do
				local url = "https://games.roblox.com/v1/games/" .. env.pid .. "/servers/Public?sortOrder=Asc&limit=100"
				if cursor ~= "" then
					url = url .. "&cursor=" .. cursor
				end

				local ok, result = pcall(function()
					return sv.hs:JSONDecode(game:HttpGet(url))
				end)

				if ok and result and result.data then
					for _, server in ipairs(result.data) do
						if server.id ~= env.jid and server.playing < server.maxPlayers then
							table.insert(servers, server)
						end
					end
					cursor = result.nextPageCursor or ""
				end

				if cursor == "" then
					break
				end
			end

			if #servers <= 0 then
				chloex("No alternative server found!")
				return
			end

			if st.hopmethod == "Random" then
				local target = servers[math.random(1, #servers)]
				sv.ts:TeleportToPlaceInstance(env.pid, target.id, env.lp)
			elseif st.hopmethod == "New" then
				table.sort(servers, function(a, b)
					return a.id > b.id
				end)
				sv.ts:TeleportToPlaceInstance(env.pid, servers[1].id, env.lp)
			elseif st.hopmethod == "Lowest Player" then
				table.sort(servers, function(a, b)
					return a.playing < b.playing
				end)
				sv.ts:TeleportToPlaceInstance(env.pid, servers[1].id, env.lp)
			elseif st.hopmethod == "Old Server" then
				table.sort(servers, function(a, b)
					return a.id < b.id
				end)
				sv.ts:TeleportToPlaceInstance(env.pid, servers[1].id, env.lp)
			end
		end,
	})

