	local spring = {}
	spring.__index = spring

	function spring.new(freq, pos)
		local self = setmetatable({}, spring)
		self.f = freq
		self.p = pos
		self.v = pos * 0
		return self
	end

	function spring:Update(dt, goal)
		local f = self.f * 2 * math.pi
		local offset = goal - self.p
		local decay = math.exp(-f * dt)
		local p1 = goal + (self.v * dt - offset * (f * dt + 1)) * decay
		local v1 = (f * dt * (offset * f - self.v) + self.v) * decay
		self.p = p1
		self.v = v1
		return p1
	end

	function spring:Reset(pos)
		self.p = pos
		self.v = pos * 0
	end

	local velSpring = spring.new(3.5, Vector3.new())
	local panSpring = spring.new(3.5, Vector2.new())
	local freecamInput = {}

	do
		local keyboard = {
			W = 0,
			A = 0,
			S = 0,
			D = 0,
			E = 0,
			Q = 0,
			Up = 0,
			Down = 0,
			Shift = 0,
		}

		local mouse = {
			Delta = Vector2.new(),
		}

		local touchPan = Vector2.new()
		local gamepadPan = Vector2.new()
		local navSpeed = 1
		local mobileBoost = 1
		local lastTap = 0
		local touchGui
		local activeTouch
		local controlModule

		pcall(function()
			controlModule =
				require(env.lp:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
		end)

		local function hasTouchControls()
			local playerGui = env.lp:FindFirstChildOfClass("PlayerGui")
			if not playerGui then
				return false
			end
			return playerGui:FindFirstChild("TouchGui") ~= nil
		end

		local function destroyTouchCapture()
			activeTouch = nil
			touchPan = Vector2.new()

			if touchGui then
				touchGui:Destroy()
				touchGui = nil
			end
		end

		local function createTouchCapture()
			destroyTouchCapture()

			if not hasTouchControls() then
				return
			end

			touchGui = Instance.new("ScreenGui")
			touchGui.Name = "ChloeFreecamTouch"
			touchGui.IgnoreGuiInset = true
			touchGui.ResetOnSpawn = false
			touchGui.DisplayOrder = 999999

			local touchArea = Instance.new("Frame")
			touchArea.Name = "LookArea"
			touchArea.BackgroundTransparency = 1
			touchArea.BorderSizePixel = 0
			touchArea.Active = true
			touchArea.Size = UDim2.fromScale(0.5, 1)
			touchArea.Position = UDim2.fromScale(0.5, 0)
			touchArea.Parent = touchGui

			touchArea.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.Touch then
					return
				end
				activeTouch = input
				local now = tick()
				if now - lastTap <= 0.25 then
					mobileBoost = mobileBoost == 1 and 1.6 or 1
				end
				lastTap = now
			end)

			touchArea.InputChanged:Connect(function(input)
				if input ~= activeTouch or input.UserInputType ~= Enum.UserInputType.Touch then
					return
				end
				touchPan = touchPan + Vector2.new(-input.Delta.Y, -input.Delta.X)
			end)

			touchArea.InputEnded:Connect(function(input)
				if input == activeTouch then
					activeTouch = nil
				end
			end)

			local parent = sv.cg
			pcall(function()
				if gethui then
					parent = gethui()
				end
			end)
			touchGui.Parent = parent
		end

		function freecamInput.Vel(dt)
			navSpeed = math.clamp(navSpeed + dt * (keyboard.Up - keyboard.Down) * 0.75, 0.01, 4)
			local move = Vector3.new(keyboard.D - keyboard.A, keyboard.E - keyboard.Q, keyboard.S - keyboard.W)

			if move.Magnitude == 0 and controlModule then
				local ok, controlMove = pcall(function()
					return controlModule:GetMoveVector()
				end)
				if ok and controlMove then
					move = Vector3.new(controlMove.X, 0, -controlMove.Z) * mobileBoost
				end
			end

			local slowMultiplier = keyboard.Shift == 1 and 0.25 or 1
			return move * navSpeed * slowMultiplier
		end

		function freecamInput.Pan()
			local desktopPan = mouse.Delta * (math.pi / 128) * st.freecamsensitivity
			local mobileMultiplier = st.freecammobile and 0.35 or 0.65
			local mobilePan = touchPan * (math.pi / 360) * mobileMultiplier * st.freecamsensitivity
			local controllerPan = gamepadPan * (math.pi / 90) * st.freecamsensitivity

			mouse.Delta = Vector2.new()
			touchPan = Vector2.new()

			return desktopPan + mobilePan + controllerPan
		end

		local function keypress(_, inputState, input)
			local value = inputState == Enum.UserInputState.Begin and 1 or 0
			if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
				keyboard.Shift = value
			else
				keyboard[input.KeyCode.Name] = value
			end
			return Enum.ContextActionResult.Sink
		end

		local function mousepan(_, inputState, input)
			if inputState == Enum.UserInputState.Change then
				mouse.Delta = mouse.Delta + Vector2.new(-input.Delta.Y, -input.Delta.X)
			end
			return Enum.ContextActionResult.Sink
		end

		local function gamepadpan(_, inputState, input)
			if inputState == Enum.UserInputState.End then
				gamepadPan = Vector2.new()
			elseif inputState == Enum.UserInputState.Change then
				gamepadPan = Vector2.new(-input.Position.Y, -input.Position.X)
			end
			return Enum.ContextActionResult.Sink
		end

		local function resetKeyboard()
			for key in pairs(keyboard) do
				keyboard[key] = 0
			end
		end

		function freecamInput.StartCapture()
			freecamInput.StopCapture()

			sv.cas:BindActionAtPriority(
				"ChloeFreecamKeyboard",
				keypress,
				false,
				Enum.ContextActionPriority.High.Value,
				Enum.KeyCode.W,
				Enum.KeyCode.A,
				Enum.KeyCode.S,
				Enum.KeyCode.D,
				Enum.KeyCode.E,
				Enum.KeyCode.Q,
				Enum.KeyCode.Up,
				Enum.KeyCode.Down,
				Enum.KeyCode.LeftShift,
				Enum.KeyCode.RightShift
			)

			sv.cas:BindActionAtPriority(
				"ChloeFreecamMousePan",
				mousepan,
				false,
				Enum.ContextActionPriority.High.Value,
				Enum.UserInputType.MouseMovement
			)

			sv.cas:BindActionAtPriority(
				"ChloeFreecamGamepadPan",
				gamepadpan,
				false,
				Enum.ContextActionPriority.High.Value,
				Enum.KeyCode.Thumbstick2
			)

			createTouchCapture()
		end

		function freecamInput.StopCapture()
			pcall(function()
				sv.cas:UnbindAction("ChloeFreecamKeyboard")
				sv.cas:UnbindAction("ChloeFreecamMousePan")
				sv.cas:UnbindAction("ChloeFreecamGamepadPan")
			end)

			resetKeyboard()
			mouse.Delta = Vector2.new()
			touchPan = Vector2.new()
			gamepadPan = Vector2.new()
			destroyTouchCapture()
		end
	end

	local function getFocusDistance(cf)
		local znear = 0.1
		local viewport = camera.ViewportSize
		local projy = 2 * math.tan(math.rad(70 / 2))
		local projx = viewport.X / viewport.Y * projy
		local fx = cf.RightVector
		local fy = cf.UpVector
		local fz = cf.LookVector
		local minDist = 512
		local minVect = Vector3.new()

		for x = 0, 1, 0.5 do
			for y = 0, 1, 0.5 do
				local cx = (x - 0.5) * projx
				local cy = (y - 0.5) * projy
				local offset = fx * cx - fy * cy + fz
				local origin = cf.Position + offset * znear
				local _, hit = workspace:FindPartOnRay(Ray.new(origin, offset.Unit * minDist))
				if hit then
					local d = (hit - origin).Magnitude
					if d < minDist then
						minDist = d
						minVect = offset.Unit
					end
				end
			end
		end

		return fz:Dot(minVect) * minDist
	end

	local function stepFreecam(dt)
		local rawVel = freecamInput.Vel(dt)
		local rawPan = freecamInput.Pan(dt)
		local vel = st.freecamsmooth and velSpring:Update(dt, rawVel) or rawVel
		local pan = st.freecamsmooth and panSpring:Update(dt, rawPan) or rawPan
		cameraRot = cameraRot + pan * Vector2.new(0.75, 1)
		cameraRot = Vector2.new(math.clamp(cameraRot.X, -math.rad(90), math.rad(90)), cameraRot.Y)
		local cf = CFrame.new(cameraPos)
			* CFrame.fromOrientation(cameraRot.X, cameraRot.Y, 0)
			* CFrame.new(vel * (64 * st.freecamspeed) * dt)
		cameraPos = cf.Position
		camera.CFrame = cf
		camera.Focus = cf * CFrame.new(0, 0, -getFocusDistance(cf))
	end

	local function startFreecam(pos)
		if fcRunning then
			pcall(function()
				sv.rs:UnbindFromRenderStep("Freecam")
			end)
			freecamInput.StopCapture()
			fcRunning = false
		end
		local cf = pos or lastFreecamCF or camera.CFrame
		local x, y = cf:ToOrientation()
		cameraRot = Vector2.new(x, y)
		cameraPos = cf.Position
		lastFreecamCF = cf
		velSpring:Reset(Vector3.new())
		panSpring:Reset(Vector2.new())
		sv.rs:BindToRenderStep("Freecam", Enum.RenderPriority.Camera.Value, stepFreecam)
		freecamInput.StartCapture()
		fcRunning = true
		st.freecam = true
	end

	local function stopFreecam()
		if not fcRunning then
			return
		end
		freecamInput.StopCapture()
		pcall(function()
			sv.rs:UnbindFromRenderStep("Freecam")
		end)
		fcRunning = false
		st.freecam = false
	end

	local function resetFreecamPosition()
		local char = env.lp.Character or env.lp.CharacterAdded:Wait()
		local hrp = char:WaitForChild("HumanoidRootPart")
		local cf = hrp.CFrame * CFrame.new(0, 2, -8)
		local x, y = cf:ToOrientation()
		cameraPos = cf.Position
		cameraRot = Vector2.new(x, y)
		lastFreecamCF = cf
	end

