			touchGui = Instance.new("ScreenGui")
			touchGui.Name = "ChloeFreecamTouch"
			touchGui.IgnoreGuiInset = true
			touchGui.ResetOnSpawn = false
			touchGui.DisplayOrder = 999999

			local touchArea = Instance.new("Frame")
			touchArea.Name = "LookArea"
			touchArea.BackgroundTransparency = 1
			touchArea.BorderSizePixel = 0
			touchArea.Active = true
			touchArea.Size = UDim2.fromScale(0.5, 1)
			touchArea.Position = UDim2.fromScale(0.5, 0)
			touchArea.Parent = touchGui

			touchArea.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.Touch then
					return
				end
				activeTouch = input
				local now = tick()
				if now - lastTap <= 0.25 then
					mobileBoost = mobileBoost == 1 and 1.6 or 1
				end
				lastTap = now
			end)

			touchArea.InputChanged:Connect(function(input)
				if input ~= activeTouch or input.UserInputType ~= Enum.UserInputType.Touch then
					return
				end
				touchPan += Vector2.new(-input.Delta.Y, -input.Delta.X)
			end)

			touchArea.InputEnded:Connect(function(input)
				if input == activeTouch then
					activeTouch = nil
				end
			end)

			local parent = sv.cg
			pcall(function()
				if gethui then
					parent = gethui()
				end
			end)
			touchGui.Parent = parent
		end

		function freecamInput.Vel(dt)
			navSpeed = math.clamp(navSpeed + dt * (keyboard.Up - keyboard.Down) * 0.75, 0.01, 4)
			local move = Vector3.new(keyboard.D - keyboard.A, keyboard.E - keyboard.Q, keyboard.S - keyboard.W)

			if move.Magnitude == 0 and controlModule then
				local ok, controlMove = pcall(function()
					return controlModule:GetMoveVector()
				end)
				if ok and controlMove then
					move = Vector3.new(controlMove.X, 0, -controlMove.Z) * mobileBoost
				end
			end

			local slowMultiplier = keyboard.Shift == 1 and 0.25 or 1
			return move * navSpeed * slowMultiplier
		end

		function freecamInput.Pan()
			local desktopPan = mouse.Delta * (math.pi / 128) * st.freecamsensitivity
			local mobileMultiplier = st.freecammobile and 0.35 or 0.65
			local mobilePan = touchPan * (math.pi / 360) * mobileMultiplier * st.freecamsensitivity
			local controllerPan = gamepadPan * (math.pi / 90) * st.freecamsensitivity

			mouse.Delta = Vector2.new()
			touchPan = Vector2.new()

			return desktopPan + mobilePan + controllerPan
		end

		local function keypress(_, inputState, input)
			local value = inputState == Enum.UserInputState.Begin and 1 or 0
			if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
				keyboard.Shift = value
			else
				keyboard[input.KeyCode.Name] = value
			end
			return Enum.ContextActionResult.Sink
		end

		local function mousepan(_, inputState, input)
			if inputState == Enum.UserInputState.Change then
				mouse.Delta += Vector2.new(-input.Delta.Y, -input.Delta.X)
			end
			return Enum.ContextActionResult.Sink
		end

		local function gamepadpan(_, inputState, input)
			if inputState == Enum.UserInputState.End then
				gamepadPan = Vector2.new()
			elseif inputState == Enum.UserInputState.Change then
				gamepadPan = Vector2.new(-input.Position.Y, -input.Position.X)
			end
			return Enum.ContextActionResult.Sink
		end

		local function resetKeyboard()
			for key in pairs(keyboard) do
				keyboard[key] = 0
			end
		end

		function freecamInput.StartCapture()
			freecamInput.StopCapture()

			sv.cas:BindActionAtPriority(
				"ChloeFreecamKeyboard",
				keypress,
				false,
				Enum.ContextActionPriority.High.Value,
				Enum.KeyCode.W,
				Enum.KeyCode.A,
				Enum.KeyCode.S,
				Enum.KeyCode.D,
