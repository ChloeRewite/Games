            local function parseRolimonsCatalog(raw)
                local _, _, jsonStr = string.find(raw, "var%s+item_details%s*=%s*(%b{})%s*;")
                if not jsonStr then return nil end
                local okJson, items = pcall(function() return hs:JSONDecode(jsonStr) end)
                if not okJson or type(items) ~= "table" then return nil end

                local headMap, headList = {}, { "None" }
                local shoulderMap, shoulderList = {}, { "None" }
                local backMap, backList = {}, { "None" }
                local seen = {}

                for key, val in pairs(items) do
                    if type(val) == "table" then
                        local aType = val[2]
                        local name = val[1]
                        local id = val[26] or tonumber(string.match(tostring(key), "%d+$"))
                        if name and id and not seen[name] and not string.find(name, "Deleted") and not string.find(name, "DELETED") then
                            seen[name] = true
                            if aType == "asset:8" or aType == "asset:41" then
                                headMap[name] = id; table.insert(headList, name)
                            elseif aType == "asset:44" then
                                shoulderMap[name] = id; table.insert(shoulderList, name)
                            elseif aType == "asset:46" then
                                backMap[name] = id; table.insert(backList, name)
                            end
                        end
                    end
                end

                local function sortList(t)
                    table.sort(t, function(a, b)
                        if a == "None" then return true end
                        if b == "None" then return false end
                        return string.lower(a) < string.lower(b)
                    end)
                end
                sortList(headList); sortList(shoulderList); sortList(backList)

                return {
                    HeadMap = headMap, HeadList = headList,
                    ShoulderMap = shoulderMap, ShoulderList = shoulderList,
                    BackMap = backMap, BackList = backList,
                }
            end

