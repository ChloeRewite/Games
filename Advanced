					return
				end

				local movement = Vector3.zero
				if ControlModule and ControlModule.GetMoveVector then
					pcall(function()
						movement = ControlModule:GetMoveVector()
					end)
				end

				local vertical = (flyUp and 1 or 0) - (flyDown and 1 or 0)
				local direction = camera.CFrame.RightVector * movement.X
					+ camera.CFrame.LookVector * -movement.Z
					+ Vector3.new(0, vertical, 0)

				if direction.Magnitude > 1 then
					direction = direction.Unit
				end

				flyVelocity.Velocity = direction * (st.flyspeed * 50)
				flyGyro.CFrame = camera.CFrame
				humanoid.PlatformStand = true
			end)
		end

