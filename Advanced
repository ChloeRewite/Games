				Delay = delay or 3,
			})
		else
			print("[Chloe X]", msg)
		end
	end

	local sv = {
		p = game:GetService("Players"),
		ts = game:GetService("TeleportService"),
		rs = game:GetService("RunService"),
		l = game:GetService("Lighting"),
		gui = game:GetService("GuiService"),
		hs = game:GetService("HttpService"),
		cg = game:GetService("CoreGui"),
		cas = game:GetService("ContextActionService"),
	}

	local env = {
		lp = sv.p.LocalPlayer,
		pid = game.PlaceId,
		jid = game.JobId,
		psid = game.PrivateServerId,
	}

	local st = {
		reducemethod = "Heavy",
		reduceinterval = 1,
		reduceenabled = false,
		noclip = false,
		walkspeedenabled = false,
		walkspeed = 16,
		infjump = false,
		fullbright = false,
		maxzoom = false,
		maxfps = false,
		flying = false,
		flyspeed = 1,
		freecam = false,
		reconnect = false,
		autoexecute = false,
		autofriend = false,
		antigameplaypaused = true,
		antiafk = true,
		afkmethod = "Idle",
		afkloop = nil,
		freecamspeed = 1,
		freecamsensitivity = 0.65,
		freecamsmooth = false,
		freecammobile = false,
		hopmethod = "Random",
		hopretry = 5,
	}

	local cache = {
		oldlighting = {
			Ambient = sv.l.Ambient,
			Brightness = sv.l.Brightness,
			FogEnd = sv.l.FogEnd,
			GlobalShadows = sv.l.GlobalShadows,
		},
		zoomconn = nil,
		errorconn = nil,
		reducetoken = 0,
		fullbrighttouched = false,
		afkconn = nil,
		noclipconn = nil,
	}

	-- // Setup Sections in Tabs
	local discordTab = (Tabs and Tabs.D)
	if not discordTab and Window and Window.AddInfoTab then
		discordTab = Window:AddInfoTab({
			Name = "Discord",
			LayoutOrder = 3,
			StartActive = false,
		})
	end
	local informationmanager = (discordTab or (Tabs and Tabs.I)) and (discordTab or (Tabs and Tabs.I)):AddSection("Chloe X Information", true)
	local performancemanager = Tabs and Tabs.Adv and Tabs.Adv:AddSection("Performance Manager", true)
	local playermanager = Tabs and Tabs.Adv and Tabs.Adv:AddSection("Player Manager", false)
	local flymanager = Tabs and Tabs.Adv and Tabs.Adv:AddSection("Fly Manager", false)
	local freecammanager = Tabs and Tabs.Adv and Tabs.Adv:AddSection("Freecam Manager", false)
	local afkmanager = Tabs and Tabs.Adv and Tabs.Adv:AddSection("AFK Manager", false)
	local servermanager = Tabs and Tabs.Adv and Tabs.Adv:AddSection("Server Manager", false)

	-- // TAB: DISCORD (Chloe X Community & Partners)
	if informationmanager then
		informationmanager:AddPanel({ Type = "Chloe" })

		informationmanager:AddButton({
			Title = "Copy Discord Chloe X Community",
			Callback = function()
				if setclipboard then
					setclipboard("discord.gg/PaPvGUE8UC")
				end
				chloex("Chloe Discord copied!")
			end,
		})

		informationmanager:AddDivider()

		informationmanager:AddPanel({ Type = "UgPhone" })

		informationmanager:AddButton({
			Title = "Copy Discord UgPhone",
			SubTitle = "Copy Register Link",
			Callback = function()
				if setclipboard then
					setclipboard("https://discord.com/invite/ugphone-official")
				end
				chloex("UgPhone Discord copied!")
			end,
			SubCallback = function()
				if setclipboard then
					setclipboard(
						"https://www.ugphone.com/toc-page/promotion/#/r?partner_id=61c46edd-49e6-0379-b03c-a1bd797557&invitation_code=chloex"
					)
				end
				chloex("UgPhone register link copied!")
			end,
		})

		informationmanager:AddDivider()

		informationmanager:AddPanel({ Type = "ChloeStore" })

		informationmanager:AddButton({
			Title = "Copy Discord Store",
			SubTitle = "Copy WhatsApp Group",
			Callback = function()
				if setclipboard then
					setclipboard("discord.gg/chloex.store")
				end
				chloex("Chloe Store Discord copied!")
			end,
			SubCallback = function()
				if setclipboard then
					setclipboard("https://chat.whatsapp.com/LWBuzyWdVxhH3Eey7Vf77z")
				end
				chloex("WhatsApp Group copied!")
			end,
		})

		informationmanager:AddButton({
			Title = "Copy WhatsApp Channel",
			Callback = function()
				if setclipboard then
					setclipboard("https://www.whatsapp.com/channel/0029VbBvs8I2P59fJGGByz1e")
				end
				chloex("WhatsApp Channel copied!")
			end,
		})
	end

	if not Tabs.Adv then
		return
	end

	-- // TAB: ADVANCED (Performance, Player, Fly, Freecam, AFK, Server)
	local terrain = workspace:FindFirstChildOfClass("Terrain")

	local deleteNamePatterns = {
		"tree",
		"lightpole",
		"barrel",
		"cylinder",
		"floor",
		"vine",
		"plane",
		"default",
		"rock",
		"terrainbase",
	}

	local vfxClasses = {
		"ParticleEmitter",
		"Trail",
		"Beam",
		"Fire",
		"Smoke",
		"Sparkles",
		"Highlight",
		"Explosion",
	}

	local postfxClasses = {
		"BloomEffect",
		"SunRaysEffect",
		"ColorCorrectionEffect",
		"DepthOfFieldEffect",
		"BlurEffect",
		"Atmosphere",
	}

	local vfxSet = {}
	for _, c in ipairs(vfxClasses) do
		vfxSet[c] = true
	end

	local postfxSet = {}
	for _, c in ipairs(postfxClasses) do
		postfxSet[c] = true
	end

	local function nameMatch(name, patterns)
		name = string.lower(name)
		for _, p in ipairs(patterns) do
			if string.find(name, p) then
				return true
			end
		end
		return false
	end

	local function disableVFX(inst)
		pcall(function()
			if
				inst:IsA("ParticleEmitter")
				or inst:IsA("Trail")
				or inst:IsA("Beam")
				or inst:IsA("Fire")
				or inst:IsA("Smoke")
				or inst:IsA("Sparkles")
				or inst:IsA("PointLight")
				or inst:IsA("SpotLight")
				or inst:IsA("SurfaceLight")
				or inst:IsA("PostEffect")
			then
				inst.Enabled = false
			elseif inst:IsA("Atmosphere") then
				inst:Destroy()
			elseif inst:IsA("Sky") then
				inst.SunAngularSize = 0
				inst.MoonAngularSize = 0
				inst.StarCount = 0
			end
		end)
	end

	local function disableInst(inst)
		pcall(function()
			if
				inst:IsA("ParticleEmitter")
				or inst:IsA("Trail")
				or inst:IsA("Beam")
				or inst:IsA("Fire")
				or inst:IsA("Smoke")
				or inst:IsA("Sparkles")
				or inst:IsA("PointLight")
				or inst:IsA("SpotLight")
				or inst:IsA("SurfaceLight")
				or inst:IsA("BlurEffect")
				or inst:IsA("BloomEffect")
				or inst:IsA("SunRaysEffect")
				or inst:IsA("ColorCorrectionEffect")
				or inst:IsA("DepthOfFieldEffect")
				or inst:IsA("Atmosphere")
				or inst:IsA("PostEffect")
			then
				inst.Enabled = false
			elseif inst:IsA("Sky") then
				inst.SunAngularSize = 0
				inst.MoonAngularSize = 0
				inst.StarCount = 0
			elseif inst:IsA("BasePart") then
				inst.CastShadow = false
				inst.Material = Enum.Material.Plastic
				inst.Reflectance = 0
			elseif inst:IsA("Decal") or inst:IsA("Texture") then
				inst.Transparency = 1
			end
		end)
	end

	local function reduceOnce()
		local method = st.reducemethod or "Heavy"
		local isHeavy = method == "Heavy"
		local isPower = method == "Powerfull Heavy"
		local isSuper = method == "Super Heavy"
		local isColorful = method == "Colorful Heavy"
		local isExtended = isPower or isSuper or isColorful

		for _, obj in ipairs(workspace:GetDescendants()) do
			local className = obj.ClassName

			disableVFX(obj)

			if vfxSet[className] then
				pcall(function()
					obj:Destroy()
				end)
			elseif obj:IsA("BasePart") then
				if (isSuper or isColorful) and nameMatch(obj.Name, deleteNamePatterns) then
					pcall(function()
						obj:Destroy()
					end)
				else
					pcall(function()
						obj.CastShadow = false
						obj.Material = Enum.Material.Plastic
						obj.Reflectance = 0
						if not isColorful then
							obj.BrickColor = BrickColor.new("Medium stone grey")
						end
						if obj:IsA("MeshPart") then
							obj.CollisionFidelity = Enum.CollisionFidelity.Box
						end
					end)
				end
			elseif obj:IsA("Decal") or obj:IsA("Texture") then
				if isSuper then
					pcall(function()
						obj:Destroy()
					end)
				elseif isHeavy or isPower then
					pcall(function()
						obj.Transparency = 1
					end)
				end
			elseif isExtended then
				if obj:IsA("Model") and nameMatch(obj.Name, { "tree", "lightpole", "barrel" }) then
					pcall(function()
						obj:Destroy()
					end)
				elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
					pcall(function()
						obj:Destroy()
					end)
				end
			end
		end

		if isExtended then
			for _, obj in ipairs(sv.l:GetDescendants()) do
				disableVFX(obj)
			end

			for _, obj in ipairs(sv.l:GetChildren()) do
				if postfxSet[obj.ClassName] then
					pcall(function()
						obj:Destroy()
					end)
				end
			end
		end

		if isSuper then
			if terrain then
				terrain.WaterTransparency = 1
				terrain.WaterReflectance = 0
				terrain.WaterWaveSize = 0
				terrain.WaterWaveSpeed = 0
			end
			pcall(function()
				sv.l.GlobalShadows = false
				sv.l.FogStart = 9e9
				sv.l.FogEnd = 9e9
				sv.l.Brightness = 1
			end)
		end

		local cam = workspace.CurrentCamera
		if cam then
			cam.CameraType = Enum.CameraType.Custom
			cam.FieldOfView = 70
		end

		if env.lp and env.lp.Character then
			for _, obj in ipairs(env.lp.Character:GetDescendants()) do
				disableVFX(obj)
				if obj:IsA("Accessory") and isExtended then
					pcall(function()
						obj:Destroy()
					end)
				end
			end
		end
	end

	local function reduceRecommended()
		local allWorkspace = workspace:GetDescendants()
		local allLighting = sv.l:GetDescendants()

		for _, obj in ipairs(allWorkspace) do
			disableInst(obj)
		end

		for _, obj in ipairs(allLighting) do
			disableInst(obj)
		end

		for _, obj in ipairs(allWorkspace) do
			if obj:IsA("Model") and nameMatch(obj.Name, { "tree", "lightpole", "barrel" }) then
				pcall(function()
					obj:Destroy()
				end)
			end
		end

		local islands = workspace:FindFirstChild("Islands")
		if islands then
			local fisher = islands:FindFirstChild("Fisherman Island")
			if fisher then
				local bg = fisher:FindFirstChild("Background Buildings")
				if bg then
					pcall(function()
						bg:Destroy()
					end)
				end
			end
			local christmas = islands:FindFirstChild("ChristmasDecor [Fisheman Island]")
			if christmas then
				pcall(function()
					christmas:Destroy()
				end)
			end
		end

		for _, obj in ipairs(allWorkspace) do
			if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
				pcall(function()
					obj:Destroy()
				end)
			end
		end

		for _, obj in ipairs(allWorkspace) do
			if vfxSet[obj.ClassName] then
				pcall(function()
					obj:Destroy()
				end)
			end
		end

		for _, obj in ipairs(sv.l:GetChildren()) do
			if postfxSet[obj.ClassName] then
				pcall(function()
					obj:Destroy()
				end)
			end
		end

		for _, obj in ipairs(allWorkspace) do
			if obj:IsA("Decal") or obj:IsA("Texture") then
				pcall(function()
					obj:Destroy()
				end)
			end
		end

		for _, obj in ipairs(allWorkspace) do
			if obj:IsA("BasePart") then
				if nameMatch(obj.Name, deleteNamePatterns) then
					pcall(function()
						obj:Destroy()
					end)
				else
					pcall(function()
						obj.Material = Enum.Material.Plastic
						obj.Transparency = 0
						obj.BrickColor = BrickColor.new("Medium stone grey")
						obj.CastShadow = false
						obj.Reflectance = 0
						if obj:IsA("MeshPart") then
							obj.CollisionFidelity = Enum.CollisionFidelity.Box
						end
					end)
				end
			end
		end

		if terrain then
			terrain.WaterTransparency = 1
			terrain.WaterReflectance = 0
			terrain.WaterWaveSize = 0
			terrain.WaterWaveSpeed = 0
		end

		pcall(function()
			sv.l.GlobalShadows = false
			sv.l.FogStart = 9e9
			sv.l.FogEnd = 9e9
			sv.l.Brightness = 1
		end)

		local cam = workspace.CurrentCamera
		if cam then
			cam.CameraType = Enum.CameraType.Custom
			cam.FieldOfView = 70
		end

		pcall(function()
			settings().Physics.PhysicsEnvironmentalThrottle = Enum.EnvironmentalPhysicsThrottle.Disabled
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)

		local function optimizeCharacter(char)
			for _, obj in ipairs(char:GetDescendants()) do
				disableInst(obj)
				if obj:IsA("Accessory") then
					pcall(function()
						obj:Destroy()
					end)
				elseif obj:IsA("BasePart") then
					pcall(function()
						obj.Material = Enum.Material.Plastic
						obj.BrickColor = BrickColor.new("Medium stone grey")
						obj.CastShadow = false
					end)
				elseif vfxSet[obj.ClassName] then
					pcall(function()
						obj:Destroy()
					end)
				end
			end
		end

		if env.lp then
			if env.lp.Character then
				optimizeCharacter(env.lp.Character)
			end
			env.lp.CharacterAdded:Connect(optimizeCharacter)
		end
	end

	-- // Performance Manager
	performancemanager:AddDropdown({
		Title = "Reduce Map Method",
		Multi = false,
		Default = st.reducemethod,
		Options = { "Heavy", "Powerfull Heavy", "Super Heavy", "Colorful Heavy" },
		Callback = function(v)
			st.reducemethod = v or "Heavy"
		end,
	})

	performancemanager:AddInput({
		Title = "Destroy Interval (Hour)",
		Default = tostring(st.reduceinterval),
		Callback = function(val)
			local num = tonumber(val)
			if num and num > 0 then
				st.reduceinterval = num
			end
		end,
	})

	performancemanager:AddToggle({
		Title = "Reduce Map Loop",
		Default = false,
		Callback = function(state)
			st.reduceenabled = state
			cache.reducetoken = cache.reducetoken + 1
			local token = cache.reducetoken
			if not state then
				return
			end
			task.spawn(function()
				while st.reduceenabled and token == cache.reducetoken do
					reduceOnce()
					task.wait(math.max(1, st.reduceinterval * 3600))
				end
			end)
		end,
	})

	performancemanager:AddButton({
		Title = "Reduce Map (Recommended)",
		Content = "Extreme Reduce map, VFX, Terrain, and Character Optimization",
		Callback = reduceRecommended,
	})

	performancemanager:AddSubSection("Quality Manager")

	performancemanager:AddToggle({
		Title = "Disable 3D Render",
		Content = "No Render Map",
		Default = false,
		Callback = function(state)
			pcall(function()
				sv.rs:Set3dRenderingEnabled(not state)
			end)
		end,
	})

	performancemanager:AddToggle({
		Title = "Black Screen",
		Content = "Make your screen fully black",
		Default = false,
		Callback = function(value)
			local chloeUI = sv.cg:FindFirstChild("Chloeex")
			local toggleUI = sv.cg:FindFirstChild("ToggleUIButton")

			if value then
				if not sv.cg:FindFirstChild("BlackScreen") then
					local frame = Instance.new("ScreenGui")
					frame.Name = "BlackScreen"
					frame.IgnoreGuiInset = true
					frame.ResetOnSpawn = false
					frame.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
					frame.DisplayOrder = 0
					frame.Parent = sv.cg

					local bg = Instance.new("Frame")
					bg.Size = UDim2.new(1, 0, 1, 0)
					bg.BackgroundColor3 = Color3.new(0, 0, 0)
					bg.ZIndex = 0
					bg.Parent = frame
				end

				if chloeUI then
					chloeUI.DisplayOrder = 10
				end
				if toggleUI then
					toggleUI.DisplayOrder = 11
				end
				pcall(function()
					sv.rs:Set3dRenderingEnabled(false)
				end)
			else
				local blackscreen = sv.cg:FindFirstChild("BlackScreen")
				if blackscreen then
					blackscreen:Destroy()
				end
				pcall(function()
					sv.rs:Set3dRenderingEnabled(true)
				end)
			end
		end,
	})

	performancemanager:AddToggle({
		Title = "Max FPS",
		Content = "Unlock FPS limit",
		Default = false,
		Callback = function(state)
			st.maxfps = state
			if state then
				if setfpscap then
					setfpscap(999)
				elseif set_fps_cap then
					set_fps_cap(999)
				end
			else
				if setfpscap then
					setfpscap(60)
				elseif set_fps_cap then
					set_fps_cap(60)
				end
			end
		end,
	})

	-- // Player Manager
	playermanager:AddToggle({
		Title = "Noclip",
		Content = "Walk through objects",
		Default = false,
		Callback = function(v)
			st.noclip = v

			if cache.noclipconn then
				cache.noclipconn:Disconnect()
				cache.noclipconn = nil
			end

			if v then
				cache.noclipconn = sv.rs.Heartbeat:Connect(function()
					local char = env.lp.Character
					if not char then
						return
					end
					for _, part in ipairs(char:GetDescendants()) do
						if part:IsA("BasePart") and part.CanCollide then
							part.CanCollide = false
						end
					end
				end)
			end
		end,
	})

	playermanager:AddSlider({
		Title = "Walkspeed",
		Min = 16,
		Max = 200,
		Default = 16,
		Callback = function(val)
			st.walkspeed = val
			local hum = env.lp.Character and env.lp.Character:FindFirstChild("Humanoid")
			if st.walkspeedenabled and hum then
				hum.WalkSpeed = val
			end
		end,
	})

	playermanager:AddToggle({
		Title = "Enable Walkspeed",
		Content = "Speed boost",
		Default = false,
		Callback = function(v)
			st.walkspeedenabled = v
			local hum = env.lp.Character and env.lp.Character:FindFirstChild("Humanoid")
			if hum then
				hum.WalkSpeed = v and st.walkspeed or 16
			end
		end,
	})

	playermanager:AddToggle({
		Title = "Fullbright",
		Default = false,
		Callback = function(state)
			st.fullbright = state
			if state then
				cache.fullbrighttouched = true
				sv.l.Ambient = Color3.new(1, 1, 1)
				sv.l.Brightness = 2
				sv.l.FogEnd = 100000
				sv.l.GlobalShadows = false
			else
				if not cache.fullbrighttouched then
					return
				end
				sv.l.Ambient = cache.oldlighting.Ambient
				sv.l.Brightness = cache.oldlighting.Brightness
				sv.l.FogEnd = cache.oldlighting.FogEnd
				sv.l.GlobalShadows = cache.oldlighting.GlobalShadows
			end
		end,
	})

	do
		local jumpConnection

		local function bindInfiniteJump(character)
			if jumpConnection then
				jumpConnection:Disconnect()
				jumpConnection = nil
			end

			local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid")

			jumpConnection = humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
				if not st.infjump then
					return
				end

				if humanoid.Jump then
					humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end)
		end

		if env.lp.Character then
			bindInfiniteJump(env.lp.Character)
		end

		env.lp.CharacterAdded:Connect(bindInfiniteJump)

		playermanager:AddToggle({
			Title = "Infinite Jump",
			Default = false,
			Callback = function(state)
				st.infjump = state

				if state then
					local character = env.lp.Character or env.lp.CharacterAdded:Wait()
					local humanoid = character:FindFirstChildOfClass("Humanoid")
					if humanoid then
						humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
					end
				end
			end,
		})
	end

	playermanager:AddToggle({
		Title = "Max Zoom 1000",
		Content = "Increase max camera distance",
		Default = false,
		Callback = function(state)
			st.maxzoom = state
			if cache.zoomconn then
				cache.zoomconn:Disconnect()
				cache.zoomconn = nil
			end
			if state then
				env.lp.CameraMaxZoomDistance = 1000
				env.lp.CameraMinZoomDistance = 0.5
				cache.zoomconn = env.lp.CharacterAdded:Connect(function()
					task.wait(0.3)
					env.lp.CameraMaxZoomDistance = 1000
					env.lp.CameraMinZoomDistance = 0.5
				end)
			else
				env.lp.CameraMaxZoomDistance = 128
				env.lp.CameraMinZoomDistance = 0.5
			end
		end,
	})

	-- // Fly Manager
	do
		local flyConnection
		local flyVelocity
		local flyGyro
		local flyHumanoid

		local flyUp = false
		local flyDown = false

		local ControlModule
		pcall(function()
			ControlModule =
				require(env.lp:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
		end)

		local function stopFly()
			st.flying = false
			flyUp = false
			flyDown = false

			pcall(function()
				sv.cas:UnbindAction("ChloeFlyUp")
				sv.cas:UnbindAction("ChloeFlyDown")
			end)

			if flyConnection then
				flyConnection:Disconnect()
				flyConnection = nil
			end

			if flyVelocity then
				flyVelocity:Destroy()
				flyVelocity = nil
			end

