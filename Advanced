                end
                local s, raw = pcall(function() return game:HttpGet("https://www.rolimons.com/catalog") end)
                if s and raw and #raw > 0 then
                    local data = parseRolimonsCatalog(raw)
                    if data then
                        if writefile then
                            pcall(function() writefile(cacheFile, hs:JSONEncode(data)) end)
                        end
                        return data
                    end
                end
                return nil
            end

