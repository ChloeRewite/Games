            })

            local headDropdown, faceDropdown, shoulderDropdown, backDropdown
            local equippedDropdown, sliderScale, sliderOffsetY, sliderOffsetX, sliderOffsetZ

            local function getEquippedAccessoryNames()
                local list = {}
                local function addNames(tbl)
                    for _, name in ipairs(tbl or {}) do
                        if name ~= "None" and name ~= "" and not table.find(list, name) then
                            table.insert(list, name)
                        end
                    end
                end
                addNames(vst.SelectedHeadAccessories)
                addNames(vst.SelectedShoulderAccessories)
                addNames(vst.SelectedBackAccessories)
                return list
            end

            local function updateOffsetSliders(itemName)
                if not sliderOffsetX or not sliderOffsetY or not sliderOffsetZ or not sliderScale then return end
                local assetId = itemName and itemName ~= "None" and itemName ~= "" and getAssetIdByName(itemName) or nil
                local off = assetId and vst.AccessoryOffsets[assetId] or { X = 0, Y = 0, Z = 0, Scale = 1.0 }
                sliderOffsetX:Set(off.X or 0, true, true)
                sliderOffsetY:Set(off.Y or 0, true, true)
                sliderOffsetZ:Set(off.Z or 0, true, true)
                sliderScale:Set(off.Scale or 1.0, true, true)
            end

            local function updateEquippedDropdownList()
                if not equippedDropdown then return end
                local equippedList = getEquippedAccessoryNames()
                if #equippedList == 0 then
                    vst.SelectedEditItem = "None"
                    equippedDropdown:SetValues({ "None" }, "None", true)
                    updateOffsetSliders("None")
                else
                    if not table.find(equippedList, vst.SelectedEditItem) then
                        vst.SelectedEditItem = equippedList[1]
                    end
                    equippedDropdown:SetValues(equippedList, vst.SelectedEditItem, true)
                    updateOffsetSliders(vst.SelectedEditItem)
                end
            end

            local function setAccessoryScale(scaleVal)
                local selectedName = vst.SelectedEditItem
                if not selectedName or selectedName == "None" or selectedName == "" then return end
                local assetId = getAssetIdByName(selectedName)
                if not assetId then return end
                if not vst.AccessoryOffsets[assetId] then
                    vst.AccessoryOffsets[assetId] = { X = 0, Y = 0, Z = 0, Scale = 1.0 }
                end
                vst.AccessoryOffsets[assetId].Scale = scaleVal

                local curChar = getRealCharacter()
                local acc = curChar and (curChar:FindFirstChild("ChloeX_Acc_" .. tostring(assetId)) or curChar:FindFirstChild("ChloeX_HeadAcc_" .. tostring(assetId)))
                local handle = acc and acc:FindFirstChild("Handle")
                if handle then
                    local sm = handle:FindFirstChildOfClass("SpecialMesh")
                    if sm and vst.AccessoryBaseMeshScale[assetId] then
                        sm.Scale = vst.AccessoryBaseMeshScale[assetId] * scaleVal
                    end
                    if handle:IsA("MeshPart") and vst.AccessoryBasePartSize[assetId] then
                        handle.Size = vst.AccessoryBasePartSize[assetId] * scaleVal
                    end
                    local weld = handle:FindFirstChild("AccessoryWeld")
                    local baseC0 = vst.AccessoryBaseC0[assetId]
                    if weld and baseC0 then
                        weld.C0 = CFrame.new(baseC0.Position * scaleVal) * (baseC0 - baseC0.Position)
                    end
                end
            end

            local function setAccessoryOffsetAxis(axis, val)
                local selectedName = vst.SelectedEditItem
                if not selectedName or selectedName == "None" or selectedName == "" then return end
                local assetId = getAssetIdByName(selectedName)
                if not assetId then return end
                if not vst.AccessoryOffsets[assetId] then
                    vst.AccessoryOffsets[assetId] = { X = 0, Y = 0, Z = 0, Scale = 1.0 }
                end
                vst.AccessoryOffsets[assetId][axis] = val

                local off = vst.AccessoryOffsets[assetId]
                local curChar = getRealCharacter()
                local acc = curChar and (curChar:FindFirstChild("ChloeX_Acc_" .. tostring(assetId)) or curChar:FindFirstChild("ChloeX_HeadAcc_" .. tostring(assetId)))
                local handle = acc and acc:FindFirstChild("Handle")
                local weld = handle and handle:FindFirstChild("AccessoryWeld")
                if weld then
                    local baseC1 = vst.AccessoryBaseC1[assetId] or weld.C1
                    vst.AccessoryBaseC1[assetId] = baseC1
                    weld.C1 = baseC1 * CFrame.new(off.X or 0, off.Y or 0, -(off.Z or 0))
                end
            end

            headDropdown = secAccessories:AddDropdown({
                Title = "Head Accessories",
                Multi = true,
                Options = makeInitialList(HEAD_ACCESSORIES_FALLBACK),
                Default = {},
                Callback = function(chosenList)
                    if type(chosenList) == "table" and table.find(chosenList, "None") then
                        vst.SelectedHeadAccessories = {}
                        syncAllAccessories(getRealCharacter())
                        if headDropdown and headDropdown.Set then headDropdown:Set({}) end
                        updateEquippedDropdownList()
                        return
                    end
                    vst.SelectedHeadAccessories = (type(chosenList) == "table" and chosenList) or (chosenList and { chosenList } or {})
                    syncAllAccessories(getRealCharacter())
                    updateEquippedDropdownList()
                end,
            })

            faceDropdown = secAccessories:AddDropdown({
                Title = "Faces",
                Options = facesList,
                Default = "Default",
                Callback = function(chosen)
                    local faceName = (type(chosen) == "table" and chosen[1]) or chosen or "Default"
                    applyFace(getRealCharacter(), faceName)
                end,
            })

            secAccessories:AddInput({
                Title = "Custom Face Asset ID",
                Placeholder = "Enter Face ID...",
                Default = "",
                Callback = function(text)
                    local id = tonumber(text)
                    if id and id > 0 then
                        applyFace(getRealCharacter(), tostring(id))
                    end
                end,
            })

            shoulderDropdown = secAccessories:AddDropdown({
                Title = "Shoulder Accessories",
                Multi = true,
                Options = makeInitialList(SHOULDER_ACCESSORIES_FALLBACK),
                Default = {},
                Callback = function(chosenList)
                    if type(chosenList) == "table" and table.find(chosenList, "None") then
                        vst.SelectedShoulderAccessories = {}
                        syncAllAccessories(getRealCharacter())
                        if shoulderDropdown and shoulderDropdown.Set then shoulderDropdown:Set({}) end
                        updateEquippedDropdownList()
                        return
                    end
                    vst.SelectedShoulderAccessories = (type(chosenList) == "table" and chosenList) or (chosenList and { chosenList } or {})
                    syncAllAccessories(getRealCharacter())
                    updateEquippedDropdownList()
                end,
            })

            backDropdown = secAccessories:AddDropdown({
                Title = "Back Accessories",
                Multi = true,
                Options = makeInitialList(BACK_ACCESSORIES_FALLBACK),
                Default = {},
                Callback = function(chosenList)
                    if type(chosenList) == "table" and table.find(chosenList, "None") then
                        vst.SelectedBackAccessories = {}
                        syncAllAccessories(getRealCharacter())
                        if backDropdown and backDropdown.Set then backDropdown:Set({}) end
                        updateEquippedDropdownList()
                        return
                    end
                    vst.SelectedBackAccessories = (type(chosenList) == "table" and chosenList) or (chosenList and { chosenList } or {})
                    syncAllAccessories(getRealCharacter())
                    updateEquippedDropdownList()
                end,
            })

            secAccessories:AddButton({
                Title = "Clear All Accessories",
                Callback = function()
                    vst.SelectedHeadAccessories = {}
                    vst.SelectedShoulderAccessories = {}
                    vst.SelectedBackAccessories = {}
                    vst.SelectedFace = "Default"
                    local curChar = getRealCharacter()
                    removeAllAccessories(curChar)
                    applyFace(curChar, "Default")
                    if headDropdown and headDropdown.Set then headDropdown:Set({}) end
                    if faceDropdown and faceDropdown.Set then faceDropdown:Set("Default") end
                    if shoulderDropdown and shoulderDropdown.Set then shoulderDropdown:Set({}) end
                    if backDropdown and backDropdown.Set then backDropdown:Set({}) end
                    updateEquippedDropdownList()
                end,
            })

            secAccessories:AddSubSection("Accessory Position & Scale")

            equippedDropdown = secAccessories:AddDropdown({
                Title = "Equiped Item",
                Options = { "None" },
                Default = "None",
                Callback = function(chosen)
                    local itemName = (type(chosen) == "table" and chosen[1]) or chosen or "None"
                    vst.SelectedEditItem = itemName
                    updateOffsetSliders(itemName)
                end,
            })

            sliderScale = secAccessories:AddSlider({
                Title = "Scale (Size)",
                Min = 0.1,
                Max = 3,
                Default = 1,
                Increment = 0.05,
                Precision = 2,
                Callback = function(val) setAccessoryScale(val) end,
            })

            sliderOffsetY = secAccessories:AddSlider({
                Title = "Up / Down (Height)",
                Min = -3,
                Max = 3,
                Default = 0,
                Increment = 0.05,
                Precision = 2,
                Callback = function(val) setAccessoryOffsetAxis("Y", val) end,
            })

            sliderOffsetX = secAccessories:AddSlider({
                Title = "Left / Right (Side)",
                Min = -3,
                Max = 3,
                Default = 0,
                Increment = 0.05,
                Precision = 2,
                Callback = function(val) setAccessoryOffsetAxis("X", val) end,
            })

            sliderOffsetZ = secAccessories:AddSlider({
                Title = "Front / Back (Depth)",
                Min = -3,
                Max = 3,
                Default = 0,
                Increment = 0.05,
                Precision = 2,
                Callback = function(val) setAccessoryOffsetAxis("Z", val) end,
            })

            secAccessories:AddButton({
                Title = "Reset Position & Scale",
                Callback = function()
                    local selectedName = vst.SelectedEditItem
                    if not selectedName or selectedName == "None" or selectedName == "" then return end
                    local assetId = getAssetIdByName(selectedName)
                    if not assetId then return end
                    vst.AccessoryOffsets[assetId] = { X = 0, Y = 0, Z = 0, Scale = 1.0 }
                    updateOffsetSliders(selectedName)
                    local curChar = getRealCharacter()
                    local acc = curChar and (curChar:FindFirstChild("ChloeX_Acc_" .. tostring(assetId)) or curChar:FindFirstChild("ChloeX_HeadAcc_" .. tostring(assetId)))
                    local handle = acc and acc:FindFirstChild("Handle")
                    if handle then
                        local sm = handle:FindFirstChildOfClass("SpecialMesh")
                        if sm and vst.AccessoryBaseMeshScale[assetId] then sm.Scale = vst.AccessoryBaseMeshScale[assetId] end
                        if handle:IsA("MeshPart") and vst.AccessoryBasePartSize[assetId] then handle.Size = vst.AccessoryBasePartSize[assetId] end
                        local weld = handle:FindFirstChild("AccessoryWeld")
                        if weld then
                            if vst.AccessoryBaseC0[assetId] then weld.C0 = vst.AccessoryBaseC0[assetId] end
                            if vst.AccessoryBaseC1[assetId] then weld.C1 = vst.AccessoryBaseC1[assetId] end
                        end
                    end
                end,
            })

            task.spawn(function()
                task.wait(0.25)
                local data = getCachedOrFetchRolimonsAccessories()
                if data and getgenv and getgenv().ChloeX_Running then
                    vst.HeadAccessoriesMap = data.HeadMap
                    vst.ShoulderAccessoriesMap = data.ShoulderMap
                    vst.BackAccessoriesMap = data.BackMap
                    if headDropdown and headDropdown.SetValues then
                        headDropdown:SetValues(data.HeadList, vst.SelectedHeadAccessories or {}, true)
                    end
                    if shoulderDropdown and shoulderDropdown.SetValues then
                        shoulderDropdown:SetValues(data.ShoulderList, vst.SelectedShoulderAccessories or {}, true)
                    end
                    if backDropdown and backDropdown.SetValues then
                        backDropdown:SetValues(data.BackList, vst.SelectedBackAccessories or {}, true)
                    end
                end
            end)

            local myWinRef = getgenv and getgenv().ChloeX_Window
            local charConn = lp and lp.CharacterAdded:Connect(function(newChar)
                if not getgenv or not getgenv().ChloeX_Running or getgenv().ChloeX_Window ~= myWinRef then return end
                task.wait(0.3)
                local rig = getRealCharacter() or newChar
                vst.OriginalHead = nil
                vst.OriginalDeathWalkerHead = nil
                vst.OriginalFaceTexture = nil
                if vst.KorbloxLeft then applyKorbloxLeft(rig) end
                if vst.KorbloxRight then applyKorbloxRight(rig) end
                if vst.HeadlessHead then applyHeadlessVisual(rig) elseif vst.DeathWalkerHead then applyDeathWalkerHead(rig) end
                if vst.SelectedFace and vst.SelectedFace ~= "Default" then applyFace(rig, vst.SelectedFace) end
                syncAllAccessories(rig)
            end)

            task.spawn(function()
                while getgenv and getgenv().ChloeX_Running and getgenv().ChloeX_Window == myWinRef do
                    task.wait(0.4)
                    local hasVisual = vst.KorbloxRight or vst.KorbloxLeft or vst.HeadlessHead or vst.DeathWalkerHead
                        or (#(vst.SelectedHeadAccessories or {}) > 0)
                        or (#(vst.SelectedShoulderAccessories or {}) > 0)
                        or (#(vst.SelectedBackAccessories or {}) > 0)
                    if hasVisual then
                        local curChar = getRealCharacter()
                        if curChar and curChar.Parent then
                            if vst.KorbloxRight and not curChar:FindFirstChild("ChloeXKorbloxRight") then
                                applyKorbloxRight(curChar)
                            end
                            if vst.KorbloxLeft and not curChar:FindFirstChild("ChloeXKorbloxLeft_Rig") then
                                applyKorbloxLeft(curChar)
                            end
                            if vst.HeadlessHead then
                                local head = curChar:FindFirstChild("Head")
                                if head and head.Transparency < 1 then applyHeadlessVisual(curChar) end
                            end
                            if vst.DeathWalkerHead then
                                local head = curChar:FindFirstChild("Head")
                                if head and not head:FindFirstChild("LeftEyeFire") then applyDeathWalkerHead(curChar) end
                            end
                            syncAllAccessories(curChar)
                        end
                    end
                end
                if charConn then pcall(function() charConn:Disconnect() end) end
                local curChar = getRealCharacter()
                if curChar then
                    removeKorbloxLeft(curChar)
                    removeKorbloxRight(curChar)
                    removeHeadlessVisual(curChar)
                    removeDeathWalkerHead(curChar)
                    removeAllAccessories(curChar)
                end
            end)
        end

        if userTab.OnOpen then
            userTab:OnOpen(initUserVisuals)
            local cfgData = Window and Window.Config and Window.Config.data
            if type(cfgData) == "table" then
                for k, v in pairs(cfgData) do
                    if type(k) == "string" and k:sub(1, 5) == "User_" and v ~= false and v ~= "" and v ~= "Default" and v ~= "None" then
                        if type(v) ~= "table" or #v > 0 then
                            if userTab.Preload then
                                userTab:Preload()
                            end
                            break
                        end
                    end
                end
            end
        else
            initUserVisuals()
        end
    end
end
