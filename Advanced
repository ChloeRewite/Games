	local function optimizeSingleObject(obj, method)
		if not obj or not obj.Parent or obj == terrain then
			return false
		end
		if processedInst[obj] then
			return false
		end

		local cls = obj.ClassName
		local isPotato = (method == "Super Potato")
		local isSuper = isPotato or (method == "Super Heavy")
		local isPower = (method == "Powerfull Heavy")
		local isColorful = (method == "Colorful Heavy")
		local isExtended = isSuper or isPower or isColorful

		if destroyClassSet[cls] then
			pcall(safeDestroy, obj)
			return true
		end

		if cls == "Decal" or cls == "Texture" then
			if isSuper or isColorful then
				pcall(safeDestroy, obj)
			else
				processedInst[obj] = true
				pcall(safeHideDecal, obj)
			end
			return true
		end

		if cls == "Sky" then
			processedInst[obj] = true
			pcall(safeSetSkyMinimal, obj)
			return true
		end

		if cls == "SpecialMesh" then
			processedInst[obj] = true
			if isSuper then
				pcall(safeClearSpecialMeshTex, obj)
				return true
			end
			return false
		end

		if cls == "BillboardGui" or cls == "SurfaceGui" then
			processedInst[obj] = true
			if st.renderblockenabled then
				registerWorldGui(obj)
			end
			return false
		end

		if obj:IsA("PostEffect") then
			obj.Enabled = false
			if isExtended then
				pcall(safeDestroy, obj)
			end
			return true
		end

		if obj:IsA("BasePart") then
			if isCharacterOrToolDescendant(obj) then
				obj.CastShadow = false
				obj.Reflectance = 0
				processedInst[obj] = true
				return false
			end

			processedInst[obj] = true
			obj.CastShadow = false
			obj.Reflectance = 0
			obj.Material = Enum.Material.SmoothPlastic

			local isRoad = isRoadOrFloorSurface(obj)
			if not isColorful then
				if obj:IsA("UnionOperation") then
					pcall(safeSetUnionPartColor, obj)
				end
				obj.Color = isRoad and roadGreyColor or mediumGreyColor
			end

			if cls == "MeshPart" and isSuper then
				pcall(safeClearMeshTex, obj)
			end

			if (isSuper or isColorful) and not isRoad and not obj.CanCollide and not obj.CanTouch and not obj.CanQuery then
				if nameMatch(obj.Name, pureFoliageHidePatterns) then
					obj.LocalTransparencyModifier = 1
					return true
				end
			end

			if st.renderblockenabled then
				registerPartToRenderBlock(obj)
			end
			return true
		end

		return false
	end

	local function startAutoCleanStream()
		if cache.descendantconn then
			return
		end

		cache.descendantconn = workspace.DescendantAdded:Connect(function(obj)
			if not st.autocleanvfx and not st.reduceenabled then
				return
			end
			pendingCount = pendingCount + 1
			pendingQueue[pendingCount] = obj

			if not cache.queueworker then
				cache.queueworker = true
				task.defer(function()
					while pendingCount > 0 do
						local t0 = os.clock()
						local mutated = 0
						local idx = pendingCount
						while idx > 0 do
							local item = pendingQueue[idx]
							pendingQueue[idx] = nil
							idx = idx - 1
							pendingCount = idx
							if optimizeSingleObject(item, st.reducemethod) then
								mutated = mutated + 1
							end
							if mutated >= 40 or (os.clock() - t0) > 0.002 then
								break
							end
						end
						if pendingCount > 0 then
							task.wait()
						end
					end
					cache.queueworker = false
				end)
			end
		end)
	end

	local function stopAutoCleanStream()
		if cache.descendantconn and not st.autocleanvfx and not st.reduceenabled then
			cache.descendantconn:Disconnect()
			cache.descendantconn = nil
			table.clear(pendingQueue)
			pendingCount = 0
		end
	end

