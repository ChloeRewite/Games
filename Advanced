			W = 0,
			A = 0,
			S = 0,
			D = 0,
			E = 0,
			Q = 0,
			Up = 0,
			Down = 0,
			Shift = 0,
		}

		local mouse = {
			Delta = Vector2.new(),
		}

		local touchPan = Vector2.new()
		local gamepadPan = Vector2.new()
		local navSpeed = 1
		local mobileBoost = 1
		local lastTap = 0
		local touchGui
		local activeTouch
