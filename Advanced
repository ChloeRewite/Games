	local function runSmoothReducePass(forceRecommended)
		if isReducingNow then
			return
		end
		isReducingNow = true

		refreshCharModelSet()
		processedInst = setmetatable({}, { __mode = "k" })

		local activeMethod = forceRecommended and "Super Potato" or (st.reducemethod or "Super Potato")
		local isSuper = (activeMethod == "Super Potato") or (activeMethod == "Super Heavy")
		local isExtended = isSuper or (activeMethod == "Powerfull Heavy") or (activeMethod == "Colorful Heavy")

		if forceRecommended then
			st.forcelowgfx = true
			st.autocleanvfx = true
			st.renderblockenabled = true
			table.clear(spatialBlocks)
			table.clear(spatialBlockMap)
			table.clear(worldGuis)
			trackedPartBlocks = setmetatable({}, { __mode = "k" })
			worldGuiOrig = setmetatable({}, { __mode = "k" })
		end

		if forceRecommended or st.forcelowgfx or activeMethod == "Super Potato" then
			applyPotatoGraphicsEngine()
		end

		local lightDesc = sv.l:GetDescendants()
		for i = 1, #lightDesc do
			optimizeSingleObject(lightDesc[i], activeMethod)
		end

		local wsDesc = workspace:GetDescendants()
		local t0 = os.clock()
		local mutated = 0
		for i = 1, #wsDesc do
			if optimizeSingleObject(wsDesc[i], activeMethod) then
				mutated = mutated + 1
			end
			if mutated >= 220 or (i % 192 == 0 and (os.clock() - t0) > 0.0025) then
				mutated = 0
				task.wait()
				t0 = os.clock()
			end
		end

		local cam = workspace.CurrentCamera
		if cam and not fcRunning then
			cam.FieldOfView = 70
		end

		bindAllPlayersOptimizer(isExtended)

		if forceRecommended then
			startAutoCleanStream()
			startRenderBlockLimiter(true)
			if forceLowGfxToggleObj and forceLowGfxToggleObj.Set then
				pcall(function() forceLowGfxToggleObj:Set(true) end)
			end
			if autoCleanToggleObj and autoCleanToggleObj.Set then
				pcall(function() autoCleanToggleObj:Set(true) end)
			end
			if renderBlockToggleObj and renderBlockToggleObj.Set then
				pcall(function() renderBlockToggleObj:Set(true) end)
			end
		end

		pcall(collectgarbage, "step", 200)
		isReducingNow = false
		if forceRecommended then
			chloex("Super Reduce active! Rata Kiri + " .. tostring(st.maxrenderblocks) .. " Render Blocks applied.")
		end
	end

