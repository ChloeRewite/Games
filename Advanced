            local function attachAccessoryWeld(acc, char, assetId)
                local handle = acc:FindFirstChild("Handle")
                if not handle then return end
                handle.CanCollide = false
                handle.Massless = true

                local sm = handle:FindFirstChildOfClass("SpecialMesh")
                if sm and not vst.AccessoryBaseMeshScale[assetId] then
                    vst.AccessoryBaseMeshScale[assetId] = sm.Scale
                end
                if not vst.AccessoryBasePartSize[assetId] then
                    vst.AccessoryBasePartSize[assetId] = handle.Size
                end

                local handleAtt = handle:FindFirstChildOfClass("Attachment")
                local targetAtt = handleAtt and char:FindFirstChild(handleAtt.Name, true) or nil

                local weld = Instance.new("Weld")
                weld.Name = "AccessoryWeld"
                weld.Part0 = handle
                local baseC0, baseC1

                if targetAtt and handleAtt then
                    weld.Part1 = targetAtt.Parent
                    baseC0 = handleAtt.CFrame
                    baseC1 = targetAtt.CFrame
                else
                    local head = char:FindFirstChild("Head")
                    local fallbackAtt = head and head:FindFirstChild("HatAttachment")
                    if head and fallbackAtt then
                        weld.Part1 = fallbackAtt.Parent
                        baseC0 = acc.AttachmentPoint or CFrame.new()
                        baseC1 = fallbackAtt.CFrame
                    elseif head then
                        weld.Part1 = head
                        baseC0 = CFrame.new()
                        baseC1 = CFrame.new(0, 0.6, 0)
                    end
                end
                if not weld.Part1 then return end

                vst.AccessoryBaseC0[assetId] = baseC0
                vst.AccessoryBaseC1[assetId] = baseC1
                local off = vst.AccessoryOffsets[assetId] or { X = 0, Y = 0, Z = 0, Scale = 1.0 }
                local scaleVal = off.Scale or 1.0

                if sm and vst.AccessoryBaseMeshScale[assetId] then
                    sm.Scale = vst.AccessoryBaseMeshScale[assetId] * scaleVal
                end
                if handle:IsA("MeshPart") and vst.AccessoryBasePartSize[assetId] then
                    handle.Size = vst.AccessoryBasePartSize[assetId] * scaleVal
                end

                local baseRot = baseC0 - baseC0.Position
                weld.C0 = CFrame.new(baseC0.Position * scaleVal) * baseRot
                weld.C1 = baseC1 * CFrame.new(off.X or 0, off.Y or 0, -(off.Z or 0))
                weld.Parent = handle
            end

            local function applySingleAccessoryAsync(char, assetId)
                if not char or not assetId then return end
                local accName = "ChloeX_Acc_" .. tostring(assetId)
                if char:FindFirstChild(accName) or char:FindFirstChild("ChloeX_HeadAcc_" .. tostring(assetId)) then return end

                local template = accessoryCache[assetId]
                if template then
                    local acc = template:Clone()
                    acc.Name = accName
                    attachAccessoryWeld(acc, char, assetId)
                    acc.Parent = char
                    return
                end

                if loadingAssets[assetId] then return end
                loadingAssets[assetId] = true

                task.defer(function()
                    local s, objs = pcall(function() return game:GetObjects("rbxassetid://" .. assetId) end)
                    loadingAssets[assetId] = nil
                    if s and objs and #objs > 0 then
                        template = objs[1]
                        accessoryCache[assetId] = template

                        local stillSelected = false
                        local function check(tbl)
                            for _, name in ipairs(tbl or {}) do
                                if getAssetIdByName(name) == assetId then
                                    stillSelected = true
                                    return
                                end
                            end
                        end
                        check(vst.SelectedHeadAccessories)
                        check(vst.SelectedShoulderAccessories)
                        check(vst.SelectedBackAccessories)

                        local curChar = getRealCharacter()
                        if stillSelected and curChar and not curChar:FindFirstChild(accName) and not curChar:FindFirstChild("ChloeX_HeadAcc_" .. tostring(assetId)) then
                            local acc = template:Clone()
                            acc.Name = accName
                            attachAccessoryWeld(acc, curChar, assetId)
                            acc.Parent = curChar
                        end
                    end
                end)
            end

