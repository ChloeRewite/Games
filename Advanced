                if template and lUpper and (isR6 or (lLower and lFoot)) then
                    local folder = Instance.new("Folder")
                    folder.Name = "ChloeXKorbloxLeft_Rig"
                    folder.Parent = char

                    local hipOrigin = nil
                    local r6HipTop = nil
                    if isR6 then
                        local srcUpper = template:FindFirstChild("LeftUpperLeg")
                        local hipAtt = srcUpper and srcUpper:FindFirstChild("LeftHipRigAttachment")
                        if srcUpper and hipAtt then
                            hipOrigin = srcUpper.CFrame * hipAtt.CFrame
                        elseif srcUpper then
                            hipOrigin = srcUpper.CFrame * CFrame.new(0, srcUpper.Size.Y * 0.5, 0)
                        end
                        r6HipTop = CFrame.new(0, lUpper.Size.Y * 0.5, 0)
                    end

                    local function attachPart(templName, realLimb)
                        local src = template:FindFirstChild(templName)
                        if src and realLimb then
                            local clone = src:Clone()
                            for _, child in ipairs(clone:GetChildren()) do
                                if child:IsA("JointInstance") then
                                    child:Destroy()
                                end
                            end
                            clone.CanCollide = false
                            clone.CanTouch = false
                            clone.CanQuery = false
                            clone.Massless = true
                            clone.Parent = folder

                            local w = Instance.new("Weld")
                            w.Part0 = realLimb
                            w.Part1 = clone
                            if isR6 and hipOrigin and r6HipTop then
                                w.C0 = r6HipTop * hipOrigin:ToObjectSpace(src.CFrame)
                            else
                                w.C0 = CFrame.new(0, 0, 0)
                            end
                            w.Parent = clone
                        end
                    end

                    if isR6 then
                        attachPart("LeftUpperLeg", lUpper)
                        attachPart("LeftLowerLeg", lUpper)
                        attachPart("LeftFoot", lUpper)
                    else
                        attachPart("LeftUpperLeg", lUpper)
                        attachPart("LeftLowerLeg", lLower)
                        attachPart("LeftFoot", lFoot)
                    end
                end
